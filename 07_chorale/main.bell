$t = 0;
$meta = read('./04_beat/beat.txt');
$peak = $meta.'peak';
$b = importaudio('./03_premerge/premerge.wav');
$b.setkey('duration', $peak).transcribe($t);
$t += $peak;
importaudio('./04_beat/beat.wav').transcribe(
    @onset $t + $meta.'offset' @gain 0.85
);
importaudio('./05_cresc/cresc.wav').transcribe(
    @onset $t - read('./05_cresc/cresc.txt') @gain 0.5
);
$t += $meta.'totdur';
$b.setkey('offset', $meta.'resume').transcribe($t);
render(
    @play 1 @process normalize(-3) 
);
ezexport()