setseed(50);
$harm = read('../00_harmony/harmony.txt');
$root = $harm.'mcroot';
$peak = read('../01_background/01_input/input.txt').'totdur' * read('../01_background/background.txt').'stretch';
$b = importaudio('../main.wav');
$b = $b.setkey('offset', $peak);
$bpm = 85;
$bardur = 240000 / $bpm;
$compression = 0.125;
$globaltime = $bardur;
$unit = $bardur * 1/8;
$totdur = $bardur * 12;
$t = 0;
$maxoffset = $b.getkey('source_end') - $unit;
$readbpf = [0 $peak 0] [1 ($maxoffset - $peak) * $compression + $peak 0];
$rhythm = null;
$slopes = null;
$revs = null;
$pans = null;
$cells = xscramble(
    [1/8 1/16 1/16] [1/24 :* 3] [5/16 3/16] 
);
for $i in 1...length($cells) collect (
    $cell = $cells::1;
    $cells = rot($cells, 1);
    $rhythm _= $cell;
    for $j in 1...length($cell) collect (
        $slopes _= xrand(-1/3, 1/3);
        $revs _= xchoose(0 1);
        $pans _= xrand() 
    ) 
);
$rhythm *= float($bardur);
$legatobpf = [0 2 0] [1/3 0.125 -0.125] [1 3 0.125];
while $t < $totdur do (
    $nt = $t / $totdur;
    $legato = exp2(samplebpf($legatobpf, $nt) );
    $val = $rhythm:1;
    $slope = $slopes:1;
    $rev = $revs:1;
    $pan = $pans:1;
    $rhythm = rot($rhythm, -1);
    $slopes = rot($slopes, -1);
    $revs = rot($revs, -1);
    $pans = rot($pans, -1);
    $offset = samplebpf($readbpf, $nt);
    $delay2 = 0;
    $delay1 = 0;
    $env = [0 1 0] [1 0 $slope];
    $seg = $b.setkey('offset', $offset).setkey('duration', $val * $legato).process(gain($env));
    $bass = ezsol(
        @pitch $root
        @duration $val * $legato
        @velocity 127
        @names 'bass' 
        @types 'pizz' 'pizz-secco' 'stacc' 
        @useseed 1
    ).process(gain($env));
    if $rev == 1 then (
        $seg = $seg.process(reverse());
        $delay2 -= ($seg.getkey('duration') - $val);
        $bass = $bass.process(reverse());
        $delay1 -= ($bass.getkey('duration') - $val) 
    );
    $bass.transcribe(
        @onset $t + $globaltime + $delay1 @pan $pan
    );
    $seg.transcribe(
        @onset $t + $globaltime + $delay2 @pan 1 - $pan
    );
    $t += $val
);
render(
    @play 1 @process (
        dynamics(
            @thresh -30
            @ratio 2
            @knee 0.12
            @release 100
        ) 
        ## ---
        normalize(3) 
        ## ---
        arctan() 
        ## ---
        normalize(-3) 
    ) 
);
ezexport(
    ['offset' -$bardur] ['peak' $peak] ['totdur' $totdur] ['resume' $offset] 
)