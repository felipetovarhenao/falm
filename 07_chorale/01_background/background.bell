$stretch = 8;
importaudio('./01_input/input.wav').transcribe();
render(
    @play 1 @process (
        normalize(-14 @rms 1) 
        ## 
        arctan() 
        ## ---
        rubberband(
            @stretching $stretch
            @smoothing 1
            @stretchmode 0
        ) 
        ## ## ----
        ## freeverb(
        ##     @roomsize 0.97
        ##     @wet 0.015
        ##     @damp 1
        ##     @width 1
        ##     @tail 0
        ## ) 
        ## ## ---
        ## fade(0, 3000) 
        ## ---
        normalize(-3) 
    ) 
);
ezexport(['stretch' $stretch])