setseed(32);
$harmony = read('../00_harmony/harmony.txt');
$mcroot = $harmony.'mcroot';
$pcs = $harmony.'pcs';
Granulate = (
    $buffer = null, $onset = 0 -> (
        $t = 0;
        $bufdur = getkey($buffer, 'duration');
        $totdur = min(
            5000, $bufdur * exp2(xrand(-0.5, 0.5)) 
        );
        $offsetbpf = [0 0 0] [1 1 xrand(-0.125, 0.125)];
        while $t < $totdur do (
            $nt = min(1, max(0, $t / $totdur));
            $graindur = xrand(90, 200);
            $incr = $graindur / exp2(xrand(-2, 2));
            $maxoffset = max(0, $bufdur - $graindur);
            $offset = $maxoffset * samplebpf($offsetbpf, $nt);
            $offset = min(
                $maxoffset, max(
                    0, $offset + exp2(xrand(-0.5, 0.5)) * $incr
                ) 
            );
            $grain = $buffer.setkey('duration', $graindur).setkey('offset', $offset);
            $envslope = xrand(-0.33, 0.33);
            $env = xchoose(
                [[0 0 0] [1 1 $envslope]] [[0 1 0] [1 0 $envslope]] [hanning()] 
            )::1;
            transcribe(
                @buffer $grain
                @onset $t + $onset + exp2(xrand(-0.5, 0.5)) * $incr
                @pan xrand() 
                @gain $env
            );
            $t += $incr
        ) 
    ) 
);
Freeze = (
    $buffer = null, $onset = 0, $nt -> (
        $maxdet = round(
            samplebpf(
                [0 0 0] [0.3 0 0] [1 2 0.5], $nt
            ) 
        );
        $t = 0;
        $bufdur = getkey($buffer, 'duration');
        $graindur = min($bufdur, xrand(100, 500));
        $release = getkey(analyze($buffer, envmaxtime()), 'envmaxtime') + 90;
        $readst = min($bufdur - $graindur, getkey($buffer, 'offset') + $release);
        $bufdur = max(1, $bufdur - $release);
        $totdur = min(
            8000, $bufdur * exp2(xrand(2)) 
        );
        $readend = $readst + max(0, $bufdur * xrand(0.5) ** 2 - $graindur);
        $readbpf = [0 $readst 0] [1 $readend xrand(0.5)];
        $gainbpf = [0 1 0] [1 0 xrand(-0.125, 0.125)];
        $panst = mc2pan(getkey($buffer, 'pitch'), 1);
        $panbpf = [0 $panst 0] [1 xrand() xrand(-0.25, 0.25)];
        transcribe(
            @buffer setkey($buffer, 'duration', $release) 
            @onset $onset
            @pan $panst
            @gain [0 1 0] [1 0 0.9] 
        );
        $rampenv = [0 xrand(0.707) ** 2 0] [1 1 xrand(-0.25, 0.25)];
        $mc = getkey($buffer, 'pitch');
        $det = xrandom(0, $maxdet);
        while $t < $totdur do (
            $win = xchoose(
                [$rampenv] [revbpf($rampenv)] [hanning()] 
            )::1;
            $nt = min(1, max(0, $t / $totdur));
            $read = min(samplebpf($readbpf, $nt), max(0, $bufdur - $graindur));
            $pan = samplebpf($panbpf, $nt);
            $gain = samplebpf($gainbpf, $nt);
            $incr = $graindur / 4;
            $truonset = $t + $onset + xrand(-0.5, 0.5) * $incr;
            $trupan = fold($pan + xrand(-1, 1) * 0.1);
            if xrand() < 0.98 then (
                $buffer.setkey('offset', $read).setkey('duration', $graindur).process(gain($gain)).transcribe(
                    @onset $truonset
                    @pan $trupan
                    @gain $win
                    @detune xrandom(-$det, $det) * 1200
                ) 
            ) else (
                sinewave(
                    @pitch $mc + r2c(xchoose(1...8) * 4) 
                    @duration $graindur * exp2(xrand(1, 4)) 
                    @velocity $gain * 5
                    @envelope [0 1 0] [1 0 -0.125] 
                ).transcribe(
                    @onset $truonset
                    @pan xrand() 
                    @gain $gain * xrand(0.01, 0.05) 
                ) 
            );
            $t += $incr
        ) 
    ) 
);
RandEnvelope = (
    $buffer = null, $onset = 0, $pan = null, $gain = null -> (
        $x = 0;
        $minstep = sqrt(90 / getkey($buffer, 'duration'));
        $env = while $x < 1 collect (
            $y = abs(xrand(0.33) - xchoose(0 1));
            $pt = [$x $y xrand(-0.25, 0.25)];
            $x += xrand($minstep, 0.5) ** 2;
            $pt
        );
        $gain = $env [1 0 0];
        transcribe(
            @buffer process($buffer, gain($gain)) 
            @onset $onset
            @pan $pan
        ) 
    ) 
);
Stutter = (
    $buffer = null, $onset = 0, $nt -> (
        $maxdevs = round(
            samplebpf(
                [0 0 0] [0.3 0 0] [1 2 0.5], $nt
            ) 
        );
        $bufdur = $buffer.getkey('duration');
        $totdur = min(2000, $bufdur * exp2(-0.5, 0.5));
        $maxsegs = round($totdur / 90);
        $durs = timeramp(
            @duration $totdur
            @length xrandom(5, $maxsegs) 
            @slope xrand(-0.25, 0.25) 
        );
        $env = [0 1 0] [1 0 xrand(-0.5, 0.5)];
        $dev = xrandom(0, $maxdevs);
        $t = 0;
        for $dur in $durs do (
            $buffer.setkey('duration', max(50, $dur)).transcribe(
                @onset $t + $onset
                @pan xrand() 
                @detune xrandom(-$dev, $dev) * 1200
                @gain $env
            );
            $t += $dur
        ) 
    ) 
);
Stretch = (
    $buffer = null, $onset = 0 -> (
        $stretch = exp2(xrand(3));
        $maxstretch = (10000 / getkey($buffer, 'duration'));
        $buffer = process(
            @buffer $buffer @operations rubberband(
                @stretching max(1.1, min($maxstretch, $stretch)) 
                @smoothing 1
                @stretchmode 0
            ) 
        );
        transcribe(
            @buffer $buffer
            @onset $onset
            @pan xrand() xrand() 
            @gain [0 1 0] [1 0 xrand(-0.25, 0.25)] 
        ) 
    ) 
);
Bell = (
    $buffer = null, $onset = 0 -> (
        $mc = getkey($buffer, 'pitch');
        $mc += r2c(xchoose(1/4 1/2 1...8));
        $gain = mean(
            getkey($buffer, 'maxabs') getkey($buffer, 'rms') 
        );
        $vel = $gain * 127;
        $dur = getkey($buffer, 'duration') * exp2(xrand(-1, 0));
        $wave = sinewave(
            @pitch $mc
            @velocity $vel
            @duration $dur
        );
        $V = xrandom(1, 4);
        $offset = 0;
        if xrand() > 0.5 && $onset > $wave.getkey('duration') then (
            $wave = $wave.process(reverse());
            $offset -= $wave.getkey('duration') 
        );
        for $v in 1...$V do (
            transcribe(
                @buffer $wave
                @onset $onset + $offset
                @pan fold(
                    mc2pan($mc, 1) + xrand(-1, 1) * 0.1
                ) 
                @gain $gain
                @detune if $v > 1 then xrand(-5, 5) 
            ) 
        ) 
    ) 
);
## 
Transcribe = (
    $buffer = null, $onset = 0, $pan = null, $gain = null, $nt = 0 -> (
        $bellthresh = samplebpf([0 0.25 0] [1 0.75 0.125], $nt);
        $fxthresh = samplebpf([0 0.15 0] [1 2/3. 0.125], $nt);
        $buffer = clipnorm(
            @buffer $buffer
            @minlevel -90
            @maxlevel -18
        );
        if xrand() < $bellthresh then (Bell(@buffer $buffer @onset $onset));
        if xrand() < $fxthresh then (
            $fxs = Freeze Granulate Stretch RandEnvelope Stutter;
            $weights = (1 - $nt) * (1 1 1 0 0) + $nt * (1 :* length($fxs));
            $fx = xchoose(@choices $fxs @weights $weights);
            $fx(
                @buffer $buffer
                @onset $onset
                @pan $pan
                @gain $gain
                @nt $nt
            ) 
        ) else (
            ## ----
            transcribe(
                @buffer $buffer
                @onset $onset
                @pan $pan
                @gain $gain
            ) 
        ) 
    ) 
);
GenBuffer = (
    $pitch = c5, $duration = 1000, $velocity = 65 -> (
        $fn = xchoose(pno ezsol @weights 3 2);
        $fn(
            @pitch $pitch
            @duration $duration
            @velocity $velocity
            @names family('plucked') (
                if xrand() > 0.8 && $velocity > 50 then 'acc' 
            ) 
            @types 'ord' (
                if $velocity > 65 then 'bisb' 'ord-high' 'reg' 'sfz' 'harm' 
            ) 
            @gain 0.05
            @norm 0.25
            @useseed 1
        ) 
    ) 
);
Chord = (
    $mcs = null, $onset = 0, $duration = 2000, $nt = 0 -> (
        $chordsize = round(
            length($mcs) * samplebpf([0 0.25 0] [1 1 0.25], $nt) 
        );
        $vel = round(
            samplebpf([0 0 0] [1 127 -0.125], $nt) 
        );
        $mcs = xscramble($mcs).left($chordsize);
        $roll = xrand() ** 2 * ($duration / length($mcs));
        $durs = timeramp(
            @duration $roll
            @length length($mcs) 
            @slope xrand(-0.125, 0.125) 
        );
        $t = 0;
        for $mc in $mcs, $dur in $durs do (
            GenBuffer(
                @pitch $mc
                @duration $duration * exp2(xrand(-0.5, 0.5)) 
                @velocity xrand($vel) 
            ).Transcribe(
                @onset $onset + $t
                @pan xrand() 
                @gain [0 1 0] [1 0 xrand(-0.25, 0.25)] 
                @nt $nt
            );
            $t += $dur
        );
        $duration
    ) 
);
Trill = (
    $mcs = null, $onset = 0, $duration = 2000, $nt = 0 -> (
        $vel = samplebpf([0 0 0] [1 127 -0.125], $nt);
        $mcs = randomseq(
            @llll $mcs
            @length xrandom(1, 4) 
            @steps -1 1
            @useseed 1
        );
        $mindur = min($duration, xrand(50, 100));
        $maxdur = xrand(0.25, 1) * ($duration / length($mcs));
        $incrbpf = float($mindur $maxdur);
        if xrand() > 0.5 then ($incrbpf = rev($incrbpf) );
        if xrand() > 0.5 then ($incrbpf _= $incrbpf:1);
        $xpts = arithmser(0, 1, null, length($incrbpf)).scale(0, 1, 0, 1, xrand(-1/3., 1/3));
        $incrbpf = for $x $xi in $xpts collect [$x $incrbpf:$xi xrand(-0.125, 0.125)];
        $t = 0;
        $pan = xrand(-1, 1) * 0.5;
        while $t < $duration do (
            $nt = min(1, max(0, $t / $duration));
            $mc = $mcs:1;
            $mcs = rot($mcs, 1);
            $incr = samplebpf($incrbpf, $nt);
            $start = $t + $onset;
            GenBuffer(
                @pitch $mc
                @duration if $start + $incr < $duration then max(250, $incr * 4) 
                @velocity xrand($vel) 
            ).Transcribe(
                @onset $start
                @pan fold(mc2pan($mc, 0.1) + $pan) 
                @gain [0 1 0] [1 0 0.75] 
                @nt $nt
            );
            $t += $incr
        );
        $duration
    ) 
);
Blurb = (
    $mcs = null, $onset = 0, $duration = 2000, $nt = 0 -> (
        $vel = samplebpf([0 0 0] [1 127 -0.125], $nt);
        $stepsize = int(
            round(
                samplebpf([0 1 0] [1 5 0.125], $nt) 
            ) 
        );
        $maxlen = round(
            ($duration / 90) * samplebpf([0 0.25 0] [1 1 0.125], $nt) 
        );
        $len = xrandom(5, $maxlen);
        $seq = randomseq(
            @llll $mcs
            @length $len
            @steps -$stepsize...$stepsize
            @useseed 1
        );
        $numattacks = xrandom(1, $len);
        $addrs = int(
            round(arithmser(1, $len + 1, null, $numattacks + 1)) 
        );
        $ranges = trans(
            [left($addrs, -1)] [right($addrs, 1) - 1] 
        );
        $chords = for $range in $ranges collect [
            sort(thin($seq:$range)) 
        ];
        $durs = timeramp(
            @duration $duration
            @length length($chords) 
            @slope xrand(-1, 1) * 1/2
        );
        $numchords = length($chords);
        $t = 0;
        $pan = xrand(-1, 1) * 0.5;
        for $chord $chordid in $chords, $dur in $durs with @unwrap 1 do (
            for $mc in $chord do (
                GenBuffer(
                    @pitch $mc
                    @velocity xrand($vel) 
                    @duration if $chordid < $numchords then max(250, 4 * $dur) 
                ).Transcribe(
                    @onset $t + $onset
                    @pan fold($pan + mc2pan($mc, 0.1) ) 
                    @gain [0 1 0] [1 0 0.75] 
                    @nt $nt
                ) 
            );
            $t += $dur
        );
        $duration
    ) 
);
Pattern = (
    $mcs = null, $onset = 0, $duration = 2000, $nt = 0 -> (
        $vel = samplebpf([0 0 0] [1 127 -0.125], $nt);
        $pat = xscramble(-2 1 1 2).left(xrandom(1, 4));
        $nummcs = length($mcs);
        $patst = xrandom(0, $nummcs - 1);
        $patreps = xrandom(
            2, $duration / (100 * length($pat)) 
        );
        $pat = dx2x($pat :* $patreps, $patst);
        $scale = $nummcs - 1;
        $pat = int(
            (fold($pat / $scale) * $scale) + 1
        );
        $durs = timeramp(
            @duration $duration
            @length length($pat) 
            @slope xrand(-0.33, 0.33) 
        );
        $t = 0;
        for $dur $id in $durs, $mc in $mcs:[$pat] do (
            GenBuffer(
                @pitch $mc
                @duration if $id < length($pat) then max(500, $dur) 
                @velocity xrandom($vel) 
            ).Transcribe(
                @onset $onset + $t
                @pan xrand() 
                @gain [0 1 0] [1 0 0.7] 
                @nt $nt
            );
            $t += $dur
        ) 
    ) 
);
$spectrum = pcquant(r2mc(1...32, $mcroot), $pcs);
$spectrum = $spectrum:[
    argsort(abs($spectrum - d5)) 
];
$t = 0;
$meta = read('../01_background/background.txt');
$fulldur = $meta.'totdur';
$peak = $meta.'peak';
$totdur = $peak + ($fulldur - $peak) * 1/3;
$midpt = $peak / $totdur;
$gapthreshbpf = [0 1 0] [$midpt 0 0.125] [1 1 -0.125];
$mcfilterbpf = [0 0.43 0] [$midpt 1 -0.125] [1 1 0];
$overlapbpf = [0 1 0] [$midpt 2.125 0.5] [1 1 -0.5];
$durmulbpf = [0 1 0] [$midpt 0.5 0.25] [1 1 -0.25];
$gapmulbpf = [0 1 0] [$midpt 0.125 0.25] [1 1 -0.25];
$ctrlbpf = [0 0 0] [$midpt 1 0] [1 0 0];
while $t < $totdur do (
    $nt = min(1, max(0, $t / $totdur));
    $mcfilter = round(samplebpf($mcfilterbpf, $nt) * length($spectrum));
    $gapthresh = samplebpf($gapthreshbpf, $nt);
    $overlap = samplebpf($overlapbpf, $nt);
    $gapmul = samplebpf($gapmulbpf, $nt);
    $durmul = samplebpf($durmulbpf, $nt);
    $ctrl = samplebpf($ctrlbpf, $nt);
    $obj = xchoose(
        Trill Blurb Pattern Chord @weights (4 8 2 1) ** 1.25
    );
    $timestep = $obj(
        @mcs sort(left($spectrum, $mcfilter)) 
        @onset $t
        @duration xrand(1000, 5000) * $durmul
        @nt $ctrl
    );
    $t += $timestep / $overlap;
    if xrand() < $gapthresh then ($t += xrandom(1000, 6000) * $gapmul) 
);
render(
    @play 1 @process normalize(-3) 
);
ezexport()