setseed(12);
$harmony = read('../00_harmony/harmony.txt');
$mcroot = $harmony.'mcroot';
$pcs = $harmony.'pcs';
Freeze = (
    $buffer = null, $onset = 0 -> (
        $t = 0;
        $release = getkey(analyze($buffer, envmaxtime()), 'envmaxtime') + 90;
        $readst = getkey($buffer, 'offset') + $release;
        $bufdur = max(1, getkey($buffer, 'duration') - $release);
        $totdur = $bufdur * exp2(xrand(2));
        $readend = $readst + $bufdur * xrand(0.9) ** 2;
        $readbpf = [0 $readst 0] [1 $readend xrand(-0.25, 0.25)];
        $graindur = xrand(100, 500);
        $gainbpf = [0 1 0] [1 0 xrand(-0.125, 0.125)];
        $panst = mc2pan(getkey($buffer, 'pitch'), 1);
        $panbpf = [0 $panst 0] [1 xrand() xrand(-0.25, 0.25)];
        transcribe(
            @buffer $buffer.setkey('duration', $release) 
            @onset $onset
            @pan $panst
            @gain [0 1 0] [1 0 0.9] 
        );
        $rampenv = [0 xrand(0.707) ** 2 0] [1 1 xrand(-0.25, 0.25)];
        $win = xchoose(
            [$rampenv] [revbpf($rampenv)] [hanning()] 
        )::1;
        $mc = getkey($buffer, 'pitch');
        $det = xrandom(0, 1);
        while $t < $totdur do (
            $nt = min(1, max(0, $t / $totdur));
            $read = samplebpf($readbpf, $nt);
            $pan = samplebpf($panbpf, $nt);
            $gain = samplebpf($gainbpf, $nt);
            $incr = $graindur / 4;
            $truonset = $t + $onset + xrand(-0.5, 0.5) * $incr;
            $trupan = fold($pan + xrand(-1, 1) * 0.1);
            if xrand() < 0.98 then (
                $buffer.setkey('offset', $read).setkey('duration', $graindur).process(gain($gain)).transcribe(
                    @onset $truonset
                    @pan $pan
                    @gain $win
                    @detune xrandom(-1, 1) * 1200 * $det
                ) 
            ) else (
                sinewave(
                    @pitch $mc + r2c(xchoose(1...8) * 4) 
                    @duration $graindur * exp2(xrand(1, 4)) 
                    @velocity $gain * 5
                    @envelope [0 1 0] [1 0 -0.125] 
                ).transcribe(
                    @onset $truonset
                    @pan xrand() 
                    @gain $gain * xrand(0.01, 0.05) 
                ) 
            );
            $t += $incr
        ) 
    ) 
);
Stretch = (
    $buffer = null, $onset = 0 -> (
        $stretch = exp2(xrand(3));
        $buffer = process(
            @buffer $buffer @operations rubberband(
                @stretching $stretch
                @smoothing 1
                @stretchmode 0
            ) 
        );
        transcribe(
            @buffer $buffer
            @onset $onset
            @pan xrand() xrand() 
            @gain [0 1 0] [1 0 xrand(-0.25, 0.25)] 
        ) 
    ) 
);
Bell = (
    $buffer = null, $onset = 0 -> (
        $mc = getkey($buffer, 'pitch');
        $mc += r2c(xchoose(1/4 1/2 1...8));
        $gain = mean(
            getkey($buffer, 'maxabs') getkey($buffer, 'rms') 
        );
        $vel = $gain * 127;
        $dur = getkey($buffer, 'duration') * exp2(xrand(-1, 0));
        $wave = sinewave(
            @pitch $mc
            @velocity $vel
            @duration $dur
        );
        $V = xrandom(1, 4);
        $offset = 0;
        if xrand() > 0.5 && $onset > $wave.getkey('duration') then (
            $wave = $wave.process(reverse());
            $offset -= $wave.getkey('duration') 
        );
        for $v in 1...$V do (
            $wave.transcribe(
                @onset $onset + $offset
                @pan fold(
                    mc2pan($mc, 1) + xrand(-1, 1) * 0.1
                ) 
                @gain $gain
                @detune if $v > 1 then xrand(-5, 5) 
            ) 
        ) 
    ) 
);
## 
Transcribe = (
    $buffer = null, $onset = 0, $pan = null, $gain = null -> (
        if xrand() > 0.66 then (Bell(@buffer $buffer @onset $onset));
        if xrand() < 0.85 then (
            ## ----
            transcribe(
                @buffer $buffer
                @onset $onset
                @pan $pan
                @gain $gain
            ) 
        ) else (
            $fx = xchoose(Freeze Stretch);
            $fx(
                @buffer $buffer
                @onset $onset
                @pan $pan
                @gain $gain
            ) 
        ) 
    ) 
);
GenBuffer = (
    $pitch = c5, $duration = 1000, $velocity = 65 -> (
        $fn = xchoose(pno ezsol @weights 1 2);
        $fn(
            @pitch $pitch
            @duration $duration
            @velocity $velocity
            @names family('plucked') 
            @types 'ord' 'ord-high' 
            @gain 0.05
            @norm 0.25
            @useseed 1
        ) 
    ) 
);
Trill = (
    $mcs = null, $onset = 0, $duration = 2000, $nt = 0 -> (
        $vel = samplebpf([0 0 0] [1 127 0.125], $nt);
        $mcs = randomseq(
            @llll $mcs
            @length xrandom(1, 4) 
            @steps -1 1
            @useseed 1
        );
        $mindur = min($duration, xrand(50, 100));
        $maxdur = xrand(0.25, 1) * ($duration / length($mcs));
        $incrbpf = float($mindur $maxdur);
        if xrand() > 0.5 then ($incrbpf = rev($incrbpf) );
        if xrand() > 0.5 then ($incrbpf _= $incrbpf:1);
        $xpts = arithmser(0, 1, null, length($incrbpf)).scale(0, 1, 0, 1, xrand(-1/3., 1/3));
        $incrbpf = for $x $xi in $xpts collect [$x $incrbpf:$xi xrand(-0.125, 0.125)];
        $t = 0;
        $pan = xrand(-1, 1) * 0.5;
        while $t < $duration do (
            $nt = min(1, max(0, $t / $duration));
            $mc = $mcs:1;
            $mcs = rot($mcs, 1);
            $incr = samplebpf($incrbpf, $nt);
            $start = $t + $onset;
            GenBuffer(
                @pitch $mc
                @duration if $start + $incr < $duration then max(250, $incr * 4) 
                @velocity xrand($vel) 
            ).Transcribe(
                @onset $start
                @pan fold(mc2pan($mc, 0.1) + $pan) 
                @gain [0 1 0] [1 0 0.75] 
            );
            $t += $incr
        );
        $duration
    ) 
);
Blurb = (
    $mcs = null, $onset = 0, $duration = 2000, $nt = 0 -> (
        $vel = samplebpf([0 0 0] [1 127 0.125], $nt);
        $len = xrandom(5, 10);
        $seq = randomseq(
            @llll $mcs
            @length $len
            @steps -2...2
            @useseed 1
        );
        $numattacks = xrandom(1, $len);
        $addrs = int(
            round(arithmser(1, $len + 1, null, $numattacks + 1)) 
        );
        $ranges = trans(
            [left($addrs, -1)] [right($addrs, 1) - 1] 
        );
        $chords = for $range in $ranges collect [
            sort(thin($seq:$range)) 
        ];
        $durs = timeramp(
            @duration $duration
            @length length($chords) 
            @slope xrand(-1, 1) * 1/2
        );
        $numchords = length($chords);
        $t = 0;
        $pan = xrand(-1, 1) * 0.5;
        for $chord $chordid in $chords, $dur in $durs with @unwrap 1 do (
            for $mc in $chord do (
                GenBuffer(
                    @pitch $mc
                    @velocity xrand($vel) 
                    @duration if $chordid < $numchords then max(250, 4 * $dur) 
                ).Transcribe(
                    @onset $t + $onset
                    @pan fold($pan + mc2pan($mc, 0.1) ) 
                    @gain [0 1 0] [1 0 0.75] 
                ) 
            );
            $t += $dur
        );
        $duration
    ) 
);
$spectrum = pcquant(r2mc(1...32, $mcroot), $pcs);
$t = 0;
$peak = read('../01_background/01_input/input.txt').'totdur';
$stretch = read('../01_background/background.txt').'stretch';
$totdur = $stretch * $peak;
$gapthreshbpf = [0 1 0] [$peak 0.01 -0.125] [1 1 0.125];
$gapbpf = [0 4000 0] [$peak 250 -0.125] [1 4000 0.125];
$mcfilterbpf = [0 0.5 0] [$peak 1 0.125] [1 1 0.125];
while $t < 120000 ||| $totdur do (
    $nt = min(1, max(0, $t / $totdur));
    $mcfilter = round(samplebpf($mcfilterbpf, $nt) * length($spectrum));
    $gapthresh = samplebpf($gapthreshbpf, $nt);
    $gap = samplebpf($gapbpf, $nt);
    $obj = xchoose(Trill Blurb @weights 1 4);
    $t += $obj(
        @mcs left($spectrum, $mcfilter) 
        @onset $t
        @duration xrand(500, 5000) 
        @nt $nt
    );
    if xrand() < $gapthresh then (
        $t += $gap * exp2(xrand(-0.5, 0.5)) 
    ) 
);
render(
    @play 1 @process (
        freeverb(
            @roomsize 0.98
            @wet 0.0125
            @damp 1
            @width 1
            @tail 0
        ) 
        ## ---
        fade(0, 1000) 
        ## ---
        normalize(-3) 
        ## ---
        mix(importaudio('../01_background/background.wav')) normalize(-3) 
    ) 
);
ezexport()