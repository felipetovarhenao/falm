setseed(0);
$t = 0;
$mcroot = c#2;
$pcroot = mc2pc($mcroot);
$rawchord = r2mc(1...32, $mcroot);
$chords = r2pc(
    ## -----------------
    [1 5/4 3/2] 
    ## -----------------
    [1 5/4 3/2 15/8] 
    ## -----------------
    [1 4/3 3/2 15/8] 
    ## -----------------
    [1 4/3 3/2 6/5] 
    ## ## -----------------
    [1 6/5 4/3 3/2 7/4] 
    ## ## -----------------
    [1 5/4 7/5 5/3] 
    ## ## -----------------
    [16/15 4/3 8/5 6/5] 
    ## ## -----------------
    [8/5 7/4 1 6/5] 
    ## ## -----------------
    [10/9 4/3 7/4 15/8] 
    ## ## -----------------
    [9/8 1 7/5 5/3 12/7] 
    ## -----------------
    @pc $pcroot
);
$bardur = 3000;
$croplist = ($list, $n -> left($list, $n));
$gaps = for $x in 1...length($chords) collect $bardur * xchoose(1/4 1/8 3/16 5/16 7/16);
for $n in 1...length($chords) do (
    for $chord in $chords.$croplist($n), $gap in $gaps.$croplist($n) with @unwrap 1 do (
        $peaks = null;
        $chord = $rawchord.pcquant($chord);
        $bufs = for $mc in $chord collect (
            $fn = xchoose(ezsol sinewave triwave rectwave sawwave @weights 90 4 3 2 1);
            $b = $fn(
                @pitch max($mcroot, $mc + if $fn != ezsol then xrandom(-1, 5) * 1200 else 0) 
                @duration if $fn != ezsol then xrand(100, 900) else xrand(200, 400) 
                @names family('winds') 
                @types 'stacc' 
                @velocity 127
                @phase xrand() 
                @envelope [0 0.0125 0] [1 0 -xrand(1/3, 6/7)] 
                @useseed 1
            ).process(dcfilter() normalize(-3));
            $peak = $b.setkey('duration', 90).analyze(envmaxtime()).getkey('envmaxtime');
            $peaks _= $peak;
            $b.setkey('envmaxtime', $peak, @mode 1) 
        );
        $maxpeak = maximum($peaks);
        for $b in $bufs do (
            $shift = 0;
            $op = gain(
                [0 1 0] [1 0 -xrand(1/3, 3/4)] 
            );
            if xrand() > 0.9 then (
                $op _= reverse();
                $shift -= $b.getkey('duration') 
            );
            $b.process($op).transcribe(
                @onset $maxpeak - $b.getkey('envmaxtime') + $t + $shift @pan mc2pan($b.getkey('pitch'), 0.3) 
            ) 
        );
        $t += $gap
    ) 
);
for $onset in arithmser(0, $t, $bardur * 1/16) do (
    ezsol(
        @pitch $mcroot + 1200 * 2
        @names family('strings') 
        @types 'pizz' 
        @velocity 80
        @duration null
    ).transcribe(
        @onset $onset @pan (xrand() - 0.5) * 0.5 + 0.5
    ) 
);
$b = render(
    @reset 1 @process normalize(-3) dynamics(
        @ratio 4
        @release 200
        @attack 5
        @thresh -30
        @knee 1
    ) normalize(-3) freeverb(
        @roomsize 0.8
        @wet 0.0125
        @damp 1
        @width 1
    ) 
);
$dur = $onset;
$t = 0;
## for $i in 1...4 do (
##     $b.transcribe($t);
##     $t += $dur
## );
$b.transcribe();
render(@play 1);
ezexport()