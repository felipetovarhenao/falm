setseed(10);
$t = 2000;
$head = $t;
$mcroot = c#2;
$pcroot = mc2pc($mcroot);
$rawchord = r2mc(1...32, $mcroot);
$chords = r2pc(
    ## -----------------
    [1 5/4 3/2] 
    ## -----------------
    [1 5/4 3/2 15/8] 
    ## -----------------
    [1 4/3 3/2 15/8] 
    ## -----------------
    [1 4/3 3/2 6/5] 
    ## ## -----------------
    [1 6/5 4/3 3/2 7/4] 
    ## ## -----------------
    [1 5/4 7/5 5/3] 
    ## ## -----------------
    [16/15 4/3 8/5 6/5] 
    ## ## -----------------
    [8/5 7/4 1 6/5] 
    ## ## -----------------
    [10/9 4/3 7/4 15/8] 
    ## ## -----------------
    [9/8 1 7/5 5/3 12/7] 
    ## -----------------
    @pc $pcroot
);
$bardur = 3000;
$croplist = ($list, $n -> left($list, $n).rev());
$gaps = for $x in 1...length($chords) collect $bardur * xchoose(1/4 3/16 5/16 7/16);
$wetbpf = [0 0 0];
for $n in rev(1...length($chords)) do (
    for $chord in $chords.$croplist($n), $gap in $gaps.$croplist($n) with @unwrap 1 do (
        $peaks = null;
        $chord = $rawchord.pcquant($chord);
        $mcbass = $chord.sort().left(3).xchoose();
        ezsol(
            @pitch $mcbass
            @names family('strings') family('plucked') 
            @types 'pizz' 'stacc' 
            @velocity 127
            @duration $gap * 2
        ).transcribe(
            @onset $t
            @pan 0.5
            @gain [0 1 0] [1 0 0.5] 
        );
        $bufs = for $mc in $chord collect (
            $fn = xchoose(ezsol sinewave triwave rectwave sawwave @weights 100 4 3 2 1);
            $normop = dcfilter() if $fn == ezsol then normalize(-3);
            $b = $fn(
                @pitch max($mcroot, $mc + if $fn != ezsol then xrandom(-1, 5) * 1200 else 0) 
                @duration if $fn != ezsol then xrand(100, 900) else xrand(200, 800) 
                @names family('winds') 'acc' 
                @types 'stacc' 
                @velocity if $fn != ezsol then xrandom(10, 100) else 127
                @phase xrand() 
                @envelope [0 0 0] [
                    xrand(0.001, 0.5) xrand(0.005, 0.125) xrand(1/3, 3/4) 
                ] [1 0 -xrand(1/3, 6/7)] 
                @useseed 1
            ).process($normop);
            $peak = getkey(
                analyze(setkey($b, 'duration', 90), envmaxtime()), 'envmaxtime' 
            );
            $peaks _= $peak;
            setkey(
                $b, 'envmaxtime', $peak, @mode 1
            ) 
        );
        $maxpeak = maximum($peaks);
        for $b in $bufs do (
            $shift = 0;
            $op = gain(
                [0 1 0] [1 0 -xrand(1/3, 3/4)] 
            );
            if xrand() > 0.9 then (
                $op _= reverse();
                $shift -= $b.getkey('duration') 
            );
            $b.process($op).transcribe(
                @onset $maxpeak - $b.getkey('envmaxtime') + $t + $shift @pan mc2pan($b.getkey('pitch'), 0.3) 
            ) 
        );
        $t += $gap;
        $wetbpf _= [
            $t xrand().scale(0, 1, 0.005, 0.025, 0.125) xrand(1/3, 3/4) * xchoose(-1 1) 
        ] 
    ) 
);
## for $onset in arithmser(0, $t, $bardur * 1/16) do (
##     ezsol(
##         @pitch $mcroot + 1200 * 2
##         @names family('strings') 
##         @types 'pizz' 
##         @velocity 80
##         @duration null
##     ).transcribe(
##         @onset $onset @pan (xrand() - 0.5) * 0.5 + 0.5
##     ) 
## );
render(
    @play 1
    @fade 2
    @process crop(@start $head @end -1) fade(5, 5) normalize(-3) freeverb(
        @roomsize 0.6
        @wet $wetbpf
        @damp 1
        @width 1
    ) 
);
ezexport()