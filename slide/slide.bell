setseed(4510);
$mcroot = ab1;
$pcroot = mc2pc($mcroot);
$ratios = 1 5/4 3/2 5/3 7/5 9/8;
$pcs = r2pc($ratios @pc $pcroot);
$fullchord = r2mc(4...24, $mcroot).pcquant($pcs);
$chordsize = 4;
$panspread = 0.5;
$chords = (
    $fullchord.group($chordsize, $chordsize - 1).group(2, 1) 
).xscramble();
$t = 0;
$unit = 170;
$mindb = -10;
$types = 'ord' 'harm' 'ord-high' 'pizz' 'pont' 'tasto' 'near-pegs' 'near-board' 'damp' 'stacc' 'harm-in-wood' 'bartok';
$names = family('plucked');
for $chordpair in $chords with @unwrap 1 do (
    $dur = $unit * xchoose(1 2 3);
    $rev = xrand() > 0.5;
    if $rev then $chordpair = $chordpair.rev();
    $glisses = $chordpair.trans();
    $slope = xrand(1/3, 6/7) * xchoose(-1 1);
    for $gliss in $glisses with @unwrap 1 do (
        $vel = xrand(10, 127);
        $mc1 = $gliss:1;
        $mc2 = $gliss:2;
        $diff = pitchdiff($mc1, $mc2).c2r();
        $env = [0 1 0] [1 1/$diff $slope];
        $durmul = integrate(
            @llll $env @numsamples 100
        ):(-1 2);
        $b = ezsol(
            @pitch $mc1
            @types $types
            @names $names
            @duration $dur / $durmul
            @velocity $vel
            @useseed 1
        ).process(resample($env) trim(@threshold 0.0025 @end 0));
        if $b.getkey('maxabs') > 0 then (
            if $b.getkey('maxabs').atodb() < $mindb then (
                $b = $b.process(normalize($mindb)) 
            );
            $pan = [0 mc2pan($mc1, $panspread) 0] [1 mc2pan($mc2, $panspread) $slope];
            sinewave(
                @pitch $mc1 + 1200 * xrandom(-1, 6) 
                @duration $dur * xrand(-1, 1.5).exp2() 
                @velocity $vel
            ).transcribe(
                @onset $t
                @pan $pan
                @gain xrand(0.05, 0.125) 
            );
            $b.transcribe(
                @onset $t
                @pan $pan
                @gain [0 1 0] [1 0 0.9] 
            ) 
        ) 
    );
    $t += $dur
);
$b = render(
    @reset 1 @process normalize(-3) 
);
$dur = $t;
$t = 0;
for $i in 1...4 do (
    $b.transcribe($t);
    $t += $dur
);
render(
    @play 1 @process freeverb(
        @roomsize 0.7
        @damp 1
        @width 1
        @wet 0.025
    ) normalize(-3) 
);
ezexport()