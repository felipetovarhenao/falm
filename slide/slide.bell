$op = normalize(-3);
$mcroot = ab1;
$pcroot = mc2pc($mcroot);
$ratios = 1 5/4 3/2 5/3 7/5 9/8;
$pcs = r2pc($ratios @pc $pcroot);
$fullchord = pcquant(r2mc(4...24, $mcroot), $pcs);
$unit = 170;
$mindb = -10;
$types = 'ord' 'harm' 'ord-high' 'pizz' 'pont' 'tasto' 'near-pegs' 'near-board' 'damp' 'stacc' 'harm-in-wood' 'bartok';
$names = family('plucked');
$panspread = 1/3;
$gain = [0 1 0] [1 0 0.9];
$events = null;
$numsizes = 7;
$seeds = 45100 :* $numsizes;
for $seed $chordsize in $seeds collect (
    setseed($seed);
    $t = 0;
    $chords = xscramble(
        group(group($fullchord, $chordsize, $chordsize - 1), 2, 1) 
    );
    for $chordpair in $chords with @unwrap 1 do (
        $dur = $unit * xchoose(
            1...int(
                round(scale($chordsize, 1, $numsizes, 3, 1, 0.25)) 
            ) 
        );
        if xrand() > 0.5 then $chordpair = rev($chordpair);
        $glisses = trans($chordpair);
        $slope = xrand(1/3, 6/7) * xchoose(-1 1);
        for $gliss in $glisses with @unwrap 1 do (
            $vel = xrand(10, 127);
            $mc1 = $gliss:1;
            $mc2 = $gliss:2;
            $diff = c2r(pitchdiff($mc1, $mc2));
            $env = [0 1 0] [1 1/$diff $slope];
            $durmul = integrate(
                @llll $env @numsamples 100
            ):(-1 2);
            $b = ezsol(
                @pitch $mc1
                @types $types
                @names $names
                @duration $dur / $durmul
                @velocity $vel
                @useseed 1
            );
            $b = process(
                @buffer $b @operations resample($env) trim(@threshold 0.00125 @end 0) 
            );
            if getkey($b, 'maxabs') > 0 then (
                if atodb(getkey($b, 'maxabs')) < $mindb then (
                    $b = process($b, normalize($mindb)) 
                );
                $pan = [0 mc2pan($mc1, $panspread) 0] [1 mc2pan($mc2, $panspread) $slope];
                $wv = sinewave(
                    @pitch $mc1 + 1200 * xrandom(-1, 6) 
                    @duration $dur * exp2(xrand(-1.25, 1.25)) 
                    @velocity $vel
                );
                $amp = xrand(0.0125, 0.125);
                transcribe(
                    @buffer $wv
                    @onset $t
                    @pan $pan
                    @gain $amp
                );
                transcribe(
                    @buffer $b
                    @onset $t
                    @pan $pan
                    @gain $gain
                ) 
            ) 
        );
        $t += $dur
    );
    $events _= [
        ## ----
        ['buffer' render(
            @reset 1 @process $op
        )] 
        ## ----
        ['duration' $t] 
    ] 
);
for $event $eventid in $events do (
    $b = getkey($event, 'buffer');
    $dur = getkey($event, 'duration');
    transcribe($b);
    render(
        @reset 1 @process freeverb(
            @roomsize 0.7
            @damp 1
            @width 1
            @wet 0.0125
        ) normalize(-3) 
    );
    ezexport(@data $dur @id $eventid) 
)