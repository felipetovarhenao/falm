$fullchord = r2mc(4...48, e1).pcquant(r2pc(1 5/4 3/2 15/8));
$chordsize = 4;
$chords = $fullchord.group($chordsize, $chordsize - 1).group(2, 1).xscramble();
$t = 0;
for $chordpair in $chords with @unwrap 1 do (
    $dur = 180 * xchoose(1 2 4 3);
    $glisses = $chordpair.trans();
    $rev = xrand() > 0.5;
    $slope = xrand(1/3, 6/7) * xchoose(-1 1);
    for $gliss in $glisses with @unwrap 1 do (
        $vel = xrand(50, 127);
        if $rev == 1 then ($gliss = rev($gliss) );
        $mc1 = $gliss:1;
        $mc2 = $gliss:2;
        $diff = pitchdiff($mc1, $mc2).c2r();
        $env = [0 1 0] [1 1/$diff $slope];
        $durmul = integrate(
            @llll $env @numsamples 100
        ):(-1 2);
        $b = ezsol(
            @pitch $mc1
            @types 'ord' 'harm' 'ord-high' 'pizz' 'pont' 'tasto' 'near-pegs' 'near-board' 'damp' 'stacc' 
            @names family('plucked') 
            @duration $dur / $durmul
            @velocity $vel
        ).process(trim(@threshold 0.001) resample($env));
        $mindb = -16;
        if $b.getkey('maxabs').atodb() < $mindb then (
            $b = $b.process(normalize($mindb)) 
        );
        $b.transcribe(
            @onset $t
            @pan mc2pan($mc1 $mc2) 
            @gain [0 1 0] [1 0 0.9] 
        ) 
    );
    $t += $dur
);
render(
    @play 1 @process normalize(-3) repeat(4) freeverb(@roomsize 0.7 @damp 1) 
);
ezexport()