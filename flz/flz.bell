$root = 5800;
$chords = (
    [1 5/4 7/5 11/7] [1 7/6 3/2 7/4] [1 5/4 3/2 11/6] [1 6/5 8/5 7/4] [1 5/4 3/2 15/8] 
);
$chords = ($chords :* 4).xscramble().r2mc($root);
$t = 0;
$bardur = 3000;
$units = 5/8 3/8 1/2 3/4;
for $chord in $chords with @unwrap 1 do (
    $chord = $chord.sort();
    $maxdur = 0;
    $dur = xchoose($units @weights $units) * $bardur;
    cycle(
        xchoose($chord).mc2f() / 2 @duration 200
    ).process(gain(0.1)).transcribe(
        @onset $t
        @gain [0 1 0] [1 0 -0.5] 
        @pan xrand() 
    );
    $slope = xrand(0.707);
    $mingain = xrand(0.01, 0.25);
    for $mc $mci in $chord do (
        $b = flute(
            @pitch $mc + 1200 @duration null
        ).analyze(envmaxtime());
        $b.transcribe(
            @onset $t @pan 1 - $pan
        );
        $pan = scale($mci, 1, length($chord), 0, 1);
        $b = flute(
            @pitch $mc
            @type xchoose(
                'flz' 'air-and-ord' 
            ) 
            @duration $dur
            @velocity 0
        );
        $b.transcribe(
            @onset $t
            @pan $pan (1 - $pan) 
            @gain xchoose(
                ## 
                [[0 $mingain 0] [1 1 $slope]] 
                ## 
                [[0 1 0] [1 $mingain -$slope]] 
                ## 
                [] 
                ## 
                [
                    [0 1 0] [1 $mingain -$slope] [2 1 $slope] 
                ] 
                ## 
                [
                    [0 $mingain 0] [1 1 -$slope] [2 $mingain $slope] 
                ] 
            )::1
        );
        $maxdur = max($maxdur, $b.getkey('duration')) 
    );
    $t += $maxdur
);
$b = render(
    @reset 1 @process freeverb(
        @roomsize 0.9
        @wet 0.025
        @damp 1
        @width 1
    ) 
);
$b.transcribe();
$clicks = arithmser(0, $t, $bardur / 24);
for $t in $clicks do (
    cycle(
        @frequency r2mc(1 3/2, $root).xchoose().mc2f() * exp2(xrandom(-3, 5)) @duration xrand(25, 50) 
    ).transcribe(
        @onset $t
        @gain [0 0 0] [
            xrand(0.01, 0.2) xrand(0.0125, 0.025) * 0.25 0.25
        ] [1 0 -0.25] 
        @pan xrand() 
    ) 
);
render(@play 1 @fade 0)