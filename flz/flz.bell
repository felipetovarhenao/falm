$chords = (
    [1 5/4 7/5 11/7] [1 7/6 3/2 7/4] [1 5/4 3/2 11/6] [1 6/5 8/5 7/4] [1 5/4 3/2 15/8] 
).r2mc();
$t = 0;
for $chord in $chords :* 4 with @unwrap 1 do (
    $chord = $chord.sort();
    $maxdur = 0;
    $dur = choose(1 3/2 2) * 2050;
    $slope = rand(0.1, 0.5);
    $mingain = rand(0.01, 0.25);
    for $mc $mci in $chord do (
        $pan = scale($mci, 1, length($chord), 0, 1);
        $b = flute(
            @pitch $mc
            @type choose(
                'flz' 'ord' 'air' 
            ) 
            @duration $dur
            @velocity choose(0, 64) 
        );
        $b.transcribe(
            @onset $t
            @pan $pan (1 - $pan) 
            @gain choose(
                ## 
                [[0 $mingain 0] [1 1 $slope]] 
                ## 
                [[0 1 0] [1 $mingain -$slope]] 
                ## 
                [] 
                ## 
                [
                    [0 1 0] [1 $mingain -$slope] [2 1 $slope] 
                ] 
                ## 
                [
                    [0 $mingain 0] [1 1 -$slope] [2 $mingain $slope] 
                ] 
            )::1
        );
        $maxdur = max($maxdur, $b.getkey('duration')) 
    );
    $t += $maxdur
);
render(
    @play 1 @process freeverb(
        @roomsize 0.9
        @wet 0.025
        @damp 1
        @width 1
    ) 
)