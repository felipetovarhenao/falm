$seeds = 1...6;
$numfiles = length($seeds);
$chord = pcquant(
    r2mc((4...16), c0), r2pc(1 5/4 9/8 15/8 3/2 5/3 7/5) 
);
$bardur = 2150.;
$units = sort(3/16 1/8 1/16 5/16);
$loopsizebpf = [0 4 0] [1 1 -0.25];
$seqsizebpf = [0 6 0] [1 2 -0.25];
$legatobpf = [0 0.5 0] [1 2 0.25];
$velbpf = [0 0 0] [1 127 0.25];
for $seed $id in $seeds do (
    $fileprog = scale($id, 1, $numfiles, 0, 1);
    $loopsize = int(
        round(samplebpf($loopsizebpf, $fileprog)) 
    );
    $loopsize = 1;
    $seqsize = int(
        round(samplebpf($seqsizebpf, $fileprog)) 
    );
    $vel = samplebpf($velbpf, $fileprog);
    $legato = samplebpf($legatobpf, $fileprog);
    setseed($seed);
    $seq = randomseq(
        @llll $chord
        @length $seqsize
        @steps 2 -1
        @useseed 1
    );
    $t = 0;
    for $mc in $seq :* $loopsize do (
        $shift = 0;
        $del = xrandom(1, 3) / 16;
        for $oct in 0 rev(1...5) * 1200 do (
            ezsol(
                @names 'bass' 'cello' 'violin' 'viola' 
                @types 'pizz' 'pizz-secco' 
                @pitch $mc + $oct
                @velocity $vel
                @duration $del * $legato * $bardur
                @useseed 1
            ).transcribe(
                @onset $t + $shift @pan mc2pan($mc, 0.2) 
            );
            $shift += $del * $bardur
        );
        $t += xchoose($units) * $bardur
    );
    render(
        @reset 1 @process dynamics(
            @knee 0.05
            @ratio 12
            @thresh -40
            @release 200
        ) 
    );
    ezexport($t @id $id) 
)