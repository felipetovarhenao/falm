$names = (
    'glitch' 'polyrhythm' 
);
$files = for $n in $names collect [
    rev(
        $folder = './' + $n;
        $files = sort(readfolder($folder));
        $files = for $file in $files collect (
            $parsed = parsepath($file);
            $basename = $parsed.getkey('parent') + $parsed.getkey('name');
            $parsed.getkey('name');
            $basename
        );
        $files
    ) 
];
$files = $files.sort(
    ($a, $b -> length($a::1) < length($b::1)) 
);
$files = $files.trans(@iterationmode 1).rev().flat();
$t = 0;
for $file $fileid in $files do (
    $b = importaudio($file + '.wav');
    $b.transcribe($t);
    $timestep = read($file + '.txt');
    $t += $timestep
);
importaudio('./loops/loops.wav').transcribe($t);
$timestep = read('./loops/loops.txt');
$t += $timestep;
$bassdur = min(2500, $timestep);
$basspeak = 0.95;
cycle(
    @frequency mc2f(c2) 
    @duration $bassdur
    @phase 0.012
).process(fade(5, 5)).transcribe(
    @onset $t - $bassdur * $basspeak
    @pan mc2pan(c3) 
    @gain [0 0 0] [$basspeak 0.5 0.75] [1 0 -0.2] 
);
render(
    @play 1
    @fade 0
    @process (
        ## dynamics(
        ##     @knee 0.05
        ##     @ratio 5
        ##     @thresh -40
        ##     @release 10
        ##     @attack 10
        ## ) 
        ## ----
        normalize(-3) 
    ) 
);
ezexport()