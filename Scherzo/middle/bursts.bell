setseed(249);
$t = 0;
$bardur = 2150.;
$waves = sinewave triwave;
for $i in 0...20 do (
    $pc = xchoose(
        r2pc((1 4/3 3/2) * (3/2)) @weights 9 1 1
    );
    $units = sort(1/4 3/16 5/16 5/8 3/8 7/16 7/8 3/4 1/8).left($i + 5);
    $chord = pcquant(r2mc(2...32, c2), r2pc(1 5/4 3/2 9/8 , $pc));
    $incr = xchoose($units) * $bardur;
    $segorder = xscramble(1...100);
    for $mc in $chord.xscramble().left(6) do (
        $split = $incr / xrandom(2, 12);
        $fn = xchoose(
            ezsol xchoose($waves) @weights 3 1
        );
        $iswave = intersection($waves, $fn) != null;
        $b = $fn(
            @names family('strings') 
            @types 'stacc' 
            @pitch $mc + (if $iswave == 1 then xrandom(-1, 3) * 1200 else 0) 
            @velocity 127
            @useseed 1
            @envelope [0 0.1 0] [1 0 -xrand(2/3, 5/6)] 
            @duration max(10, $incr) 
        );
        if $iswave == 0 then (
            $b = $b.process(normalize(-8)) 
        );
        $segs = $b.splitbuf(@split $split);
        $shift = 0;
        $pan = mc2pan($mc, 0.2);
        for $seg in $segs:[$segorder] do (
            $env = [0 1 0] [1 0 xrand(1/3, 3/4)];
            $segdur = $seg.getkey('duration');
            if $segdur > 10 then $seg.transcribe(
                @onset $t + $shift
                @pan $pan
                @gain $env
            );
            $shift += $segdur
        ) 
    );
    $t += $incr
);
render(
    @play 1 @process (
        ## 
        ## dynamics(
        ##     @knee 0.1
        ##     @ratio 4
        ##     @thresh -20
        ##     @release 10
        ##     @attack 200
        ## ) 
        ## 
        freeverb(
            @roomsize 0.4
            @wet 0.0125
            @damp 1
            @width 1
        ) normalize(-3) 
    ) 
);
ezexport($t)