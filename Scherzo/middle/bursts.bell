$t = 0;
for $i in 0...20 do (
    $pc = xchoose(r2pc(1 4/3 3/2));
    $chord = pcquant(r2mc(2...32, c2), r2pc(1 5/4 3/2 9/8, $pc));
    $incr = choose(1/4 3/16 5/16 5/8 3/8 7/16 7/8 3/4 1/8) * 2000;
    $segorder = scramble(1...100);
    for $mc in $chord.scramble().left(6) do (
        $split = $incr / random(2, 9);
        $b = choose(ezsol sinewave @weights 3 1)(
            @names family('strings') 
            @types 'stacc' 
            @pitch $mc
            @velocity 127
            @envelope [0 0.01 0] [1 0 -0.8] 
            @duration $incr
        );
        $b = $b.process(normalize(-8));
        $segs = $b.splitbuf(@split $split);
        $shift = 0;
        $pan = mc2pan($mc);
        for $seg in $segs:[$segorder] do (
            $seg.transcribe(
                @onset $t + $shift
                @pan $pan
                @gain [0 1 0] [1 0 rand(1/3, 3/4)] 
            );
            $shift += $seg.getkey('duration') 
        ) 
    );
    $t += $incr
);
render(
    @play 1 @process freeverb(
        @roomsize 0.8
        @wet 0.0125
        @damp 1
        @width 1
    ) normalize(-3) 
)