setseed(100 + 1234);
$t = 0;
$bassdur = 2150.;
$basspeak = 0.7;
for $i in 0...1 do (CrushedCresc($t, $bassdur * $basspeak) );
sinewave(
    @pitch c2 
    @duration $bassdur
    @envelope [0 0 0] [$basspeak 0.5 0.125] [1 0 -0.125] 
).process(fade()).transcribe($t @pan 0.8 0);
$t += $bassdur * $basspeak;
ezsol(
    @pitch c2 
    @types 'pizz' 
    @names 'bass' 
    @duration null
    @velocity 127
    @useseed 1
).transcribe($t @pan 0.5);
render(
    @play 1 @process normalize(-3)
);
ezexport($t)