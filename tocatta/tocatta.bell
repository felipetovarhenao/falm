$nums = (3...16).scramble();
for $shift in 0...2 do (
    $chord = r2mc(
        $nums + $shift, d2 + r2c(6/5) 
    );
    $pcs = r2pc(
        [1 5/4 3/2] [9/8 4/3 3/2 15/8] [1 4/3 5/3] 
    );
    $t = 0;
    for $pc in $pcs :* 4 with @unwrap 1 do (
        $mcs = $chord.pcquant($pc);
        for $mc in $mcs do (
            maracas(@velocity rand(127)).transcribe($t);
            acc(
                @pitch $mc
                @type choose('stacc' 'reg') 
                @duration 200
                @velocity 127
            ).transcribe(
                @onset $t
                @pan rand() 
                @gain [0 1 0] [1 0 0.5] 
            );
            $t += 90
        ) 
    ) 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.8
        @wet 0.0125
        @damp 1
        @width 1
    ) normalize(-4) 
)