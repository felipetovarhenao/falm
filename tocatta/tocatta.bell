$nums = (3...16).xscramble();
$dynpat = round((1 0.5 0.25 0.75 0.3 0.1) * 127);
$count = 0;
$root = d2 + r2c(7/5);
$rootpc = $root.mc2pc();
for $shift $si in 0...2 do (
    $chord = r2mc($nums + $shift, $root);
    $pcs = r2pc(
        [1 5/4 3/2] [9/8 4/3 3/2 15/8] [1 4/3 5/3], $rootpc
    );
    $t = 0;
    for $pc in $pcs :* 4 with @unwrap 1 do (
        $mcs = $chord.pcquant($pc);
        for $mc in $mcs do (
            if $si == 1 then (
                maracas(
                    @velocity $dynpat:($count % length($dynpat) + 1) + xrand(-1, 1) * 7
                ).transcribe($t @gain 0.123);
                $count += 1
            );
            acc(
                @pitch $mc
                @type xchoose('stacc' 'reg') 
                @duration 200
                @velocity 127
            ).transcribe(
                @onset $t
                @pan xrand() 
                @gain [0 1 0] [1 0 0.5] 
            );
            $t += 90
        ) 
    ) 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.8
        @wet 0.025
        @damp 1
        @width 1
    ) normalize(-4) 
);
ezexport()