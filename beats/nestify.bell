setseed(200);
$period = 4000;
$depth = 6;
GetRoot = (-> e2);
MakeEvent = (
    $pitch = c5, $duration = 1000, $velocity = 65, $names = null, $types = null, $level = 1 -> (
        [
            ['pitch' $pitch] ['duration' $duration] ['velocity' $velocity] ['names' $names] ['types' $types] ['level' $level] 
        ] 
    ) 
);
Nestify = (
    $event -> (
        $duration = getkey($event, 'duration');
        if $duration != null then (
            $maxlength = max(1, round($duration / 90));
            $length = min($maxlength, xrandom(2, 4));
            $slope = xrand(-0.18, 0.18);
            $durations = nest(
                @duration $duration
                @length $length
                @slope $slope
            );
            if length($durations) > 1 then (
                $topvel = getkey($event, 'velocity');
                $level = getkey($event, 'level');
                $root = GetRoot();
                $harmst = min(8, exp2($level));
                $harmend = min(exp2($level + 1), 48);
                $harm = $harmst...$harmend;
                $chord = r2mc($harm, $root);
                $mcs = sort(
                    left(
                        xscramble(
                            pcquant(
                                $chord, r2pc(1 5/4 3/2 5/3, mc2pc($root)) 
                            ) 
                        ), xrandom(2, 6) 
                    ) 
                );
                $vels = arithmser(0, 1, null, $length).scale(0, 1, $topvel * 2/3., $topvel, 0.25);
                if $slope >= 0 then ($vels = rev($vels));
                $groups = (
                    ## [
                    ##     ['names' 'guitar'] [
                    ##         'types' 'ord' 
                    ##     ] 
                    ## ] [
                    ##     ['names' 'harp'] [
                    ##         'types' 'ord' 
                    ##     ] 
                    ## ] 
                    ## ----
                    ## [
                    ##     ['names' 'guitar'] [
                    ##         'types' 'harm' 
                    ##     ] 
                    ## ] 
                    ## ## ----
                    ## [
                    ##     ['names' 'harp'] [
                    ##         'types' 'harm' 
                    ##     ] 
                    ## ] 
                    ## ----
                    [
                        ['names' family('strings')] [
                            'types' 'pizz' 
                        ] 
                    ] 
                );
                $group = xchoose($groups);
                $names = $group.getkey('names');
                $types = $group.getkey('types');
                $children = for $d in $durations, $v in $vels collect MakeEvent(
                    @pitch $mcs
                    @duration $d
                    @velocity $v
                    @names $names
                    @types $types
                    @level $level + 1
                );
                $event = $event.setkey('children', $children @mode 1) 
            ) 
        );
        $event
    ) 
);
Consume = (
    $event, $onset = 0, $maxlevel = -1, $maxonset = 0 -> (
        $t = $onset;
        $chordiszebpf = [0 0 0] [1 1 0.25];
        $children = $event.getkey('children');
        $level = $event.getkey('level');
        if $maxlevel == -1 || $level < $maxlevel then (
            for $child in $children do (
                $mcs = $child.getkey('pitch');
                $vel = $child.getkey('velocity');
                $duration = $child.getkey('duration');
                $names = $child.getkey('names');
                $types = $child.getkey('types');
                $gainmul = scale(0, 127, 0.01, 1, 0.125) ** 0.5;
                $nt = $t / $maxonset;
                $chordsize = max(
                    1, ceil(samplebpf($chordiszebpf, $nt) * length($mcs)) 
                );
                for $mc in $mcs.left($chordsize) do (
                    ezsol(
                        @pitch $mc
                        @duration max(200, $duration * 2) 
                        @names $names
                        @types $types
                        @velocity $vel
                        @useseed 1
                    ).process(normalize(-3)).transcribe(
                        @onset $t
                        @pan mc2pan($mc, 0.7) 
                        @gain [0 $gainmul 0] [1 0 -0.25] 
                    ) 
                );
                Consume(
                    @event $child
                    @onset $t
                    @maxlevel $maxlevel
                    @maxonset $maxonset
                );
                $t += $duration
            ) 
        );
        $t - $onset
    ) 
);
$events = [
    [
        'children' MakeEvent(
            @pitch GetRoot() 
            @duration $period
            @velocity 110
            @names 'bass' 
            @types 'pizz' 
        ) 
    ] 
];
for $i in 1...$depth do ($events = $events.map(Nestify @maxdepth -3));
$t = 0;
$reps = 6;
$levels = 1...($depth + 1 + $reps);
$totdur = float($period * length($levels));
for $i in $levels do (
    addmarker($t, $i);
    $t += Consume(
        @event $events
        @onset $t
        @maxlevel $i
        @maxonset $totdur
    ) 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.85
        @wet 0.0125
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport()