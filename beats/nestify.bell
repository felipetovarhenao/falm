setseed(120);
$period = 5000;
$depth = 6;
GetRoot = (-> f2);
MakeEvent = (
    $pitch = c5, $duration = 1000, $velocity = 65 -> (
        [
            ['pitch' $pitch] ['duration' $duration] ['velocity' $velocity] 
        ] 
    ) 
);
$events = [
    ['depth' $depth] ['children' MakeEvent(
        @pitch GetRoot() 
        @duration $period
        @velocity 127
    )] 
];
$nestify = (
    $event, $addr -> (
        $duration = $event.getkey('duration');
        if $duration != null then (
            $depth = int(length($addr) / 2) - 1;
            $root = GetRoot();
            $chord = r2mc(
                ($depth + 1)...min(exp2($depth + 1), 32), $root
            );
            $topvel = getkey($event, 'velocity');
            $mc = xchoose(
                pcquant(
                    $chord, r2pc(1 9/8 8/7 5/4 7/5 3/2 5/3 15/8, mc2pc($root)) 
                ) 
            );
            $maxlength = max(1, round($duration / 110));
            $length = min($maxlength, random(2, 5));
            $slope = xrand(-0.15, 0.15);
            $durations = nest($duration, $length, $slope);
            $vels = arithmser(0, 1, null, $length).scale(0, 1, $topvel * 2/3., $topvel, 0.125);
            if xrand() > 0.5 then ($vels = rev($vels));
            $children = for $d in $durations, $v in $vels collect MakeEvent(
                @pitch $mc
                @duration $d
                @velocity $v
            );
            $event = $event.setkey('children', $children @mode 1) 
        );
        $event
    ) 
);
for $i in 1...$depth do ($events = $events.map($nestify @maxdepth -3));
write($events, './events.txt')