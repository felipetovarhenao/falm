setseed(200);
$period = 4500;
$depth = 7;
GetRoot = (-> e2);
MakeEvent = (
    $pitch = c5, $duration = 1000, $velocity = 65, $names = null, $types = null, $level = 1 -> (
        [
            ['pitch' $pitch] ['duration' $duration] ['velocity' $velocity] ['names' $names] ['types' $types] ['level' $level] 
        ] 
    ) 
);
Nestify = (
    $event -> (
        $duration = getkey($event, 'duration');
        if $duration != null then (
            $maxlength = max(1, round($duration / 90));
            $length = min($maxlength, xrandom(2, 4));
            $slope = xrand(-0.18, 0.18);
            $durations = nest(
                @duration $duration
                @length $length
                @slope $slope
            );
            if length($durations) > 1 then (
                $topvel = getkey($event, 'velocity') ||| 127;
                $level = getkey($event, 'level') ||| 0;
                $root = GetRoot();
                $chord = r2mc(1...60, $root);
                $mcs = sort(
                    left(
                        xscramble(
                            pcquant(
                                $chord, r2pc(1 10/9 5/4 3/2 5/3 15/8, mc2pc($root)) 
                            ) 
                        ), xrandom(3, 7) 
                    ) 
                );
                $vels = arithmser(0, 1, null, $length).scale(0, 1, $topvel * 2/3., $topvel, 0.25);
                if $slope >= 0 then ($vels = rev($vels));
                $strings = for $name in family('strings') collect instrument(
                    @name $name @types 'pizz' 
                );
                $plucked = for $name in family('plucked') collect instrument(
                    @name $name
                    @types 'harm' 'ord' 
                    @join 0
                );
                $names = null;
                $types = null;
                for $mc in $mcs do (
                    $instrument = xchoose(
                        pitchfilter(
                            @instruments $strings (if $mc >= g5 then $plucked) 
                            @pitch $mc
                            @tolerance 1200
                        ) 
                    );
                    $names _= $instrument.getkey('name');
                    $types _= $instrument.getkey('types')
                );
                $children = for $d in $durations, $v in $vels collect MakeEvent(
                    @pitch $mcs
                    @duration $d
                    @velocity $v
                    @names $names
                    @types $types
                    @level $level + 1
                );
                $event = $event.setkey('children', $children @mode 1) 
            ) 
        );
        $event
    ) 
);
Consume = (
    $event, $onset = 0, $maxlevel = -1, $maxonset = 0 -> (
        $t = $onset;
        $chordiszebpf = [0 0 0] [1 1 0.125];
        $children = $event.getkey('children');
        $level = $event.getkey('level') ||| 0;
        if $maxlevel == -1 || $level < $maxlevel then (
            for $child in $children do (
                $mcs = $child.getkey('pitch');
                $vel = $child.getkey('velocity');
                $duration = $child.getkey('duration');
                $names = $child.getkey('names');
                $types = $child.getkey('types');
                $gainmul = sqrt(scale($vel, 0, 127, 0.1, 1) / exp2($level));
                $nt = $t / $maxonset;
                $chordsize = max(
                    1, ceil(samplebpf($chordiszebpf, $nt) * length($mcs)) 
                );
                for $mc $mci in left($mcs, $chordsize) do (
                    ezsol(
                        @pitch $mc
                        @duration max(125, $duration * 2) 
                        @names $names:$mci
                        @types $types:$mci
                        @velocity $vel
                        @useseed 1
                    ).process(normalize(-3)).transcribe(
                        @onset $t
                        @pan mc2pan($mc, 0.7) 
                        @gain [0 $gainmul 0] [1 0 -0.25] 
                    ) 
                );
                Consume(
                    @event $child
                    @onset $t
                    @maxlevel $maxlevel
                    @maxonset $maxonset
                );
                $t += $duration
            ) 
        );
        $t - $onset
    ) 
);
GetMaxLevel = (
    $event -> (
        $children = $event.getkey('children');
        if $children == null then $levels = ($event.getkey('level') ||| 0) else ($levels = for $child in $children collect GetMaxLevel($child));
        maximum($levels) 
    ) 
);
$events = [
    [
        'children' MakeEvent(
            @pitch GetRoot() 
            @duration $period
            @velocity 110
            @names 'bass' 
            @types 'pizz' 
        ) 
    ] 
];
for $i in 1...$depth do ($events = $events.map(Nestify @maxdepth -3));
## write($events, './events.txt');
## null
$t = 0;
$reps = 16;
$depth = GetMaxLevel($events);
$levels = 1...($depth + $reps);
$totdur = float($period * length($levels));
for $i in $levels do (
    addmarker($t, $i);
    $t += Consume(
        @event $events
        @onset $t
        @maxlevel $i
        @maxonset $totdur
    ) 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.85
        @wet 0.0125
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport()