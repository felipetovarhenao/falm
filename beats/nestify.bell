setseed(700);
$period = 5500;
$depth = 10;
GetRoot = (-> c2);
MakeEvent = (
    $pitch = c5, $duration = 1000, $velocity = 65, $names = null, $types = null, $level = 1 -> (
        [
            ['pitch' $pitch] ['duration' $duration] ['velocity' $velocity] ['names' $names] ['types' $types] ['level' $level] 
        ] 
    ) 
);
Nestify = (
    $event -> (
        $duration = getkey($event, 'duration');
        if $duration != null then (
            $maxlength = max(1, round($duration / 90));
            $length = min($maxlength, xrandom(2, 4));
            $slope = xrand(-0.18, 0.18);
            $durations = nest(
                @duration $duration
                @length $length
                @slope $slope
            );
            if length($durations) > 1 then (
                $topvel = getkey($event, 'velocity') ||| 127;
                $level = getkey($event, 'level') ||| 0;
                $root = GetRoot();
                $chord = r2mc(max(2, $level)...60, $root);
                $mcs = sort(
                    left(
                        xscramble(
                            pcquant(
                                $chord, r2pc(1 10/9 5/4 3/2 5/3 15/8, mc2pc($root)) 
                            ) 
                        ), xrandom(3, 8) 
                    ) 
                );
                $vels = arithmser(0, 1, null, $length).scale(0, 1, $topvel * 2/3., $topvel, 0.25);
                if $slope >= 0 then ($vels = rev($vels));
                $strings = for $name in family('strings') collect instrument(
                    @name $name @types 'pizz' 
                );
                $plucked = for $name in family('plucked') collect instrument(
                    @name $name
                    @types 'harm' 'ord' 
                    @join 0
                );
                $names = null;
                $types = null;
                for $mc in $mcs do (
                    $instrument = xchoose(
                        pitchfilter(
                            @instruments $strings (if $mc >= g5 then $plucked) 
                            @pitch $mc
                            @tolerance 1200
                        ) 
                    );
                    $names _= $instrument.getkey('name');
                    $types _= $instrument.getkey('types') 
                );
                $children = for $d in $durations, $v in $vels collect MakeEvent(
                    @pitch $mcs
                    @duration $d
                    @velocity $v
                    @names $names
                    @types $types
                    @level $level + 1
                );
                $event = $event.setkey('children', $children @mode 1) 
            ) 
        );
        $event
    ) 
);
ApplyTremolo = (
    $buffer -> (
        $sgn = xchoose(-1 1);
        $fqbpf = for $x in arithmser(0, 1, null, xrandom(2, 4)) collect [
            $x xrand(0.01, 3) * $sgn xrand(0.25, 0.25) 
        ];
        $gain = for $x in arithmser(0, 1, null, xrandom(2, 4)) collect [$x xrand(0.01, 0.5) ** 0.5 xrand(0.125, 0.125)];
        $mod = cycle(
            @frequency $fqbpf
            @duration $buffer.getkey('duration') 
            @phase xrand() 
        );
        $mod = $mod.process(scaling(-1, 1, $gain, 1));
        $buffer.process(multiply($mod)) 
    ) 
);
Consume = (
    $event, $onset = 0, $maxlevel = -1, $maxonset = 0 -> (
        $t = $onset;
        $peak = 0.9;
        $chordiszebpf = [0 0 0] [$peak 1 0.125] [1 1 0];
        $legatobpf = [0 1 0] [$peak 2 0.125] [1 2 0];
        $envslopebpf = [0 0 0] [$peak -0.5 -0.125] [1 -0.5 0];
        $sinegatebpf = [0 0 0] [$peak 0.25 0.125] [1 0.5 0];
        $panspreadbpf = [0 0.05 0] [1 1 1/3.];
        $children = $event.getkey('children');
        $level = $event.getkey('level') ||| 0;
        if $maxlevel == -1 || $level < $maxlevel then (
            for $child in $children do (
                $mcs = $child.getkey('pitch');
                $vel = $child.getkey('velocity');
                $duration = $child.getkey('duration');
                $names = $child.getkey('names');
                $types = $child.getkey('types');
                $gainmul = sqrt(scale($vel, 0, 127, 0.1, 1) / exp2($level));
                $nt = max(0, min(1, $t / $maxonset));
                $chordsize = max(
                    1, ceil(samplebpf($chordiszebpf, $nt) * length($mcs)) 
                );
                $legato = samplebpf($legatobpf, $nt);
                $envslope = samplebpf($envslopebpf, $nt);
                $sinegate = samplebpf($sinegatebpf, $nt);
                $panspread = samplebpf($panspreadbpf, $nt);
                $sinegate = xrand() < samplebpf($sinegatebpf, $nt);
                for $mc $mci in left($mcs, $chordsize) do (
                    $panval = mc2pan($mc, $panspread);
                    if $sinegate == 1 then (
                        $sineoct = xrandom(-2, 2) * 1200;
                        sinewave(
                            @pitch $mc + $sineoct
                            @velocity $vel
                            @duration $duration * $legato
                            @phase xrand() 
                            @envelope [0 $gainmul 0] [1 0 $envslope] 
                        ).ApplyTremolo().transcribe(
                            @onset $t
                            @gain 0.125
                            @pan $panval
                        ) 
                    );
                    ezsol(
                        @pitch $mc
                        @duration max(50, $duration * $legato) 
                        @names $names:$mci
                        @types $types:$mci
                        @velocity $vel
                        @useseed 1
                    ).process(normalize(-3)).transcribe(
                        @onset $t
                        @pan $panval
                        @gain [0 $gainmul 0] [1 0 $envslope] 
                    ) 
                );
                Consume(
                    @event $child
                    @onset $t
                    @maxlevel $maxlevel
                    @maxonset $maxonset
                );
                $t += $duration
            ) 
        );
        $t - $onset
    ) 
);
GetMaxLevel = (
    $event -> (
        $children = $event.getkey('children');
        if $children == null then $levels = ($event.getkey('level') ||| 0) else ($levels = for $child in $children collect GetMaxLevel($child));
        maximum($levels) 
    ) 
);
$events = [
    [
        'children' MakeEvent(
            @pitch GetRoot() 
            @duration $period
            @velocity 110
            @names 'bass' 
            @types 'pizz' 
        ) 
    ] 
];
for $i in 1...$depth do ($events = $events.map(Nestify @maxdepth -3));
## write($events, './events.txt');
## null
$t = 0;
$reps = 16;
$depth = GetMaxLevel($events);
print('Recursion depth:' $depth);
$levels = 1...($depth + $reps);
$totdur = float($period * length($levels));
for $i in $levels do (
    addmarker($t, $i);
    $t += Consume(
        @event $events
        @onset $t
        @maxlevel $i
        @maxonset $totdur
    ) 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.85
        @wet 0.0125
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport()