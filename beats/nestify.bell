setseed(200);
$period = 4000;
$depth = 7;
GetRoot = (-> e2);
MakeEvent = (
    $pitch = c5, $duration = 1000, $velocity = 65, $names = null, $types = null -> (
        [
            ['pitch' $pitch] ['duration' $duration] ['velocity' $velocity] ['names' $names] ['types' $types] 
        ] 
    ) 
);
Nestify = (
    $event, $addr -> (
        $duration = getkey($event, 'duration');
        if $duration != null then (
            $maxlength = max(1, round($duration / 125));
            $length = min($maxlength, xrandom(2, 4));
            $slope = xrand(-0.175, 0.175);
            $durations = nest(
                @duration $duration
                @length $length
                @slope $slope
            );
            if length($durations) > 1 then (
                $topvel = getkey($event, 'velocity');
                $depth = int(length($addr) / 2) - 1;
                $root = GetRoot();
                $chord = r2mc(
                    max(
                        $depth + 1, int(exp2($depth / 1.25))
                    )...min(exp2($depth + 1), 54), $root
                );
                $mcs = sort(
                    left(
                        xscramble(
                            pcquant(
                                $chord, r2pc(1 5/4 3/2 5/3, mc2pc($root)) 
                            ) 
                        ), xrandom(1, 4) 
                    ) 
                );
                $vels = arithmser(0, 1, null, $length).scale(0, 1, $topvel * 2/3., $topvel, 0.25);
                if $slope >= 0 then ($vels = rev($vels));
                $groups = (
                    ## [
                    ##     ['names' 'guitar'] [
                    ##         'types' 'ord' 
                    ##     ] 
                    ## ] [
                    ##     ['names' 'harp'] [
                    ##         'types' 'ord' 
                    ##     ] 
                    ## ] 
                    ## ----
                    ## [
                    ##     ['names' 'guitar'] [
                    ##         'types' 'harm' 
                    ##     ] 
                    ## ] 
                    ## ## ----
                    ## [
                    ##     ['names' 'harp'] [
                    ##         'types' 'harm' 
                    ##     ] 
                    ## ] 
                    ## ----
                    [
                        ['names' family('strings')] [
                            'types' 'pizz' 
                        ] 
                    ] 
                );
                $group = xchoose($groups);
                $names = $group.getkey('names');
                $types = $group.getkey('types');
                $children = for $d in $durations, $v in $vels collect MakeEvent(
                    @pitch $mcs
                    @duration $d
                    @velocity $v
                    @names $names
                    @types $types
                );
                $event = $event.setkey('children', $children @mode 1) 
            ) 
        );
        $event
    ) 
);
Consume = (
    $event, $onset = 0, $level = 0, $maxlevel = -1 -> (
        $t = $onset;
        $children = $event.getkey('children');
        if $maxlevel == -1 || $level < $maxlevel then (
            for $child in $children do (
                $mcs = $child.getkey('pitch');
                $vel = $child.getkey('velocity');
                $duration = $child.getkey('duration');
                $names = $child.getkey('names');
                $types = $child.getkey('types');
                $gainmul = scale(0, 127, 0.01, 1, 0.125) ** 0.5;
                for $mc in $mcs do (
                    ezsol(
                        @pitch $mc
                        @duration max(200, $duration * 2) 
                        @names $names
                        @types $types
                        @velocity $vel
                        @useseed 1
                    ).process(normalize(-3)).transcribe(
                        @onset $t
                        @pan mc2pan($mc, 0.7) 
                        @gain [0 $gainmul 0] [1 0 -0.25] 
                    ) 
                );
                Consume($child, $t, $level + 1, $maxlevel);
                $t += $duration
            ) 
        );
        $t - $onset
    ) 
);
$events = [
    [
        'children' MakeEvent(
            @pitch GetRoot() 
            @duration $period
            @velocity 100
            @names 'bass' 
            @types 'pizz' 
        ) 
    ] 
];
for $i in 1...$depth do ($events = $events.map(Nestify @maxdepth -3));
$t = 0;
$reps = 5;
for $i in 1...($depth + 1 + $reps) do (
    addmarker($t, $i);
    $t += Consume($events, $t, @maxlevel $i) 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.95
        @wet 0.0125
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport()