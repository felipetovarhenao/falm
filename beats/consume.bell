$events = [read('./events.txt')];
Consume = (
    $event, $onset = 0, $level = 1, $maxlevel = -1 -> (
        $t = $onset;
        $children = $event.getkey('children');
        if $maxlevel == -1 || $level <= $maxlevel then (
            for $child in $children do (
                $mc = $child.getkey('pitch');
                $vel = $child.getkey('velocity');
                $duration = $child.getkey('duration');
                ezsol(
                    @pitch $mc
                    @duration max(200, $duration + 100) 
                    @names family('strings') family('plucked') 
                    @types 'pizz' 
                    @velocity $vel
                ).transcribe(
                    @onset $t
                    @pan mc2pan($mc, 0.35) 
                    @gain [0 1 0] [1 0 0.25] 
                );
                Consume($child, $t, $level + 1, $maxlevel);
                $t += $duration
            ) 
        );
        $t - $onset
    ) 
);
$t = 0;
for $i in 1...12 do ($t += Consume($events, $t, 1, $i));
render(
    @play 1 @process freeverb(
        @roomsize 0.9
        @wet 0.0025
        @damp 1
        @width 1
    ) normalize(-3) 
)