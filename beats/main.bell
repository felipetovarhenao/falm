$t = 0 ;
importaudio('./intro/intro.wav').transcribe($t);
$t += read('./intro/intro.txt').maximum();
importaudio('./arpeggi/arpeggi.wav').transcribe($t);
$t += read('./arpeggi/arpeggi.txt');
importaudio('./swell/swell.wav').transcribe(
    @onset $t - read('./swell/swell.txt') + 500 @gain 0.707
);
importaudio('./nesting/nesting.wav').transcribe($t);
$meta = read('./nesting/nesting.txt');
$peak = $meta.'peak';
$t += $peak;
$b = importaudio('./cresc/cresc.wav');
$b.transcribe($t - read('./cresc/cresc.txt'));
$b.process(
    reverse() freeverb(
        @roomsize 0.9
        @wet 0.1
        @dry 1
        @damp 1
        @width 1
    ) 
).transcribe(
    $t + 300 @gain [0 1 0] [0.05 0.5 -0.5] [1 0 -0.125] 
);
harp(
    @pitch c6 
    @type 'bisb' 
    @duration null
).transcribe(
    @onset $t + maximum($meta.'markers') - $peak
    @pan xrand() 
    @gain [0 1 0] [1 0 -0.5] 
);
render(
    @play 1 @process (
        normalize(0) multiply(1.3) arctan() normalize(-3) 
    ) 
);
ezexport()