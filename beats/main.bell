$t = 0 ;
importaudio('./intro/intro.wav').transcribe($t);
$t += read('./intro/intro.txt').maximum();
importaudio('./bridge/bridge.wav').transcribe($t);
$t += read('./bridge/bridge.txt').maximum();
importaudio('./nesting/nesting.wav').transcribe($t);
$t += read('./nesting/nesting.txt');
$b = importaudio('./cresc/cresc.wav');
$b.transcribe($t - read('./cresc/cresc.txt'));
$b.process(reverse()).transcribe(
    $t + 300 @gain [0 1 0] [0.05 0.5 -0.5] [1 0 -0.125] 
);
render(
    @play 1 @process normalize(-3) 
);
ezexport()