$folders = 'introduction' 'folia' 'scherzo' 'vespertino' ['andante' 'post'] 'passacaglia';
$t = 0;
for $folder $id in $folders with @unwrap 1 do (
    $file = $folder:2 ||| 'main';
    $folder = $folder:1;
    $path = './0' + tosymbol($id) + '_' + $folder + '/' + $file + '.wav';
    $b = importaudio($path);
    $bdur = $b.getkey('duration');
    $tail = $b.setkey('offset', $bdur - 20000).process(reverse() trim(@threshold 0.0001 @end 0));
    $b.setkey('duration', $bdur - $tail.getkey('duration')).transcribe($t);
    $t += $b.getkey('duration') + 1000
);
render(
    @play 1 @process normalize(-3) 
);
ezexport()