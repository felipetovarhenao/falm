$folders = (
    '01_preludio' 
    ## ---
    '02_serenata' 
    ## ---
    '03_scherzo' 
    ## ---
    ['04_andante' 'post'] 
    ## ---
    '05_nocturno' 
    ## ---
    '06_fantasia' 
    ## ---
    '07_passacaglia' 
    ## ---
    '08_epilogo' 
);
$t = 0;
for $folder $id in $folders with @unwrap 1 do (
    $file = $folder:2 ||| 'main';
    $folder = $folder:1;
    $path = './' + $folder + '/' + $file + '.wav';
    $b = importaudio($path);
    $bdur = $b.getkey('duration');
    addmarker($t @names $folder);
    $b.transcribe($t);
    $t += $bdur
);
render(
    @play 1 @process normalize(-3) 
);
ezexport()