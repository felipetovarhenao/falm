$folders = '01_introduction' '04_vespertino' '03_scherzo' ['05_andante' 'post'] '02_folia' '06_passacaglia' '08_coda';
$t = 0;
for $folder $id in $folders with @unwrap 1 do (
    $file = $folder:2 ||| 'main';
    $folder = $folder:1;
    $path = './' + $folder + '/' + $file + '.wav';
    $b = importaudio($path);
    $bdur = $b.getkey('duration');
    $tailsize = 20000;
    $tail = $b.setkey('offset', $bdur - 15000).setkey('duration', $tailsize).process(
        reverse() normalize(-3) trim(@threshold 0.001 @end 0) 
    );
    $taildur = $tail.getkey('duration');
    $b = $b.setkey(
        'duration', min($bdur,  ($bdur - $taildur) + 1000) 
    );
    $b.transcribe($t);
    $t += $b.getkey('duration') 
);
render(
    @play 1 @process normalize(-3) 
);
ezexport()