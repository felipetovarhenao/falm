TimeCode = (
    $ms -> (
        $s = $ms / 1000;
        $m = int(floor($s / 60));
        $s = int(round($s % 60));
        $m = tosymbol($m);
        if symlen($m) == 1 then ($m = '0' + $m);
        $s = tosymbol($s);
        if symlen($s) == 1 then ($s = '0' + $s);
        $m + ':' + $s
    ) 
);
$folders = (
    '01_preludio' 
    ## ---
    '02_serenata' 
    ## ---
    '03_scherzo' 
    ## ---
    '04_andante' 
    ## ---
    '05_nocturno' 
    ## ---
    '06_fantasia' 
    ## ---
    '07_chorale' 
    ## ---
    '07_passacaglia' 
    ## ---
    '08_epilogo' 
);
$t = 0;
$stats = null;
for $folder $id in $folders do (
    $path = './' + $folder + '/' + 'main' + '.wav';
    $b = importaudio($path);
    $bdur = $b.getkey('duration');
    $stats _= [
        ['name' $folder] ['marker' TimeCode($t)] ['duration' TimeCode($bdur)] 
    ];
    addmarker($t @names $folder);
    $b.transcribe($t);
    $t += $bdur
);
render(
    @play 1 @process normalize(-3) 
);
ezexport(
    ['total_length' TimeCode($t)] ['tracks' $stats]
)