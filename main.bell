$folders = '01_introduction' '04_vespertino' '03_scherzo' ['05_andante' 'post'] '07_test' '02_folia' '06_passacaglia' '08_coda';
$t = 0;
for $folder $id in $folders with @unwrap 1 do (
    $file = $folder:2 ||| 'main';
    $folder = $folder:1;
    $path = './' + $folder + '/' + $file + '.wav';
    $b = importaudio($path);
    $bdur = $b.getkey('duration');
    $b.transcribe($t);
    $t += $bdur
);
render(
    @play 1 @process normalize(-3) 
);
ezexport()