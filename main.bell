$folders = (
    '01_preludio' 
    ## ---
    '02_serenata' 
    ## ---
    '03_scherzo' 
    ## ---
    '04_andante' 
    ## ---
    '05_nocturno' 
    ## ---
    '06_fantasia' 
    ## ---
    '07_chorale' 
    ## ---
    '07_passacaglia' 
    ## ---
    '08_epilogo' 
);
$t = 0;
$stats = null;
for $folder $id in $folders do (
    $path = './' + $folder + '/' + 'main' + '.wav';
    $b = importaudio($path);
    $bdur = $b.getkey('duration');
    $stats _= [
        ['track' $folder] ['marker' $t] ['duration' $bdur]
    ];
    addmarker($t @names $folder);
    $b.transcribe($t);
    $t += $bdur
);
render(
    @play 1 @process normalize(-3) 
);
ezexport($stats)