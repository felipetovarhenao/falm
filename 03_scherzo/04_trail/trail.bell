if FastArpeggio == null then BP_FN_ERROR(@details 'You need you run script containing gesture/object definitions first.');
setseed(1000 + 1234);
$t = 0;
$b = importaudio('../03_loops/loops.wav');
$bardur = 2150.;
$dur = 1/8 * $bardur;
$end = read('../03_loops/loops.txt');
$N = 12;
for $i in 1...($N + 1) do (
    $mc = Root + 1200 * 5;
    $dur2 = ($N + 1 - $i) * $dur;
    if $dur2 > 10 then (
        for $v in 1...4 do (
            $resbpf = [0 1 0] [1 1/c2r(-50) xrand(2/3, 7/8)];
            $durfactor = integrate($resbpf):(-1 2);
            ezsol(
                @pitch $mc
                @velocity 127
                @names family('strings') 'acc' 
                @types 'nonvib' 'harm' 'reg' 'ord' 'ord-to-crushed' 
                @duration $dur2 / $durfactor
                @useseed 1
            ).process(resample($resbpf)).transcribe(
                @onset $t
                @pan mc2pan($mc) 
                @gain [0 0 0] [1 1 0.5] 
            ) 
        );
        $t += $dur2
    );
    $subdiv = exp2(
        int(($i - 1) / 2) 
    );
    for $rep in 1...$i do (
        $incr = $dur / $subdiv;
        $b.setkey('offset', $end - $dur).setkey('duration', if $rep == $i then 4000 else max(45, $incr * 2)).transcribe(
            @onset $t
            @pan xrand() 
            @gain [0 1 0] [1 0 xrand(-1/2, 1/2)] 
        );
        $t += $incr * ($rep < $i) 
    ) 
);
$bassdur = $dur * ($N + 1);
$bass = cycle(
    @frequency mc2f(Root) @duration $bassdur
);
$bass.process(
    gain([0 0 0] [1 0.5 0.5]) panning(
        [0 0 0] [0.7 1 0.25] [1 0.5 -0.125] 
    ) 
).transcribe(@onset $t - $bassdur);
addmarker($t);
render(
    @play 1 @process normalize(@level -18 @rms 1) arctan() normalize(-3) freeverb(
        @roomsize 0.8
        @wet [0 0.005 0] [1 0 -0.125] 
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport($t)