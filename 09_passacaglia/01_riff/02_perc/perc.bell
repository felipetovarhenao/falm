setseed(1);
$data = read('../../00_sequence/sequence.txt');
$sections = $data.'sections';
$unit = $data.'unit';
$mix = 0;
$dummy = envelope(0);
$sectionids = 2...length($sections);
$sectionids = 2;
for $id in $sectionids do (
    $chords = ($sections:$id).getkey('chords');
    $base = importaudio(
        '../01_strings/strings_' + tosymbol($id) + '.wav' 
    );
    $dummy.transcribe();
    $t = 0;
    $empty = 1;
    $maxdivs = max(
        1, min(4, ceil($id / 2)) 
    );
    for $chord in $chords :* 4 do (
        $timestep = $chord.getkey('timestep');
        $numunits = int(round($timestep / $unit));
        $notes = $chord.getkey('notes');
        $vel = ($notes:-1).getkey('velocity');
        $pitch = ($notes:-1).getkey('pitch');
        for $i in 1...($numunits - 1) do (
            $empty = 0;
            $onset = $t;
            $numdivs = xchoose(1...$maxdivs, @weights rev(1...$maxdivs));
            $step = $i * $unit;
            $b = ezsol(
                @pitch $pitch
                @names family('strings') family('plucked') 
                @types 'hit-on-body' 'perc' 'behind-frog' 
                @velocity $vel
                @duration $timestep
                @resample 1
                @useseed 1
            ).clipnorm(
                @minlevel -18
                @maxlevel -12
                @rms 1
            );
            $onset = $t + $step;
            $substep = $unit / $numdivs;
            for $div in 0...($numdivs - 1) do (
                $det = if $div > 0 then xrand(-200, 200);
                $b.setkey('duration', $substep).transcribe(
                    @onset $onset + $substep * $div
                    @gain [0 1 0] [1 0 -xrand(1/4, 1/2)] 
                    @pan mc2pan($pitch, 0.2) 
                    @detune $det
                ) 
            ) 
        );
        $t += $timestep
    );
    if $empty == 0 then (
        render(
            @play 1
            @reset 1
            @process (
                ## ---
                freeverb(
                    @roomsize 0.75
                    @wet 0.0122
                    @damp 1
                    @width 1
                ) 
                ## ---
                normalize(-8) 
                ## ---
                (
                    if $mix == 1 then mix($base) normalize(-3) 
                ) 
            ) 
        );
        ezexport(@id $id) 
    ) 
)