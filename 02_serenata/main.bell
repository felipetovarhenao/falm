$t = 0 ;
importaudio('./01_intro/intro.wav').transcribe($t);
$t += read('./01_intro/intro.txt').maximum();
importaudio('./02_transient/transient.wav').transcribe(
    $t - read('./02_transient/transient.txt') @gain 0.707
);
importaudio('./03_arpeggi/arpeggi.wav').transcribe($t);
$t += read('./03_arpeggi/arpeggi.txt');
importaudio('./04_swell/swell.wav').transcribe(
    @onset $t - read('./04_swell/swell.txt') + 500 @gain 0.5
);
importaudio('./05_nesting/nesting.wav').transcribe($t);
$meta = read('./05_nesting/nesting.txt');
$peak = $meta.'peak';
$t += $peak;
$b = importaudio('./06_cresc/cresc.wav');
$b.transcribe($t - read('./06_cresc/cresc.txt'));
$tail = 2000;
$b.process(
    reverse() freeverb(
        @roomsize 0.9
        @wet 0.1
        @dry 1
        @damp 1
        @width 1
        @tail $tail
    ) fade(
        @fadein 0
        @fadeout $tail
        @fadeouttype 2
    ) 
).transcribe(
    $t + 300 @gain [0 1 0] [0.05 0.707 -0.35] [1 0 -0.125] 
);
harp(
    @pitch r2mc(7/8, d6) 
    @type 'bisb' 
    @duration null
    @useseed 1
).transcribe(
    @onset $t + maximum($meta.'markers') - $peak
    @pan xrand() 
    @gain [0 1 0] [1 0 -0.5] 
);
render(
    @play 1 @process (
        normalize(0) arctan() normalize(-3) 
    ) 
);
ezexport()