setseed(100);
$root = r2mc(7/8, d2);
$mcs = r2mc(1...80, $root).pcquant(
    r2pc(1 10/9 5/4 7/5 3/2 5/3 15/8, mc2pc($root)) 
);
$maxdur= 0;
for $mc in $mcs do (
    $stretch = exp2(xrand(0, 2));
    $b = ezsol(
        @pitch $mc + r2c($stretch) 
        @duration null
        @velocity 127
        @names family('strings') family('winds') 'acc' 
        @types 'harm' 'crushed-to-ord' 'ord' 'sfz' 'dim' 'trem' 'flz' 
        @useseed 1
    ).process(trim(
        @start 0
        @end 1
        @threshold 0.005
    ) resample($stretch));
    $maxdur = max($maxdur, $b.getkey('duration'));
    $b.transcribe(
        @onset 0
        @pan mc2pan($mc) 
        @gain [0 1 0] [1 0 -1/3] 
    ) 
);
sawwave(@pitch $root @duration $maxdur).transcribe(
    @onset 0
    @pan 0.5
    @gain [0 0.125 0] [1 0 -0.5] 
);
$b = render(
    @play 1 @process (
        normalize(-3) 
        ## ---
        trim(@threshold 0.00125 @start 0) 
        ##  ---
        fade(
            @fadein 0
            @fadeout 2000
            @fadeouttype 2
        ) 
        ## ---
        reverse() 
    ) 
);
ezexport($b.getkey('duration'))