setseed(797);
$chord = r2mc(1...24, c2).rev().pcquant(r2pc(1 5/4 21/16 3/2 5/3));
$totdur = 35000;
$incrbpf = [0 150 0] [0.9 40 0.25] [1 350 0.125];
$incrjitbpf = [0 1 0] [1 0 -0.125];
$jitterbpf = [0 3 0] [1 0 0.125];
$octvarbpf = [0 3 0] [1 0 -0.5];
$t = 0;
$i = 0;
RandomOctave = (
    $mc, $min = 3600, $max = 13000, $maxdev = 2 -> (
        $down = floor(($mc - $min) / 1200);
        $up = floor(($max - $mc) / 1200);
        $down = minimum(abs($maxdev $down)) * sgn($down);
        $up = minimum(abs($maxdev $up)) * sgn($up);
        $mc + xrandom(-$down, $up) * 1200
    ) 
);
while ($t < $totdur) || (
    $t >= $totdur && ($i + 1) != (length($chord) - 2) 
) do (
    $nt = max(0, min(1, $t / $totdur));
    $incr = samplebpf($incrbpf, $nt);
    $jitter = samplebpf($jitterbpf, $nt) / 2;
    $octvar = round(samplebpf($octvarbpf, $nt));
    $incrjit = exp2(-samplebpf($incrjitbpf, $nt));
    $jitter = xrand(-$jitter, $jitter) * $incr;
    $mc = RandomOctave(
        $chord:($i + 1) @maxdev $octvar
    );
    $vel = xrandom(0., 127);
    $b = ezsol(
        @pitch $mc
        @names family('strings') family('plucked') 
        @types 'pizz' 'pizz-secco' (
            if xrand() > 0.95 then 'bartok' 'legno-bat' 
        ) 
        @duration null
        @velocity $vel
        @useseed 1
    );
    $start = $t + $jitter;
    $env = [0 1 0] [1 0 -xrand(-0.5)];
    if xrand() > 0.9 && $start > 0 then (
        $sinedur = $b.analyze(effectiveduration(@thresholdratio 0.001)).getkey('effectiveduration') * exp2(xrand());
        $sine = sinewave(
            @pitch $mc + xrandom(0, 4) * 1200
            @velocity $vel
            @duration $sinedur
            @envelope [0 0.5 0] [1 0 -xrand(1/3, 6/7)] 
        ).process(
            gain($b.getkey('rms') ** 0.5) 
        );
        $b = $b.process(mix($sine)) 
    );
    if xrand() > 0.9 then (
        $b = $b.process(reverse());
        $env = revbpf($env);
        $start -= $b.getkey('duration') 
    );
    $b.clipnorm(@minlevel -18).transcribe(
        @onset max(0, $start) 
        @pan mc2pan($mc, 0.5) 
        @gain $env
    );
    $i = ($i + 1) % length($chord);
    $t += $incr * $incrjit
);
render(
    @play 1 @process freeverb(
        @roomsize 0.9
        @wet 0.0125
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport($t + 150)