$chord = r2mc(1/2 1 5/2 9/4 3/2 5 15/4, 4800);
$t = 0;
$totdur = 25000;
$markers = null;
while $t < $totdur do (
    $sampler = choose(violin viola cello bass);
    $off = 0;
    $b = $sampler(
        @pitch choose($chord) + xchoose(-1 0 1 2 @weights 2 4 2 1) * 1200
        @type choose('pizz' 'pizz-secco' ) 
        @duration null
        @velocity xrandom(0, 127) 
    );
    if rand() > 0.95 then (
        $maxdur = max(
            50, min($b.getkey('duration'), $t) 
        );
        $b = $b.setkey('duration', $maxdur).process(reverse());
        $off -= $b.getkey('duration') 
    );
    $b.transcribe(
        @onset $t + $off @pan rand() 
    );
    $markers _= $t;
    $t += rand(150) 
);
render(
    @play 1 @process normalize(-3) freeverb(
        @roomsize 0.9
        @wet 0.0125
        @damp 1
        @width 1
    ) 
);
ezexport($markers)