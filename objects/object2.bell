$tuning = 1 5/4 3/2 7/5 11/10 12/7 9/8 5/3;
$t = 0;
$order = scramble(1...16);
for $pc in 0...12 do (
    $chord = r2mc(1...32, 3600):[$order].pcquant(
        r2pc(
            $tuning, octreduce((3/2.) ** $pc).r2pc() 
        ) 
    );
    for $mc in $chord do (
        pno(
            $mc @velocity rand(0, 127) @duration 2000
        ).transcribe(
            @onset $t
            @pan $mc.mc2pan() 
            @gain [0 1 0] [1 0 0.125] 
        );
        $t += 30
    );
    $t += 2000
);
render(@play 1) 
