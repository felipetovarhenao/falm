$t = 0;
$chord = r2mc(1...16, 4500).pcquant(r2pc(1 5/4 3/2, 3)).scramble();
for $i in 0...7 do (
    $shift = 0;
    $shiftsize = rand(0, 350) / length($chord);
    for $mc in $chord do (
        $group = (
            [
                [
                    'names' 'flute' 'sax' 'clar' 
                ] ['types' 'keys' ] ['resample' 1] 
            ] [
                [
                    'names' 'guitar' family('strings') 
                ] [
                    'types' 'perc' 'hit-on-body' 
                ] ['resample' 0] 
            ] 
        ).choose();
        ezsol(
            @pitch $mc
            @names $group.getkey('names') 
            @types $group.getkey('types') 
            @duration null
            @resample $group.getkey('resample') 
        ).transcribe(
            @onset $t + $shift @pan mc2pan($mc) 
        );
        $shift += $shiftsize
    );
    $t += 500
);
render(
    @play 1 @process normalize(-3) 
);
ezexport()