setseed(30);
$names = 'flute';
$types = 'whistle' 'whistle-sweep' 'air';
$keymap = for $n in $names collect (
    for $type in intersection(types($n), $types) collect keymap($n, $type) 
);
$t = 0;
$keymap = for $k in $keymap with @unwrap 1 collect (
    $mc = $k:1;
    $files = $k.right(1);
    for $f in $files collect [$mc $f] 
);
$keymap = $keymap.xscramble();
$keymapsize = length($keymap);
$totdur = 60000;
$t = 0;
$onsets = arithmser(0, 1, null, $keymapsize);
$onsets = for $x in $onsets collect samplebpf(
    [0 0 0] [0.5 0.5 -0.125] [1 1 0.125], $x
) * $totdur;
$pcbpf = [0 2 0] [1 0 -0.5];
for $key in $keymap, $onset in $onsets with @unwrap 1 do (
    $nt = $onset / $totdur;
    $pc = samplebpf($pcbpf, $nt);
    $mc = $key:1;
    $f = $key:2;
    $detune = $mc.pitchdiff($pc);
    $r = 1/c2r($detune);
    $b = importaudio($f).process(resample($r) window());
    $b.transcribe(
        @onset $onset @pan xrand() 
    ) 
);
render(
    @play 1 @process (
        ## ----
        freeverb(
            @roomsize 0.8
            @wet [0 0.2 0] [1 0 -0.125] 
            @width 1
            @damp 0.8
        ) 
    ) 
);
ezexport($totdur)