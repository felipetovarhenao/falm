$t = 0;
for $mc in r2mc(1/2 3/4 1 9/8 7/5 3 15/8 5/2) do (
    $t = 0;
    $pan = mc2pan($mc, 0.707);
    for $i in 0...9 do (
        $b = ezsol(
            @pitch $mc
            @names 'flute' 'clar'
            @duration null
            @types 'air-and-ord' 'air' 'air-to-ord' 'ord-to-air' 
            @useseed 1
            @velocity 0
        );
        $b = $b.process(
            multiply(
                cycle(
                    for $x in 0...10 collect xrand(13) @duration $b.getkey('duration') 
                ).process(
                    scaling(
                        -1, 1, for $y in 0...xrandom(0, 2) collect xrand(0.01, 0.5), 1
                    ) 
                ) 
            ) 
        );
        $b.transcribe(
            @onset $t
            @pan $pan
            @gain hanning() 
        );
        $t += 3000
    ) 
);
render(
    @play 1 @process ezverb() normalize(-3) 
);
ezexport()