$data = read('../sequence.txt');
$sections = $data.'sections';
$combine = 0;
$t = 0;
$sectionids = 1...length($sections);
for $sectionid in $sectionids do (
    $section = $sections:$sectionid;
    $chords = $section.getkey('chords');
    if $combine == 0 then ($t = 0);
    for $chord in $chords :* 4 do (
        $timestep = $chord.getkey('timestep');
        $notes = $chord.getkey('notes');
        $balance = 1.05 ** (1 - length($notes));
        for $event in $notes do (
            $pitch = $event.getkey('pitch');
            $duration = $event.getkey('duration');
            $velocity = $event.getkey('velocity');
            $name = $event.getkey('name');
            $types = $event.getkey('type');
            $gliss = $event.getkey('gliss');
            $buffer = ezsol(
                @pitch $pitch
                @duration $duration + 300
                @velocity $velocity
                @names $name
                @types $types
            ).process(
                normalize(-14 @rms 1) 
                ## --
                trim(@threshold 0.1 @end 0) 
            );
            $buffer = $buffer.setkey('duration', $duration).process(resample($gliss));
            $buffer.transcribe(
                @onset $t
                @pan mc2pan($pitch, 1/3) 
                @gain [0 $balance 0] [1 0 0.95] 
            ) 
        );
        $t += $timestep
    );
    if $combine == 0 then (
        render(
            @reset 1 @process normalize(-3) 
        );
        ezexport(@id $sectionid) 
    ) 
);
if $combine == 1 then (
    render(
        @play 1 @process normalize(-3) 
    );
    ezexport() 
)