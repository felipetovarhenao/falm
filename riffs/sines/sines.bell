ApplyTremolo = (
    $buffer -> (
        $sgn = xchoose(-1 1);
        $fqbpf = for $x in arithmser(0, 1, null, xrandom(2, 4)) collect [
            $x xrand(0.01, 3) * $sgn xrand(0.25, 0.25) 
        ];
        $gain = for $x in arithmser(0, 1, null, xrandom(2, 4)) collect [$x xrand(0.01, 0.5) ** 0.5 xrand(0.125, 0.125)];
        $mod = cycle(
            @frequency $fqbpf
            @duration $buffer.getkey('duration') 
            @phase xrand() 
        );
        $mod = $mod.process(scaling(-1, 1, $gain, 1));
        $buffer.process(multiply($mod)) 
    ) 
);
RandomOctave = (
    $mc, $min = 4800, $max = 13000, $maxdev = 2 -> (
        $down = floor(($mc - $min) / 1200);
        $up = floor(($max - $mc) / 1200);
        $down = minimum(abs($maxdev $down)) * sgn($down);
        $up = minimum(abs($maxdev $up)) * sgn($up);
        $mc + xrandom(-$down, $up) * 1200
    ) 
);
setseed(10);
$sequence = read('../sequence.txt');
$sections = $sequence.'sections';
$ids = 3...length($sections);
$firstsection = minimum($ids);
$numsections = maximum($ids);
## $ids = 8;
$combine = 0;
$preview = 0;
$ringbpf = [0 1 0] [1 3 0.125];
$mixbpf = [0 0.5 0] [1 0.9 0.125];
$densitybpf = [0 0.25 0] [1 1 0];
$postfx = (
    ## ----
    freeverb(
        @roomsize 0.8
        @wet 0.015
        @dry 0.5
        @damp 1
        @width 1
    ) 
    ## ----
    normalize(-15) 
);
$t = 0;
for $i in $ids do (
    $gnt = scale($i, $firstsection, $numsections, 0, 1);
    $ring = exp2(samplebpf($ringbpf, $gnt));
    $mix = samplebpf($mixbpf, $gnt);
    $density = samplebpf($densitybpf, $gnt);
    $id = tosymbol($i);
    $section = $sections:$i;
    $chords = getkey($section, 'chords');
    $totdur = getkey($section, 'total_duration');
    if $combine == 0 then ($t = 0);
    for $chord in $chords :* 4 do (
        $timestep = getkey($chord, 'timestep');
        $notes = getkey($chord, 'notes');
        $balance = 1.05 ** (
            -1 * (length($notes) - 1) 
        );
        for $note in $notes do (
            if xrand() <= $density then (
                $pitch = getkey($note, 'pitch');
                $gliss = getkey($note, 'gliss');
                $duration = $timestep;
                $gain = (
                    max(5, getkey($note, 'velocity')) / 127.
                ) ** 1.5;
                $freq = mc2f($pitch) * xrandom(1, 6) * exp2(xrandom(0, 2));
                $buffer = cycle(
                    @frequency $freq
                    @duration $duration * $ring * exp2(xrand(-0.25, 0.25)) 
                    @phase xrand() 
                ).process(resample($gliss));
                ApplyTremolo($buffer).transcribe(
                    @onset $t
                    @pan mc2pan($pitch, 0.5) 
                    @gain [0 $gain * $balance 0] [1 0 -xrand(1/2, 0.9)] 
                ) 
            ) 
        );
        $t += $timestep
    );
    if $combine == 0 then (
        render(
            @reset 1 @process $postfx gain($mix ** 0.5) 
        );
        ezexport(@id $id) 
    ) 
);
if $combine == 1 then (
    render(
        @play 1 @process $postfx (
            if $preview == 1 then (
                ## ---
                mix(importaudio('../riff/riff_' + $id + '.wav')) 
                ## ---
                normalize(-3) 
            ) 
        ) 
    ) 
)