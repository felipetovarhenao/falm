setseed(1);
$data = read('./riffs.txt');
$riffs = $data.('riffs');
$unit = $data.('unit');
$id = 8;
$riff = ($riffs:$id).getkey('riff');
$base = importaudio(
    './riffs_' + tosymbol($id) + '.wav' 
);
$t = 0;
envelope(0).transcribe();
$empty = 1;
$maxdivs = max(
    1, min(4, ceil($id / 2)) 
);
for $event in $riff :* 4 do (
    $timestep = $event.getkey('timestep');
    $numunits = int(round($timestep / $unit));
    $events = $event.getkey('events');
    $vel = ($events:-1).getkey('velocity');
    $pitch = ($events:-1).getkey('pitch');
    for $i in 1...($numunits - 1) do (
        $empty = 0;
        $onset = $t;
        $numdivs = xchoose(1...$maxdivs, @weights rev(1...$maxdivs));
        $step = $i * $unit;
        $b = ezsol(
            @pitch $pitch
            @names family('strings') family('plucked') 
            @types 'hit-on-body' 'perc' 
            @velocity $vel
            @duration $timestep
            @resample 1
            @useseed 1
        );
        $onset = $t + $step;
        $substep = $unit / $numdivs;
        for $div in 0...($numdivs - 1) do (
            $b.setkey('duration', $substep).transcribe(
                @onset $onset + $substep * $div
                @gain [0 1 0] [1 0 -0.5] 
                @pan mc2pan($pitch, 0.125) 
            ) 
        ) 
    );
    $t += $timestep
);
render(
    @play 1 @process (
        if $empty == 0 then (
            ## ---
            freeverb(
                @roomsize 0.9
                @wet 0.0125
                @damp 1
                @width 1
            ) normalize(-3) 
        ) 
    ) mix($base) normalize(-3) 
)