$metadata = read('./pulse/pulse.txt');
$beat = $metadata.'beat';
$peak = $metadata.'sections':2;
$b = importaudio('./main.wav');
$durs = arithmser(0, 1, null, 8).scale(0, 1, $beat * 2, 5, -0.125);
$t = 0;
$b.setkey('duration', $peak).transcribe(@onset $t);
$t = $peak;
for $dur in $durs do (
    $seg = $b.setkey('offset', $peak - $dur).setkey('duration', $dur);
    $seg.transcribe($t);
    $t += $dur
);
$b.setkey('offset', $peak).transcribe($t);
render(
    @play 1
    @fade 1
    @process (
        dynamics(
            @attack 500
            @release 1000
            @knee 4
            @ratio 10
            @thresh -25
        ) 
        ## ----
        ## resample(1/c2r(-60)) 
        
    ) 
);
ezexport()