$t = 0;
$mc = r2mc(64, f#2);
pno(
    @pitch $mc
    @duration null
    @velocity 127
).transcribe(
    @pan mc2pan($mc) 
);
importaudio('./pulse/pulse.wav').transcribe(@onset $t);
importaudio('./gliss/gliss.wav').transcribe(@onset $t);
$markers = read('./pulse/pulse.txt').'sections';
$t += $markers:2;
importaudio('./layers/layers.wav').transcribe(@onset $t);
importaudio('./cresc/cresc.wav').transcribe(@onset $t - read('./cresc/cresc.txt'));
render(
    @play 1 @process resample(1/c2r(-125)) normalize(-3) 
);
ezexport()