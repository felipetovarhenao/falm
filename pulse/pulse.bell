$t = 0;
$mcroot = f#2;
$pcroot = mc2pc($mcroot);
$beat = 133.3;
$minutes = 3;
$totdur = 60 * 1000 * $minutes;
$pcs = r2pc(1 5/4 3/2 10/9 9/8 5/3 7/5 13/7, $pcroot);
$mcs = r2mc(1...64, $mcroot).pcquant($pcs);
$mcsminmax = minmax($mcs);
$minmc = $mcsminmax:1;
$maxmc = $mcsminmax:3;
$velbpf = [0 0 0] [1 127 -0.125];
$rangebpf = [0 3 0] [1 length($mcs) -1/3];
$revgatebpf = [0 1 0] [1 0.75 0.25];
$streamsizebpf = [0 1 0] [1 round(5000 / $beat) 0.125];
$legatobpf = [0 0.125 0] [1 2 -0.25];
$wavegatebpf = [0 0.15 0] [1 0.01 -0.125];
$solgroups = (
    ## -----
    [[
        'names' 'harp' 'guitar' 
    ] [
        'types' 'ord' 'harm' 
    ]] 
    ## -----
    [
        ['names' family('strings')] [
            'types' 'pizz' 
        ] 
    ] 
    ## -----
    [
        ['names' family('strings')] [
            'types' 'stacc' 
        ] 
    ] 
    ## ----- 
    [
        ['names' family('woodwinds')] [
            'types' 'pizz' 'stacc' 'keys' 
        ] 
    ] 
    ## ----- 
    [
        ['names' family('brass')] [
            'types' 'stacc' 
        ] 
    ] 
);
GenSolBuf = (
    $pitch, $velocity, $nt = 0 -^ $solgroups -> (
        $numgroups = length($solgroups);
        $fn = choose(
            ezsol pno @weights ($numgroups 1) / ($numgroups + 1.) 
        );
        if $fn == ezsol then (
            $numgroups = int(
                round(scale($nt ||| 0, 0, 1, 1, $numgroups, 0.125) ) 
            );
            $groups = choose(left($solgroups, $numgroups));
            $names = $groups.getkey('names');
            $types = $groups.getkey('types') 
        );
        $b = $fn(
            @pitch $pitch
            @velocity $velocity
            @gain 0.125
            @duration null
            @useseed 0
            @names $names
            @types $types
            @norm 1
        );
        $b = $b.analyze(effectiveduration(@thresholdratio 0.005));
        $b = $b.setkey('duration', $b.getkey('effectiveduration'));
        $b
    ) 
);
while $t < $totdur do (
    $nt = $t / $totdur;
    $range = int(
        round(samplebpf($rangebpf, $nt)) 
    );
    $streamsize = int(
        round(samplebpf($streamsizebpf, $nt)) 
    );
    $mc = choose(right($mcs, -$range));
    $durmul = exp2(scale($mc, $minmc, $maxmc, 2, 0));
    $vel = samplebpf($velbpf, $nt);
    $wavegate = samplebpf($wavegatebpf, $nt);
    $legato = samplebpf($legatobpf, $nt);
    $revgate = samplebpf($revgatebpf, $nt);
    $iswave = rand() < $wavegate;
    if $iswave == 0 then (
        $b = GenSolBuf(
            @pitch $mc
            @velocity $vel + rand(-1, 1) * 25
            @nt $nt
        ) 
    ) else (
        ## 
        $b = sinewave(
            @pitch $mc
            @velocity $vel * 0.3 + 1
            @duration $streamsize * $beat
            @phase rand() 
        ) 
    );
    $segs = $b.splitbuf(@split $beat @partials 0).left($streamsize);
    $tshift = 0;
    $pan = mc2pan($mc, 0.5);
    for $s in scramble($segs) do (
        $onset = $t + $tshift;
        $env = [0 1 0] [1 0 rand(1/5, 3/4) * choose(-1 1)];
        $segdur = $s.getkey('duration');
        if $segdur > 10 then (
            $process = gain($env);
            $revshift = 0;
            $grain = $s.setkey('duration', $beat * $durmul * $legato);
            if rand() > $revgate then (
                $process _= reverse();
                $grain = $grain.process($process);
                $revshift -= $grain.getkey('duration') 
            );
            $grain.transcribe(
                @onset $onset + $revshift
                @pan $pan
                @detune if $iswave == 1 then xrandom(-1, 3) * 1200
            );
            $tshift += $beat
        ) 
    );
    $t += $beat
);
render(
    @play 1 @process freeverb(
        @roomsize 0.9
        @wet 0.025
        @damp 1
        @width 1
    ) normalize(-3) 
)