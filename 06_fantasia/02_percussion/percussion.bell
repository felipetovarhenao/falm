setseed(4);
$meta = read('../01_foreground/foreground.txt');
$peak = $meta.'peak';
$tempo = $meta.'tempo';
$beatdur = 60000 / $tempo;
$bardur = $beatdur * 4;
$markers = $meta.'markers';
$onsets = null;
$cycleonsets = null;
for $x in $markers do (
    $onset = $x.getkey('onset');
    $onsets _= $onset;
    if $x.getkey('index') == 1 then (
        $cycleonsets _= $onset;
        $x
    ) 
);
$peakmarkerid = nearest(
    @list $onsets
    @target $peak
    @mode 1
);
$peak = $onsets:$peakmarkerid;
$stop = 0;
$peakmarker = null;
$peakid = null;
for $i in -1 * (0...64) as $peakmarker == null || $stop == 0 do (
    $addr = ($peakmarkerid + $i);
    $marker = $markers:$addr;
    $index = $marker.getkey('index');
    if $index == 1 then (
        $peakmarker = $marker;
        $peakid = $addr
    ) else if $index == 6 then ($stop = 1) 
);
$peakmarkerid = $peakid;
$peak = $peakmarker.getkey('onset');
$markers = $markers.right($peakmarkerid - 1);
$velpattern = int(
    round(scale(3 2 3 4 0 8 1 2 9 1 10 2, 0, 10, 1, 127, -0.125)) 
);
$mcpattern = scale(8 7 8 9 6 1 5 6 2 6 0 10, 0, 10, 0, 1);
$durmulpattern = exp2(scale(8 7 8 9 6 1 5 6 2 6 0 10, 10, 0, -0.5, 1));
$count = 0;
$groups = (
    [
        [
            'names' family('strings') 'harp' 
        ] [
            'types' 'hit-on-body' 'tap' 
        ] 
    ] [
        ['names' family('plucked')] [
            'types' 'pizz' 'ord' 'harm' 'perc' 'tap' 
        ] 
    ] [
        [
            'names' 'sax' 'flute' 'clar' family('strings') 
        ] [
            'types' 'keys' 'pizz' 'exp-slap-pitch' 'slap-pitch' 'slap-unpitch' 'tongue-ram' 'legno-bat' 
        ] 
    ] 
);
for $marker in $markers do (
    $vel = $velpattern:($count + 1);
    $chord = for $mc in $marker.getkey('chord') collect if $mc < e7 then $mc;
    $mcpos = $mcpattern:($count + 1);
    $id = int(
        round(
            $mcpos.scale(0, 1, 1, length($chord)) 
        ) 
    );
    $mc = $chord:$id;
    $durmul = $durmulpattern:($count + 1);
    $onset = $marker.getkey('onset') - $peak;
    $group = xchoose($groups);
    $process = trim(
        @start 1
        @end 0
        @threshold 0.00125
    );
    if xrand() > 0.95 then (
        $process _= freqshift(
            $mc.mc2f() * xrandom(1, 4) @negative xchoose(-1 1) 
        ) 
    );
    maracas(
        @velocity $vel
        @useseed 1
        @duration $bardur * 1/16 * $durmul
        @useseed 1
    ).transcribe(
        @onset $onset
        @pan mc2pan($mc, 0.3) 
        @gain 0.125
    );
    $grouptypes = $group.getkey('types');
    $b = ezsol(
        @pitch $mc
        @names $group.getkey('names') 
        @duration $bardur * 1/16 * $durmul
        @types $group.getkey('types') 
        @resample intersection($grouptypes, 'hit-on-body') == null
        @velocity $vel
        @useseed 1
    ).process($process).clipnorm(@minlevel -14 @maxlevel -3);
    $st = $onset;
    if $vel < 100 && xrand() > 0.9 then (
        $b = $b.process(reverse());
        $st -= $b.getkey('duration') 
    );
    $b.transcribe(
        @onset $st
        @gain [0 1 0] [1 0 -xrand(1/8, 1/3)] 
        @pan mc2pan($mc, 0.125) 
    );
    if $vel > 100 then (
        $fq = $mc.mc2f() * 0.5;
        $gliss = $fq * xrand(-90, -10).c2r();
        cycle(
            @frequency [0 $fq 0] [1 $gliss -0.125] 
            @duration $durmul * 200
            @phase rand() 
        ).transcribe(
            @onset $onset
            @gain [0 0.2 0] [1 0 -0.25] 
            @pan mc2pan($mc, 0.125) 
        ) 
    );
    $count = ($count + 1) % length($velpattern);
    null
);
render(
    @play 1 @process (
        normalize(0) arctan() freeverb(
            @roomsize 0.85
            @wet 0.0025
            @damp 1
            @width 1
        ) normalize(-6) 
    ) 
);
ezexport($peakmarker)