$t = 0;
$b = importaudio('./06_premerge/premerge.wav');
$b.transcribe($t);
$t += read('./07_tile/tile.txt');
$b = importaudio('./07_tile/tile.wav');
$b.transcribe($t);
$tail = 1000;
render(
    @play 1 @process freeverb(
        @roomsize 0.8
        @wet 0.0125
        @damp 1
        @width 1
        @tail $tail
    ) fade(0, $tail) normalize(-3) 
);
ezexport()