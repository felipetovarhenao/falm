$samps = sax flute clar tpt;
$incr = 90;
for $samp $voice in $samps do (
    $pan = ($voice - 1) / max(1, length($samps) - 1);
    $scale = r2mc(1/2 1 9/8 10/9 9/7 7/5 3/2 5/3 15/8 2, 7000).sort();
    $scale = scramble($scale);
    $scale _= $scale.rev().left(-1).right(1);
    $group = 3;
    $scale = $scale.group($group, $group - 1);
    ## $scale = for $g in group($scale, $group, $group - 2) with @unwrap 1 collect scramble($g);
    $t = 0;
    for $mc in $scale.flat() :* 4 do (
        $vel = xrandom(1, 127);
        $type = choose('ord' if $vel > 90 then 'stacc');
        $samp(
            @pitch $mc
            @type $type
            @velocity $vel
            @duration if $type != 'stacc' then $incr * rand(1, 1.25) 
        ).process(multiply(127/$vel)).transcribe(
            @onset $t @pan $pan
        );
        $t += $incr
    ) 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.9
        @wet 0.025
        @damp 1
    ) normalize(-3) 
)