$folders = 'doppel' 'run' 'arpeggi' 'blast' 'strum' 'bell' 'gap' 'riff';
$t = 0;
for $i in 1...8 do (
    $id = tosymbol($i);
    for $folder $folderid in $folders do (
        $prefix = '0' + tosymbol(8 - $folderid + 1) + '_';
        $basefile = './' + $prefix + $folder + '/' + $folder + '_' + $id ;
        $sndfile = $basefile + '.wav';
        $txtfile = $basefile + '.txt';
        if exists($sndfile) == 1 && exists($txtfile) == 1 then (
            $b = importaudio($sndfile);
            $meta = read($txtfile);
            if $folder == 'strum' then (
                $b.transcribe($t - $meta.'offset');
                $t += $meta.'duration' 
            ) else (
                $b.transcribe($t);
                $t += $meta
            ) 
        ) 
    ) 
);
importaudio('./09_dissolve/dissolve.wav').transcribe($t);
render(
    @play 1 @process normalize(-3) join(envelope(@duration 2500)) 
);
ezexport()