setseed(3);
$meta = read('../01_strings/strings.txt');
$totdur = $meta.getkey('totdur');
$mc = d5;
$octs = (-2...3) * 1200 r2c(3/2 3 6 12);
$octs = $octs:[
    argsort(abs($octs)) 
];
$numoctsbpf = [0 5 0] [1 length($octs) 0];
$overdrivebpf = [0 5 0] [1 25 0.25];
$velbpf = [0 40 0] [1 127 -0.125];
$prefx = trim(@start 1 @threshold 0.001) gain([0 1 0] [1 0 0.25]);
$types = 'harm' 'harm-in-wood' 'pizz' 'ord' 'bartok';
$numtypesbpf = [0 3 0] [1 length($types) 0];
$onsets = arithmser(0, $totdur, null, 10);
$minonset = 0;
$markers = null;
for $t in $onsets do (
    addmarker($t);
    $nt = $t / $totdur;
    $numocts = round(samplebpf($numoctsbpf, $nt));
    $overdrive = samplebpf($overdrivebpf, $nt);
    $vel = samplebpf($velbpf, $nt);
    $numtypes = samplebpf($numtypesbpf, $nt);
    $cresc = bass(
        @pitch $mc - 3600
        @duration xrandom(1000, 3000) 
        @velocity $vel
        @type 'stacc' 
        @useseed 1
    ).process(overdrive($overdrive) $prefx reverse()).analyze(envmaxtime());
    $t += $cresc.getkey('duration');
    if $minonset == 0 then ($minonset = $t);
    $markers _= $t;
    $cresc.transcribe(
        @onset $t - $cresc.getkey('envmaxtime') 
        @pan [0 xrand(0.25, 0.75) 0] [1 xrand(0.25, 0.75) xrand(-0.25, 0.25)] 
        @gain 0.33
    );
    $bassdur = xrand(5000, 10000);
    $basspeak = xrand(0.1, 1) ** 2 * (500 / $bassdur);
    $bass = simplefm(
        @frequency mc2f($mc) / 8
        @duration $bassdur
        @phase xrand() 
        @harmonicity xrandom(1, 2) 
        @modindex [0 0 0] [$basspeak xrand() ** 2 xrand(3/4, 1/2)] [1 0 -xrand(1/3, 3/4)] 
    );
    $bass.transcribe(
        @onset $t - $bass.getkey('duration') * $basspeak
        @pan xrand(-1, 1) * 0.05 + 0.5 xrand() 
        @gain [0 0 0] [$basspeak scale($vel, 0, 127, 0.125, 0.35, 0.125) xrand(1/4, 2/3)] [1 0 -xrand(1/3, 3/4)] 
    );
    for $oct in $octs.left($numocts) do (
        $pitch = $mc + $oct;
        $b = ezsol(
            @pitch $pitch
            @velocity $vel + xrandom(-12, 12) 
            @duration null
            @names family('plucked') 
            @types left($types, $numtypes) 
            @useseed 1
        ).process(
            $prefx
            ## ----
            rubberband(
                @stretching xrand(2, 4.5) @smoothing 1
            ) 
        );
        $normgain = gainboost(
            @buffer $b
            @outmin dbtoa(-55) 
            @outmax dbtoa(-6) 
        );
        $b = $b.process(gain($normgain));
        if $t + $b.getkey('duration') > $totdur + 10000 then (
            $b = $b.setkey('duration', 10000).process(fade(
                @fadein 0
                @fadeout 2000
                @fadeouttype 2
            )) 
        );
        $b.transcribe(
            @onset $t
            @pan [0 xrand() 0] [1 xrand() xrand(-0.5, 0.5)] 
            @gain 1.1 ** (1 - $numocts) 
        ) 
    ) 
);
$tail = 1000;
$b = render(@reset 1);
$segs = splitbuf(
    @buffer $b
    @split $onsets
    @mode 2
);
for $seg in $segs, $onset in $onsets do process(
    @buffer $seg @operations normalize(0) arctan() normalize(-3) 
).transcribe(@onset $onset);
render(
    @play 1 @process (
        freeverb(
            @roomsize 0.95
            @wet 0.0125
            @damp 1
            @width 1
            @tail $tail
        ) 
        ## ---
        fade(
            @fadein 0
            @fadeout $tail
            @fadeouttype 2
        ) 
        ## ---
        normalize(-3) 
    ) 
);
ezexport(['onset' $minonset] ['markers' $markers])