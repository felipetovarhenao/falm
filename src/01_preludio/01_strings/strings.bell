#( 
    in memoriam Malugo
)#
setseed(208);
$distsort = (
    $llll, $ref -> (
        $dist = abs($llll - $ref);
        $ids = argsort($dist);
        $llll:[$ids] 
    ) 
);
$fundamental = D3;
$pcprog = r2pc(
    ## 
    [1 6/5 3/2] 
    ## 
    [1 9/8 6/5 3/2] 
    ## 
    [1 9/8 6/5 3/2 7/4] 
    ## 
    [1 9/8 6/5 4/3 3/2 7/4] 
    ## 
    [1 9/8 6/5 4/3 3/2 8/5 7/4] 
    ## 
    [1 9/8 6/5 4/3 3/2 5/3 7/4] 
    ## 
    [1 9/8 5/4 4/3 3/2 5/3 7/4] 
    ## 
    [1 9/8 5/4 4/3 3/2 5/3 15/8] 
    ## 
    [1 9/8 5/4 7/5 3/2 5/3 15/8] 
    ## 
    [1 9/8 5/4 3/2 5/3 15/8] 
    ## 
    [1 9/8 5/4 3/2 5/3] 
    ## 
    [1 5/4 3/2 5/3] 
    ## 
    [1 5/4 3/2] :* 2
    ## 
    [1 3/2] :* 4
    ## 
    @pc mc2pc($fundamental) 
);
$instrumentnames = 'viola' 'violin' 'cello' 'bass';
$techniques = 'nonvib' 'nonvib+mute' 'ord' 'ord+mute' 'harm' 'harm-trem' 'cresc' 'dim' 'cresc-to-dim' 'ord-to-crushed' 'crushed-to-ord' 'sfz' 'trem-to-ord' 'trem' 'stacc';
$chord = r2mc(1/2 (1...32), $fundamental);
$totaldur = 60 * 1000 * 5;
$panvals = $distsort(
    arithmser(
        0, 1, null, max(3, length($chord)) 
    ), 0.5
);
## --------------- BPFs ---------------
$pcidbpf = [0 1 0] [1 length($pcprog) - 1 0.125];
$onsetvarbpf = [0 0 0] [1 1 1/3];
$velbpf = [0 0 0] [1 127 1/3];
$velvarbpf = [0 0 0] [1 7 1/4];
$mixbpf = [0 0 0] [1 2 0.25];
$timestepbpf = [0 5000 0] [1 1500 -1/4];
$chordsizebpf = [0 1 0] [1 length($chord) 0.125];
$numnamesbpf = [0 2 0] [1 length($instrumentnames) 1/8];
$numtechniquesbpf = [0 1 0] [1 length($techniques) 1/5];
## --------------- LOOP ---------------
$t = 0;
$chordseq = null;
while $t < $totaldur do (
    ## --------------- BPF SAMPLING ---------------
    $nt = $t / $totaldur;
    $pcid = samplebpf($pcidbpf, $nt);
    $mix = samplebpf($mixbpf, $nt);
    $vel = samplebpf($velbpf, $nt);
    $velvar = samplebpf($velvarbpf, $nt);
    $numnames = samplebpf($numnamesbpf, $nt).round().int();
    $chordsize = int(
        round(samplebpf($chordsizebpf, $nt)) 
    );
    $onsetvar = samplebpf($onsetvarbpf, $nt);
    $timestep = samplebpf($timestepbpf, $nt);
    $numtechniques = max(
        1, int(
            round(samplebpf($numtechniquesbpf, $nt)) 
        ) 
    );
    ## --------------- 
    $pcmix = fmod($pcid, 1) ** $mix;
    $pcid = int($pcid);
    $pcs1 = $pcprog::$pcid;
    $pcs2 = $pcprog::($pcid + 1);
    $mcs = for $mc in $chord collect (
        $mc1 = $mc + pitchdiff($mc, $pcs1);
        $mc2 = $mc + pitchdiff($mc, $pcs2);
        int(
            round((1 - $pcmix) * $mc1 + $pcmix * $mc2) 
        ) 
    );
    $mcs = thin($mcs);
    $mcs = $distsort($mcs, d5);
    $chordseq _= [
        ['onset' $t] ['velocity' $vel] ['chord' $mcs] ['duration' $timestep] ['density' $chordsize] 
    ];
    $mcs = $mcs.left($chordsize);
    for $mc in $mcs, $pan in left($panvals, $chordsize) with @scalarmode 0 do (
        $instruments = for $n in left($instrumentnames, $numnames) collect instrument(
            @name $n
            @types $techniques.left($numtechniques) 
            @join 0
        );
        $instrument = $instruments.pitchfilter($mc, 600).xchoose();
        $fn = $instrument.getkey('fn');
        $type = $instrument.getkey('types').xchoose();
        $b = $fn(
            @pitch $mc
            @duration null
            @velocity $vel + xrand(-0.5, 0.5) * $velvar
            @type $type
            @useseed 1
        );
        $boost = gainboost(
            @buffer $b.process(trim(@threshold 0.001)) 
            @outmin dbtoa(-50) 
            @rms 1
            @slope -0.05
        );
        $b.process(gain($boost)).transcribe(
            @onset $t + $timestep * xrand(-0.5, 0.5) * $onsetvar
            @gain sqrt(1/length($mcs)) 
            @pan $pan
        ) 
    );
    $t += $timestep
);
$tail = 6000;
render(
    @play 1 @process freeverb(
        @roomsize 0.95
        @wet [0 0.005 0] [1 0.025 0.25] 
        @tail $tail
        @width 1
        @damp 1
    ) fade(
        @fadein 0
        @fadeout $tail
        @fadeoutcurve 1/3
        @fadeouttype 1
    ) normalize(-3) 
);
$metadata = [['totdur' $totaldur] ['events' $chordseq]];
ezexport($metadata)