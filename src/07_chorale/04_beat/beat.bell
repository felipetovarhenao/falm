setseed(8);
$harm = read('../00_harmony/harmony.txt');
$root = $harm.'mcroot';
$meta = read('../01_background/background.txt');
$peak = $meta.'peak';
$b = importaudio('../03_premerge/premerge.wav');
$b = $b.setkey('offset', $peak);
$bpm = 85;
$bardur = float(240000 / $bpm);
$globaloffset = $bardur;
$totdur = $bardur * 16;
$t = 0;
$rhythm = for $cell in xscramble(
    [1/8 1/16 1/16] [1/24 :* 3] [5/16 3/16] 
) with @unwrap 1 collect xscramble($cell) * $bardur;
$maxoffset = $b.getkey('source_end') - maximum($rhythm);
$readst = $peak - $bardur * 1/2;
$compression = 0.25;
$readend = $readst + ($maxoffset - $readst) * $compression;
$readbpf = [0 $peak 0] [1 $readend 0.125];
$pattern = for $unit in $rhythm collect [
    ['unit' $unit] 
    ## ---
    ['slope' xrand(-1/3, 1/3)] 
    ## ---
    ['reverse' xchoose(0 1)] 
    ## ---
    ['pan' xrand()] 
    ## ---
    ['type' xchoose(
        'sfz' 'pizz' 'stacc' 
    )] 
];
$midpt = 1/3.;
$legatobpf = [0 2 0] [$midpt 0.25 -0.125] [1 3 0.125];
$bassvelbpf = [0 0 0] [$midpt 127 -0.125] [1 0 0.125];
while $t < $totdur do (
    $nt = min(1, max(0, $t / $totdur));
    $legato = exp2(samplebpf($legatobpf, $nt));
    $bassvel = samplebpf($bassvelbpf, $nt);
    $params = $pattern:1;
    $pattern = rot($pattern, -1);
    $unit = getkey($params, 'unit');
    $slope = getkey($params, 'slope');
    $type = getkey($params, 'type');
    $rev = getkey($params, 'reverse');
    $pan = getkey($params, 'pan');
    $offset = samplebpf($readbpf, $nt);
    $env = [0 1 0] [1 0 $slope];
    $seg = $b.setkey('offset', $offset).setkey('duration', $unit * $legato).process(gain($env));
    $bass = ezsol(
        @pitch $root
        @duration $unit * $legato
        @velocity $bassvel
        @names 'bass' 
        @types $type
        @useseed 1
    );
    $sine = sinewave(
        @pitch $root
        @velocity $bassvel * 0.8 + 5
        @duration $bass.getkey('duration') * exp2(xrand(-0.5, 0)) 
    ).process(gain(0.707));
    $bass = $bass.process(
        gain($env) mix($sine) 
    );
    $segdelay = 0;
    $bassdelay = 0;
    if $rev == 1 then (
        $seg = $seg.process(reverse());
        $segdelay -= $seg.getkey('duration') - $unit;
        $bass = $bass.process(reverse());
        $bassdelay -= $bass.getkey('duration') - $unit
    );
    $bass.transcribe(
        @onset $t + $globaloffset + $bassdelay @pan $pan
    );
    $seg.transcribe(
        @onset $t + $globaloffset + $segdelay @pan 1 - $pan
    );
    $t += $unit
);
null render(
    @play 1 @process (
        dynamics(
            @thresh -30
            @ratio 2
            @knee 0.12
            @release 100
        ) 
        ## ---
        normalize(@level -14 @rms 1) 
        ## ---
        arctan() 
        ## ---
        normalize(-3) 
    ) 
);
ezexport(
    ['offset' -$bardur] ['peak' $peak] ['totdur' $totdur] ['resume' $readend] 
)