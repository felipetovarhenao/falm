setseed(2);
$randwin = (
    -> (
        $x = scale(arithmser(0, 1, null, 30), 0, 1, 0, 1, xrand(-1/3, 1/3));
        sin($x * pi) ** 2
    ) 
);
$data = read('../01_strings/strings.txt');
$marker = getkey($data, 'totdur');
$b = importaudio('../01_strings/strings.wav').process(mixdown(@numchannels 1)).setkey('offset', $marker).process(trim(@threshold 0.001 @start 0)).detach();
$bufdur = $b.getkey('duration');
$t = 0;
$readbpf = [0 0 0] [1 1 -0.5];
$gainbpf = [0 0 0] [1/3 1 0.25] [1 1 0];
$durmulbpf = [0 1 0] [1 0.25 0.25];
$panspreadbpf = [0 0 0] [1 1 -0.125];
$jit = 0.25;
$totdur = $bufdur * 2;
while $t < $totdur do (
    $nt = $t / $totdur;
    $gain = samplebpf($gainbpf, $nt);
    $panspread = samplebpf($panspreadbpf, $nt);
    $graindur = 200 * exp2(xrand(-1, 1));
    $incr = $graindur / 4;
    $read = samplebpf($readbpf, $nt);
    $maxoffset = $bufdur - $graindur;
    $offset = $maxoffset * $read;
    $offset = max(
        0, min(
            $maxoffset, $offset + exp2(xrand(-$jit, $jit)) * $incr
        ) 
    );
    $durmul = samplebpf($durmulbpf, $nt);
    $grain = $b.setkey('offset', $offset).setkey('duration', $graindur * $durmul);
    $grain.transcribe(
        @onset $t + exp2(xrand(-$jit, $jit)) * $incr
        @pan 0.5 + $panspread * 0.5 * xrand(-1, 1) 
        @gain $randwin() * $gain
    );
    $t += max(20, $incr) 
);
$tail = 3000;
render(
    @play 1 @process (
        freeverb(
            @roomsize 0.9
            @wet 0.0125
            @damp 1
            @width 1
            @tail 0
        ) fade(
            @fadein 0
            @fadeout $tail
            @fadeouttype 2
        ) 
        ## ---
        normalize(-3) 
    ) 
);
ezexport($marker)