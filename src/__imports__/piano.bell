## change path below if it differs in your computer
$pianopath = '/Applications/Ableton Live 12 Suite.app/Contents/App-Resources/Core Library/Samples/Multisamples/Grand Piano';
$files = readfolder($pianopath);
$keymap = null;
$dynamics = (
    'ff' 'f' 'mf' 'mp' 'p' 
).rev();
$velocities = int(
    arithmser(1, 127., null, length($dynamics)) 
);
$portal = {fromsymbol};
$regex1 = {regexp @re [A-G](b|#)?};
$regex2 = {regexp @re [0-9]};
$regex3 = {regexp @re (ff|pp|mp|mf|p|f)};
$dyn2vel = for $d in $dynamics, $v in $velocities collect [$d $v];
for $f in $files do (
    $parsed = parsepath($f);
    $filename = $parsed.getkey('name');
    $pitchname = $regex1(
        $filename @out 'm' @fetch 3
    ):2;
    $oct = $regex2(
        $filename @out 'm' @fetch 3
    );
    $mc = $pitchname + tosymbol($oct);
    $mc = pitch($portal($mc @out 'm') + 2400);
    $dyn = $regex3(
        $filename @out 'm' @fetch 3
    );
    $vel = $dyn2vel.$dyn;
    if $keymap.$mc == null then ($keymap _= [$mc]);
    if ($keymap.$mc).$vel == null then ($keymap.$mc _= [$vel]);
    $keymap.$mc.$vel _= $f
);
write(
    @data $keymap
    @path '../__data__/pno/ord.txt' 
    @escape 2
)