setseed(1);
$harmony = read('../00_harmony/harmony.txt');
$ratios = $harmony.'ratios';
$mcroot = $harmony.'root';
$pcroot = $harmony.'pc';
$pcs = r2pc($ratios, $pcroot);
$chord = pcquant(r2mc(1...64, $mcroot), $pcs);
$totdur = 30000;
$t = 0;
$velbpf = [0 0 0] [1 127 0.125];
$incrbpf = [0 1000 0] [1 20 -0.125];
$gainbpf = [0 0.0125 0] [1 1 0.125];
$delay = 4000;
while $t < $totdur do (
    $nt = $t / $totdur;
    $incr = samplebpf($incrbpf, $nt) * exp2(xrand(-0.25, 0.25));
    $vel = samplebpf($velbpf, $nt);
    $gain = samplebpf($gainbpf, $nt);
    $mc = xchoose($chord);
    $b = ezsol(
        @pitch $mc
        @duration null
        @velocity $vel + xrandom(-7, 7) 
        @names family('winds') family('strings') 
        @types 'cresc' 'dim' 'sfz' 'ord-to-brassy' 'ord-to-flz' 'flz-to-ord' 'crushed-to-ord' 'ord-to-crushed' 'nat-harm-gliss' 'trem' 'harm-trem' 
        @useseed 1
    ).analyze(envmaxtime());
    $b.transcribe(
        @onset $t - $b.getkey('envmaxtime') + $delay
        @pan mc2pan($mc, 0.125) 
        @gain $gain
    );
    $t += $incr
);
for $type in 'mid' 'drawn' do (
    $b = perc(
        @pitch 4100
        @resample 0
        @type $type
        @velocity 127
        @duration null
        @useseed 1
    ).analyze(envmaxtime() effectiveduration(@thresholdratio 0.01));
    $b.setkey('duration', $b.getkey('effectiveduration')).transcribe(
        @onset $t - $b.getkey('envmaxtime') + $delay
        @pan xrand() xrand() 
        @gain [0 1 0] [1 0 0.25] 
    ) 
);
ezrender(
    @play 1 @process freeverb(
        @roomsize 0.95
        @wet 0.05
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport($totdur + $delay);
done()