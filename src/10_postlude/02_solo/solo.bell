setseed(18);
$harmony = read('../00_harmony/harmony.txt');
$mcroot = $harmony.'root';
$pcroot = $harmony.'pc';
$ratios = $harmony.'ratios';
$meta = read('../01_intro/intro.txt');
$totdur = $meta.'total_duration';
$globaldelay = ($meta.'markers':2) + 2000;
$totdur -= $globaldelay;
$basechord = r2mc(4...42, $mcroot);
$pcs = r2pc($ratios, $pcroot);
$pcslen = length($pcs);
$t = 0;
$gapbpf = [0 5000 0] [1 250 -0.125];
$melspanbpf = [0 3000 0] [1 1500 -0.125];
$maxnotesbpf = [0 0 0] [1 1 0.05];
$melvelbpf = [0 0 0] [1 127 0.25];
$numvoicesbpf = [0 1 0] [1 4 2/3];
$gainbpf = [0 0.5 0] [1 1 0.125];
$filterbpf = [0 2/3 0] [1 1 0.125];
$types = thin(
    'ord' 'stacc' 'ten' 'stop' 'flz' 'bisb' 'dim' 'stop-to-open' 'open-to-stop' 'ord+mute' 'sfz' 'ord-high' 'ord-micro' 'ord-to-brassy' 'flz-stop' 'flz+mute' 'flz-to-ord' 
);
$numtypesbpf = [0 2 0] [1 length($types) 0.05];
$names = 'horn' 'sax' 'clar' 'tromb' 'flute';
$numnamesbpf = [0 1 0] [1 length($names) 1/3];
$pcfilter = (
    $mcs, $pcs -> (
        for $mc in $mcs collect (
            $diff = pitchdiff($mc, $pcs);
            if abs($diff) <= 1 then $mc
        ) 
    ) 
);
Markers = null;
Transcribe = (
    $buffer = null, $onset = 0, $gain = null, $pan = null -> (
        Markers _= [
            ['onset' $onset] ['duration' getkey($buffer, 'duration')] 
        ];
        transcribe(
            @buffer $buffer
            @onset $onset
            @pan $pan
            @gain $gain
        ) 
    ) 
);
while $t < $totdur do (
    $nt = $t / $totdur;
    $gap = samplebpf($gapbpf, $nt) * exp2(xrand(-1/2, 1/2));
    $numvoices = round(samplebpf($numvoicesbpf, $nt));
    $balance = 1.1 ** (1 - $numvoices);
    for $v in 1...$numvoices do (
        $melspan = samplebpf($melspanbpf, $nt) * exp2(xrand(-1/2, 1/2));
        $voicedelay = if $v > 1 then xrand(-0.5, 0.5) * $melspan else 0;
        $maxnotes = samplebpf($maxnotesbpf, $nt);
        $maxnotes = max(
            1, int(
                round($maxnotes * ($melspan / 100)) 
            ) 
        );
        $numnotes = xrandom(ceil($maxnotes / 6), $maxnotes);
        $slope = xrand(-1/2, 1/2);
        $durs = timeramp(
            @duration $melspan
            @length $numnotes
            @slope $slope
        );
        $filter = int(
            round(samplebpf($filterbpf, $nt) * length($basechord)) 
        );
        $chord = left($basechord, $filter);
        $chord = $pcfilter(
            $chord, left(
                xscramble($pcs), xrandom($pcslen - 3, $pcslen) 
            ) 
        );
        $mcs = randomseq(
            @llll $chord
            @length $numnotes
            @steps (-1 1) (2 * xchoose(-1 1)) 
            @useseed 1
        );
        $dyads = group($mcs $mcs:-1, 2, 1);
        $shift = 0;
        $pan = xrand() - 0.5;
        for $dyad in $dyads, $dur in $durs with @unwrap 1 do (
            $onset = $shift + $t + $voicedelay;
            if $onset < $totdur then (
                $nt = $onset / $totdur;
                $melvel = samplebpf($melvelbpf, $nt);
                $gain = samplebpf($gainbpf, $nt);
                $numtypes = int(
                    round(samplebpf($numtypesbpf, $nt)) 
                );
                $numnames = int(
                    round(samplebpf($numnamesbpf, $nt)) 
                );
                $mc1 = $dyad:1;
                $mc2 = $dyad:2;
                $gliss = [0 1 0] [
                    1 1/c2r(minabs($mc2 - $mc1, 400)) xrand(1/2, 0.95) 
                ];
                $durmul = integrate($gliss):(-1 2);
                $envslope = xrand(-2/3, 2/3);
                $minenvgain = xrand(0.01, 0.707) * $gain;
                $env = xchoose(
                    ## ---
                    [[0 $minenvgain 0] [1 $gain $envslope]] 
                    ## ---
                    [[0 $gain 0] [1 $minenvgain $envslope]] 
                    ## ---
                    [hanning() * $gain] 
                )::1;
                $b = ezsol(
                    @pitch $mc1
                    @duration $dur / $durmul
                    @velocity min(
                        127, max(0, $melvel + xrandom(-7, 7)) 
                    ) 
                    @names flat(left($names, $numnames)) 
                    @types left($types, $numtypes) 
                    @useseed 1
                ).clipnorm(@minlevel -32 @maxlevel -24).process(
                    resample($gliss) multiply(xchoose(-1 1)) dcfilter() gain($env) 
                );
                $dur = $b.getkey('duration');
                $b.Transcribe(
                    @onset $onset
                    @gain $balance
                    @pan fold(mc2pan($mc1, 0.125) + $pan) 
                ) 
            );
            $shift += $dur
        ) 
    );
    $t += $melspan + $gap
);
$tail = 5000;
ezrender(
    @play 1 @process normalize(-3) 
);
ezexport(
    @data ['delay' $globaldelay] ['markers' Markers] 
);
done()