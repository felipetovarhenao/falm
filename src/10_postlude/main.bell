$t = 0;
importaudio('./01_intro/intro.wav').transcribe(@onset $t);
$t += read('./03_glitch/glitch.txt');
importaudio('./03_glitch/glitch.wav').transcribe(@onset $t);
$end = read('./01_intro/intro.txt').'markers':-1;
$peak = read('./05_climax/climax.txt');
importaudio('./03_arpeggi/arpeggi.wav').transcribe($end);
importaudio('./04_sustain/sustain.wav').transcribe($end);
importaudio('./05_climax/climax.wav').transcribe($end - $peak);
render(
    @play 1 @process normalize(-3) 
);
ezexport()