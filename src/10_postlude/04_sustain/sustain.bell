setseed(1);
$harmony = read('../00_harmony/harmony.txt');
$mcroot = $harmony.'root';
$ratios = $harmony.'ratios';
$pcroot = $harmony.'pc';
$meta = read('../03_arpeggi/arpeggi.txt');
$basechord = r2mc(1...48, $mcroot);
$pcs = r2pc($ratios, $pcroot);
$basechord = pcquant($basechord, $pcs);
$globalduration = $meta.'total_duration';
$slope = $meta.'slope';
$numvoices = int(round($meta.'numvoices' / 1.5));
$mcs = $basechord:1 sort(
    left(
        xscramble(right($basechord, 1)), $numvoices
    ) 
);
$names = 'acc' (
    for $family in 'strings' 'winds' collect family($family) 
);
$velbpf = [0 120 0] [1 0 $slope];
$gainbpf = [0 1 0] [1 0.1 $slope];
$veltotypes = ($vel -> (
    $types = null;
    if $vel > 90 then 'cresc' 'cresc-to-dim' 'dim' 'stacc';
    $types
));
for $mc in $mcs do (
    $t = 0;
    $totdur = $globalduration * exp2(xrand(-0.25, 0));
    $pan = mc2pan($mc, 1/3.);
    while $t < $totdur do (
        $nt = $t / $totdur;
        $vel = samplebpf($velbpf, $nt) xrandom(-7, 7);
        $gain = samplebpf($gainbpf, $nt);
        $b = ezsol(
            @pitch $mc
            @duration null
            @velocity $vel
            @names $names
            @types 'ord' 'nonvib' $veltotypes($vel) 
            @useseed 1
        ).analyze(effectiveduration(@thresholdratio 0.01));
        $boost = gainboost(
            @buffer $b
            @slope -0.125
            @outmin dbtoa(-40) 
            @rms 1
        );
        $b.process(gain($boost * $gain) dcfilter()).transcribe(@onset $t @pan $pan);
        $t += max(0, $b.getkey('effectiveduration') - 200) 
    ) 
);
ezrender(
    @play 1 @process freeverb(
        @roomsize 0.96
        @wet 0.05
        @dry 1
    ) normalize(-3) 
);
ezexport();
done()