setseed(4);
$meta = read('../01_foreground/foreground.txt');
$peak = $meta.'peak';
$tempo = $meta.'tempo';
$beatdur = 60000 / $tempo;
$bardur = $beatdur * 4;
$markers = $meta.'markers';
$onsets = null;
$cycleonsets = null;
for $x in $markers do (
    $onset = $x.getkey('onset');
    $onsets _= $onset;
    if $x.getkey('index') == 1 then (
        $cycleonsets _= $onset;
        $x
    ) 
);
$peakmarkerid = nearest(
    @list $onsets
    @target $peak
    @mode 1
);
$peak = $onsets:$peakmarkerid;
$stop = 0;
$peakmarker = null;
$peakid = null;
for $i in -1 * (0...64) as $peakmarker == null || $stop == 0 do (
    $addr = ($peakmarkerid + $i);
    $marker = $markers:$addr;
    $index = $marker.getkey('index');
    if $index == 1 then (
        $peakmarker = $marker;
        $peakid = $addr
    ) else if $index == 6 then ($stop = 1) 
);
$peakmarkerid = $peakid;
$peak = $peakmarker.getkey('onset');
$markers = $markers.right($peakmarkerid - 1);
$velpattern = int(
    round(scale(3 2 3 4 0 8 1 2 9 1 10 2, 0, 10, 1, 127, -0.125)) 
);
$mcpattern = scale(8 7 8 9 6 1 5 6 2 6 0 10, 0, 10, 0, 1);
$durmulpattern = exp2(scale(8 7 8 9 6 1 5 6 2 6 0 10, 10, 0, -0.5, 1));
$count = 0;
$groups = (
    [
        [
            'names' family('strings') 'harp' 
        ] [
            'types' 'hit-on-body' 'tap' 
        ] 
    ] [
        ['names' family('plucked')] [
            'types' 'pizz' 'ord' 'harm' 'bartok' 'harm-on-wood' 
        ] 
    ] [
        [
            'names' 'sax' 'flute' 'clar' family('strings') 
        ] [
            'types' 'keys' 'pizz' 'exp-slap-pitch' 'slap-pitch' 'slap-unpitch' 'tongue-ram' 'legno-bat' 'bartok' 
        ] 
    ] 
);
$fqshiftbpf = [0 0.5 0] [1 0 -0.125];
for $marker $markid in $markers do (
    $nt = scale($markid, 1, length($markers), 0, 1);
    $fqshift = samplebpf($fqshiftbpf, $nt);
    $vel = $velpattern:($count + 1);
    $chord = for $mc in getkey($marker, 'chord') collect if $mc < f#6 then $mc;
    $mcpos = $mcpattern:($count + 1);
    $id = int(
        round(
            $mcpos.scale(0, 1, 1, length($chord)) 
        ) 
    );
    $mc = $chord:$id;
    $durmul = $durmulpattern:($count + 1);
    $onset = $marker.getkey('onset') - $peak;
    $group = xchoose($groups);
    $process = trim(
        @start 1
        @end 0
        @threshold 0.00125
    );
    if xrand() < $fqshift && $id > 1 then (
        $process _= freqshift(
            mc2f($mc) * exp2(xrandom(0, 1)) @negative xchoose(-1 1) 
        ) 
    );
    $reps = xchoose(1 2 3 @weights 8 2 1);
    $shift = 0;
    for $rep in 1...$reps do (
        $repunit = 1 / (16 * $reps);
        maracas(
            @velocity $vel + xrandom(-7, 7) 
            @duration $bardur * $repunit * $durmul
            @useseed 1
        ).transcribe(
            @onset $onset + $shift
            @pan mc2pan($mc, 0.9) 
            @gain [0 0.125 0] [1 0 -xrand(1/8, 3/4)] 
        );
        $shift += $bardur * $repunit
    );
    $grouptypes = $group.getkey('types');
    $b = ezsol(
        @pitch $mc
        @names $group.getkey('names') 
        @duration $bardur * 1/8 * $durmul
        @types $group.getkey('types') 
        @resample intersection($grouptypes, 'hit-on-body') == null
        @velocity $vel + xrandom(-7, 7) 
        @useseed 1
    ).process($process).clipnorm(@minlevel -14 @maxlevel -3);
    $st = $onset;
    if $vel < 100 && xrand() > 0.9 then (
        $b = $b.process(reverse());
        $st -= $b.getkey('duration') 
    );
    $b.transcribe(
        @onset $st
        @gain [0 1 0] [1 0 -xrand(1/8, 1/3)] 
        @pan mc2pan($mc, 0.125) 
    );
    if $vel > 100 then (
        $fq = $mc.mc2f() * 0.5;
        $gliss = $fq * c2r(xrand(-220, -10));
        cycle(
            @frequency [0 $fq 0] [1 $gliss -0.125] 
            @duration $durmul * $bardur * 1/8
            @phase xrand() 
        ).transcribe(
            @onset $onset
            @gain [
                0 0.25 * exp2(xrand(-0.1, 0.1)) 0
            ] [1 0 -0.25] 
            @pan mc2pan($mc, 0.125) 
        ) 
    );
    $count = ($count + 1) % length($velpattern) 
);
$bassmc = getkey($markers:1, 'chord');
bass(
    @pitch $bassmc
    @velocity 127
    @duration null
    @type 'bartok' 
    @useseed 1
).transcribe(@pan 0.707);
render(
    @play 1 @process (
        normalize(@level -24 @rms 1) arctan() normalize(-3) 
    ) 
);
ezexport($peakmarker)