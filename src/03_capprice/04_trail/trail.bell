if FastArpeggio == null then BP_FN_ERROR(@details 'You need you run script containing gesture/object definitions first.');
setseed(1000);
$t = 0;
$b = importaudio('../03_loops/loops.wav');
$bardur = 2150.;
$dur = 1/8 * $bardur;
$end = read('../03_loops/loops.txt');
$mcs = r2mc(1...32, Root).pcquant(r2pc(1 9/8 5/4 7/5 3/2 5/3 15/8, PcRoot));
$mcs = rev($mcs);
$stnumnotes = 4;
$mcs !_= $mcs:1 :* ($stnumnotes - 1);
$numnotesbpf = [0 $stnumnotes 0] [1 length($mcs) 0.125];
$N = 12;
for $i in 1...($N + 1) do (
    $nt = scale($i, 1, $N + 1, 0, 1);
    $dur2 = ($N + 1 - $i) * $dur;
    if $dur2 > 10 then (
        $numnotes = int(
            round(samplebpf($numnotesbpf, $nt)) 
        );
        $submcs = $mcs.left($numnotes);
        $bal = 1.0125 ** (1 - length($submcs));
        for $mc in $submcs do (
            $resbpf = [0 1 0] [1 1/c2r(-50) xrand(2/3, 7/8)];
            $durfactor = integrate($resbpf):(-1 2);
            ezsol(
                @pitch $mc
                @velocity 127
                @names family('strings') 'acc' 
                @types 'nonvib' 'harm' 'reg' 'ord' 'ord-to-crushed' 
                @duration $dur2 / $durfactor
                @useseed 1
            ).process(resample($resbpf)).transcribe(
                @onset $t
                @pan [0 mc2pan($mc) 0] [1 xrand() xrand(1/4, 4/5)] 
                @gain [0 0 0] [1 $bal xrand(1/2, 3/4)] 
            ) 
        );
        $t += $dur2
    );
    $subdiv = exp2(
        int(($i - 1) / 2) 
    );
    for $rep in 1...$i do (
        $incr = $dur / $subdiv;
        $b.setkey('offset', $end - $dur).setkey('duration', if $rep == $i then 4000 else max(90, $incr * 2)).transcribe(
            @onset $t
            @pan xrand(-1, 1) * 0.25 + 0.5
            @gain [0 0.707 0] [1 0 xrand(-1/2, 1/2)] 
        );
        $t += $incr * ($rep < $i) 
    ) 
);
$bassdur = $dur * ($N + 1);
$bass = cycle(
    @frequency mc2f(Root) @duration $bassdur
);
$bass.process(
    gain([0 0 0] [1 0.5 0.5]) panning(
        [0 0 0] [0.7 1 0.25] [1 0.5 -0.125] 
    ) 
).transcribe(@onset $t - $bassdur @gain 0.707);
addmarker($t);
render(
    @play 1 @process normalize(@level -18 @rms 1) arctan() normalize(-3) freeverb(
        @roomsize 0.8
        @wet [0 0.005 0] [1 0 -0.125] 
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport($t)