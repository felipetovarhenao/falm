if FastArpeggio == null then BP_FN_ERROR(@details 'You need you run script containing gesture/object definitions first.');
setseed(289);
$t = 0;
$bardur = 2150.;
$pcroot = mc2pc(Root);
$waves = sinewave triwave;
$totdur = round(50000 / $bardur) * $bardur;
$units = sort(1/8 3/16 1/4 5/16 3/8 7/16 5/8 3/4 7/8 4/4 9/8 5/4);
$numunits = length($units);
$unitrangesize = 5;
$maxpos = $numunits - $unitrangesize;
$unitposbpf = [0 1 0] [1 $maxpos 0.125];
$gainbpf = [0 1 0] [1 0.414 0.125];
while $t < $totdur do (
    $nt = $t / $totdur;
    $gain = samplebpf($gainbpf, $nt);
    $pc = xchoose(
        r2pc((1 4/3 3/2), $pcroot) @weights 7 2 1
    );
    $unitpos = int(
        round(samplebpf($unitposbpf, $nt)) 
    );
    $unitrange = (1...$unitrangesize) + min($unitpos, $numunits - $unitrangesize);
    $subunits = $units:[$unitrange];
    $chord = pcquant(r2mc(1...32, Root), r2pc(1 5/4 3/2 9/8, $pc));
    $incr = xchoose($subunits) * $bardur;
    $segorder = xscramble(1...100);
    for $mc in $chord.xscramble().left(6) do (
        $split = $incr / xrandom(2, 12);
        $fn = xchoose(
            ezsol xchoose($waves) @weights 3 1
        );
        $iswave = intersection($waves, $fn) != null;
        $b = $fn(
            @pitch $mc + (if $iswave == 1 then xrandom(-1, 3) * 1200 else 0) 
            @names family('strings') 
            @types 'stacc' 
            @velocity 127
            @envelope [0 0.1 0] [1 0 -xrand(2/3, 5/6)] 
            @duration max(10, $incr) 
            @useseed 1
        ).detach();
        $segs = $b.splitbuf(@split $split);
        $shift = 0;
        $pan = mc2pan($mc, 0.2);
        for $seg in $segs:[$segorder] do (
            $env = [0 $gain 0] [1 0 xrand(1/3, 3/4)];
            $segdur = $seg.getkey('duration');
            if $segdur > 10 then $seg.transcribe(
                @onset $t + $shift
                @pan $pan
                @gain $env
            );
            $shift += $segdur
        ) 
    );
    $t += $incr
);
$tail = 2000;
ezrender(
    @play 1 @process (
        freeverb(
            @roomsize 0.4
            @wet [0 0.0125 0] [1 0.05 0.35] 
            @damp 1
            @width 1
            @tail $tail
        ) fade(
            @fadein 0
            @fadeout $tail
            @fadeouttype 2
        ) normalize(-3) 
    ) 
);
ezexport($t)