setseed(40);
$mcroot = r2mc(7/8, d2);
$pcroot = mc2pc($mcroot);
$chord = r2mc(8...24, $mcroot).pcquant(r2pc(1 5/4 3/2 5/3 9/8 10/9, $pcroot));
$bufs = for $mc in $chord collect (
    $b = ezsol(
        @pitch $mc
        @duration null
        @velocity 0
        @types 'cresc-to-dim' 'harm' 'nonvib' 'harm-trem' 
        @names family('strings') 
        @useseed 1
    ).analyze(envmaxtime()) 
);
$maxdur = maximum(for $b in $bufs collect $b.getkey('envmaxtime'));
for $b in $bufs do (
    $offset = $maxdur - $b.getkey('envmaxtime');
    $t = 0;
    $maxgraindurbpf = [0 10 0] [0.5 100 0.125] [1 10 -0.125];
    $bufdur = $b.getkey('duration') - 200;
    while $t < $bufdur do (
        $nt = min(1, max(0, $t / $bufdur));
        $maxgraindur = samplebpf($maxgraindurbpf, $nt);
        $grainenv = xchoose(
            [
                [0 1 0] [1 0 -xrand(1/4, 6/7)] 
            ] [
                [0 0 0] [1 1 xrand(1/4, 6/7)] 
            ] [hanning()] 
        )::1;
        $graindur = xrand($maxgraindur / 6, $maxgraindur);
        $jit = xrand(-1, 1) * 400;
        if xrand() > 0.8 then (
            $grain = sinewave(
                @pitch $b.getkey('pitch') + 1200
                @velocity $b.getkey('maxabs') * 100
                @duration $graindur
            ) 
        ) else (
            $grain = $b.setkey('offset', $t).setkey('duration', $graindur) 
        );
        $grain.transcribe(
            @onset $t + $jit + $offset
            @pan xrand() 
            @gain $grainenv
            @detune xrandom(-1, 2) * 1200
        );
        $t += xrand(200) 
    ) 
);
$totdur = maximum(for $b in $bufs collect $b.getkey('duration'));
for $i in 1...3 do (
    ezsol(
        @pitch xrandom(21, 108) * 100
        @names family('strings') 
        @types 'nat-harm-gliss' 
        @duration null
        @resample 0
        @velocity 0
        @useseed 1
    ).process(trim(
        @end 1
        @start 0
        @threshold 0.005
    )).transcribe(
        @onset $maxdur - xrand(-1000, 1000) 
        @pan xrand() 
        @gain hanning() * 0.125
    ) 
);
$peak = $maxdur / $totdur;
ezrender(
    @play 1 @process biquad(
        [0 9000 0] [$peak 5000 -0.125] [1 90 0.25] @type 0 @q 0.25
    ) freeverb(
        @roomsize 0.8
        @wet [0 0 0] [$peak 0.0125 0.33] [1 0.005 -0.125] 
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport($totdur);
done()