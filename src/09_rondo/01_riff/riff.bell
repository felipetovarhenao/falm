$data = read('../00_sequence/sequence.txt');
$sections = $data.'sections';
$numsections = length($sections);
$layers = 'strings' 'perc' 'downbeat' 'bass' 'sines' 'brass';
$t = 0;
for $i in 1...$numsections do (
    $id = tosymbol($i);
    $t = 0;
    for $layer $layerid in $layers do (
        $digit = '0' + tosymbol($layerid) + '_';
        $file = './' + $digit + $layer + '/' + $layer + '_' + $id + '.wav';
        if exists($file) == 1 then (
            $b = importaudio($file);
            $b.transcribe($t) 
        ) 
    );
    $t += read('./01_strings/strings_' + $id + '.txt');
    ezrender(
        @reset 1 @process normalize(-3) 
    );
    ezexport(@data $t @id $i) 
);
done()