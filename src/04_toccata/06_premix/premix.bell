$t = 0;
$mc = r2mc(64, r2mc(5/4, d2));
pno(
    @pitch $mc
    @duration null
    @velocity 127
    @gain 0.125
    @norm 1
    @useseed 1
).transcribe(
    @pan mc2pan($mc) 
);
importaudio('../01_pulse/pulse.wav').transcribe(@onset $t);
importaudio('../02_gliss/gliss.wav').transcribe(@onset $t);
$markers = read('../01_pulse/pulse.txt').'sections';
$t += $markers:2;
importaudio('../05_layers/layers.wav').transcribe(@onset $t);
importaudio('../04_climax/climax.wav').transcribe(@onset $t);
importaudio('../03_cresc/cresc.wav').transcribe(@onset $t - read('../03_cresc/cresc.txt'));
render(
    @play 1 @process normalize(-3) 
);
ezexport()