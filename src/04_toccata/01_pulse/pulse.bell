setseed(4321);
$bpm = 112;
$unit = 1/16.;
$beat = (240000/$bpm) * $unit;
$t = 0;
$mcroot = r2mc(6/5, d2);
$pcroot = mc2pc($mcroot);
$mindurthresh = 10;
$minutes = 5;
$totdur = 60 * 1000 * $minutes;
$tuning = 1/1 567/512 9/8 147/128 21/16 1323/1024 189/128 3/2 49/32 7/4 441/256 63/32;
$pcs = r2pc($tuning, $pcroot);
$mcs = r2mc(1...64, $mcroot).pcquant($pcs);
$mcsminmax = minmax($mcs);
$minmc = $mcsminmax:1;
$maxmc = $mcsminmax:3;
$phi = 1.618033;
$climaxst = 1 / $phi;
$climaxend = $climaxst + ((1 - $climaxst) / $phi);
PointToClimax = (
    $y, $slope -^ $climaxst, $climaxend -> (for $x in $climaxst $climaxend collect [$x $y $slope] ) 
);
$velvar = 25;
$maxstreamsize = round(5000. / $beat);
$velbpf = [0 0 0] PointToClimax(127, -0.125) [1 0 -0.125];
$rangebpf = [0 3 0] PointToClimax(length($mcs), -1/6) [1 length($mcs) -1/3];
$rangesizebpf = [0 length($mcs) 0] PointToClimax(length($mcs), 0) [1 2 -1/5];
$revgatebpf = [0 1 0] PointToClimax(0.75, 0.25) [1 0.75 0.25];
$streamsizebpf = [0 1 0] PointToClimax($maxstreamsize, 0.125) [1 $maxstreamsize * 0.25 -0.125];
$legatobpf = [0 0.5 0] PointToClimax(2 0.125) [1 0.25 -0.125];
$wavegatebpf = [0 1 0] PointToClimax(0.001, -0.75) [1 0.001 -0.125];
$numvoicesbpf = [0 1 0] PointToClimax(4, 0.125) [1 1 -0.15];
$subdivgatebpf = [0 0 0] PointToClimax(0.1, 0.125) [1 0.1 0.125];
$panspreadbpf = [0 0 0] PointToClimax(0.5, 0.125) [0.1 0.125 0.125];
$headsizebpf = [0 0 0] PointToClimax(3, 1/3) [1 0 -0.25];
$sortweightbpf = [0 0 0] PointToClimax(1, 3/4.) [1 0 -3/4.];
$countstepbpf = [0 1 0] [$climaxst 1 0] [$climaxend 5 0.2] [1 1 -2/3.];
$solgroups = (
    ## ----------
    [[
        'names' 'harp' 'guitar' 
    ] [
        'types' 'ord' 'harm' 
    ]] 
    ## ----------
    [
        ['names' family('strings')] [
            'types' 'pizz' 'stacc' 
        ] 
    ] 
    ## ---------- 
    [
        ['names' family('woodwinds')] [
            'types' 'pizz' 'slap-pitch' 'stacc' 'tongue-ram' 'keys' 
        ] 
    ] 
    ## ----------
    [
        ['names' family('brass')] [
            'types' 'stacc' 
        ] 
    ] 
    ## ----------
    [
        ['names' 'acc'] [
            'types' 'stacc' 
        ] 
    ] 
);
GenSolBuf = (
    $pitch, $velocity, $nt = 0 -^ $solgroups -> (
        $numgroups = length($solgroups);
        $solweightbpf = [0 0 0] PointToClimax(1, 0.05) [1 1 0];
        $solweight = samplebpf($solweightbpf, $nt);
        $baseweights = ($numgroups 1) / ($numgroups + 1.);
        $weights = (1 - $solweight) * (0 1) + $solweight * $baseweights;
        $fn = xchoose(ezsol pno @weights $weights);
        if $fn == ezsol then (
            $maxgroups = int(
                round(
                    samplebpf(
                        [0 1 0] PointToClimax($numgroups, 0.125) [1 1 0], $nt
                    ) 
                ) 
            );
            $groups = xchoose(left($solgroups, $maxgroups));
            $names = $groups.getkey('names');
            $types = $groups.getkey('types');
            $numtypes = int(
                round(
                    samplebpf(
                        [0 0 0] PointToClimax(1, -0.125) [1 1 0], $nt
                    ) * (length($types) - 1) 
                ) 
            ) + 1;
            $types = $types.left($numtypes) 
        );
        $b = $fn(
            @pitch $pitch
            @velocity $velocity
            @gain 0.125
            @duration null
            @useseed 1
            @names $names
            @types $types
            @norm 1
        );
        $b = $b.analyze(effectiveduration(@thresholdratio 0.005));
        $b = $b.setkey('duration', $b.getkey('effectiveduration'));
        $b
    ) 
);
$count = 0;
$metadata = (
    ['beat' $beat] 
    ## -----
    ['chords'] 
);
while $t < $totdur do (
    $nt = $t / $totdur;
    $range = int(
        round(samplebpf($rangebpf, $nt)) 
    );
    $streamsize = int(
        round(samplebpf($streamsizebpf, $nt)) 
    );
    $headsize = int(
        round(samplebpf($headsizebpf, $nt)) 
    );
    $vel = samplebpf($velbpf, $nt);
    $sortweight = samplebpf($sortweightbpf, $nt);
    $subdivgate = samplebpf($subdivgatebpf, $nt);
    $countstep = int(
        round(samplebpf($countstepbpf, $nt)) 
    );
    $rangesize = samplebpf($rangesizebpf, $nt);
    $wavegate = samplebpf($wavegatebpf, $nt);
    $legato = samplebpf($legatobpf, $nt);
    $panspread = samplebpf($panspreadbpf, $nt);
    $revgate = samplebpf($revgatebpf, $nt);
    $numvoices = int(
        round(samplebpf($numvoicesbpf, $nt)) 
    );
    $submcs = left(right($mcs, -$range), $rangesize);
    $metadata.'chords' _= [
        ['onset' $t] ['chord' $submcs] 
    ];
    $numsubmcs = length($submcs);
    for $v in 1...$numvoices do (
        $mcid = $count % $numsubmcs + 1;
        if $nt > $climaxend then ($mcid *= -1);
        $mc = if xrand() > $sortweight then xchoose($submcs) else $submcs:$mcid;
        $durmul = exp2(scale($mc, $minmc, $maxmc, 2, 0));
        $iswave = xrand() < $wavegate;
        if $iswave == 0 then (
            $b = GenSolBuf(
                @pitch $mc
                @velocity min(
                    max(0, $vel + xrand(-1, 1) * $velvar), 127
                ) 
                @nt $nt
            ) 
        ) else (
            ## ----------
            $b = sinewave(
                @pitch $mc
                @velocity scale($vel, 0, 127, 3, 70) 
                @duration $streamsize * $beat + $mindurthresh
                @phase xrand() 
            ) 
        );
        $segs = $b.splitbuf(@split $beat @partials 1).left($streamsize);
        $tshift = 0;
        $pan = mc2pan($mc, $panspread);
        $head = $segs:[0...$headsize];
        $tail = $segs:[($headsize + 1)...length($segs)];
        $segs = $head ($tail &&& xscramble($tail));
        for $s in $segs do (
            $segdur = $s.getkey('duration');
            if $segdur > $mindurthresh then (
                if ($t + $tshift) < ($totdur + $streamsize * $beat) then (
                    $env = [0 1 0] [1 0 xrand(1/5, 3/4) * xchoose(-1 1)];
                    $process = gain($env);
                    $revshift = 0;
                    $grain = $s.setkey('duration', $beat * $durmul * $legato);
                    if xrand() > $revgate then (
                        $process _= reverse();
                        $grain = $grain.process($process);
                        $revshift -= $grain.getkey('duration') 
                    );
                    $subdivs = 1;
                    if $revshift == 0 && xrand() < $subdivgate then ($subdivs = xchoose(2...3));
                    $trudur = $grain.getkey('duration');
                    for $sd in 1...$subdivs do (
                        $tshiftstep = $beat / $subdivs;
                        $onset = $t + $tshift;
                        $grain.setkey('duration', if $sd == $subdivs then $trudur else $tshiftstep).transcribe(
                            @onset $onset + $revshift
                            @pan $pan
                            @detune if $iswave == 1 then xrandom(-1, 3) * 1200
                        );
                        $tshift += $tshiftstep
                    ) 
                ) 
            ) 
        ) 
    );
    $count += $countstep;
    $t += $beat
);
$tail = 2000;
render(
    @play 1 @process (
        ## ---
        freeverb(
            @roomsize 0.9
            @wet 0.025
            @damp 1
            @width 1
            @tail $tail
        ) 
        ## ---
        fade(
            @fadein 0
            @fadeout $tail
            @fadeouttype 2
        ) 
        ## ---
        normalize(-3) 
    ) 
);
$metadata _= ['sections' (0 $climaxst $climaxend 1) * $totdur];
ezexport($metadata)