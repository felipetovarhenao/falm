setseed(2);
$metadata = read('../01_pulse/pulse.txt');
$beat = $metadata.'beat';
$beatnum = int(round($metadata.'sections':2 / $beat));
$event = $metadata.'chords':$beatnum;
$chord = $event.getkey('chord');
$t = 0;
$velbpf = [0 1 0] [1 127 0.125];
$incrbpf = [0 $beat * 5 0] [1 $beat / 2 -0.5];
$gainbpf = [0 0.1 0] [1 1 0.125];
for $mc $mci in $chord.rev() do (
    $nt = $mci.scale(1, length($chord), 0, 1);
    $vel = samplebpf($velbpf, $nt);
    $gain = samplebpf($gainbpf, $nt);
    $incr = samplebpf($incrbpf, $nt);
    $incr = xrandom(1, round($incr / $beat)) * $beat;
    pno(
        @pitch $mc
        @gain 0.125
        @norm 1
        @velocity $vel
        @duration null
        @useseed 1
    ).transcribe(
        @onset $t
        @pan mc2pan($mc, 1.) 
        @gain $gain
    );
    $t += $incr
);
$mc = minimum($chord);
$duration = 6000;
$phasor = phasor(
    @frequency mc2f($mc) @duration $duration
);
$b = triangle(
    @phase $phasor @offset [0 0 0] [1 1 0.25] 
);
$bassop = (
    gain([0 1 0] [1 20 0.5]) 
    ## ---
    pong() 
    ## ---
    onepole(300) 
    ## ---
    fade(5, 5) 
    ## ---
    gain([0 0 0] [1 1 0.5]) 
);
$b.process($bassop).transcribe(
    @onset $t - $duration
    @pan xrand() xrand() 
    @gain 0.25
);
$tail = 2000;
ezrender(
    @play 1
    @panmode 1
    @process (
        normalize(-3) 
        ## ---
        freeverb(
            @roomsize 0.9
            @wet [0 0 0] [1 0.0125 0.5] 
            @damp 1
            @width 1
            @tail $tail
        ) 
        ## ---
        fade(
            @fadein 0
            @fadeout $tail
            @fadeouttype 2
        ) 
        ## ---
        normalize(-3) 
    ) 
);
ezexport($t);
done()