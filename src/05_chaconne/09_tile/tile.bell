$data = read('../08_premerge/premerge.txt');
$data2 = read('../01_foreground/foreground.txt');
$bassfq = getkey($data2.'final_marker', 'chord').minimum().mc2f();
$gates = $data.'gates';
if length($gates) % 2 == 1 then ($gates _= $gates:-1);
$gates = group($gates, 2);
$offset = $gates::(1 1 1);
$b = importaudio('../08_premerge/premerge.wav').setkey('offset', $offset);
$c = importaudio('../04_glide/glide.wav');
$t = 0;
$minlevel = -12;
$maxlevel = -3;
$rate = 0.125;
$bass = (
    $onset, $fq, $dur, $gain -> (
        cycle(@frequency $fq @duration $dur).transcribe(
            @onset $onset
            @gain [0 0.25 * $gain 0] [1 0 -0.5] 
            @pan 0.5
        ) 
    ) 
);
$gainbpf = [0 0.25 0] [1 1 -0.125];
$lastdur = null;
for $g $gi in $gates with @unwrap 1 do (
    $nt = scale($gi, 1, length($gates), 0, 1);
    $gain = samplebpf($gainbpf, $nt);
    $start = $g:(1 1);
    $end = $g:(2 1);
    $dur = $end - $start;
    $start -= $offset;
    if $dur > 0 then (
        $c.setkey('offset', max(0, $start * $rate)).setkey('duration', $dur).detach().clipnorm(@minlevel $minlevel @maxlevel $maxlevel).transcribe($start @gain $gain);
        $bass($start, $bassfq, $dur, $gain);
        $lastdur = $dur
    );
    $t += $dur
);
$c.setkey('offset', max(0, $start * $rate)).detach().clipnorm(@minlevel $minlevel @maxlevel $maxlevel).transcribe($start);
$bass($start, $bassfq, $lastdur * 4);
$tail = 1000;
ezrender(
    @play 1
    @fade 3
    @process (
        freeverb(
            @roomsize 0.95
            @wet [0 0.0001 0] [1 0.015 0.45] 
            @damp 1
            @width 1
            @tail $tail
        ) 
        ## ---
        fade(
            @fadein 0
            @fadeout $tail
            @fadeouttype 2
            @fadeoutcurve 0.5
        ) 
        ## ---
        normalize(-3) 
        ## 
        ## mix($b @gains 1 0.5) normalize(-3) 
        
    ) 
);
ezexport($offset);
done()