PianoRoll = (
    $onset = 0, $duration = 1000, $chord = null, $vel = 100 -> (
        $t = $onset;
        $vel = $vel ||| xrand(20, 100);
        $incr = xrand(50);
        cycle(
            @frequency mc2f(
                $chord.minimum().mc2pc() * 100 + 2100
            ) 
            @duration $duration
            @phase xrand() 
        ).transcribe(
            @onset $t
            @gain [
                0 (($vel + 1) / 127) ** 0.5 * 0.25 0
            ] [1 0 -xrand(1/4, 4/5)] 
            @pan xrand() 
        );
        for $mc in $chord do (
            if xrand() > 0.75 then (
                sinewave(
                    @pitch $mc + xrandom(-2, 4) * 1200
                    @duration 300 * xrand(0, 2).exp2() 
                    @velocity $vel
                    @envelope [0 0.33 0] [1 0 -xrand(1/3, 3/4)] 
                ).transcribe(
                    @onset $t
                    @gain (($vel + 1) / 127) ** 0.5
                    @pan xrand() 
                ) 
            );
            $b = xchoose(pno ezsol)(
                @pitch $mc + xrandom(-1, 2) * 1200
                @duration null
                @velocity $vel
                @useseed 1
                @names family('plucked') 
                @types 'ord' 'harm' 
                @gain 0.125
                @norm 0.25
            );
            $boost = gainboost(
                @buffer $b
                @outmin dbtoa(-60) 
                @outmax dbtoa(-12) 
                @rms 1
            );
            $b.process(gain($boost)).transcribe(
                @onset $t
                @pan mc2pan($mc, 0.1) 
                @gain [0 1 0] [1 0 0.7] 
            );
            $t += $incr
        ) 
    ) 
);
PercGap = (
    $onset = 0, $duration = 1000, $chord = null, $velocity = null -> (
        $mcs = randomseq(
            @llll $chord
            @length xrandom(4, 9) 
            @steps -2 -3 3
            @useseed 1
        );
        $mcs = sort(thin($mcs));
        if xrand() > 0.5 then ($mcs = $mcs.rev());
        $onsetvar = xrand().scale(@slope 0.25) * 90;
        for $mc in $mcs do (
            $b = ezsol(
                @pitch $mc
                @names 'sax' 'flute' 'clar' family('strings') 'harp' 
                @types 'pizz' 'keys' 'slap-pitch' 'pizz-secco' 'exp-slap-pitch' 'harm-in-wood' 
                @velocity $velocity ||| xrandom(60, 127) 
                @useseed 1
                @duration $duration * 2
            );
            $boost = gainboost(
                @buffer $b
                @outmin dbtoa(-50) 
                @outmax dbtoa(-12) 
                @rms 1
            );
            $b.process(gain($boost)).transcribe(
                @onset $onset
                @pan mc2pan($mc, 0.5) 
                @gain [0 0.25 0] [1 0 0.7] 
            );
            $onset += $onsetvar
        ) 
    ) 
);
Arpeggi = (
    $onset = 0, $duration = 10000, $chord = null, $velocity = 127, $tempo = 100 -> (
        PianoRoll(
            @onset $onset
            @duration $duration
            @chord $chord
            @vel $velocity * 0.25
        );
        $bardur = 240000 / $tempo;
        $unit = $bardur * xchoose(1/16 1/20 1/12);
        $chord = xscramble($chord).left(xrandom(3, 7));
        $chordsize = length($chord);
        $numnotes = max(3, $duration / $unit);
        $legato = $unit * 0.25;
        $panoffset = xrand(-1, 1);
        $onsets = $onset + arithmser(0, 1, null, $numnotes + 1).scale(
            @outmax $duration @slope xrand(0.05, 0.3) 
        );
        $durs = thin($onsets).x2dx();
        for $onset $i in $onsets, $dur in $durs do (
            $mc = $chord:(
                (($i - 1) % $chordsize) + 1
            );
            $b = ezsol(
                @pitch $mc
                @duration $dur + $legato
                @names (
                    'clar' 'flute' 'sax' 'acc' 
                ) 
                @types 'ord' 'ord-high' 'ord-micro' 
                @velocity $velocity + xrand(-7, 7) 
                @useseed 1
            );
            $boost = gainboost(
                @buffer $b
                @outmin dbtoa(-60) 
                @outmax dbtoa(-12) 
                @slope -0.25
                @rms 1
            );
            $b = $b.process(gain($boost));
            if $mc > 4500 && xrand() > 0.9 then (Freeze(@buffer $b @onset $onset));
            $b.transcribe(
                @onset $onset
                @gain [0 1 0] [1 0 0.5] 
                @pan fold(mc2pan($mc, 0.125) + $panoffset) 
            ) 
        ) 
    ) 
);
Freeze = (
    $buffer, $onset = 0, $duration = null -> (
        $bufdur = $buffer.getkey('duration');
        $duration = $duration ||| ($bufdur * xrand(-1, 1).exp2());
        $readst = $buffer.getkey('offset');
        $readend = $bufdur + $readst;
        $graindur = min($bufdur, xrand(50, 150));
        $readbpf = [0 $readst 0.] [1 max($readst, $readend - $graindur) 0];
        $gainbpf = [0 1 0] [1 0 -xrand(1/10, 3/4)];
        if xrand() > 0.6 then (
            $gainbpf = revbpf($gainbpf);
            if xrand() > 0.5 then ($onset -= $duration) 
        );
        $t = 0;
        $win = hanning();
        while $t < $duration do (
            $nt = $t / $duration;
            $grainoffset = samplebpf($readbpf, $nt);
            $gain = samplebpf($gainbpf, $nt);
            $grain = $buffer.setkey('offset', $grainoffset).setkey('duration', $graindur);
            $grain.transcribe(
                @onset $t + $onset
                @gain $win * $gain
                @pan xrand() 
            );
            $t += $graindur * xrand(0.125, 1/3) 
        ) 
    ) 
);
setseed(507);
$t = 0;
$meta = read('../01_foreground/foreground.txt');
$finalmarker = $meta.'final_marker';
$chord = getkey($finalmarker, 'chord');
$root = $meta.'root';
$pcroot = r2pc(getkey($finalmarker, 'step'), mc2pc($root));
$pcs = r2pc(1 8/7 5/4 21/16 3/2 5/3 15/8, $pcroot);
$modbpf = [0 0 0] [1 1 -0.125];
$chord = for $mc in $chord collect if $mc > 3600 && $mc < 8700 then $mc;
$N = 13;
for $i in 1...$N do (
    $nt = scale($i, 1, $N, 0, 1);
    $mod = samplebpf($modbpf, $nt);
    $dur = scale($i, 1, $N, 3000, 7000, 0.125);
    $tempo = scale($i, 1, $N, 150, 90, 0.125);
    $vel = scale($i, 1, $N, 127, 1, 0.125);
    $mcs = for $mc in $chord collect $mc + pitchdiff($mc, $pcs) * $mod;
    PercGap(
        @onset $t
        @duration $dur
        @chord $mcs
        @velocity $vel
    );
    Arpeggi(
        @onset $t
        @chord $mcs
        @tempo $tempo
        @duration $dur
        @velocity $vel
    );
    $t += $dur
);
$tail = 2000;
render(
    @play 1 @process (
        freeverb(
            @roomsize 0.95
            @wet 0.0125
            @damp 1
            @width 1
            @tail $tail
        ) fade(
            @fadein 0
            @fadeout $tail
            @fadeouttype 2
            @fadeoutcurve 0.5
        ) normalize(-3) 
    ) 
);
ezexport()