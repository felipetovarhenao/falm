$stretch = 8;
importaudio('./01_input/input.wav').transcribe();
$b = ezrender(
    @play 1 @process (
        normalize(-14 @rms 1) 
        ## 
        arctan() 
        ## ---
        trim(
            @threshold 0.01
            @start 0
            @end 1
        ) 
        ## ---
        fade(
            @fadein 0
            @fadeout 500
            @fadeoutcurve 0.125
            @fadeouttype 2
        ) 
        ## ---
        rubberband(
            @stretching $stretch
            @smoothing 1
            @stretchmode 0
        ) 
        ## ---
        normalize(-3) 
    ) 
);
$meta = read('./01_input/input.txt');
$peak = $meta.'peak' * $stretch;
$totdur = $b.getkey('duration');
$midpt = $peak / $totdur;
ezexport(
    ['stretch' $stretch] ['midpt' $midpt] ['peak' $peak] ['totdur' $totdur] 
)