$lattice = (
    ## ——— 2 limit———
    [0] 
    ## ——— 3 limit———
    [-1...3] 
    ## ——— 5 limit———
    [0] 
    ## ——— 7 limit———
    [-1] 
    ## ———11 limit———
    [-1] 
    ## ———13 limit———
    [-1 -2] 
    ## ———17 limit———
    [-1] 
);
$ratios = gentuning($lattice);
$mcroot = r2mc(11/8, d2);
$pcroot = mc2pc($mcroot);
$pcs = r2pc($ratios, $pcroot);
$deviations = for $r in $ratios collect (
    $pc = r2pc($r);
    $dev1 = $pc % 1;
    $dev2 = 1 - $dev1;
    $sign = '+';
    $dev = if abs($dev1) < $dev2 then $dev1 else (
        $sign = '-';
        $dev2
    );
    $sign + tosymbol(
        int(round($dev * 100)) 
    ) + '¢' 
);
write(
    @data ['mcroot' $mcroot] ['pcroot' $pcroot] ['ratios' $ratios] ['pcs' $pcs] ['cent_deviations' $deviations] 
    ## ---
    @path './harmony.txt' 
);
done()