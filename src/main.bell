TimeCode = (
    $ms -> (
        $s = $ms / 1000;
        $m = int(floor($s / 60));
        $s = int(round($s % 60));
        $m = tosymbol($m);
        if symlen($m) == 1 then ($m = '0' + $m);
        $s = tosymbol($s);
        if symlen($s) == 1 then ($s = '0' + $s);
        $m + ':' + $s
    ) 
);
$folders = (
    '01_prelude' 
    ## ---
    '02_serenade' 
    ## ---
    '03_caprice' 
    ## ---
    '04_toccata' 
    ## ---
    '05_chaconne' 
    ## ---
    '06_waltz' 
    ## ---
    '07_reverie' 
    ## ---
    '08_nocturne' 
    ## ---
    '09_rondo' 
    ## ---
    '10_postlude' 
);
$t = 0;
$stats = null;
for $folder $id in $folders do (
    $path = './' + $folder + '/' + 'main' + '.wav';
    $b = importaudio($path);
    $bdur = $b.getkey('duration');
    $stats _= [
        ['name' $folder] ['marker' TimeCode($t)] ['duration' TimeCode($bdur)] 
    ];
    addmarker($t @names $folder);
    $b.transcribe($t);
    $t += $bdur
);
ezrender(
    @play 1 @process normalize(-3) 
);
ezexport(
    ['total_length' TimeCode($t)] ['tracks' $stats] 
);
done()