$objects = (
    FastArpeggio
    ## ---
    CrushedCresc
    ## ---
    Strum
    ## ---
    Rest
    ## ---
    SustainedChord
    ## ---
    HarmGliss
    ## ---
    SynthChord
);
if $objects == null then BP_FN_ERROR(@details 'You need you run script containing gesture/object definitions first.');
$numobjects = 9;
for $seed $seedid in (91 98 8) + 8934 do (
    setseed($seed);
    $objects = xscramble($objects);
    $bardur = 2150.;
    $dur = $bardur * 1/8;
    $t = 0;
    for $i in rev(1...$numobjects) do (
        for $j in rev(1...$i) do (
            setseed($j * 31 + 99 + ($seedid - 1) * 20);
            $obj = $objects:$j;
            $obj(@onset $t @duration $dur);
            $t += $dur
        ) 
    ) 
);
ezrender(
    @play 1 @process normalize(-3) 
);
ezexport($t);
done()