$harmony = read('../../00_harmony/harmony.txt');
$cadence = $harmony.'cadence';
$chord = getkey($cadence:1, 'mcs');
$t = 0;
$pts = arithmser(0, 1, null, 8);
$spanbpf = [0 10000 0] [1 800 -0.125];
$lenbpf = [0 12 0] [1 8 -0.125];
for $x $i in $pts do (
    $span = round(samplebpf($spanbpf, $x));
    $len = round(samplebpf($lenbpf, $x));
    $durs = timeramp(
        @duration $span
        @length $len
        @slope -1/3
    );
    $ctrlbpf = [0 $x 0] [
        1 ($pts:($i + 1) ||| $x) 0.125
    ];
    for $dur $j in $durs do (
        $nnt = scale($j, 1, length($durs), 0, 1);
        $ctrl = samplebpf($ctrlbpf, $nnt);
        for $fn in Swirl Tremolo KeyClicks do (
            setseed($i * 3 + 40);
            $fn(
                @onset $t
                @spectrum $chord
                @ctrl $ctrl * (if $fn == KeyClicks then 0.25 else 1) 
                @duration $dur
            ) 
        );
        $t += $dur
    ) 
);
render(
    @play 1 @process normalize(-3) 
);
ezexport($t)