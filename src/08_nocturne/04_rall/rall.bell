setseed(202);
$harmony = read('../00_harmony/harmony.txt');
$spectrum = left(
    getkey(($harmony.'cadence'):1, 'mcs'), 32
);
$spectrum2 = left(
    getkey(($harmony.'cadence'):2, 'mcs'), 32
);
$t = 0;
$totdur = 7900;
$durs = timeramp(
    @duration $totdur
    @length 7
    @slope 0.18
);
$sineprobbpf = [0 0.01 0] [1 1 0.125];
$sinegainbpf = [0 0.125 0] [1 0.25 0.125];
$bassgainbpf = [0 0.25 0] [1 0.66 0.125];
$numnotesbpf = [0 24 0] [1 length($spectrum) 0.125];
$mixbpf = [0 0 0] [1 1 2/3];
$rollbpf = [0 0 0] [
    1 ($durs:-1) / (length($spectrum) * 1.5) 1/3
];
for $dur in $durs do (
    $nt = $t / $totdur;
    $sineprob = samplebpf($sineprobbpf, $nt);
    $bassgain = samplebpf($bassgainbpf, $nt);
    $numnotes = int(
        round(samplebpf($numnotesbpf, $nt)) 
    );
    $mcs = left($spectrum, $numnotes);
    $bassbuf = Compress(ezsol(
        @pitch $mcs:1
        @duration $dur * 4
        @names 'bass' 
        @types 'pizz' 'pizz-secco' 
        @velocity 127
        @useseed 1
    ));
    $basspan = mc2pan($mc, 0.12) + xrand(-0.05, 0.05);
    $bassbuf.setkey('duration', $dur).process(
        reverse() gain([0 0 0] [1 1 0.33]) 
    ).transcribe(
        @onset $t
        @pan $basspan
        @gain 0.125 * $bassgain
    );
    $bassbuf.transcribe(
        @onset $t
        @pan $basspan
        @gain [0 $bassgain 0] [1 0 -0.35] 
    );
    $shift = 0;
    for $mc in xscramble(right($mcs, 1)) do (
        $onset = $t + $shift;
        $nt = max(0, min(1, $onset / $totdur) );
        $mix = round(samplebpf($mixbpf, $nt));
        $sinegain = samplebpf($sinegainbpf, $nt);
        $mc += pitchdiff($mc, $spectrum2) * $mix;
        $roll = samplebpf($rollbpf, $nt);
        $b = ezsol(
            @pitch $mc
            @duration max(1000, $dur) 
            @velocity 127
            @names 'flute' 'clar' 'sax' family('brass') family('strings') family('plucked') 
            @types 'keys' 'slap-pitch' 'slap-unpitch' 'exp-slap-pitch' 'bartok' 'pizz' 'tongue-ram' 'kiss' 'perc' 'hit-on-body' 'air' 'air-and-ord' 'air-to-ord' 
            @useseed 1
        );
        $instrument = $b.getkey('instrument');
        $slope = -xrand(1/8, 1/2);
        if intersection(
            $instrument.'type', 'air-to-ord' 'air' 
        ) != null then $slope = abs($slope) ** 0.707;
        $b = Compress($b);
        $pan = mc2pan($mc, 0.707);
        $rms = $b.getkey('rms');
        if xrand() < $sineprob then (
            $durmul = scale(
                $mc, minimum($mcs), maximum($mcs), 4, 1, 0.125
            );
            Compress(
                sinewave(
                    @pitch $mc + r2c(xchoose(1/2 1...8)) 
                    @duration $dur * exp2($rms ** 0.707) * $durmul
                    @velocity $rms * 127
                    @envelope [0 0.25 0] [1 0 xchoose(-1 1) * xrand(1/8, 4/5)] 
                    @phase xrand() 
                ) 
            ).transcribe(
                @onset $onset
                @pan $pan xrand() 
                @gain $sinegain
            ) 
        );
        transcribe(
            @buffer $b
            @onset $onset
            @pan $pan
            @gain [0 1 0] [1 0 $slope] 
        );
        $shift -= xrand($roll) 
    );
    $t += $dur
);
$peakdur = $durs:-1;
for $type in 'ord' 'mid' do (
    $perc = perc(
        @pitch b6 
        @type $type
        @duration $peakdur
        @useseed 1
        @velocity 127
    ).process(
        reverse() gain([0 0 0] [1 1 2/3]) 
    );
    $perc = $perc.Compress().analyze(envmaxtime());
    $perc.transcribe(
        @onset $t - $perc.getkey('envmaxtime') @pan [0 0 0] [1 xrand() 2/3] 
    ) 
);
$tail = 500;
ezrender(
    @play 1 @process (
        normalize(3) 
        ## ---
        arctan() 
        ## ---
        reverse() 
        ## ---
        freeverb(
            @roomsize 0.9
            @wet [1 0.025 0] [0 0.02 -0.125] 
            @damp 1
            @width 1
            @damp 1
            @tail 10
        ) 
        ## ---
        fade(0, 10) 
        ## ---
        reverse() 
        ## ---
        freeverb(
            @roomsize 0.85
            @wet [0 0.005 0] [1 0.0125 0.125] 
            @damp 1
            @width 1
            @damp 1
            @tail $tail
        ) 
        ## ---
        fade(
            @fadein 0
            @fadeout $tail
            @fadeouttype 2
            @fadeoutcurve 0.125
        ) 
        ## ---
        normalize(-3) 
    ) 
);
ezexport($totdur);
done()