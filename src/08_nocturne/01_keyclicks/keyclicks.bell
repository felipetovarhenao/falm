$files = [1 'pickup'] [2 'intro'] [3 'break'] [4 'cresc'];
$t = 0;
for $file in $files with @unwrap 1 do (
    $id = $file:1;
    $name = $file:2;
    $basepath = './' + '0' + tosymbol($id) + '_' + $name + '/' + $name;
    $snd = importaudio($basepath + '.wav');
    $txt = read($basepath + '.txt');
    if $id != 3 then (
        $snd = $snd.process(
            normalize(@level -26 @rms 1) arctan() normalize(-3) 
        ) 
    );
    if $name == 'cresc' then (
        importaudio('./05_transient/transient.wav').transcribe($t - read('./05_transient/transient.txt')) 
    );
    $snd.transcribe($t);
    $t += $txt
);
ezrender(
    @play 1 @process normalize(-3) 
);
ezexport($t);
done()