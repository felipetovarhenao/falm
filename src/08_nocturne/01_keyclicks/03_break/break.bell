setseed(60);
$cadence = read('../../00_harmony/harmony.txt').'cadence';
$spectrum = getkey($cadence:1, 'mcs');
$chord = xscramble(for $mc in $spectrum collect if $mc > g4 then $mc).left(5);
$t = 0;
for $mc in $chord do (
    $group = xchoose(
        [[
            'names' 'harp' 'guitar' 
        ] ['types' 'harm']] 
        ## ---
        [[
            'names' 'flute' 'clar' 'sax' 
        ] [
            'types' 'keys' 'pizz' 
        ]] 
    );
    ezsol(
        @pitch $mc
        @names $group.getkey('names') 
        @types $group.getkey('types') 
        @velocity 0
        @duration null
        @useseed 1
    ).transcribe(
        @onset $t @pan xrand() 
    );
    $t += xrand(20) 
);
$t = 0;
$t += Tremolo(
    @onset $t
    @spectrum $spectrum
    @duration 8000
    @ctrl 0
);
$tail = 2000;
ezrender(
    @play 1 @process (
        normalize(0) 
        ## ---
        freeverb(
            @roomsize 0.95
            @wet [0 0.015 0] [1 0.25 0.125] 
            @damp 1
            @width 1
            @tail $tail
        ) 
        ## ---
        fade(
            @fadein 0
            @fadeout $tail
            @fadeoutcurve 0.8
            @fadeouttype 2
        ) 
        ## ---
        normalize(-5) 
    ) 
);
ezexport($t);
done()