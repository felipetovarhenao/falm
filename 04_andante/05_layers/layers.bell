setseed(1);
$mcroot = r2mc(6/5, d2);
$pcroot = mc2pc($mcroot);
$tuning = 1/1 567/512 9/8 147/128 21/16 1323/1024 189/128 3/2 49/32 7/4 441/256 63/32;
$pcs = r2pc($tuning, $pcroot);
$mcs = r2mc(1...32, $mcroot).pcquant($pcs).xscramble();
initurn(
    @size length($mcs) @useseed 1
);
$markers = read('../01_pulse/pulse.txt').'sections';
$climaxst = $markers:2;
$climaxend = $markers:3;
$totdur = ($climaxend - $climaxst);
$t = 0;
$bpm = 112;
$unit = 1/16.;
$beat = (240000/$bpm) * $unit;
while $t < $totdur do (
    $nt = $t / $totdur;
    $id = urn() + 1;
    $mc = $mcs:($id);
    $b = ezsol(
        @pitch $mc
        @names family('brass') family('woodwinds') family('strings') 
        @types 'cresc-to-dim' 'stacc' 'cresc' 
        @duration null
        @velocity 127
        @useseed 1
    ).analyze(effectiveduration(@thresholdratio 0.001));
    $b = $b.setkey('duration', $b.getkey('effectiveduration'));
    $b.transcribe(
        @onset $t @pan mc2pan($mc, 0.25) 
    );
    $t += xrandom(1, 4) * $beat
);
$tail = 2000;
render(
    @play 1 @process (
        freeverb(
            @roomsize 0.9
            @wet 0.05
            @damp 1
            @width 1
        ) fade(
            @fadein 0
            @fadeout $tail
            @fadeouttype 2
        ) normalize(-3) 
    ) 
);
ezexport()