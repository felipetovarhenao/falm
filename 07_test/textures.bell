setseed(450);
$mcroot = f2;
$pcroot = mc2pc($mcroot);
$ratios = 1 9/8 8/7 5/4 21/16 11/8 3/2 5/3 15/8 13/7;
$pcs = r2pc($ratios, $pcroot);
$spectrum = pcquant(r2mc(2...32, $mcroot), $pcs);
$t = 0;
$totdur = 60000;
$names = 'clar' 'sax' 'flute' 'horn' 'tromb';
$types = 'ord' 'sfz' 'flz' 'ord-high' 'ord-micro' 'keys' 'stacc' 'slap-pitch' 'tongue-ram' 'harm' 'air' 'air-to-ord' 'ord-to-air' 'air-and-ord';
$dryenv = [0 0.001 0];
$midpoint = 0.3;
$gapbpf = [0 0 0] [$midpoint 1500 0.25] [1 0 -0.125];
$delthreshbpf = [0 1 0] [$midpoint 0.33 0.25] [1 1 0.125];
while $t < $totdur do (
    $nt = $t / $totdur;
    $gap = samplebpf($gapbpf, $nt) * exp2(xrand(-0.5, 0.5));
    $delthresh = samplebpf($delthreshbpf, $nt);
    $seqlen = xrandom(7, 23);
    $steps = (-1 2 -3 0) * xchoose(-1 1);
    $mcs = randomseq(
        @llll $spectrum
        @length $seqlen
        @steps $steps
        @useseed 1
    );
    $span = xrand(500, 3000);
    $dyads = group($mcs $mcs:-1, 2, 1);
    $durations = timeramp(
        @duration $span
        @length length($mcs) 
        @slope xrand(-1/2, 1/2) 
    );
    for $dyad in $dyads, $dur in $durations with @unwrap 1 do (
        $mc1 = $dyad:1;
        $mc2 = $dyad:2;
        $glidefactor =1/c2r(minabs($mc2 - $mc1, 200));
        $glideslope = xrand(0.6, 0.9);
        $glidebpf = [0 1 0] [1 $glidefactor $glideslope];
        $durmul = integrate($glidebpf):(-1 2);
        $b = ezsol(
            @pitch $mc1
            @duration $dur / $durmul
            @names $names
            @types $types
            @velocity 0
            @useseed 1
        ).process(resample($glidebpf));
        if xrand() > 0.75 then (
            $sine = cycle(
                @frequency $mc1 + r2c(xchoose(1/2 1...8)) 
                @duration $dur
                @phase xrand() 
            ).process(
                gain(
                    [
                        0 $b.getkey('rms') ** xrand(1, 2) 0
                    ] [1 0 -xrand(1/8, 2/3)] 
                ) 
            );
            $b = $b.process(mix($sine)) 
        );
        $boost = gainboost(
            @buffer $b
            @outmin dbtoa(-56) 
            @outmax dbtoa(-12) 
            @slope -0.125
            @rms 1
        );
        $b = $b.process(
            gain([0 $boost 0] [1 0 0.75]) 
        );
        if xrand() > $delthresh then (
            $b.transcribe(
                @onset $t @pan mc2pan($mc1, 0.25) 
            ) 
        ) else (
            $deldur = $dur * exp2(xrand(4));
            $dels = timeramp(
                @duration $deldur
                @length xrandom(4, 22) 
                @slope xrand(-1/3, 1/3) 
            );
            $d = 0;
            $delgainbpf = [0 1 0] [1 0.001 -xrand(1/9, 3/4)];
            $deloffset = 0;
            if xrand() > 0.5 then (
                $delgainbpf = revbpf($delgainbpf);
                $deloffset -= $deldur
            );
            $detunings = $spectrum - $mc1;
            $detunings = $detunings:[
                left(
                    argsort(abs($detunings)), xrandom(1, 5) 
                ) 
            ];
            $detunings = thin($detunings (-1...1) * 1200);
            for $del in $dels do (
                $dt = $d / $deldur;
                $gain = samplebpf($delgainbpf, $dt);
                $b.setkey('duration', $del).transcribe(
                    @onset $t + $d + $deloffset
                    @gain $gain
                    @pan xrand() 
                    @detune xchoose($detunings) 
                    @keepduration 0
                );
                $d += $del
            ) 
        );
        $t += $dur
    );
    $t += $gap;
    $dryenv _= [
        $t scale(xrand(), 0, 1, 0.01, 1, -0.125) xrand(-0.125, 0.125) 
    ] 
);
$b = render(
    @reset 1 @process normalize(-3) 
);
$b.process(gain($dryenv) freeverb(
    @roomsize 0.98
    @wet 0.02
    @dry 0
    @damp 1
    @width 1
)).transcribe();
$b.transcribe();
render(
    @play 1 @process normalize(-3) 
);
ezexport()