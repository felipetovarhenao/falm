setseed(10);
$mcroot = bb1;
$pcroot = mc2pc($mcroot);
$ratios = 1 9/8 8/7 5/4 21/16 11/8 3/2 5/3 15/8 13/7;
$pcs = r2pc($ratios, $pcroot);
$spectrum = pcquant(r2mc(2...32, $mcroot), $pcs);
$t = 0;
$totdur = 60000;
$names = 'clar' 'sax' 'flute' 'horn' 'tromb';
$types = 'ord' 'sfz' 'flz' 'ord-high' 'ord-micro' 'keys' 'stacc' 'slap-pitch' 'tongue-ram' 'harm' 'air' 'air-to-ord' 'ord-to-air' 'air-and-ord';
$dryenv = [0 0.001 0];
$midpoint = 0;
$gapbpf = [$midpoint 1500 -0.125] [1 0 -0.125];
$delthreshbpf = [$midpoint 0.125 0.25] [1 1 0.125];
$velbpf = [$midpoint 0 0.25] [1 127 0.125];
$maxrms = dbtoa(-14);
$minrms = dbtoa(-45);
while $t < $totdur do (
    $nt = $t / $totdur;
    $gap = samplebpf($gapbpf, $nt) * exp2(xrand(-0.5, 0.5));
    $delthresh = samplebpf($delthreshbpf, $nt);
    $vel = samplebpf($velbpf, $nt);
    $span = xrand(500, 4000);
    $maxlen = round(max(2, $span / 90));
    $minlen = round(max(2, $maxlen / 4.));
    $seqlen = xrandom($minlen, $maxlen);
    $steps = (-1 2 -3 0) * xchoose(-1 1);
    $mcs = randomseq(
        @llll $spectrum
        @length $seqlen
        @steps $steps
        @useseed 1
    );
    $dyads = group($mcs $mcs:-1, 2, 1);
    $durations = timeramp(
        @duration $span
        @length length($mcs) 
        @slope xrand(-1/2, 1/2) 
    );
    for $dyad in $dyads, $dur in $durations with @unwrap 1 do (
        $mc1 = $dyad:1;
        $mc2 = $dyad:2;
        $glidefactor = 1 / c2r(minabs($mc2 - $mc1, 200));
        $glideslope = xrand(1/2, 0.9);
        $glidebpf = [0 1 0] [1 $glidefactor $glideslope];
        $durmul = integrate($glidebpf):(-1 2);
        $b = ezsol(
            @pitch $mc1
            @duration $dur / $durmul
            @names $names
            @types $types
            @velocity $vel
            @useseed 1
        ).process(resample($glidebpf) dcfilter());
        if $b.getkey('rms') > dbtoa(-23) then (
            $bass = ezsol(
                @pitch xchoose($spectrum:1 - 1200 left($spectrum, 5)) 
                @duration $dur
                @velocity 127
                @names 'bass' 'acc' 'tuba' 'bassoon' 
                @types 'pizz' 'stacc' 'pizz-secco' 'bartok' 'back' 'sfz' 
                @useseed 1
            );
            $boost = gainboost(
                @buffer $bass
                @outmin $minrms
                @outmax $maxrms
                @slope -0.125
                @rms 1
            );
            $bass.process(gain($boost)).transcribe(
                @onset $t
                @pan xrand() 
                @gain [0 1 0] [1 0 -xrand(1/8, 2/3)] 
            ) 
        );
        if xrand() > 0.75 then (
            $sine = cycle(
                @frequency $mc1 + r2c(xchoose(1/2 1...8)) 
                @duration $dur
                @phase xrand() 
            ).process(
                gain(
                    [
                        0 $b.getkey('rms') ** xrand(1, 2) 0
                    ] [1 0 -xrand(1/8, 2/3)] 
                ) 
            );
            $b = $b.process(mix($sine)) 
        );
        $boost = gainboost(
            @buffer $b
            @outmin $minrms
            @outmax $maxrms
            @slope -0.125
            @rms 1
        );
        $b = $b.process(
            gain([0 $boost 0] [1 0 0.75]) 
        );
        if xrand() < $delthresh then (
            $deldur = $dur * exp2(xrand(4));
            $maxdels = max(2, round($deldur / 90));
            $mindels = max(2, round($maxdels / 3.));
            $dels = timeramp(
                @duration $deldur
                @length xrandom($mindels, $maxdels) 
                @slope xrand(-1/3, 1/3) 
            );
            $d = 0;
            $delgainbpf = [0 1 0] [1 0.001 -xrand(1/9, 3/4)];
            $deloffset = 0;
            if xrand() > 0.5 then (
                $delgainbpf = revbpf($delgainbpf);
                $deloffset -= $deldur
            );
            $detunings = $spectrum - $mc1;
            $detunings = $detunings:[
                left(
                    argsort(abs($detunings)), xrandom(1, 5) 
                ) 
            ];
            $detunings = thin($detunings (-1...1) * 1200);
            $legato = exp2(xrand());
            for $del in $dels do (
                $dt = $d / $deldur;
                $gain = samplebpf($delgainbpf, $dt);
                $delenvslope = xrand(1/8, 3/4);
                $delenv = xchoose(
                    [[0 $gain 0] [1 0 -$delenvslope]] [[0 0 0] [1 $gain $delenvslope]] [hanning()] [$gain] 
                )::1;
                $onset = $t + $d + $deloffset;
                $pan = xrand();
                $det = xchoose($detunings);
                if $onset >= 0 then (
                    $b.setkey('duration', $del * $legato).transcribe(
                        @onset $onset
                        @gain $delenv
                        @pan $pan
                        @detune $det
                        @keepduration 0
                    ) 
                );
                $d += $del
            ) 
        ) else (
            $b.transcribe(
                @onset $t @pan mc2pan($mc1, 0.25) 
            ) 
        );
        $t += $dur
    );
    $t += $gap;
    $dryenv _= [
        $t scale(xrand(), 0, 1, 0.01, 1, -0.125) xrand(-0.125, 0.125) 
    ] 
);
$b = render(
    @reset 1 @process normalize(-3) 
);
$b.process(gain($dryenv) freeverb(
    @roomsize 0.98
    @wet 0.02
    @dry 0
    @damp 1
    @tail 4000
    @width 1
)).transcribe();
$b.transcribe();
render(
    @play 1 @process normalize(-3) 
);
ezexport()