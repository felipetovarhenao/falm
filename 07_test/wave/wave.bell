Compress = (
    $b -> (
        $g = gainboost(
            @buffer $b
            @outmin dbtoa(-60) 
            @outmax dbtoa(-14) 
            @rms 1
        );
        $b.process(gain($g)) 
    ) 
);
$mcroot = b1;
$progression = for $pc in r2pc(1 21/16 7/8 7/6 5/4 8/7 3/4 1, mc2pc($mcroot)) collect (
    for $i in 1 2 collect (
        $n7 = (13/7 7/4):$i;
        $n4 = ([11/8 7/5] [21/16 4/3])::$i;
        [
            ['pc' $pc] ['ratios' 1 9/8 8/7 5/4 $n4 3/2 5/3 $n7] 
        ] 
    ) 
);
setseed(2);
$t = 0;
$order = xscramble(1...12);
$reps = 2;
$period = 1400;
$rangesplit = 3;
for $harmony in $progression do (
    $ratios = $harmony.getkey('ratios');
    $pcroot = $harmony.getkey('pc');
    $pcs = r2pc($ratios, $pcroot);
    $spectrum = pcquant(r2mc(1...16, $mcroot), $pcs);
    $arp = right($spectrum, $rangesplit - 1):[$order];
    $durs = timeramp(
        @duration $period
        @length length($arp) 
        @slope xrand(-1/3, 1/3) 
    );
    for $rep in 1...$reps do (
        $mc = xchoose(left($spectrum, $rangesplit));
        ezsol(
            @pitch $mc
            @duration $period
            @velocity 50
            @useseed 1
            @names family('strings') 
            @types 'pizz' 'pizz-secco' 
        ).Compress().transcribe(
            @onset $t
            @pan mc2pan($mc, 0.125) 
            @gain [0 0.25 0] [1 0 0.5] 
        );
        for $mc in $arp , $dur in $durs do (
            $pan = fold(0.9 + mc2pan($mc, 0.15));
            if xrand() > 0.8 then (
                ezsol(
                    @pitch $mc + xrandom(0, 2) * 1200
                    @names family('strings') 
                    @types 'pizz' 'pizz-secco' 'legno-batt' 
                    @velocity 0
                    @duration $dur * 4
                ).Compress().transcribe(
                    @onset $t
                    @pan xrand() 
                    @gain [0 0.25 0] [1 0 0.5] 
                ) 
            );
            ezsol(
                @pitch $mc
                @names 'flute' 'clar' 'sax' 
                @types 'keys' 
                @useseed 1
            ).Compress().transcribe(
                @onset $t
                @pan $pan
                @gain 0.5
            );
            if xrand() > 0.5 then (
                $V = xrandom(1, 4);
                $vg = 2 ** (1 - $V);
                $oct = xrandom(-1, 4) * 1200;
                for $v in 1...$V do (
                    sinewave(
                        @pitch $mc + $oct + xrand(-2, 2) 
                        @duration $dur * exp2(xrand(1.25, 4)) 
                        @velocity xrandom(5, 15) 
                        @envelope [0 1 0] [0.05 0.05 -0.125] [1 0 -xrand(1/4, 4/5)] 
                    ).transcribe(
                        @onset $t
                        @pan xrand() 
                        @gain 0.05 * $vg
                    ) 
                ) 
            );
            ezsol(
                @pitch $mc
                @names 'flute' 'clar' 
                @types 'flz' 'air' 
                @velocity 0
                @duration $dur * 9
                @useseed 1
            ).Compress().transcribe(
                @onset $t
                @gain [0 1 0] [0.05 0.125 -0.25] [1 0 -0.125] 
                @pan fold($pan - 0.5) 
            );
            $t += $dur
        ) 
    ) 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.9
        @wet 0.001
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport($t)