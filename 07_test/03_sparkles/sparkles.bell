setseed(13);
$harmony = read('../00_harmony/harmony.txt');
$cadence = $harmony.'cadence';
$mcs = getkey($cadence:2, 'mcs');
$t = 0;
for $mc in xscramble($mcs) do (
    Compress(ezsol(
        @pitch $mc
        @names 'sax' 'flute' 'clar' 
        @types 'keys' 
        @useseed 1
        @velocity 127
        @duration 500
    )).transcribe(
        @onset $t
        @pan xrand() 
        @gain [0 1 0] [1 0 0.25] 
    );
    $t += xrand(20) 
);
for $type in 'bartok' 'pizz' do (
    Compress(bass(
        @pitch $mcs:1
        @duration null
        @type $type
        @velocity 127
        @useseed 1
    )).transcribe(@pan xrand() * 0.1 + 0.5) 
);
$mcs = right($mcs, 4);
$totdur = 15000;
$t = 0;
$incrbpf = [0 20 0] [1 1000 0.125];
$gainbpf = [0 0.125 0] [1 0 -0.25];
$velbpf = [0 127 0] [1 0 -0.25];
while $t < $totdur do (
    $nt = $t / $totdur;
    $incr = samplebpf($incrbpf, $nt);
    $gain = samplebpf($gainbpf, $nt);
    $vel = samplebpf($velbpf, $nt);
    $mc = xchoose($mcs);
    $b = Compress(
        cycle(
            @frequency $mc.mc2f() * xrandom(1, 8) 
            @duration xrand().scale(0, 1, 500, 3000, 0.5) 
            @phase xrand() 
        ) 
    );
    $onset = $t + xrand(-0.5, 0.5) * $incr;
    ezsol(
        @pitch $mc
        @duration 500
        @names 'flute' 'sax' 'clar' 
        @types 'keys' 'pizz' 
        @useseed 1
        @velocity $vel
    ).transcribe(
        @onset $onset @pan xrand() 
    );
    $pan = xrand();
    $V = xrandom(1, 5);
    $gain *= 1.25 ** (1 - $V);
    for $i in 1...$V do (
        $b.transcribe(
            @onset $onset
            @pan $pan xrand() 
            @detune if $i > 1 then xrand(-2, 2) 
            @keepduration 0
            @gain [
                0 $gain * exp2(xrand(-1, 0)) 0
            ] [1 0 -xrand(0.125, 0.75)] 
        ) 
    );
    $t += $incr
);
render(
    @play 1 @process freeverb(
        @roomsize 0.98
        @wet 0.025
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport($totdur)