setseed(23);
$mcroot = b1;
$pcroot = mc2pc($mcroot);
$t = 0;
$dryenv = [0 0 0];
$harmony = read('../00_harmony/harmony.txt');
$cadence = $harmony.'cadence';
$base = getkey($cadence:2, 'mcs');
for $i in 1...16 do (
    $mcs = randomseq(
        @llll $base
        @length xrandom(12, 23) 
        @steps (-1 2 -3 0) * xchoose(-1 1) 
        @useseed 1
    );
    $span = xrand(1000, 5000);
    $timesteps = timeramp(
        @duration $span
        @length length($mcs) 
        @slope xrand(-1/3, 1/3) 
    );
    for $dyad in group($mcs $mcs:-1, 2, 1), $dur in $timesteps with @unwrap 1 do (
        $mc = $dyad:1;
        $mc2 = $dyad:2;
        $gliss = [0 1 0] [
            1 1/c2r(minabs($mc2-$mc, 100)) xrand(0.75, 0.9) 
        ];
        $durmul = integrate($gliss):(-1 2);
        $b = ezsol(
            @pitch $mc
            @duration $dur / $durmul
            @names 'clar' 'sax' 'flute' 'viola' 
            @types 'ord' 'sfz' 'flz' 'ord-high' 'ord-micro' 'keys' 'stacc' 'slap-pitch' 'pizz' 'tongue-ram' 'harm' 'air' 'air-to-ord' 'ord-to-air' 'air-and-ord' 'trem' 'harm-trem' 'nonvib' 
            @velocity 0
            @useseed 1
        ).process(resample($gliss));
        if xrand() > 0.7 then (
            $sine = cycle(
                @frequency $mc + r2c(xrandom(1, 8)) @duration $dur
            ).process(
                gain(
                    [
                        0 $b.getkey('rms') ** xrand(1, 2) 0
                    ] [1 0 -0.125] 
                ) 
            );
            $b = $b.process(mix($sine)) 
        );
        $boost = $b.gainboost(
            @outmin dbtoa(-50) 
            @slope -0.125
            @rms 1
        );
        $b = $b.process(
            gain([0 $boost 0] [1 0 0.75]) 
        );
        if xrand() > 1/4 then (
            $b.transcribe(
                @onset $t @pan mc2pan($mc, 0.25) 
            ) 
        ) else (
            $deldur = $dur * exp2(xrand(4));
            $dels = timeramp(
                @duration $deldur
                @length xrandom(4, 22) 
                @slope xrand(-1/3, 1/3) 
            );
            $d = 0;
            $env = [0 1 0] [1 0.001 -xrand(1/9, 3/4)];
            if xrand() > 0.5 then ($env = revbpf($env) );
            for $del in $dels do (
                $nt = $d / $deldur;
                $gain = samplebpf($env, $nt);
                $b.setkey('duration', $del).transcribe(
                    @onset $t + $d
                    @gain $gain
                    @pan xrand() 
                    @detune xrandom(-1, 1) * 1200
                    @keepduration 0
                );
                $d += $del
            ) 
        );
        $t += $dur
    );
    $t += xrandom(1000);
    $dryenv _= [
        $t xrand().scale(0, 1, 0.01, 1, -0.125) xrand(-0.125, 0.125) 
    ] 
);
$b = render(
    @reset 1 @process normalize(-3) 
);
$tail = 4000;
$b.process(
    gain($dryenv) freeverb(
        @roomsize 0.98
        @wet [0 0.015 0] [1 0.05 0.25] 
        @dry 0
        @damp 1
        @width 1
        @tail $tail
    ) 
).transcribe();
$b.transcribe(
    @gain [0 1 0] [1 0.125 0.75] 
);
render(
    @play 1 @process normalize(-3) fade(0, $tail) 
);
ezexport($t)