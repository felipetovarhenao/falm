```
)#
KeyClicks = (
    $onset = 0, $spectrum = r2mc(4...16, c1), $duration = 1500, $reps = 2, $rangesplit = 3 -> (
        init $order = xscramble(
            1...(length($spectrum) * 4) 
        );
        keep $order;
        $onset;
        $arp = right($spectrum, $rangesplit):[$order];
        for $rep in 1...$reps do (
            $durs = timeramp(
                @duration $duration
                @length length($arp) 
                @slope xrand(-1/3, 1/3) 
            );
            $mc = xchoose(left($spectrum, $rangesplit));
            ezsol(
                @pitch $mc
                @duration $duration
                @velocity 50
                @useseed 1
                @names family('strings') 
                @types 'pizz' 'pizz-secco' 
            ).Compress().transcribe(
                @onset $onset
                @pan mc2pan($mc, 0.125) 
                @gain [0 0.25 0] [1 0 0.5] 
            );
            for $mc in $arp , $dur in $durs do (
                $pan = fold(0.9 + mc2pan($mc, 0.15));
                if xrand() > 0.8 then (
                    ezsol(
                        @pitch $mc + xrandom(0, 2) * 1200
                        @names family('strings') 
                        @types 'pizz' 'pizz-secco' 'legno-batt' 
                        @velocity 0
                        @duration $dur * 4
                        @useseed 1
                    ).Compress().transcribe(
                        @onset $onset
                        @pan xrand() 
                        @gain [0 0.25 0] [1 0 0.5] 
                    ) 
                );
                ezsol(
                    @pitch $mc
                    @names 'flute' 'clar' 'sax' 
                    @types 'keys' 
                    @duration max(250, $dur) 
                    @useseed 1
                ).Compress().transcribe(
                    @onset $onset
                    @pan $pan
                    @gain [0 0.5 0] [1 0 0.5] 
                );
                if xrand() > 0.5 then (
                    $V = xrandom(1, 4);
                    $vg = 2 ** (1 - $V);
                    $oct = xrandom(-1, 4) * 1200;
                    for $v in 1...$V do (
                        sinewave(
                            @pitch $mc + $oct + xrand(-2, 2) 
                            @duration $dur * exp2(xrand(1.25, 4)) 
                            @velocity xrandom(5, 15) 
                            @envelope [0 1 0] [0.05 0.05 -0.125] [1 0 -xrand(1/4, 4/5)] 
                        ).transcribe(
                            @onset $onset
                            @pan xrand() 
                            @gain 0.05 * $vg
                        ) 
                    ) 
                );
                ezsol(
                    @pitch $mc
                    @names 'flute' 'clar' 
                    @types 'flz' 'air' 
                    @velocity 0
                    @duration $dur * 9
                    @useseed 1
                ).Compress().transcribe(
                    @onset $onset
                    @gain [0 1 0] [0.05 0.125 -0.25] [1 0 -0.125] 
                    @pan fold($pan - 0.5) 
                );
                $onset += $dur
            ) 
        );
        $duration * $reps
    ) 
);
$mcroot = b1;
$base = r2mc(1...16, $mcroot);
$progression = for $pc in r2pc(1 21/16 7/8 7/6 5/4 8/7 3/4 1, mc2pc($mcroot)) collect (
    for $i in 1 2 collect (
        $n7 = (13/7 7/4):$i;
        $n4 = ([11/8 7/5] [21/16 4/3])::$i;
        [
            pcquant($base, r2pc(1 9/8 8/7 5/4 $n4 3/2 5/3 $n7, $pc)) 
        ] 
    ) 
);
Arpeggio = (
    $onset = 0, $spectrum = null, $duration = 1000 -> (
        $mcs = sort(
            $spectrum:[
                left(
                    argsort(abs($spectrum - c7)), 12
                ) 
            ] 
        );
        $durs = timeramp(
            @duration $duration
            @length length($mcs) 
            @slope xrand(-1/3, 1/3) 
        );
        $t = 0;
        for $mc in $mcs, $dur in $durs do (
            $pan = mc2pan($mc, .2);
            $b = ezsol(
                @pitch $mc
                @duration $dur
                @names 'flute' 'clar' 
                @types 'ord' 'ord-high' 'ord-micro' 
                @velocity 0
            ).process(
                gain(
                    [0 1 0] [1 0 -xrand(1/4, 4/5)] 
                ) 
            ).Compress();
            sinewave(
                @pitch $mc + 2400
                @duration max(5, $dur * 0.125) 
                @velocity xrandom(2, 10) 
            ).transcribe(
                @onset $onset + $t
                @pan 1 - $pan
                @gain 0.125
            );
            $b.transcribe(
                @onset $onset + $t @pan $pan
            );
            $t += $dur
        );
        $duration
    ) 
);
$t = 0;
$objects = Arpeggio KeyClicks Tremolo Beats;
for $chord $chordid in $progression.left(3) with @unwrap 1 do (
    $fns = rot($objects, 1 - $chordid);
    for $fn in $fns do $t += $fn(
        @onset $t
        @spectrum $chord
        @rangesplit 4
        @subdivs xrandom(3, 20) 
        @duration 2000
    ) 
);
render(
    @play 1 @process normalize(-3) 
);
ezexport()