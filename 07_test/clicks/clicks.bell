setseed(1);
Compress = (
    $buffer -> (
        $g = gainboost(
            @buffer $buffer
            @outmin dbtoa(-60) 
            @outmax dbtoa(-14) 
            @rms 1
        );
        process($buffer, gain($g)) 
    ) 
);
Beats = (
    $onset = 0, $spectrum, $duration = 2000, $subdivs = 12 -> (
        $spectrum = xscramble($spectrum).left(4);
        $pan = xrand() - 0.5;
        for $dur in timeramp(
            @duration $duration
            @length $subdivs
            @slope xrand(-0.2, 0.2) 
        ) 0 do (
            for $mc in $spectrum do (
                $b = ezsol(
                    @pitch $mc
                    @duration $duration
                    @velocity 0
                    @names family('brass') 'sax' 
                    @types 'slap-pitch' 'slap-unpitch' 'perc-emb' 'keys' 'kiss' 
                    @useseed 1
                ).Compress().process(gain(0.125));
                $b.transcribe(
                    @onset $onset
                    @gain [0 1 0] [0.1 xrand(0.1, 0.5) -0.125] [1 0 0.5] 
                    @pan fold($pan + mc2pan($mc, 0.25)) 
                ) 
            );
            $onset += $dur
        );
        $duration
    ) 
);
Tremolo = (
    $onset = 0, $spectrum, $duration = 1000 -> (
        $spectrum = sort($spectrum).right(-4);
        for $mc in xscramble($spectrum) do (
            $slope = xrand(1/8, 6/7) * xchoose(-1 1);
            $envmin = xrand(0.125) ** 2;
            $gain = 0.5;
            $env = xchoose(
                [[0 $envmin 0] [1 $gain $slope]] [[0 $gain 0] [1 $envmin -$slope]] [
                    [0 0 0] [xrand(0.1, 0.9) $gain $slope] [1 0 -$slope] 
                ] [$gain] 
            )::1;
            $b = ezsol(
                @pitch $mc
                @names 'flute' 'clar' 'sax' 
                @duration $duration
                @types 'ord' 'air' 
                @velocity 0
                @useseed 1
            ).Compress();
            if xrand() > 0.5 then (
                $trem = (
                    xchoose(saw tri cycle rect)(
                        @frequency [0 xrand(12) 0] [1 xrand(12) xrand(-1/3, 1/3)] @duration $b.getkey('duration') 
                    ) 
                ).process(scaling(-1, 1, $envmin, 1) rampsmooth(16, 16));
                $b = $b.process(multiply($trem)) 
            );
            $b.transcribe(
                @onset $onset
                @gain $env
                @pan mc2pan($mc, 0.3) 
            ) 
        );
        $duration
    ) 
);
