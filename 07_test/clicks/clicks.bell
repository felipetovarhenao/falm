setseed(4);
Compress = (
    $buffer -> (
        $g = gainboost(
            @buffer $buffer
            @outmin dbtoa(-60) 
            @outmax dbtoa(-14) 
            @rms 1
        );
        process($buffer, gain($g)) 
    ) 
);
KeyClicks = (
    $onset = 0, $spectrum = r2mc(4...16, c1), $duration = 1500, $reps = 2, $rangesplit = 3 -> (
        init $order = xscramble(
            1...(length($spectrum) * 4) 
        );
        keep $order;
        $onset;
        $period = $duration;
        $arp = right($spectrum, $rangesplit):[$order];
        for $rep in 1...$reps do (
            $durs = timeramp(
                @duration $period
                @length length($arp) 
                @slope xrand(-1/3, 1/3) 
            );
            $mc = xchoose(left($spectrum, $rangesplit));
            ezsol(
                @pitch $mc
                @duration $period
                @velocity 50
                @useseed 1
                @names family('strings') 
                @types 'pizz' 'pizz-secco' 
            ).Compress().transcribe(
                @onset $onset
                @pan mc2pan($mc, 0.125) 
                @gain [0 0.25 0] [1 0 0.5] 
            );
            for $mc in $arp , $dur in $durs do (
                $pan = fold(0.9 + mc2pan($mc, 0.15));
                if xrand() > 0.8 then (
                    ezsol(
                        @pitch $mc + xrandom(0, 2) * 1200
                        @names family('strings') 
                        @types 'pizz' 'pizz-secco' 'legno-batt' 
                        @velocity 0
                        @duration $dur * 4
                        @useseed 1
                    ).Compress().transcribe(
                        @onset $onset
                        @pan xrand() 
                        @gain [0 0.25 0] [1 0 0.5] 
                    ) 
                );
                ezsol(
                    @pitch $mc
                    @names 'flute' 'clar' 'sax' 
                    @types 'keys' 
                    @duration $period
                    @useseed 1
                ).Compress().transcribe(
                    @onset $onset
                    @pan $pan
                    @gain 0.5
                );
                if xrand() > 0.5 then (
                    $V = xrandom(1, 4);
                    $vg = 2 ** (1 - $V);
                    $oct = xrandom(-1, 4) * 1200;
                    for $v in 1...$V do (
                        sinewave(
                            @pitch $mc + $oct + xrand(-2, 2) 
                            @duration $dur * exp2(xrand(1.25, 4)) 
                            @velocity xrandom(5, 15) 
                            @envelope [0 1 0] [0.05 0.05 -0.125] [1 0 -xrand(1/4, 4/5)] 
                        ).transcribe(
                            @onset $onset
                            @pan xrand() 
                            @gain 0.05 * $vg
                        ) 
                    ) 
                );
                ezsol(
                    @pitch $mc
                    @names 'flute' 'clar' 
                    @types 'flz' 'air' 
                    @velocity 0
                    @duration $dur * 9
                    @useseed 1
                ).Compress().transcribe(
                    @onset $onset
                    @gain [0 1 0] [0.05 0.125 -0.25] [1 0 -0.125] 
                    @pan fold($pan - 0.5) 
                );
                $onset += $dur
            ) 
        );
        $period * $reps
    ) 
);
$t = 0;
for $mc in r2mc(1 1 1, c2) do (
    $mcs = r2mc(4...16, $mc);
    $t += KeyClicks(
        @onset $t
        @spectrum $mcs
        @duration 1000
        @reps 4
    ) 
);
render(
    @play 1 @process normalize(-3) 
);
ezexport()