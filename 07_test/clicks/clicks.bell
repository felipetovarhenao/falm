setseed(7);
#(
```bell
Compress(
    @buffer null
) -> llll
```

Scales the gain of a buffer based on its RMS.
)#
Compress = (
    $buffer -> (
        $g = gainboost(
            @buffer $buffer
            @outmin dbtoa(-60) 
            @outmax dbtoa(-14) 
            @rms 1
        );
        process($buffer, gain($g)) 
    ) 
);
#(
```bell
Beats(
    @onset 0
    @spectrum null
    @duration 2000
    @subdivs 12
) -> float/int
```
)#
Beats = (
    $onset = 0, $spectrum, $duration = 2000, $ctrl = 0 -> (
        $maxsubdivs = max(
            2, int(round($duration / 120)) 
        );
        $slope = 0.125;
        $subdivsbpf = [0 4 0] [1 $maxsubdivs $slope];
        $subdivs = int(
            round(
                min(
                    max(
                        2, samplebpf($subdivsbpf, $ctrl) + xrand(-1, 1) * 2.5
                    ), $maxsubdivs
                ) 
            ) 
        );
        $maxnotes = 10;
        $numnotesbpf = [0 4 0] [1 $maxnotes $slope];
        $numnotes = int(
            round(samplebpf($numnotesbpf, $ctrl)) 
        );
        $velbpf = [0 0 0] [1 127 $slope];
        $vel = samplebpf($velbpf, $ctrl);
        $gainbpf = [0 0.25 0] [1 1 $slope];
        $gain = samplebpf($gainbpf, $ctrl);
        $addrs = left(
            argsort(abs($spectrum - c5)), $maxnotes
        );
        $spectrum = left(
            xscramble($spectrum:[$addrs]), $numnotes
        );
        $pan = xrand() - 0.5;
        for $dur in timeramp(
            @duration $duration
            @length $subdivs
            @slope xrand(-1/4, 1/4) 
        ) 0 do (
            for $mc in $spectrum do (
                $b = process(
                    @buffer Compress(
                        ezsol(
                            @pitch $mc
                            @duration $duration
                            @velocity $vel
                            @names family('brass') 'sax' 
                            @types 'slap-pitch' 'slap-unpitch' 'perc-emb' 'keys' 
                            @useseed 1
                        ) 
                    ) @operations gain($gain) 
                );
                $b.transcribe(
                    @onset $onset
                    @gain [0 1 0] [0.1 xrand(0.1, 0.5) -0.125] [1 0 0.5] 
                    @pan fold($pan + mc2pan($mc, 0.25)) 
                ) 
            );
            $onset += $dur
        );
        $duration
    ) 
);
#(
```bell
Tremolo(
    @onset 0
    @spectrum null
    @duration 1000
) -> float/int
```
)#
Tremolo = (
    $onset = 0, $spectrum, $duration = 1000 -> (
        $spectrum = sort($spectrum).right(-4);
        for $mc in xscramble($spectrum) do (
            $slope = xrand(1/8, 6/7) * xchoose(-1 1);
            $envmin = xrand(0.125) ** 2;
            $gain = 0.5;
            $env = xchoose(
                [[0 $envmin 0] [1 $gain $slope]] [[0 $gain 0] [1 $envmin -$slope]] [
                    [0 0 0] [xrand(0.1, 0.9) $gain $slope] [1 0 -$slope] 
                ] [$gain] 
            )::1;
            $b = ezsol(
                @pitch $mc
                @names 'flute' 'clar' 'sax' 
                @duration $duration
                @types 'ord' 'air' 
                @velocity 0
                @useseed 1
            ).Compress();
            if xrand() > 0.5 then (
                $phase = xchoose(-1 1);
                $trem = (
                    xchoose(saw tri cycle rect)(
                        @frequency [0 xrand(12) * $phase 0] [1 xrand(12) * $phase xrand(-1/3, 1/3)] @duration $b.getkey('duration') 
                    ) 
                ).process(scaling(-1, 1, $envmin, 1) rampsmooth(16, 16));
                $b = $b.process(multiply($trem)) 
            );
            $b.transcribe(
                @onset $onset
                @gain $env
                @pan mc2pan($mc, 0.3) 
            ) 
        );
        $duration
    ) 
);
#(
```bell
KeyClicks(
    @onset 0
    @spectrum r2mc(1...32, c1)
    @duration 1500
    @reps 2
    @rangesplit 3
) -> float/int
```
)#
KeyClicks = (
    $onset = 0, $spectrum = r2mc(4...16, c1), $duration = 1500, $reps = 2, $rangesplit = 3 -> (
        init $order = xscramble(
            1...(length($spectrum) * 4) 
        );
        keep $order;
        $onset;
        $arp = right($spectrum, $rangesplit):[$order];
        for $rep in 1...$reps do (
            $durs = timeramp(
                @duration $duration
                @length length($arp) 
                @slope xrand(-1/3, 1/3) 
            );
            $mc = xchoose(left($spectrum, $rangesplit));
            ezsol(
                @pitch $mc
                @duration $duration
                @velocity 50
                @useseed 1
                @names family('strings') 
                @types 'pizz' 'pizz-secco' 
            ).Compress().transcribe(
                @onset $onset
                @pan mc2pan($mc, 0.125) 
                @gain [0 0.25 0] [1 0 0.5] 
            );
            for $mc in $arp , $dur in $durs do (
                $pan = fold(0.9 + mc2pan($mc, 0.15));
                if xrand() > 0.8 then (
                    ezsol(
                        @pitch $mc + xrandom(0, 2) * 1200
                        @names family('strings') 
                        @types 'pizz' 'pizz-secco' 'legno-batt' 
                        @velocity 0
                        @duration $dur * 4
                        @useseed 1
                    ).Compress().transcribe(
                        @onset $onset
                        @pan xrand() 
                        @gain [0 0.25 0] [1 0 0.5] 
                    ) 
                );
                ezsol(
                    @pitch $mc
                    @names 'flute' 'clar' 'sax' 
                    @types 'keys' 
                    @duration max(250, $dur) 
                    @useseed 1
                ).Compress().transcribe(
                    @onset $onset
                    @pan $pan
                    @gain [0 0.5 0] [1 0 0.5] 
                );
                if xrand() > 0.5 then (
                    $V = xrandom(1, 4);
                    $vg = 2 ** (1 - $V);
                    $oct = xrandom(-1, 4) * 1200;
                    for $v in 1...$V do (
                        sinewave(
                            @pitch $mc + $oct + xrand(-2, 2) 
                            @duration $dur * exp2(xrand(1.25, 4)) 
                            @velocity xrandom(5, 15) 
                            @envelope [0 1 0] [0.05 0.05 -0.125] [1 0 -xrand(1/4, 4/5)] 
                        ).transcribe(
                            @onset $onset
                            @pan xrand() 
                            @gain 0.05 * $vg
                        ) 
                    ) 
                );
                ezsol(
                    @pitch $mc
                    @names 'flute' 'clar' 
                    @types 'flz' 'air' 
                    @velocity 0
                    @duration $dur * 9
                    @useseed 1
                ).Compress().transcribe(
                    @onset $onset
                    @gain [0 1 0] [0.05 0.125 -0.25] [1 0 -0.125] 
                    @pan fold($pan - 0.5) 
                );
                $onset += $dur
            ) 
        );
        $duration * $reps
    ) 
);
#(
```bell
Arpeggio(
    @onset 0
    @spectrum null
    @duration 1000
) -> float/int
```
)#
Arpeggio = (
    $onset = 0, $spectrum = null, $duration = 1000 -> (
        $mcs = sort(
            $spectrum:[
                left(
                    argsort(abs($spectrum - c7)), xrandom(7, 13) 
                ) 
            ] 
        );
        $mode = xchoose(1...3);
        if $mode == 2 then ($mcs = rev($mcs)) else if $mode == 3 then ($mcs = xscramble($mcs));
        $durs = timeramp(
            @duration $duration
            @length length($mcs) 
            @slope xrand(-1/3, 1/3) 
        );
        $t = 0;
        for $mc in $mcs, $dur in $durs do (
            $pan = mc2pan($mc, .2);
            $b = ezsol(
                @pitch $mc
                @duration $dur
                @names 'flute' 'clar' 
                @types 'ord' 'ord-high' 'ord-micro' 
                @velocity 0
            ).process(
                gain(
                    [0 1 0] [1 0 -xrand(1/4, 4/5)] 
                ) 
            ).Compress();
            sinewave(
                @pitch $mc + 2400
                @duration max(5, $dur * 0.125) 
                @velocity xrandom(2, 10) 
            ).transcribe(
                @onset $onset + $t
                @pan 1 - $pan
                @gain 0.125
            );
            $b.transcribe(
                @onset $onset + $t @pan $pan
            );
            $t += $dur
        );
        $duration
    ) 
);
#(
```bell
Swirl(
    @onset 0
    @duration 2000
    @spectrum null
) -> float/int
```
)#
Swirl = (
    $onset = 0, $duration = 2000, $spectrum = null -> (
        $spectrum = $spectrum:[
            left(
                argsort(abs($spectrum - c7)), 12
            ) 
        ] + 1200;
        $addrs = randomseq(
            @llll 1...length($spectrum) 
            @length xrandom(2, length($spectrum)) 
            @steps (-1 1 -2) * xchoose(-1 1) 
            @useseed 1
        );
        $seq = $spectrum:[$addrs];
        $t = 0;
        $durrange = sort(for $i in 1 2 collect xrand(50, 300));
        $durbpf = [0 $durrange:1 0] [1 $durrange:2 xrand(-1/3, 1/3)];
        if xrand() > 0.5 then ($durbpf = revbpf($durbpf));
        if xrand() > 0.5 then ($durrange = rev($durrange));
        for $mc in $seq do (
            for $type in 'keys' 'air-and-ord' do (
                if $type != 'keys' then (
                    $env = xchoose(
                        [[0 1 0] [1 0 -0.25]] [[0 0 0] [1 1 0.25]] 
                    )::1
                ) else $env = 1;
                ezsol(
                    @pitch $mc
                    @duration $duration
                    @velocity 0
                    @names 'clar' 
                    @types $type
                    @useseed 1
                ).process(gain($env)).Compress().transcribe(
                    @onset $t + $onset
                    @pan xrand() 
                    @gain 0.125
                ) 
            ) 
        );
        while $t < $duration do (
            $nt = min(1, max(0, $t / $duration));
            $dur = samplebpf($durbpf, $nt);
            $mc = $seq:1;
            $seq = rot($seq, 1);
            $vel = scale($dur, $durrange:1, $durrange:2, 0, 50);
            $group = xchoose(
                [
                    ['names' family('strings')] [
                        'types' 'pizz-secco' 'pizz' 
                    ] 
                ] [
                    ['names' 'harp'] [
                        'types' 'harm' 'harm-in-wood' 
                    ] 
                ] 
            )::1;
            $b = ezsol(
                @pitch $mc
                @duration $duration
                @velocity $vel
                @names $group.'names' 
                @types $group.'types' 
                @useseed 0
            );
            if xrand() > 0.5 then (
                $s = sinewave(
                    @pitch $mc + r2c(xchoose(1/2 1...8)) 
                    @velocity $vel * 0.5
                    @duration $dur * exp2(xrand(0, 6)) 
                    @phase xrand() 
                ).process(gain(0.05));
                $b = $b.process(mix($s)) 
            );
            $b.Compress().transcribe(
                @onset $t + $onset
                @pan mc2pan($mc, 0.125) 
                @gain [0 0.125 0] [0.125 0.01 -0.125] [1 0 xrand(1/8, 9/10)] 
            );
            $t += $dur
        );
        $duration
    ) 
);
$mcroot = b1;
$base = r2mc(1...16, $mcroot);
$progression = for $pc in r2pc(1 21/16 7/8 7/6 5/4 8/7 3/4 1, mc2pc($mcroot)) collect (
    for $i in 1 2 collect (
        $n7 = (13/7 7/4):$i;
        $n4 = ([11/8 7/5] [21/16 4/3])::$i;
        [
            pcquant($base, r2pc(1 9/8 8/7 5/4 $n4 3/2 5/3 $n7, $pc)) 
        ] 
    ) 
);
$t = 0;
$objects = KeyClicks Tremolo Swirl Arpeggio Beats;
$order = xscramble(1...length($objects));
for $chord $chordid in $progression with @unwrap 1 do (
    $fns = KeyClicks xchoose($objects);
    for $fn in $fns do $t += $fn(
        @onset $t
        @spectrum $chord
        @rangesplit 4
        @subdivs xrandom(3, 20) 
        @duration 2250
    ) 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.98
        @wet 0.005
        @damp 0.5
        @width 1
    ) normalize(-3) 
);
ezexport()