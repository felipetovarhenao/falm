$chord = r2mc(8...32, c2).pcquant(r2pc(1 5/4 3/2 9/8 7/5 5/3));
$seq = randomseq(
    $chord @length 24 @steps -1 2 -3
);
$t = 0;
$dur = 100;
for $dyad in group($seq, 2, 1) :* 4 with @unwrap 1 do (
    $mc1 = $dyad:1;
    $mc2 = $dyad:2;
    ezsol(
        @pitch $mc1
        @duration $dur + 25
        @types ('ord' 'ord-micro') 
        @names 'flute' 'clar' 'sax' 
        @velocity 50
    ).process(
        resample(
            [0 1 0] [1 1/c2r($mc2 - $mc1) rand(0.7, 0.9)] 
        ) 
    ).transcribe(
        @onset $t @pan mc2pan($mc1 $mc2, 0.15) 
    );
    $t += $dur
);
render(
    @play 1 @process freeverb(
        @roomsize 0.7
        @wet 0.0125
        @damp 1
        @width 0.9
    ) normalize(-8) 
);
ezexport()