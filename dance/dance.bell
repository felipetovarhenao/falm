setseed(1);
$cells = (
    ## 
    [1/8 1/16 1/16 1/8] [6/16] [-5/16 3/16 2/16 2/16] [3/16] [1/16] ([-5/16 3/16 2/16 2/16] * 3) 
);
$mcs = r2mc(
    [2/3] [1] [9/4] [6/5] [15/16] [3/2] 
).xscramble();
$totdur = 13000;
$bardur = 2100;
scoreconfig(
    @clefs 'f' :* length($cells) 
);
$pans = arithmser(0, 1, null, length($cells));
for $cell $voice in $cells, $mc in $mcs, $pan in $pans.xscramble() with @unwrap 1 do (
    $t = 0;
    $count = 0;
    while $t < $totdur do (
        $vel = xrand() * 60;
        $id = ($count % length($cell)) + 1;
        $beatsize = $cell:$id;
        $pitch = $mc + ($count % ($voice) * 15);
        if $beatsize > 0 then (
            $timestep = abs($beatsize) * $bardur;
            if $voice > 0 then (
                if xrand() > 0.8 then ($b = maracas(
                    @pitch $pitch
                    @velocity $vel
                    @duration $timestep
                ) ) else (
                    $b = cycle(
                        @frequency $pitch.mc2f() * exp2(xrandom(-2, 4)) @duration $timestep * 0.25
                    ).process(
                        gain(
                            [0 0.05 0] [1 0 -xrand(1/3, 3/4)] 
                        ) 
                    ) 
                );
                $b.transcribe(
                    @onset $t
                    @pan 1 - $pan
                    @gain xrand(0.01, 0.2) 
                ) 
            );
            $names = 'flute' 'sax' 'clar';
            $types = 'keys' 'pizz' 'slap-unpitch';
            $env = [0 1 0] [1 0 -xrand(1/3, 3/4)];
            if xrand() > 0.25 then (
                $vel = 0;
                if xrand() > 0.5 then (
                    $names = 'harp';
                    $types = 'harm' 'ord' 'harm-in-wood' 
                ) else (
                    $names = 'violin' 'viola' 'cello';
                    $types = 'pizz' 
                );
                $env = $env.bpf(@yfunc $y -> $y * 0.5) 
            );
            $b = ezsol(
                @pitch $pitch
                @names $names
                @types $types
                @duration $timestep * 2
                @velocity $vel
            );
            $b.transcribe(
                @onset $t
                @pan $pan
                @voice $voice
                @gain $env
            ) 
        );
        $t += $timestep;
        $count += 1
    ) 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.7
        @wet 0.015
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport()