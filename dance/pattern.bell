setseed(1518);
$b = importaudio('./layer.wav');
$maxdur = $b.getkey('duration') / 2;
$t = 0;
$wetbpf = null;
while $t < $maxdur do (
    $chord = r2mc(1...48, a2).pcquant(r2pc(1 9/8 4/3 3/2 15/8 6/5));
    $pat = randomseq(
        @source $chord
        @length xrandom(5, 10) 
        @steps 2 -1 3 -4
        @useseed 1
    );
    $dur = xrand(40, 150);
    $pan = xrand();
    $gain = 0.3;
    $env = xchoose(
        [hanning()] [[0 1 0] [1 0 -0.5]] [[0 0 0] [1 1 0.25]] 
    )::1;
    for $mc in $pat do (
        xchoose(tri saw cycle rect phasor triangle)(
            $mc.mc2f() * choose(-1 1) @duration $dur
        ).process(dcfilter() gain($gain)).transcribe(
            @onset $t
            @gain $env
            @pan $pan
        );
        $t += $dur * 0.5
    );
    $wetbpf _= [$t xrand(0.05, 0.2) 0.1];
    $t += xrand(500, 2000) 
);
render(
    @play 1 @process freeverb(@roomsize 0.6 @wet $wetbpf) mix($b) normalize(-3) freqshift(-250) 
);
ezexport()