$data = read('../06_premerge/premerge.txt');
$data2 = read('../01_foreground/foreground.txt');
$bassfq = $data2.'final_chord'.minimum().mc2f();
$gates = $data.'gates';
if length($gates) % 2 == 1 then ($gates = $gates.left(-1));
$gates = group($gates, 2);
$offset = $gates::(1 1 1);
$b = importaudio('../06_premerge/premerge.wav').setkey('offset', $offset);
$c = importaudio('../04_glide/glide.wav');
$t = 0;
$minlevel = -20;
$maxlevel = -6;
$rate = 0.125;
$bass = (
    $onset, $fq, $dur -> (
        cycle(@frequency $fq @duration $dur).transcribe(
            @onset $onset
            @gain [0 0.25 0] [1 0 -0.5] 
            @pan 0.5
        ) 
    ) 
);
for $g in $gates with @unwrap 1 do (
    $start = $g:(1 1);
    $end = $g:(2 1);
    $dur = $end - $start;
    $start -= $offset;
    $c.setkey('offset', max(0, $start * $rate)).setkey('duration', $dur).detach().clipnorm(@minlevel $minlevel @maxlevel $maxlevel).transcribe($start);
    $bass($start, $bassfq, $dur);
    $t += $dur
);
$c.setkey('offset', max(0, $start * $rate)).detach().clipnorm(@minlevel $minlevel @maxlevel $maxlevel).transcribe($start);
$bass($start, $bassfq, $dur * 4);
render(
    @play 1
    @fade 3
    @process (
        freeverb(
            @roomsize 0.95
            @wet [0 0.0001 0] [1 0.015 0.45] 
            @damp 1
            @width 1
        ) normalize(-3) 
        ## 
        ## mix($b @gains 1 0.5) normalize(-3) 
        
    ) 
);
ezexport($offset)