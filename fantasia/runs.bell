$chord = r2mc(1...48, d2).pcquant(r2pc(1 9/8 5/4 7/5 3/2 5/3 15/8 7/4));
$t = 9000;
for $i in 1...15 do (
    $pat = randomseq(
        $chord @length xrandom(2, 10) @steps 2 -1 -3
    );
    $step = xrand(50, 100);
    $gap = xrand(300, 3500);
    $dur = $gap.max(1000);
    for $mc in $pat do (
        $b = pno(
            @pitch $mc
            @velocity xrand(1, 127) 
            @duration $dur * 1.5
        ).process(
            @operations gain([0 1 0] [1 0 0.35]) 
        );
        $shift = 0;
        if xrand() > 0.8 then (
            $b = $b.process(
                gain([0 1 0] [1 0 -0.5]) reverse() 
            );
            $shift -= $b.getkey('duration') 
        );
        if xrand() > 0.6 then (
            cycle(
                @frequency $mc.mc2f() * xrandom(-2, 4).exp2() 
                @duration xrand(100, $dur * xrand(0, 1).exp2()) 
                @phase xrand() 
            ).transcribe(
                @onset $t
                @pan xrand() 
                @gain [0 xrand(0.05, 0.2) 0] [1 0 -0.5] 
            ) 
        );
        $b.transcribe(
            @onset $t + $shift @pan xrand() 
        );
        $t += $step
    );
    $t += $gap
);
render(
    @play 1
    @fade 2
    @process freeverb(
        @roomsize 0.9
        @wet 0.0125
        @damp 1
        @width 1
    ) trim(@threshold 0.01 @end 0) normalize(-3) 
);
ezexport()