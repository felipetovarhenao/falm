pluckramp = (
    $time = 0, $duration = 2000, $timejitter = 0, $rate = 10, $legato = 2, $slope = -1/4, $velocity = 64, $cents = 6000 -> (
        BP_FN_CHECK_ARGS(
            'rampobj', 'time', $time, 'duration', $duration
        );
        $numnotes = int(
            round(
                max(1,  ($duration / 1000.) * $rate) 
            ) 
        );
        $names = family('strings');
        $types = 'pizz';
        $onsets = arithmser(0, 1, null, $numnotes).scale(0, 1, 0, $duration, $slope);
        $subdurs = x2dx($onsets);
        for $mc in $cents do (
            $in = ezinstrument(
                @pitch $mc
                @names $names
                @types $types
            );
            $fn = $in.getkey('fn');
            $type = $in.getkey('types');
            $pan = rand();
            for $onset in $onsets, $subdur in $subdurs do (
                $fn(
                    @pitch $mc
                    @type $type
                    @duration max(50, $subdur * $legato) 
                    @velocity $velocity
                ).transcribe(
                    @onset $onset + $time + rand(-0.5, 0.5) * $subdur * $timejitter @pan $pan
                ) 
            ) 
        );
        $duration
    ) 
);
$t = 0;
for $i in 1...9 do (
    $dur = rand(1000, 5000);
    $dur = pluckramp(
        @cents r2mc(1/4 3/4 1/2 1 3/2 5/2 15/8 9/4).scramble().left($i) 
        @time $t
        @legato 8
        @duration $dur
        @velocity random(1, 127) 
        @slope rand(1/4, 3/4) * choose(-1 1) 
    );
    $t += $dur;
    if rand() > 0.9 then ($t += rand(250, 1000)) 
);
render(
    @play 1 @process ezverb() normalize(-3) 
)