$arp = r2mc(1 5/4 3/2 15/8 9/4 14/5 5, c4).xscramble();
$t = 0;
$pc = 0;
for $mc in $arp :* 100 do (
    $pcs = r2pc(1 9/8 5/4 4/3 3/2 5/3 15/8, 12 - fmod($pc, 12.));
    $pc += 0.0125;
    $mc += pitchdiff($mc, $pcs);
    xchoose(harp guitar)(
        @pitch $mc
        @duration 800
        @velocity 0
    ).transcribe($t @pan mc2pan($mc));
    $t += 95
);
render(@play 1)