$riffs = read('./riffs.txt');
$combine = 1;
$t = 0;
$riffids = 1...length($riffs);
for $riffid in $riffids do (
    $section = $riffs:$riffid;
    $riff = $section.getkey('riff');
    $pcs = $section.getkey('pcs');
    if $combine == 0 then ($t = 0);
    for $slide in $riff :* 4 do (
        $timestep = $slide.getkey('timestep');
        $events = $slide.getkey('events');
        $balance = 1.05 ** (1 - length($events));
        for $event in $events do (
            $pitch = $event.getkey('pitch');
            $duration = $event.getkey('duration');
            $velocity = $event.getkey('velocity');
            $name = $event.getkey('name');
            $types = $event.getkey('types');
            $gliss = $event.getkey('gliss');
            $b = ezsol(
                @pitch $pitch
                @duration $duration
                @velocity $velocity
                @names $name
                @types $types
            ).process(
                ## --
                trim(@threshold 0.00125 @end 0) 
                ## --
                resample($gliss) 
                ## --
                normalize(-14 @rms 1) 
            );
            ## $b = $b.clipnorm(
            ##     @minlevel -18
            ##     @maxlevel -12
            ##     @rms 1
            ## );
            $b.transcribe(
                @onset $t
                @pan mc2pan($pitch, 1/3) 
                @gain [0 $balance 0] [1 0 0.95] 
            ) 
        );
        $t += $timestep
    );
    if $combine == 0 then (
        render(
            @reset 1 @process normalize(-3) 
        );
        ezexport(@id $riffid) 
    ) 
);
if $combine == 1 then (
    render(
        @play 1 @process normalize(-3) 
    );
    ezexport() 
)