BP_FN_ON_BEFORE = (
    -> (
        BP_FN_SANDBOX_CLEAR();
        setseed(1);
        scoreconfig();
        BP_URN = null;
        BP_VIEWER_DATA = null;
        BP_DATABASE_BROWSER = null;
        BP_DATABASE_TABLES = null;
        BP_FN_DISPATCH('db', ['erase']);
        BP_BUFFER_CACHE = null;
        BP_PLAY_TOGGLE = 0;
        NORMALIZED_PNO_SAMPLES = null
    ) 
);
jispectrum = (
    $harmonics = 1...32, $ratios = 1 5/4 3/2 5/3, $root = d2 -> (
        $pcs = r2pc($ratios, mc2pc($root));
        $chord = r2mc($harmonics, $root);
        thin(
            int(
                round(for $mc in $chord collect $mc + pitchdiff($mc, $pcs)) 
            ) 
        ) 
    ) 
);
#(
```bell
pcquant(
    @mc ## pitch/int/float (required)
    @pcs 0 4 7
    @thin 1
)
```

Quantizes a _llll_ of MIDIcents to the nearest pitch class in `@pcs`.

---

### Arguments

- `@mc`: _llll_ of MIDIcents to quantize. (_required_)
- `@pcs`: List of MIDIcents (_default_: `0 4 7`)
- `@thin`: Remove duplicates after quantization (_default_: `1`)
)#
pcquant = (
    $mc, $pcs = 0 4 7, $thin = 1 -> (
        for $x $addr in $mc with @maxdepth -1 @spikemode 1 do ($mc:$addr += pitchdiff($x, $pcs));
        if $thin == 1 then (
            $mc = thin(
                int(round($mc)) 
            ) 
        );
        $mc
    ) 
);
NORMALIZED_PNO_SAMPLES = null;
#(
```bell
pno(
    @pitch 6000
    @duration 500
    @velocity 64
    @useseed 1
    @usecache 1
    @resample 1
    @gain 0.25
    @norm 0.5
)
```

SOL-based sampler. Returns a buffer with a piano sample that best matches `@pitch` and `@velocity`.

--- 

### Arguments

- `@pitch`: Target pitch. (_default_: `6000`)
- `@duration`: Target duration. (_default_: `500`)
- `@velocity`: Target velocity. (_default_: `64`)
- `@useseed`: Use seeded random selection. (_default_: `1`)
- `@usecache`: Use buffer pre-loading cache. (_default_: `1`)
- `@resample`: Resample buffer based on target `@pitch`. (_default_: `1`)
- `@gain`: Pre-gain.
- `@norm`: SOL technique type. (_default_: 0.707)
)#
pno = (
    $pitch = 6000, $duration = 500, $velocity = 64, $useseed = 1, $usecache = 1, $resample = 1, $gain = 0.25, $norm = 0.707 -> (
        ## -----
        $b = sol(
            @name 'pno' 
            @pitch $pitch
            @duration $duration
            @velocity $velocity
            @useseed $useseed
            @usecache $usecache
            @resample $resample
            @type 'ord' 
        );
        $file = $b.getkey('file');
        $process = mixdown(@autogain 1) gain($gain);
        if NORMALIZED_PNO_SAMPLES.$file == null then (
            BP_BUFFER_CACHE.$file = BP_BUFFER_CACHE.$file.process($process);
            NORMALIZED_PNO_SAMPLES _= [$file 1];
            $b = $b.process($process) 
        );
        $maxabs = $b.getkey('maxabs');
        if $maxabs > $norm then (
            $b = $b.process(
                normalize(@level $norm @ampunit 0) @keepkeys 'file' 
            ) 
        );
        $b
    ) 
);
