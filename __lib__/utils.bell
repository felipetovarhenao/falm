```bell
timeramp(
    @duration 1000
    @length 3
    @slope 0
) -> llll
```

Generates a list of accelerating or descelerating duration times based on a given `@slope`, whose sum is equal to `@duration`.
)#
timeramp = (
    $duration = 1000, $length = 3, $slope = 0 -> (
        if $length > 1 then (
            $x = arithmser(0, 1, null, $length + 1);
            $x = scale($x, 0, 1, 0, $duration, $slope);
            x2dx($x) 
        ) else $duration
    ) 
);
#( 
```bell
gainboost(
    @buffer ## required
    @inmin 0
    @inmax 1
    @outmin 0
    @outmax 1
    @slope -0.125
    @rms 0
) -> llll
```

Returns the gain boost factor for a buffer, given a slope, based on either its true peak of RMS value.
)#
gainboost = (
    $buffer = null, $inmin = 0, $inmax = 1, $outmin = 0, $outmax = 1, $slope = -0.125, $rms = 0 -> (
        $key = if $rms == 1 then 'rms' else 'maxabs';
        $g1 = getkey(detach($buffer), $key);
        $g2 = scale(
            @x $g1
            @inmin $inmin
            @inmax $inmax
            @outmin $outmin
            @outmax $outmax
            @slope $slope
        );
        $boost = if $g1 > 0 then $g2 / $g1 else 1;
        $boost
    ) 
);
#(
```bell
gentuning(
    @lattice ## required
) -> llll
```

Generate a just-intonation tuning from a lattice.
)#
gentuning = (
    $lattice -> (
        $monzos = cartesianprod($lattice);
        $limits = primeser(
            @min 2 @maxcount length($lattice) 
        );
        $ratios = flat([$limits] ** $monzos);
        $ratios = sort(
            thin(octreduce($ratios)) 
        );
        $ratios
    ) 
)