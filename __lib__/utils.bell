```

Simplified exporting utility for solo album
)#
ezexport = (
    $data = null, $id = null -> (
        $filename = thispath(1).getkey('name');
        if $id != null then (
            $filename = $filename + '_' + tosymbol($id) 
        );
        export('./' + $filename + '.wav');
        $data &&& write(
            @data $data @path './' + $filename + '.txt' 
        ) 
    ) 
);
randwalk = (
    $length = 10, $steps = -1 1, $st = 0, $useseed = 0 -> (
        $choose = if $useseed == 1 then xchoose else choose;
        $dx = for $i in 1...max(0, $length - 1) collect $choose($steps);
        ($dx &&& dx2x($dx, $st)) ||| $st
    ) 
);
#(
```bell
randomseq(
    @llll null
    @length 10
    @steps -1 1
    @useseed 0
```

Generates a random pattern from a _llll_.

---

### Arguments

- `@llll`: _llll_ from which to retrieve pattern elements. (_required_)
- `@length`: Sequence length. (_default_: `10`)
- `@steps`: Step choices for random walk (_default_: `-1 1`)
- `@useseed`: Use seeded randomness. (_default_: `0`)
)#
randomseq = (
    $llll = null, $length = 10, $steps = -1 1, $useseed = 0 -> (
        BP_FN_CHECK_ARGS('randomseq', 'source', $llll);
        $size = length($llll);
        $N = ($size - 1);
        $random = if $useseed == 1 then xrandom else random ;
        $st = $random(0, $N);
        $x = randwalk(
            @st $st
            @length $length
            @steps $steps
            @useseed $useseed
        );
        $x = int(
            round(fold($x / $N) * $N) 
        ) + 1;
        $llll:[$x] 
    ) 
);
