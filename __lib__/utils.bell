```bell
maracas(
    @pitch 6000
    @duration 500
    @velocity 64
    @useseed 1
    @usecache 1
    @resample 1
    @type `'ord'`
)
```

SOL-based sampler. Returns a buffer with a maracas sample that best matches `@pitch` and `@velocity`.

--- 

### Arguments

- `@pitch`: Target pitch. (_default_: `6000`)
- `@duration`: Target duration. (_default_: `500`)
- `@velocity`: Target velocity. (_default_: `64`)
- `@useseed`: Use seeded random selection. (_default_: `1`)
- `@usecache`: Use buffer pre-loading cache. (_default_: `1`)
- `@resample`: Resample buffer based on target `@pitch`. (_default_: `1`)
- `@type`: SOL technique type. (_default_: `'ord'`)
    - `'ord'`
)#
maracas = (
    $pitch = 6000, $duration = 500, $velocity = 64, $useseed = 1, $usecache = 1, $resample = 0, $type = 'ord' -> (sol(
        @name 'maracas' 
        @pitch $pitch
        @duration $duration
        @velocity $velocity
        @useseed $useseed
        @usecache $usecache
        @resample $resample
        @type $type
    ) ) 
);
#(
```bell
ezinstrument(
    @pitch ## required
    @names 'guitar' 'harp'
    @types 'ord'
    @useseed 0
)
```

Returns an SOL instrument with the following structure:

```bell
[
    ['name' <instrument name>]
    ['fn' <callback>]
    ['types' <keymap_types>]
    ['range' <pitch_range>]
]
```
)#
ezinstrument = (
    $pitch, $names = 'guitar' 'harp', $types = 'ord', $useseed = 0 -> (
        BP_FN_CHECK_ARGS(
            'ezinstrument', 'pitch', $pitch, 'names', $names
        );
        $choose = if $useseed == 1 then xchoose else choose;
        $instruments = for $n in $names collect instrument($n, $types @join 0);
        $instruments.pitchfilter($pitch).$choose() 
    ) 
);
#(
```bell
ezsol(
    @pitch ## required
    @names 'guitar' 'harp'
    @types 'ord'
    @velocity 64
    @duration 1000
    @resample 1
    @useseed 0
) -> ## buffer
```

Returns a buffer given parametric constraints.
)#
ezsol = (
    $pitch, $names = 'guitar' 'harp', $types = 'ord', $velocity = 64, $duration = 1000, $resample = 1, $useseed = 0 -> (
        BP_FN_CHECK_ARGS(
            'ezsol', 'pitch', $pitch, 'names', $names
        );
        $choose = if $useseed == 1 then xchoose else choose;
        $instruments = for $n in $names collect instrument($n, $types @join 0);
        $instrument = $instruments.pitchfilter($pitch).$choose();
        $fn = $instrument.getkey('fn');
        $type = $instrument.getkey('types');
        $name = $instrument.getkey('name');
        $b = $fn(
            @pitch $pitch
            @duration $duration
            @velocity $velocity
            @type $type
            @resample $resample
            @useseed $useseed
        ).setkey(
            'instrument', ['name' $name] ['type' $type], @mode 1
        );
        $b
    ) 
);
ezexport = (
    $data -> (
        $filename = thispath(1).getkey('name');
        export('./' + $filename + '.wav');
        $data &&& write(
            @data $data @path './' + $filename + '.txt' 
        ) 
    ) 
);
randwalk = (
    $length = 10, $steps = -1 1, $st = 0, $useseed = 0 -> (
        $choose = if $useseed == 1 then xchoose else choose ;
        $dx = for $i in 1...max(0, $length - 1) collect $choose($steps);
        ($dx &&& dx2x($dx, $st)) ||| $st
    ) 
);
randpattern = (
    $source, $length = 10, $steps = -1 1, $useseed = 0 -> (
        BP_FN_CHECK_ARGS('randpattern', 'source', $source);
        $size = length($source);
        $N = ($size - 1);
        $random = if $useseed == 1 then xrandom else random ;
        $st = $random(0, $N);
        $x = randwalk(
            @st $st
            @length $length
            @steps $steps
            @useseed $useseed
        );
        $x = int(
            round(fold($x / $N) * $N) 
        ) + 1;
        $source:[$x] 
    ) 
);
family = (
    $name -> (
        $families = (
            [
                'strings' 'violin' 'viola' 'cello' 'bass' 
            ] [
                'woodwinds' 'flute' 'oboe' 'clar' 'sax' 'bassoon' 
            ] [
                'winds' 'flute' 'oboe' 'clar' 'sax' 'bassoon' 'tpt' 'horn' 'tromb' 'tuba' 
            ] [
                'brass' 'tpt' 'horn' 'tromb' 'tuba' 
            ] [
                'plucked' 'harp' 'guitar' 'pno' 
            ] 
        );
        $families.$name ||| BP_FN_ERROR('invalid family name:' $name) 
    ) 
);
mc2pan = ($mc -> $mc.mc2pc() / 12.);
ms2samps = (
    $ms, $sr = 48000 -> int(($ms / 1000.) * $sr) 
);
samps2ms = (
    $samps, $sr = 48000 -> (($samps / $sr) * 1000.) 
);
ezverb = (-> freeverb(
    @roomsize 0.9
    @wet 0.0125
    @damp 1
    @width 1
));
float2rat = (
    $x, $denoms = 16 -> (
        $x.map(
            $float -^ $denoms -> (
                $sign = sgn($float);
                $float = abs($float);
                $bestnum = 0;
                $bestden = 1;
                $besterror = abs($float);
                for $den in $denoms do (
                    $num = round($float * $den);
                    $error = abs($float - ($num / $den));
                    if $error < $besterror then (
                        $bestnum = $num;
                        $bestden = $den;
                        $besterror = $error
                    ) 
                );
                rat($bestnum / $bestden) * $sign
            ) @maxdepth -1
        ) 
    ) 
)