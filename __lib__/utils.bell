```bell
family(
    @name ## symbol (required)
)
```

Returns a list of SOL names.

---

### Arguments

- `@name`: instrument family name:
    - `'strings'`
    - `'woodwinds'`
    - `'winds'`
    - `'brass'`
    - `'plucked'`
)#
family = (
    $name -> (
        $families = (
            [
                'strings' 'violin' 'viola' 'cello' 'bass' 
            ] [
                'woodwinds' 'flute' 'oboe' 'clar' 'sax' 'bassoon' 
            ] [
                'winds' 'flute' 'oboe' 'clar' 'sax' 'bassoon' 'tpt' 'horn' 'tromb' 'tuba' 
            ] [
                'brass' 'tpt' 'horn' 'tromb' 'tuba' 
            ] [
                'plucked' 'harp' 'guitar' 
            ] 
        );
        $families.$name ||| BP_FN_ERROR('invalid family name:' $name) 
    ) 
);
mc2pan = (
    $mc, $spread = 1.0 -> (
        $pan = mc2pc($mc) / 12.;
        $pan = ($pan - 0.5) * $spread + 0.5;
        $pan
    ) 
);
ms2samps = (
    $ms, $sr = 48000 -> int(($ms / 1000.) * $sr) 
);
samps2ms = (
    $samps, $sr = 48000 -> (($samps / $sr) * 1000.) 
);
ezverb = (-> freeverb(
    @roomsize 0.9
    @wet 0.0125
    @damp 1
    @width 1
));
float2rat = (
    $x, $denoms = 16 -> (
        $x.map(
            $float -^ $denoms -> (
                $sign = sgn($float);
                $float = abs($float);
                $bestnum = 0;
                $bestden = 1;
                $besterror = abs($float);
                for $den in $denoms do (
                    $num = round($float * $den);
                    $error = abs($float - ($num / $den));
                    if $error < $besterror then (
                        $bestnum = $num;
                        $bestden = $den;
                        $besterror = $error
                    ) 
                );
                rat($bestnum / $bestden) * $sign
            ) @maxdepth -1
        ) 
    ) 
);
WAVESYNTH = (
    $pitch = c5, 
    ## ----
    $duration = 1000, 
    ## ----
    $velocity = 64, 
    ## ----
    $envelope = [0 0.33 0] [1 0 -0.25], 
    ## ----
    $phase = 0.25, 
    ## ----
    $fn = 'cycle' -> (
        $map = ['cycle' cycle] ['tri' tri] ['rect' rect] ['saw' saw];
        $wave = $map.$fn;
        $b = $wave(
            @frequency mc2f($pitch) 
            @duration $duration
            @phase $phase
            @duty $phase
        );
        $process = dcfilter();
        $envelope &&& (
            $process _= gain(
                bpf($envelope @yfunc $y -^ $velocity -> $y * ($velocity / 127.)) 
            );
            $b = $b.process($process) 
        );
        $b
    ) 
);
