sigmoid(
    @x ## int/float/llll (required)
) -> llll
```

[Logistic curve](https://en.wikipedia.org/wiki/Sigmoid_function) function. Maps numeric values to the 0 to 1 range.
)#
sigmoid = (
    $x -> 1.0 / (1.0 + exp(-$x)) 
);
#( 
```bell
randn(
    @mean 0
    @std 1
) -> float
```
Samples a number from a normal distribution with a given mean and standard deviation.
)#
randn = (
    $mean = 0, $std = 1 -> (
        $u1 = rand();
        $u2 = rand();
        $z0 = sqrt(-2 * log($u1)) * cos(2 * pi * $u2);
        $mean + $std * $z0
    ) 
);
#( 
```bell
clipnorm(
    @buffer ## required
    @minlevel -25
    @maxlevel -3
    @ampunit 1
    @rms 0
) -> float
```
Normalizes a buffer only if it's peak amplitude is outside the `@minlevel` and `@maxlevel` range.
)#
clipnorm = (
    $buffer = null, $minlevel = -25, $maxlevel = -3, $ampunit = 1, $rms = 0 -> (
        $maxabs = $buffer.getkey('maxabs');
        if $ampunit == 0 then (
            $minlevel = dbtoa($minlevel);
            $maxlevel = dbtoa($maxlevel) 
        ) else ($maxabs = atodb($maxabs) );
        $process = null if $maxabs < $minlevel then (
            ## 
            $process = normalize(
                @level $minlevel
                @ampunit $ampunit
                @rms $rms
            ) 
        ) else if $maxabs > $maxlevel then (
            ## 
            $process = normalize(
                @level $maxlevel
                @ampunit $ampunit
                @rms $rms
            ) 
        );
        if $process != null then ($buffer = $buffer.process($process));
        $buffer
    ) 
);
