jispectrum = (
    $harmonics = 1...32, $ratios = 1 5/4 3/2 5/3, $root = d2 -> (
        $pcs = r2pc($ratios, mc2pc($root));
        $chord = r2mc($harmonics, $root);
        thin(
            int(
                round(for $mc in $chord collect $mc + pitchdiff($mc, $pcs) ) 
            ) 
        ) 
    ) 
);
pcquant = (
    $mc, $pcs = 0 4 7, $thin = 1 -> (
        for $x $addr in $mc with @maxdepth -1 @spikemode 1 do ($mc:$addr += pitchdiff($x, $pcs));
        if $thin == 1 then (
            $mc = thin(
                int(round($mc)) 
            ) 
        );
        $mc
    ) 
);
fold = (
    $x -> 1 - 2 * abs(mod($x * 0.5, 1) - 0.5) 
);
pno = (
    $pitch = 6000, $duration = 500, $velocity = 64, $useseed = 1, $usecache = 1, $resample = 1, $norm = 0.5 -> (
        ## -----
        $b = sol(
            @name 'pno' 
            @pitch $pitch
            @duration $duration
            @velocity $velocity
            @useseed $useseed
            @usecache $usecache
            @resample $resample
            @type 'ord' 
        ).process(mixdown());
        $maxabs = $b.getkey('maxabs');
        if $maxabs > $norm then (
            $b = $b.process(normalize(@level $norm @ampunit 0)) 
        );
        $b
    ) 
);
maracas = (
    $pitch = 6000, $duration = 500, $velocity = 64, $useseed = 1, $usecache = 1, $resample = 0, $type = 'ord' -> (sol(
        @name 'maracas' 
        @pitch $pitch
        @duration $duration
        @velocity $velocity
        @useseed $useseed
        @usecache $usecache
        @resample $resample
        @type $type
    ) ) 
);
ezinstrument = (
    $pitch, $names = 'guitar' 'harp', $types = 'ord', $useseed = 0 -> (
        BP_FN_CHECK_ARGS(
            'ezinstrument', 'pitch', $pitch, 'names', $names
        );
        $choose = if $useseed == 1 then xchoose else choose;
        $instruments = for $n in $names collect instrument($n, $types @join 0);
        $instruments.pitchfilter($pitch).$choose() 
    ) 
);
ezexport = (
    $data -> (
        $filename = thispath(1).getkey('name');
        export('./' + $filename + '.wav');
        $data &&& write(
            @data $data @path './' + $filename + '.txt' 
        ) 
    ) 
);
randpattern = (
    $source, $length = 10, $steps = -1 1, $useseed = 0 -> (
        $size = length($source);
        $N = ($size - 1);
        if $useseed == 1 then (
            $choose = xchoose;
            $random = xrandom
        ) else (
            $choose = choose;
            $random = random
        );
        $dx = for $i in 1...($length - 1) collect $choose($steps);
        $st = $random(0, $N);
        $x = dx2x($dx, $st);
        $x = int(
            round(fold($x / $N) * $N) 
        ) + 1;
        $source:[$x] 
    ) 
);
family = (
    $name -> (
        $families = (
            [
                'strings' 'violin' 'viola' 'cello' 'bass' 
            ] [
                'winds' 'flute' 'oboe' 'clar' 'sax' 'bassoon' 
            ] [
                'plucked' 'harp' 'guitar' 'pno' 
            ] 
        );
        $families.$name ||| BP_FN_ERROR('invalid family name:' $name) 
    ) 
);
mc2pan = ($mc -> $mc.mc2pc() / 12.);
ms2samps = (
    $ms, $sr = 48000 -> int(($ms / 1000.) * $sr) 
);
samps2ms = (
    $samps, $sr = 48000 -> (($samps / $sr) * 1000.) 
);
ezverb = (-> freeverb(
    @roomsize 0.9
    @wet 0.0125
    @damp 1
    @width 1
))