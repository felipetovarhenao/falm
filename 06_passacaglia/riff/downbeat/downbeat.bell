$sequence = read('../sequence.txt');
$sections = $sequence.'sections';
$root = $sequence.'root';
$ids = 2...length($sections);
## $ids = 7;
for $id in $ids do (
    $section = $sections:$id;
    $pcs = getkey($section, 'pitch_classes').print();
    $mc = pcquant(r2mc(5, $root), $pcs) - 1200;
    $b = bass(
        @pitch $mc
        @duration null
        @velocity 127
        @type 'pizz' 
    ).analyze(effectiveduration(@thresholdratio 0.001));
    cycle(
        @frequency mc2f($mc) / 2 @duration $b.getkey('effectiveduration') 
    ).transcribe(
        @gain [0 1 0] [1 0 -0.5] 
    );
    $b.setkey('duration', $b.getkey('effectiveduration')).transcribe(
        @pan mc2pan($mc, 0.25) @gain [0 1 0] [1 0 -0.5] 
    );
    render(
        @reset 1 @process normalize(-5) 
    );
    ezexport(@id $id) 
)