$data = read('./sequence.txt');
$sections = $data.'sections';
$numsections = length($sections);
$layers = 'strings' 'perc' 'sines' 'bass' 'brass' 'downbeat';
$t = 0;
for $i in 1...$numsections do (
    $id = tosymbol($i);
    $t = 0;
    for $layer in $layers do (
        $file = './' + $layer + '/' + $layer + '_' + $id + '.wav';
        if exists($file) == 1 then (
            $b = importaudio($file);
            $b.transcribe($t) 
        ) 
    );
    $t += read('./strings/strings_' + $id + '.txt');
    render(
        @reset 1 @process normalize(-3) 
    );
    ezexport(@data $t @id $i) 
)