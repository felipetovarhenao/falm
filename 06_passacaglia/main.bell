$data = read('./sequence.txt');
$sections = $data.'sections';
$numsections = length($sections);
$layers = 'riff' 'perc' 'sines' 'bass' 'brass';
$t = 0;
for $i in 3...$numsections do (
    $id = tosymbol($i);
    for $layer in $layers do (
        $file = './' + $layer + '/' + $layer + '_' + $id + '.wav';
        if exists($file) == 1 then (
            $b = importaudio($file);
            $b.transcribe($t) 
        ) 
    );
    $t += read('./riff/riff_' + $id + '.txt') 
);
render(
    @play 1 @process normalize(-3)
);
ezexport()