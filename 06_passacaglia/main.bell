$folders = 'run' 'arpeggi' 'strum' 'doppel' 'bell' 'riff';
$t = 0;
for $i in 5...8 do (
    $id = tosymbol($i);
    for $folder in $folders do (
        $basefile = './' + $folder + '/' + $folder + '_' + $id ;
        $sndfile = $basefile + '.wav';
        $txtfile = $basefile + '.txt';
        if exists($sndfile) == 1 && exists($txtfile) == 1 then (
            $b = importaudio($sndfile);
            $meta = read($txtfile);
            if $folder == 'strum' then (
                $b.transcribe($t - $meta.'offset');
                $t += $meta.'duration' 
            ) else (
                $b.transcribe($t);
                $t += $meta
            ) 
        ) 
    ) 
);
render(
    @play 1 @process normalize(-3) 
);
ezexport()