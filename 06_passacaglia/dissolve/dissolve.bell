setseed(80);
$sequence = read('../riff/sequence.txt');
$sections = $sequence.'sections';
$unit = $sequence.'unit';
$id = length($sections);
$b = importaudio(
    '../riff/riff_' + tosymbol($id) + '.wav' 
);
$meta = read(
    '../riff/riff_' + tosymbol($id) + '.txt' 
);
$reps = 5;
$markers = arithmser(0, $meta, $unit);
$mdurs = x2dx($markers);
$markers = $markers.left(-1);
$period = length($markers) / 4;
$t = 0;
$totdur = $meta * $reps;
$slopebpf = [0 0.99 0] [1 -0.5 0];
$speedbpf = [0 1 0] [0.95 0.33 -0.1] [1 1 0.25];
$legatobpf = [0 1 0] [1 0.05 -0.125];
$gainbpf = [0 1 0] [0.95 0.25 0.25] [1 0.707 1/2];
$onsetjitbpf = [0 0 0] [1 1 0.25];
while $t < $totdur do (
    for $m $mi in $markers, $mdur in $mdurs do (
        $nt = min(1, max(0, $t / $totdur));
        $onsetjit = samplebpf($onsetjitbpf, $nt);
        $gain = samplebpf($gainbpf, $nt);
        $slope = samplebpf($slopebpf, $nt);
        $speed = samplebpf($speedbpf, $nt);
        $legato = samplebpf($legatobpf, $nt);
        $graindur = $mdur * $legato;
        $incr = $mdur * $speed;
        $seg = $b.setkey('offset', $m).setkey('duration', $graindur);
        $seg.transcribe(
            @onset $t + xrand(-0.5, 0.5) * $incr * $onsetjit @gain [0 $gain 0] [1 0 $slope] 
        );
        $t += $incr;
        if $mi % $period == 1 then (
            $ids = xscramble(1...length($markers)).left(2);
            $tmp = $mdurs:($ids:1);
            $mdurs:($ids:1) = $mdurs:($ids:2);
            $mdurs:($ids:2) = $tmp;
            $tmp = $markers:($ids:1);
            $markers:($ids:1) = $markers:($ids:2);
            $markers:($ids:2) = $tmp
        ) 
    ) 
);
render(
    @play 1 @process normalize(-3) join(envelope(@duration 2000)) 
);
ezexport(@data $totdur)