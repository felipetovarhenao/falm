setseed(2);
$sequence = read('../riff/sequence.txt');
$sections = $sequence.'sections';
$unit = $sequence.'unit';
$id = length($sections);
$b = importaudio(
    '../riff/riff_' + tosymbol($id) + '.wav' 
);
$meta = read(
    '../riff/riff_' + tosymbol($id) + '.txt' 
);
$t = 0;
$bufdur = ($meta - $unit);
$totdur = $bufdur * 4.75;
$readbpf = [0 1 0] [1 0 -0.125];
$gainbpf = [0 1 0] [0.5 1 0] [0.9 0.707 0.125] [1 0 0.125];
$graindurbpf = [0 500 0] [1 25 -0.125];
$onsetjitbpf = [0 0 0] [1 1 0.25];
$overlapbpf = [0 4 0] [1 1 -0.125];
$panjitbpf = [0 0 0] [1 1 -0.125];
$revbpf = [0 0 0] [1 0.5 0.125];
$offset = 0;
$han = hanning();
while $t < $totdur do (
    $nt = $t / $totdur;
    $graindur = samplebpf($graindurbpf, $nt);
    $rev = samplebpf($revbpf, $nt);
    $onsetjit = samplebpf($onsetjitbpf, $nt);
    $overlap = samplebpf($overlapbpf, $nt);
    $gain = samplebpf($gainbpf, $nt);
    $panjit = samplebpf($panjitbpf, $nt);
    $dur = $graindur * exp2(xrand(-0.5, 0.5));
    $incr = $dur / $overlap;
    $read = samplebpf($readbpf, $nt);
    $seg = $b.setkey('offset', $offset).setkey('duration', $dur);
    if xrand() < $rev then ($seg = $seg.process(reverse()));
    $onset = $t + xrand(-0.5, 0.5) * $onsetjit * $dur;
    if $onset >= -10 then (
        $seg.transcribe(
            @onset $t + xrand(-0.5, 0.5) * $onsetjit * $dur
            @gain $han * $gain
            @pan abs($panjit * xrand() - 0.5) 
        ) 
    );
    $offset += $incr * $read;
    $offset = $offset % $bufdur;
    $t += $incr
);
$dissolve = render(
    @reset 1 @process freeverb(
        @roomsize 0.9
        @wet [0 0 0] [0.9 0.0125 0.125] [1 0 -0.125] 
        @damp 1
        @width 1
    ) normalize(-3) 
);
$b.transcribe();
$dissolve.transcribe($meta);
render(@play 1);
ezexport()