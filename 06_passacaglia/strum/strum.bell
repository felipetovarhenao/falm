BassDrum = (
    $onset = 0, $duration = 1000, $unit = 100, $pitch = c3 -> (
        $numattacks = int(round($duration / $unit));
        $t = 0;
        $bass = cycle(
            @frequency mc2f($pitch) * 0.5 @duration $unit * 0.25
        );
        $knock = ezsol(
            @pitch xrandom(21, 108) * 100
            @names family('plucked') family('strings') 
            @types 'perc' 'hit-on-body' 
            @duration $unit
            @velocity 127
            @useseed 1
            @resample 0
        ).process(normalize(@level -28 @rms 1));
        for $i in 1...$numattacks do (
            $pan = mc2pan($pitch, 0.25);
            $knock.transcribe(
                @onset $t + $onset
                @pan 1 - $pan
                @gain [0 1 0] [1 0 -0.5] 
            );
            $bass.transcribe(
                @onset $t + $onset
                @pan $pan
                @gain [0 1 0] [1 0 -xrand(1/4, 5/6)] 
            );
            $t += $unit
        ) 
    ) 
);
Freeze = (
    $buffer, $onset = 0, $duration = null -> (
        $bufdur = $buffer.getkey('duration');
        $duration = $duration ||| ($bufdur * xrand(-1, 1).exp2());
        $readst = $buffer.getkey('offset');
        $readend = $bufdur + $readst;
        $graindur = min($bufdur, xrand(50, 150));
        $readbpf = [0 $readst 0.] [1 max($readst, $readend - $graindur) 0];
        $gainbpf = [0 1 0] [1 0 -xrand(0.125, 0.75)];
        if xrand() > 0 then ($gainbpf = revbpf($gainbpf));
        $t = 0;
        $win = hanning();
        $pan = xrand();
        while $t < $duration do (
            $nt = $t / $duration;
            $grainoffset = samplebpf($readbpf, $nt);
            $gain = samplebpf($gainbpf, $nt);
            $grain = $buffer.setkey('offset', $grainoffset).setkey('duration', $graindur);
            $grain.transcribe(
                @onset $t + $onset
                @gain $win * $gain
                @pan $pan
            );
            $t += $graindur * xrand(0.125, 1/3) 
        ) 
    ) 
);
$postfx = normalize(-3);
$sequence = read('../riff/sequence.txt');
$sections = $sequence.'sections';
$unit = $sequence.'unit';
$ids = 2...length($sections);
$minid = minimum($ids);
$maxid = maximum($ids);
## $ids = 8;
$preview = length($ids) == 1;
$mcroot = $sequence.'root';
$fullchord = r2mc(3...48, $mcroot + 1200);
$windlayerbpf = [0 0 0] [1 1 0.125];
$bassdivsbpf = [0 2 0] [1 -1 -0.125];
for $id in $ids do (
    $gnt = scale($id, $minid, $maxid, 0, 1);
    $windlayer = samplebpf($windlayerbpf, $gnt);
    $bassdivs = exp2(
        int(
            round(samplebpf($bassdivsbpf, $gnt)) 
        ) 
    );
    setseed($id + 300);
    $section = $sections:($id - 1);
    $totdur = getkey($section, 'total_duration') / ($id / 2.0);
    $pcs = getkey($section, 'pitch_classes');
    $mcs = (
        left(
            xscramble(pcquant($fullchord, $pcs)), 12
        ) 
    );
    $t = 0;
    $maxonset = 0;
    $mdur = $totdur;
    $offset = 0;
    $strum = xrand(20);
    $glissdir = xchoose(-1 1);
    for $mc in $mcs do (
        $onset = $t + $offset;
        $maxonset = max($onset, $maxonset);
        $maxdur = max(1, min($totdur - $onset, $mdur * 2));
        $fn = xchoose(ezsol pno @weights 10 1);
        $b = $fn(
            @pitch $mc
            @names family('plucked') 
            @types 'ord' 'harm' 'pizz' 'harm-in-wood' 
            @velocity 30
            @duration $maxdur + 100
            @useseed 1
        ).clipnorm(@minlevel -22 @rms 1);
        if xrand() < $windlayer then (
            $wind = ezsol(
                @pitch $mc
                @names 'flute' 'sax' 'clar' 'acc' 
                @velocity 0
                @types 'flz' 'flz-to-ord' 'bisb' 'reg' 
                @duration $maxdur
                @useseed 1
            ).clipnorm(@minlevel -20 @rms 1).process(trim(@threshold 0.005));
            $wind.process(reverse()).transcribe(
                @onset $totdur - $wind.getkey('duration') 
                @pan mc2pan($mc, 0.3) 
                @gain [0 0 0] [1 1 xrand(1/5, 2/3)] 
            ) 
        );
        Freeze(
            @buffer $b
            @onset $onset
            @duration $maxdur
        );
        $b.process(
            resample(
                [0 1 0] [
                    1 1/c2r(xrand(100, 300) * $glissdir) 0.25
                ] 
            ) 
        ).transcribe(
            @onset $onset
            @gain [0 1 0] [1 0 xrand(-0.25, 0.25)] 
            @pan for $n in 1...xrandom(4, 10) collect [
                $n - 1 abs(($n % 2) - mc2pan($mc, 0.5)) xrand(-0.5, 0.5) 
            ] 
        );
        $offset += $strum
    );
    BassDrum(
        @onset $maxonset
        @duration $totdur
        @unit $unit * $bassdivs
        @pitch minimum($mcs) 
    );
    if $preview == 0 then (
        render(
            @reset 1 @process $postfx
        );
        ezexport(
            @data ['duration' max(0, $totdur - $maxonset)] ['offset' $maxonset] @id $id
        ) 
    ) 
);
if $preview == 1 then (render(@play 1 @process $postfx) )