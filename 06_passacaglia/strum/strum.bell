## ----------------------
## Function: Freeze
## ----------------------
Freeze = (
    $buffer, $onset = 0, $duration = null -> (
        $bufdur = $buffer.getkey('duration');
        $duration = $duration ||| ($bufdur * xrand(-1, 1).exp2());
        $readst = $buffer.getkey('offset');
        $readend = $bufdur + $readst;
        $graindur = min($bufdur, xrand(50, 150));
        $readbpf = [0 $readst 0.] [1 max($readst, $readend - $graindur) 0];
        $gainbpf = [0 1 0] [1 0 -xrand(0.125, 0.75)];
        if xrand() > 0 then ($gainbpf = revbpf($gainbpf));
        $t = 0;
        $win = hanning();
        $pan = xrand();
        while $t < $duration do (
            $nt = $t / $duration;
            $grainoffset = samplebpf($readbpf, $nt);
            $gain = samplebpf($gainbpf, $nt);
            $grain = $buffer.setkey('offset', $grainoffset).setkey('duration', $graindur);
            $grain.transcribe(
                @onset $t + $onset
                @gain $win * $gain
                @pan $pan
            );
            $t += $graindur * xrand(0.125, 1/3) 
        ) 
    ) 
);
$postfx = normalize(-3);
$sequence = read('../riff/sequence.txt');
$sections = $sequence.'sections';
$unit = $sequence.'unit';
$ids = 2...length($sections);
## $ids = 2;
$preview = length($ids) == 1;
$mcroot = $sequence.'root';
$fullchord = r2mc(3...48, $mcroot + 1200);
for $id in $ids do (
    setseed($id + 300);
    $section = $sections:($id - 1);
    $totdur = getkey($section, 'total_duration') / ($id / 2.0);
    $numattacks = $id;
    $numattacks = 1;
    $pcs = getkey($section, 'pitch_classes');
    $mcs = (
        left(
            xscramble(pcquant($fullchord, $pcs)), 12
        ) 
    );
    $t = 0;
    $markers = arithmser(0, 1, null, $numattacks + 1).scale(0, 1, 0, $totdur, xrand(0.1, 1/4) * xchoose(-1 1));
    $mdurs = x2dx($markers);
    $markers = $markers.left(-1);
    $maxonset = 0;
    for $t in $markers, $mdur in $mdurs do (
        $offset = 0;
        $strum = xrand(20);
        for $mc in $mcs do (
            $onset = $t + $offset;
            $maxonset = max($onset, $maxonset);
            $maxdur = max(1, min($totdur - $onset, $mdur * 2));
            $fn = xchoose(ezsol pno @weights 10 1);
            $b = $fn(
                @pitch $mc
                @names family('plucked') 
                @types 'ord' 'harm' 'pizz' 'harm-in-wood' 
                @velocity 30
                @duration $maxdur + 100
                @useseed 1
            ).clipnorm(@minlevel -22 @rms 1);
            $wind = ezsol(
                @pitch $mc
                @names 'flute' 'sax' 'clar' 'acc' 
                @velocity 0
                @types 'flz' 'ord-to-flz' 'bisb' 'reg' 
                @duration $maxdur
                @useseed 1
            ).process(trim(@threshold 0.0025)).clipnorm(@minlevel -28 @rms 1);
            $wind.process(reverse()).transcribe(
                @onset $totdur - $wind.getkey('duration') 
                @pan mc2pan($mc, 0.3) 
                @gain [0 0 0] [1 1 xrand(1/5, 2/3)] 
            );
            Freeze(
                @buffer $b
                @onset $onset
                @duration $maxdur
            );
            $b.process(
                resample(
                    [0 1 0] [
                        1 1/c2r(-xrand(100, 300)) 0.25
                    ] 
                ) 
            ).transcribe(
                @onset $onset
                @gain [0 1 0] [1 0 xrand(-0.25, 0.25)] 
                @pan for $n in 1...xrandom(4, 10) collect [
                    $n - 1 abs(($n % 2) - mc2pan($mc, 0.5)) xrand(-0.5, 0.5) 
                ] 
            );
            $offset += $strum
        ) 
    );
    if $preview == 0 then (
        render(
            @reset 1 @process $postfx
        );
        ezexport(
            @data ['duration' max(0, $totdur - $maxonset)] ['offset' $maxonset] @id $id
        ) 
    ) 
);
if $preview == 1 then (render(@play 1 @process $postfx) )