setseed(303);
Swirl = (
    $onset = 0, $duration = 1000, $chord = null, $length = null, $velocity = 127, $slope = 0.125 -> (
        $t = 0;
        $velbpf = bpf($velocity);
        $maxnumnotes = round($duration / 50);
        $seqlength = $length ||| xrandom(2, 5);
        $numnotes = xrandom($maxnumnotes // 2, $maxnumnotes);
        $numreps = ceil($numnotes / $seqlength);
        $seq = randomseq(
            @llll $chord
            @length $seqlength
            @steps -2 -1 1 2
            @useseed 1
        );
        $seq = $seq :* $numreps;
        $seq = $seq.left($numnotes);
        $panoffset = xrand();
        $onsets = $onset + arithmser(0, 1, null, length($seq) + 1).scale(@outmax $duration @slope $slope);
        $durs = x2dx($onsets $duration);
        for $mc in $seq, $onset in $onsets, $dur in $durs do (
            $nt = $t / $duration;
            $vel = samplebpf($velbpf, $nt);
            $mindb = atodb(($vel / 127) ** 3);
            ezsol(
                @pitch $mc
                @names 'flute' 'sax' 'clar' 'acc' 
                @types 'ord' 'ord-high' 'ord-micro' 
                @velocity $vel
                @duration $dur + 90
                @useseed 1
            ).clipnorm(@minlevel $mindb).transcribe(
                @onset $onset
                @gain [0 1 0] [1 0 0.9] 
                @pan fold(mc2pan($mc, 0.2) + $panoffset) 
            );
            $t += $dur
        ) 
    ) 
);
$meta = read('../03_leadup/leadup.txt');
$meta2 = read('../01_foreground/foreground.txt');
$tempo = $meta2.'tempo';
$beatdur = 60000 / $tempo;
$bardur = $beatdur * 4;
$chord = $meta.'next_chord'.sort();
$totdur = $bardur * 3/8 * 7;
$finalunit = $bardur * 1/16;
$velocity = [0 45 0] [1 127 0.3];
$numvoices = 3;
for $vel $id in (
    ## [revbpf($velocity)] 
    ## 
    [$velocity] 
) with @unwrap 1 do (
    for $i in 1...($numvoices * $id) do (
        $slope = xrand(0.1, 0.3) * (if $id == 1 then -1 else 1);
        Swirl(
            @chord $chord
            @duration $totdur
            @velocity $vel
            @length null
            @slope $slope
        ) 
    ) 
);
$ampenv = [0 0.707 0] [0.25 0.125 -0.25] [1 1 0.8];
$bassmc = $chord:1;
$bassfq = $bassmc.mc2f() * 0.5;
cycle(
    @frequency [0 $bassfq * c2r(50) 0] [1 $bassfq -0.125] 
    @duration $totdur
    @phase xrand() 
).transcribe(
    @gain $ampenv @pan xrand() xrand() 
);
for $mc $mci in ($bassmc $chord:2) - 1200, $start in 0 $totdur do (
    $offset = 0;
    $bass = bass(
        @pitch $mc
        @duration $totdur
        @type 'bartok' 
        @velocity 127
        @useseed 1
    );
    $process = gain([0 1 0] [1 0 0.8]);
    if $mci == 2 then (
        $process _= reverse();
        $offset -= $bass.getkey('duration') 
    );
    $bass.process($process).transcribe(
        @onset $start + $offset @pan xrand() 
    ) 
);
$t = 0;
for $mc in $chord do (
    $fn = xchoose(ezsol pno @weights 4 1);
    $start = $totdur + $t - 200;
    $b = $fn(
        @pitch $mc
        @duration 4000
        @velocity 127
        @names family('strings') family('plucked') 
        @types 'pizz' 'pizz-secco' 
    );
    $b.clipnorm(@minlevel -19 @maxlevel -3).transcribe(
        @onset $start
        @gain [0 1 0] [1 0 0.5] 
        @pan mc2pan($mc, 0.5) 
    );
    cycle(
        @frequency $mc.mc2f() * xrandom(-2, 4).exp2() 
        @duration 300 * xrand(0, 4).exp2() 
        @phase xrand() 
    ).transcribe(
        @onset $start
        @gain [0 $b.getkey('maxabs') * 0.25 0] [1 0 -xrand(1/3, 3/4)] 
        @pan xrand() 
    );
    $t += xrand(70) 
);
$t = $totdur;
for $o $oi in -2...0 do (
    bass(
        @pitch $chord:1 - $o * 1200
        @velocity 127
        @duration null
        @type xchoose('pizz' 'bartok') 
    ).transcribe(
        @onset $t @pan xrand() 
    ) 
);
$downbeatdur = 3000;
cycle(
    @frequency $chord:2.mc2f() / 2 @duration $downbeatdur
).transcribe(
    @onset $totdur @gain [0 1 0] [1 0 -0.5] 
);
$tail = 300;
$b = render(
    @reset 1 @process freeverb(
        @roomsize 0.98
        @wet [0 0.05 0] [$totdur / ($totdur + $downbeatdur) 0 -0.125] [1 0 0] 
        @damp 1
        @width 1
        @tail $tail
    ) fade(0, $tail) normalize(-3) 
);
$bl = $b.setkey('duration', $totdur);
$bl.detach().process(normalize(-3)).transcribe();
$shift = 0;
$shift += $totdur;
for $rampdur in arithmser(0, 1, null, 4).scale(0, 1, 500, 2000, 0.125), $headtime in arithmser(-5, 5, null, 4) do (
    $timeramp = timeramp(
        @duration $rampdur
        @length 15
        @slope 0.22
    );
    $pizz = ezsol(
        @pitch $chord:1 - 1200
        @velocity 127
        @duration min($rampdur * 3, 3000) 
        @names 'bass' 
        @types 'bartok' 
        @useseed 1
    ).process(
        gain(0.125) panning(
            @position xrand(-1, 1) * 0.125 + 0.5 @numchannels 2
        ) 
    );
    for $dur in $timeramp do (
        $bm = $b.setkey(
            'offset',  (($totdur - $dur) + $headtime) 
        ).process(mix($pizz)).setkey('duration', max(25 , $dur));
        $bm.process(
            gain([0 1 0] [1 0 -0.125]) 
        ).transcribe(
            @onset $shift @pan xrand() 
        );
        $shift += $dur
    ) 
);
$br = $b.setkey('offset', $totdur);
$br.transcribe($shift);
$bassdur = 2000;
cycle(
    @frequency mc2f($chord:1) / 2 @duration $bassdur
).transcribe(
    @onset $shift - $bassdur
    @gain [0 0 0] [1 0.125 2/3.] 
    @pan 0 1 0.5
);
render(
    @play 1 @process normalize(@level -18 @rms 1) arctan() normalize(-3) 
);
ezexport($shift)