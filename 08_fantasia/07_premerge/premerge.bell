setseed(33);
$t = 0;
$meta = read('../01_foreground/foreground.txt');
$tempo = $meta.'tempo';
$totdur = $meta.'totdur';
$beatdur = 60000 / $tempo;
$bardur = $beatdur * 4;
$unit = $bardur * 1/16;
$split = read('../02_percussion/percussion.txt').getkey('onset');
$basemarkers = $meta.'markers';
$wetenv = for $m in $basemarkers collect (
    $x = $m.getkey('onset') / $totdur;
    $y = xrand().scale(0, 1, 0.005, 0.0125, 0.25);
    $s = xrand(-0.125, 0.125);
    [$x $y $s] 
);
$reverb = freeverb(
    @roomsize 0.85
    @wet $wetenv
    @damp 1
    @width 1
);
$base = importaudio('../01_foreground/foreground.wav').process($reverb);
$base1 = $base.setkey('duration', $split);
$base2 = $base.setkey('offset', $split);
$base1.process(normalize(-3)).transcribe($t);
$t += $split;
$b = importaudio('../03_leadup/leadup.wav');
$leadupmeta = read('../03_leadup/leadup.txt');
$b.transcribe(
    $t - $leadupmeta.'duration' @gain 0.33
);
$b = importaudio('../06_transient/transient.wav');
$b.transcribe($t - read('../06_transient/transient.txt'));
importaudio('../05_bridge/bridge.wav').transcribe($t);
$t += read('../05_bridge/bridge.txt');
$tail = $base2.process(
    mix(
        importaudio('../02_percussion/percussion.wav') @gains 0.707 1
    ) arctan() normalize(-3) 
).setkey('duration', $totdur - $split);
$segs = $tail.splitbuf(@split $unit);
$numsegs = length($segs);
$slopebpf = [0 0.5 0] [1 -0.5 -0.25];
$maskbpf = [0 1 0] [1 0.25 0.85];
$stutterbpf = [0 0 0] [1 1 0.4];
$maxnumcopies = 4;
$lastonset = 0;
$speedbpf = [0 1 0] [2/3. 1 0] [1 2 0.5];
$reset = 0;
$gates = null;
for $seg $segid in $segs do (
    $nt = ($segid - 1) / ($numsegs - 1);
    $speed = samplebpf($speedbpf, $nt);
    $mask = samplebpf($maskbpf, $nt);
    if $mask > xrand() then (
        if $reset == 1 then ($gates _= [$t $reset]);
        $reset = 0;
        $slope = samplebpf($slopebpf, $nt);
        $stutter = samplebpf($stutterbpf, $nt);
        $copyweights = (1 0 :* ($maxnumcopies - 1)) * (1 - $stutter) + $stutter * rev(
            exp2(
                (0...($maxnumcopies - 1)) 
            ) 
        );
        $copy = $seg.process(
            gain([0 1 0] [1 0 $slope]) 
            ## ---
            normalize(-8) 
        );
        $numcopies = xchoose(1...4 @weights $copyweights);
        $copydur = $copy.getkey('duration') / $numcopies;
        $shift = 0;
        $lastonset = $t;
        for $c in 1...$numcopies do (
            $copy.setkey('duration', max(25, $copydur)).process(
                normalize(-18 @rms 1) arctan() normalize(-6.25) 
            ).transcribe(@onset $t + $shift);
            $shift += $copydur
        ) 
    ) else (
        if $reset == 0 then ($gates _= [$t $reset]);
        $reset = 1
    );
    $t += $unit * $speed
);
$gates _= [$t $reset];
render(
    @play 1 @process normalize(-3) 
);
ezexport(['totdur' $lastonset] ['gates' $gates])