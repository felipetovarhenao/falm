$chord = 1/8 1/4 3/8 1/2 6/10 3/4 7/8 1 6/5 4/3 3/2 7/4 2 9/4 8/3 3 7/2 4 9/2 24/5 16/3 6 8;
$chord = $chord.sort().print().slice(int($chord.length() / 2));
$chord = trans($chord:2 [$chord::1.rev()]).flat();
$chord = $chord.r2mc(@mc 6200);
$t = 0;
$N = length($chord) + 16;
$velbpf = [0 0 0] [1 127 0.45];
$fadeinbpf = [0 1000 0] [1 0 -0.125];
$quantbpf = [0 0 0] [1 1 0.5];
$pcs = r2pc(1 5/4 3/2 5/3 9/8 15/8 7/5 @pc 2);
for $i in 1...($N) do (
    $x = scale($i, 1, $N, 0, 1).min(1);
    $vel = samplebpf($velbpf, $x);
    $fadein = samplebpf($fadeinbpf, $x);
    $quant = samplebpf($quantbpf, $x);
    $durs = null;
    for $mc in $chord.left($i) collect (
        $type = 'nonvib';
        if $vel > 100 && rand() > 0.5 then ($type = choose(
            'ord' 'ord-to-crushed' 'nonvib' 'cresc-to-dim' 'pont' 'tasto' 
        ));
        $mc += pitchdiff($mc, $pcs) * $quant;
        $b = choose(violin cello viola)(
            @pitch $mc
            @duration null
            @type $type
            @velocity min(
                127, max(0, $vel + random(-1, 1) * 10) 
            ) 
        );
        if $fadein > 0 then (
            $b = $b.process(fade($fadein, 0)) 
        );
        $durs _= $b.analyze(effectiveduration(@thresholdratio 0.0001)).getkey('effectiveduration');
        $b.transcribe(
            @onset $t @pan rand() 
        ) 
    );
    $mindur = minimum($durs);
    $t += $mindur
);
render(
    @play 1 @process freeverb(
        @roomsize 0.9
        @wet [0 0.0001 0] [1 0.025 0.3] 
        @width 1
        @damp 1
    ) normalize() 
)