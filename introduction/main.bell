$onset = 0;
$metadata = read('./strings.txt');
importaudio('./strings.wav').transcribe(@onset $onset);
importaudio('./runs.wav').transcribe(@onset $onset @gain 0.25);
$lastevent = $metadata.getkey('events'):-1;
$onset += $lastevent.getkey('onset') + $lastevent.getkey('duration') * 2.5;
importaudio('./tail.wav').transcribe($onset);
render(
    @play 1 @process (
        dynamics(
            @knee 0.33
            @thresh -30
            @ratio 4
        ) 
        ## 
        freeverb(
            @roomsize 0.95
            @wet 0.025
            @damp 1
            @width 1
        ) 
        ## 
        normalize(-3) 
    ) 
);
ezexport($onset)