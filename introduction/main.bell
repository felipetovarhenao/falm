$metadata = read('./strings.txt');
$b = importaudio('./strings.wav');
$b.transcribe();
$b = importaudio('./tail.wav');
$last = $metadata.getkey('events'):-1;
$onset = $last.getkey('onset');
$dur = $last.getkey('duration');
$b.transcribe($onset + $dur * 2);
$b = importaudio('./runs.wav');
$b.transcribe(@gain 0.25);
render(
    @play 1 @process (
        dynamics(
            @knee 0.33
            @thresh -30
            @ratio 4
        ) 
        ## 
        freeverb(
            @roomsize 0.95
            @wet 0.025
            @damp 1
            @width 1
        ) 
        ## 
        normalize(-3) 
    ) 
);
ezexport()