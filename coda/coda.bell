$chord = jispectrum(
    @harmonics 1...64
    @ratios 1 9/8 8/7 5/4 9/7 3/2 7/5 11/8 5/3 15/8
    @root eb2 
).int().thin();
$t = 0;
$names = family('strings') family('winds') family('brass') family('plucked');
for $i in 0...3 do (
    for $mc in $chord.scramble() do (
        if rand() > 0.01 then (
            cycle(
                @frequency $mc.mc2f() * random(-1, 3).exp2() 
                @duration rand(100, 1000) 
                @phase rand() 
            ).transcribe(
                @onset $t
                @pan rand() 
                @gain [0 rand(0.001, 0.025) 0] [1 0 -rand(1/4, 3/4)] 
            ) 
        );
        ezsol(
            @pitch $mc
            @duration null
            @types 'nonvib' 'ord' 'harm' 'air' 'air-and-ord' 
            @names $names
            @velocity 0
        ).transcribe(
            @onset $t @pan mc2pan($mc) 
        );
        $t += rand(200) 
    );
    $t += 5000
);
render(
    @play 1 @process freeverb(
        @roomsize 0.97
        @wet [0 0.025 0] [1 0.3 0.25] 
        @damp 1
        @width 1
    ) 
);
ezexport()