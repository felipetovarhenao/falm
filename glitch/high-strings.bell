FastArpeggio = (
    $onset = 0, $duration = 500 -> (
        $offset = 500;
        $numnotes = random(5, 10);
        $onsetbpf = [0 0 0] [1 $duration 0.25];
        $onsets = for $n in 0...$numnotes collect (
            $nt = $n / $numnotes;
            $t = samplebpf($onsetbpf, $nt);
            $t
        );
        $chord = pcquant(r2mc(1...32, 5500), r2pc(1 5/4 9/8 15/8 3/2));
        $durs = x2dx($onsets);
        $legato = 1.5;
        $dur *= $legato;
        $env = choose(
            [hanning()] [[0 1 0] [1 0 -0.25]] [[0 0 0] [1 1 0.25]] 
        )::1;
        for $t in $onsets, $dur in $durs do (
            $mc = choose($chord);
            if rand() > 0.25 then (
                $b = setkey(
                    setkey(
                        ezsol(
                            @pitch $mc
                            @names 'violin' 'viola' 'cello' 
                            @types 'ord' 
                            @velocity 128
                            @duration $dur + $offset
                        ), 'offset', $offset
                    ), 'duration', $dur
                ) 
            ) else (
                $b = sinewave(
                    @pitch $mc
                    @velocity rand(30, 80) 
                    @duration $dur
                    @envelope [0 0.125 0] 
                ) 
            );
            transcribe(
                @buffer $b
                @onset $onset + $t
                @gain $env
                @pan mc2pan($mc, 0.5) 
            ) 
        );
        $bassfq = mc2f(
            (
                mc2pc(choose($chord)) + 36
            ) * 100
        );
        $b = cycle(
            @frequency $bassfq
            @duration $duration * exp2(rand(-2, 0)) 
            @phase rand() 
        );
        transcribe(
            @buffer $b
            @onset $onset
            @gain [0 rand(0.05, 0.125) 0] [1 0 -rand(1/3, 3/4)] 
        ) 
    ) 
);
CrushedCresc = (
    $onset = 0, $duration = 1000 -> (
        $chord = pcquant(r2mc(1...32, 5500 - 1200), r2pc(1 5/4 9/8 15/8 3/2));
        $offset = rand(100, 300);
        $mc = choose($chord);
        $b = ezsol(
            @pitch $mc
            @names 'violin' 'viola' 'cello' 
            @types 'crushed-to-ord' 
            @duration $duration + $offset
        );
        $b = setkey($b, 'offset', $offset);
        $b = setkey($b, 'duration', $duration);
        $env = [0 0 0] [1 1 rand(1/3, 3/4)];
        $b = process(
            @buffer $b @operations gain($env) normalize(rand(-12, -8)) 
        );
        $pan = mc2pan($mc, 0.707);
        transcribe(
            @buffer $b
            @onset $onset
            @pan $pan
        );
        $mc = $mc - random(-1, 3) * 1200 ;
        transcribe(
            @buffer sinewave(
                @pitch $mc
                @duration $duration * exp2(rand(-2, 0)) 
                @velocity rand(0.1, 1) * 50
            ) 
            @onset $onset + $duration
            @pan 1 - $pan
        );
        $fq = mc2f($mc) * 0.25;
        $b = cycle(
            @frequency $fq
            @duration $duration
            @phase rand() 
        );
        transcribe(
            @buffer $b
            @onset $onset
            @pan mc2pan($mc) 
            @gain bpf($env @yfunc $y -> $y * 0.125) 
        ) 
    ) 
);
Strum = (
    $onset = 0, $duration = 1000 -> (
        $pc = choose(r2pc(1 4/3 3/2));
        $chord = pcquant(r2mc(1...32, 5500 - 2400), r2pc(1 5/4 9/8 15/8 3/2, $pc));
        $chord = $chord.scramble().left(10).sort();
        $t = 0;
        for $mc in $chord do (
            ezsol(
                @pitch $mc
                @types 'stacc' 'pizz' 'pizz-secco' 
                @names 'violin' 'viola' 'cello' 'bass' 
                @velocity rand(127) 
                @duration $duration * 3
            ).transcribe(
                @onset $onset + $t
                @pan mc2pan($mc, 0.25) 
                @gain [0 1 0] [1 0 0.25] 
            );
            $t += 5
        ) 
    ) 
);
Rest = (-> null);
SustainedChord = (
    $onset = 0, $duration = 1000 -> (
        $pc = 0;
        $chord = pcquant(r2mc(1...32, 5500 - 1200), r2pc(1 5/4 9/8 15/8 3/2, $pc));
        $chord = $chord.scramble().left(10).sort();
        $reps = random(2, 7);
        $process = fade(2, 2) repeat($reps);
        if rand() > 0.5 then (
            $env = choose(
                ## -----
                [[0 0 0] [1 1 0.5]] 
                ## -----
                [[0 1 0] [1 0 -0.5]] 
                ## -----
                [hanning()] 
            )::1;
            $process !_= gain($env) 
        );
        $dur = $duration / $reps;
        for $mc in $chord do (
            $vel = rand(127);
            $pan = abs(mc2pan($mc) - (1 0));
            ezsol(
                @pitch $mc
                @names 'violin' 'viola' 'cello' 
                @types 'nonvib' 
                @duration $dur
                @velocity $vel
            ).process($process).transcribe(
                @onset $onset @pan $pan
            ) 
        ) 
    ) 
);
HarmGliss = (
    $onset = 0, $duration = 1000 -> (
        $name = choose(
            'violin' 'viola' 'cello' 'bass' 
        );
        $type = 'nat-harm-gliss';
        $file = choose(samples(@name $name @type $type));
        $b = importaudio($file).analyze(effectiveduration(@thresholdratio 0.001));
        $b = $b.setkey('duration', $b.getkey('effectiveduration'));
        $b = $b.process(gain(1.414) resample(@duration $duration @timeunit 0));
        $b.transcribe(
            @onset $onset @pan abs(rand() - 0.5) * 0.2
        ) 
    ) 
);
SynthChord = (
    $onset = 0, $duration = 1000 -> (
        $pc = 0;
        $chord = pcquant(r2mc(1...32, 5500 - 1200), r2pc(1 5/4 9/8 15/8 3/2, $pc));
        $chord = $chord.scramble().left(5).sort();
        for $mc in $chord do (
            $wave = choose(sinewave triwave rectwave sawwave);
            $b = $wave(
                @pitch $mc + 2400
                @duration $duration
                @velocity rand(2, 30) 
                @envelope [0 0.5 0] 
            );
            $env = [0 0 0] [1 1 rand(1/3, 3/4)];
            if rand() > 0.5 then ($env = revbpf($env));
            for $v in 1...random(1, 4) do (
                $b.transcribe(
                    @onset $onset
                    @pan mc2pan($mc) 
                    @detune rand(0, -5) 
                    @gain $env
                ) 
            ) 
        ) 
    ) 
);
$onset = 0;
$bardur = 2150.;
$durs = $bardur * thin(1/8 3/16 5/16 1/4 3/8 7/16 1/2 5/8);
$objects = (
    ## ----
    FastArpeggio
    ## ----
    CrushedCresc
    ## ----
    Strum
    ## ----
    Rest
    ## ----
    SustainedChord
    ## ----
    HarmGliss
    ## ----
    SynthChord
);
for $i in 1...50 do (
    $dur = choose($durs);
    $obj = choose(
        @choices $objects @weights rev(1...7) 
    );
    $obj(@onset $onset @duration $dur);
    $onset += $dur
);
render(
    @play 1 @process dynamics(
        @knee 0.1
        @ratio 3
        @thresh -30
        @release 200
    ) normalize(-3) freeverb(
        @roomsize 0.6
        @wet 0.0125
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport()