$obj1 = (
    $onset = 0, $duration = 500 -> (
        $offset = 500;
        $numnotes = random(5, 10);
        $onsetbpf = [0 0 0] [1 $duration 0.25];
        $onsets = for $n in 0...$numnotes collect (
            $nt = $n / $numnotes;
            $t = samplebpf($onsetbpf, $nt);
            $t
        );
        $chord = pcquant(r2mc(1...32, 5500), r2pc(1 5/4 9/8 15/8 3/2));
        $durs = x2dx($onsets);
        $legato = 1.5;
        $dur *= $legato;
        $env = choose(
            [hanning()] [[0 1 0] [1 0 -0.25]] [[0 0 0] [1 1 0.25]] 
        )::1;
        for $t in $onsets, $dur in $durs do (
            $mc = choose($chord);
            if rand() > 0.25 then (
                $b = setkey(
                    setkey(
                        ezsol(
                            @pitch $mc
                            @names 'violin' 'viola' 'cello' 
                            @types 'ord' 
                            @velocity 128
                            @duration $dur + $offset
                        ), 'offset', $offset
                    ), 'duration', $dur
                ) 
            ) else (
                $b = sinewave(
                    @pitch $mc
                    @velocity rand(30, 80) 
                    @duration $dur
                    @envelope [0 0.125 0] 
                ) 
            );
            transcribe(
                @buffer $b
                @onset $onset + $t
                @gain $env
                @pan mc2pan($mc, 0.5) 
            ) 
        ) 
    ) 
);
$obj2 = (
    $onset = 0, $duration = 1000 -> (
        $chord = pcquant(r2mc(1...32, 5500 - 1200), r2pc(1 5/4 9/8 15/8 3/2));
        $offset = rand(100, 300);
        $mc = choose($chord);
        $b = ezsol(
            @pitch $mc
            @names 'violin' 'viola' 'cello' 
            @types 'crushed-to-ord' 
            @duration $duration + $offset
        );
        $b = setkey($b, 'offset', $offset);
        $b = setkey($b, 'duration', $duration);
        $b = process(
            @buffer $b @operations gain(
                [0 0 0] [1 1 rand(1/3, 3/4)] 
            ) normalize(rand(-12, -8)) 
        );
        $pan = mc2pan($mc, 0.707);
        transcribe(
            @buffer $b
            @onset $onset
            @pan $pan
        );
        transcribe(
            @buffer sinewave(
                @pitch $mc - random(-1, 2) * 1200
                @duration $duration
                @velocity rand(0.1, 1) * 50
            ) 
            @onset $onset + $duration
            @pan 1 - $pan
        ) 
    ) 
);
$obj3 = (
    $onset = 0, $duration = 1000 -> (
        $pc = choose(r2pc(1 4/3 3/2));
        $chord = pcquant(r2mc(1...32, 5500 - 2400), r2pc(1 5/4 9/8 15/8 3/2, $pc));
        $chord = $chord.scramble().left(10).sort();
        $t = 0;
        for $mc in $chord do (
            ezsol(
                @pitch $mc
                @types 'stacc' 'pizz' 'pizz-secco' 
                @names 'violin' 'viola' 'cello' 'bass' 
                @velocity rand(127) 
                @duration $duration * 3
            ).transcribe(
                @onset $onset + $t
                @pan mc2pan($mc, 0.25) 
                @gain [0 1 0] [1 0 0.25] 
            );
            $t += 5
        ) 
    ) 
);
$obj4 = (-> null);
$obj5 = (
    $onset = 0, $duration = 1000 -> (
        $pc = 0;
        $chord = pcquant(r2mc(1...32, 5500 - 1200), r2pc(1 5/4 9/8 15/8 3/2, $pc));
        $chord = $chord.scramble().left(10).sort();
        $reps = random(2, 7);
        $process = fade(2, 2) repeat($reps);
        if rand() > 0.5 then (
            $env = choose(
                ## -----
                [[0 0 0] [1 1 0.5]] 
                ## -----
                [[0 1 0] [1 0 -0.5]] 
                ## -----
                [hanning()] 
            )::1;
            $process !_= gain($env) 
        );
        $dur = $duration / $reps;
        for $mc in $chord do (
            $vel = rand(127);
            $pan = abs(mc2pan($mc) - (1 0));
            ezsol(
                @pitch $mc
                @names 'violin' 'viola' 'cello' 
                @types 'nonvib' 
                @duration $dur
                @velocity $vel
            ).process($process).transcribe(
                @onset $onset @pan $pan
            ) 
        ) 
    ) 
);
$obj6 = (
    $onset = 0, $duration = 1000 -> (
        $name = choose(
            'violin' 'viola' 'cello' 'bass' 
        );
        $type = 'nat-harm-gliss';
        $file = choose(samples(@name $name @type $type));
        $b = importaudio($file).analyze(effectiveduration(@thresholdratio 0.001));
        $b = $b.setkey('duration', $b.getkey('effectiveduration'));
        $b = $b.process(resample(@duration $duration @timeunit 0));
        $b.transcribe(
            @onset $onset @pan abs(rand() - 0.5) * 0.2
        ) 
    ) 
);
$onset = 0;
$bardur = 2250.;
$durs = $bardur * (1/8 3/16 5/16 1/4 3/8 7/16 1/2);
for $i in 1...50 do (
    $dur = choose($durs);
    $obj = choose(@choices $obj1 $obj2 $obj3 $obj4 $obj5 $obj6 @weights 3 2 2 1 1 0.5);
    $obj(@onset $onset @duration $dur);
    $onset += $dur
);
render(
    @play 1 @process dynamics(@knee 0.1 @ratio 3) freeverb(
        @roomsize 0.6
        @wet 0.0125
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport()