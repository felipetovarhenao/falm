setseed(20);
FastArpeggio = (
    $onset = 0, $duration = 500 -> (
        $offset = 500;
        $numnotes = xrandom(5, 15);
        $onsetbpf = [0 0 0] [1 $duration xrand(1/4, 2/3) * xchoose(-1 1)];
        $onsets = for $n in 0...$numnotes collect (
            $nt = $n / $numnotes;
            $t = samplebpf($onsetbpf, $nt);
            $t
        );
        $chord = pcquant(r2mc(1...32, 5500), r2pc(1 5/4 9/8 15/8 3/2));
        $durs = x2dx($onsets);
        $legato = 1.5;
        $dur *= $legato;
        $env = xchoose(
            [hanning()] [[0 1 0] [1 0 -0.25]] [[0 0 0] [1 1 0.25]] 
        )::1;
        for $t in $onsets, $dur in $durs do (
            $mc = xchoose($chord);
            if xrand() > 0.25 then (
                $b = setkey(
                    setkey(
                        ezsol(
                            @pitch $mc
                            @names 'violin' 'viola' 'cello' 
                            @types 'ord' 
                            @velocity 128
                            @duration $dur + $offset
                        ), 'offset', $offset
                    ), 'duration', $dur
                ) 
            ) else (
                $b = sinewave(
                    @pitch $mc
                    @velocity xrand(30, 80) 
                    @duration $dur
                    @envelope [0 0.125 0] 
                ) 
            );
            transcribe(
                @buffer $b
                @onset $onset + $t
                @gain $env
                @pan mc2pan($mc, 0.5) 
            ) 
        );
        $bassfq = mc2f(
            (
                mc2pc(xchoose($chord)) + 36
            ) * 100
        );
        $b = cycle(
            @frequency $bassfq
            @duration $duration * exp2(xrand(-2, 0)) 
            @phase xrand() 
        );
        transcribe(
            @buffer $b
            @onset $onset
            @gain [0 xrand(0.05, 0.125) 0] [1 0 -xrand(1/3, 3/4)] 
        ) 
    ) 
);
CrushedCresc = (
    $onset = 0, $duration = 1000 -> (
        $chord = pcquant(r2mc(1...32, 5500 - 1200), r2pc(1 5/4 9/8 15/8 3/2));
        $offset = xrand(100, 300);
        $mc = xchoose($chord);
        $b = ezsol(
            @pitch $mc
            @names 'violin' 'viola' 'cello' 
            @types 'crushed-to-ord' 
            @duration $duration + $offset
        );
        $b = setkey($b, 'offset', $offset);
        $b = setkey($b, 'duration', $duration);
        $env = [0 0 0] [1 1 xrand(1/3, 3/4)];
        $b = process(
            @buffer $b @operations gain($env) normalize(xrand(-12, -8)) 
        );
        $pan = mc2pan($mc, 0.707);
        transcribe(
            @buffer $b
            @onset $onset
            @pan $pan
        );
        $mc = $mc - xrandom(-1, 3) * 1200 ;
        transcribe(
            @buffer sinewave(
                @pitch $mc
                @duration $duration * exp2(xrand(-2, 0)) 
                @velocity xrand(0.1, 1) * 50
            ) 
            @onset $onset + $duration
            @pan 1 - $pan
        );
        $fq = mc2f($mc) * 0.25;
        $b = cycle(
            @frequency $fq
            @duration $duration
            @phase xrand() 
        );
        transcribe(
            @buffer $b
            @onset $onset
            @pan mc2pan($mc) 
            @gain bpf($env @yfunc $y -> $y * 0.125) 
        ) 
    ) 
);
Strum = (
    $onset = 0, $duration = 1000 -> (
        $pc = xchoose(r2pc(1 4/3 3/2));
        $chord = pcquant(r2mc(1...32, 5500 - 2400), r2pc(1 5/4 9/8 15/8 3/2, $pc));
        $chord = $chord.xscramble().left(10).sort();
        $t = 0;
        for $mc in $chord do (
            ezsol(
                @pitch $mc
                @types 'stacc' 'pizz' 'pizz-secco' 
                @names 'violin' 'viola' 'cello' 'bass' 
                @velocity xrand(127) 
                @duration $duration * 3
            ).transcribe(
                @onset $onset + $t
                @pan mc2pan($mc, 0.25) 
                @gain [0 1 0] [1 0 0.25] 
            );
            $t += 5
        );
        $b = cycle(
            rand(5000, 9000) @duration 20
        ).process(
            gain(
                [0 rand(0.05, 0.1) 0] [1 0 -0.8] 
            ) 
        );
        for $t in arithmser(0, $duration, 2150. * 1/16.) do ($b.transcribe($onset + $t @pan rand())) 
    ) 
);
Rest = (-> null);
SustainedChord = (
    $onset = 0, $duration = 1000 -> (
        $pc = 0;
        $chord = pcquant(r2mc(1...32, 5500 - 1200), r2pc(1 5/4 9/8 15/8 3/2, $pc));
        $chord = $chord.xscramble().left(10).sort();
        $reps = xrandom(2, 7);
        $process = fade(2, 2) repeat($reps);
        if xrand() > 0.5 then (
            $env = xchoose(
                ## -----
                [[0 0 0] [1 1 0.5]] 
                ## -----
                [[0 1 0] [1 0 -0.5]] 
                ## -----
                [hanning()] 
            )::1;
            $process !_= gain($env) 
        );
        $dur = $duration / $reps;
        for $mc in $chord do (
            $vel = xrand(127);
            $pan = abs(mc2pan($mc) - (1 0));
            ezsol(
                @pitch $mc
                @names 'violin' 'viola' 'cello' 
                @types 'nonvib' 
                @duration $dur
                @velocity $vel
            ).process($process).transcribe(
                @onset $onset @pan $pan
            ) 
        ) 
    ) 
);
HarmGliss = (
    $onset = 0, $duration = 1000 -> (
        $name = xchoose(
            'violin' 'viola' 'cello' 'bass' 
        );
        $type = 'nat-harm-gliss';
        $file = xchoose(samples(@name $name @type $type));
        $b = importaudio($file).analyze(effectiveduration(@thresholdratio 0.001));
        $b = $b.setkey('duration', $b.getkey('effectiveduration'));
        $b = $b.process(gain(1.414) resample(@duration $duration @timeunit 0));
        $b.transcribe(
            @onset $onset @pan abs(xrand() - 0.5) * 0.2
        ) 
    ) 
);
SynthChord = (
    $onset = 0, $duration = 1000 -> (
        $pc = 0;
        $chord = pcquant(r2mc(1...32, 5500 - 1200), r2pc(1 5/4 9/8 15/8 3/2, $pc));
        $chord = $chord.xscramble().left(5).sort();
        for $mc in $chord do (
            $wave = xchoose(sinewave triwave rectwave sawwave);
            $b = $wave(
                @pitch $mc + 2400
                @duration $duration
                @velocity xrand(2, 30) 
                @envelope [0 0.5 0] 
            );
            $env = [0 0 0] [1 1 xrand(1/3, 3/4)];
            if xrand() > 0.5 then ($env = revbpf($env));
            for $v in 1...xrandom(1, 4) do (
                $b.transcribe(
                    @onset $onset
                    @pan mc2pan($mc) 
                    @detune xrand(0, -5) 
                    @gain $env
                ) 
            ) 
        ) 
    ) 
);
$onset = 0;
$bardur = 2150.;
$durs = $bardur * thin(1/8 3/16 5/16 1/4 3/8 7/16 1/2 5/8);
$objects = (
    ## ----
    FastArpeggio
    ## ----
    CrushedCresc
    ## ----
    Strum
    ## ----
    Rest
    ## ----
    SustainedChord
    ## ----
    HarmGliss
    ## ----
    SynthChord
);
for $i in 1...50 do (
    $dur = xchoose($durs);
    $obj = xchoose(
        @choices $objects @weights rev(1...7) 
    );
    $obj(@onset $onset @duration $dur);
    $onset += $dur
);
render(
    @play 1 @process dynamics(
        @knee 0.05
        @ratio 12
        @thresh -40
        @release 200
    ) normalize(-3) freeverb(
        @roomsize 0.6
        @wet 0.0125
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport()