$chord = pcquant(
    r2mc((4...32), c2), r2pc(1 5/4 9/8 15/8 3/2 5/3 7/5) 
);
$bardur = 2150.;
$totdur = $bardur * 1.5;
$delay = rand(5);
$numvoices = 9;
$mcs = $chord.scramble().left($numvoices);
$units = scramble(thin(1/8 3/16 5/16 1/4 7/16 11/16 3/4 3/8 1/12 1/20 1/16 1/32)).left($numvoices);
for $mc $v in $mcs, $unit in $units do (
    $legato = exp2(rand(-2, 0));
    $t = 0;
    $notedur = $unit * $bardur;
    $del = ($v - 1) * $delay;
    $gainbpf = [0 rand(0.01, 0.25) 0] [1 1 rand(1/3, 3/4)];
    if rand() > 0.5 then ($gainbpf = revbpf($gainbpf));
    $b = choose(ezsol sinewave @weights 4 1)(
        @pitch $mc
        @names family('strings') 
        @types 'stacc' 
        @duration $notedur * $legato
        @velocity 25
    ).process(
        gain(
            [0 1 0] [1 0 rand(1/3, 3/4)] 
        ) 
    );
    while $t < $totdur do (
        $nt = $t / $totdur;
        $gain = samplebpf($gainbpf, $nt);
        $b.transcribe(
            @onset $t + $del
            @pan mc2pan($mc, 0.5) 
            @gain $gain
        );
        $t += $notedur
    ) 
);
render(
    @play 1
    @fade 0
    @process normalize(-9) ezverb() 
)