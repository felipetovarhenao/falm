$chord = pcquant(
    r2mc((4...16), e0), r2pc(1 5/4 9/8 15/8 3/2 5/3 7/5, 4) 
);
$seq = randomseq(
    @llll $chord
    @length 4
    @steps 2 -1
);
$t = 0;
$bardur = 2000.;
$units = sort(3/16 1/8 1/16 5/16);
for $mc in $seq :* 4 do (
    $shift = 0;
    $del = random(1, 3) / 16;
    for $oct in 0 rev(1...5) * 1200 do (
        ezsol(
            @names 'bass' 'cello' 'violin' 'viola' 
            @types 'pizz' 'pizz-secco' 
            @pitch $mc + $oct
            @velocity 10
            @duration 2000
        ).transcribe(
            @onset $t + $shift @pan mc2pan($mc, 0.2) 
        );
        $shift += $del * $bardur
    );
    $t += choose($units) * $bardur
);
render(
    @play 1 @process dynamics(
        @knee 0.05
        @ratio 12
        @thresh -40
        @release 200
    ) normalize(-3) ezverb() 
);
ezexport()