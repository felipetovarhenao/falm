setseed(140);
$N = 4;
$M = 32;
$unit = 120;
$root = e3;
$pcroot = mc2pc($root);
$numattacks = ($M - $N + 1);
$chord = r2mc(($N...$M) / $N, $root).pcquant(r2pc(1 5/4 3/2 9/8 7/5 5/3 15/8, $pcroot));
for $fn in ($l -> $l) rev do (
    $events = null;
    $onsets = null;
    for $mc $m in $chord.$fn() do (
        $dur = $unit * 5;
        $b = ezsol(
            @names 'sax' 
            @pitch $mc
            @duration $dur
            @velocity 127
            @types 'stacc' 'slap-pitch' 'sfz' 'pizz' 'pizz-secco' 'keys' (if xrand() > 0.3 then 'slap-unpitch') (if xrand() > 0.3 then 'exp-slap-pitch') 
            @useseed 1
        ).process(normalize(-7));
        for $i $ii in (1...$numattacks) - 1 do (
            $nt = scale($ii, 1, $numattacks, 0, 1);
            $onset = $i * $unit * $m;
            $onsets _= $onset;
            $buffer = if xrand() > 0.1 then $b.setkey('duration', xrand(50, $dur)) else (
                sinewave(
                    @pitch $mc
                    @duration xrand(100, $dur) 
                    @velocity xrand(5, 64) 
                    @envelope [0 0.25 0] [1 0 -xrand(1/3, 3/4)] 
                ) 
            );
            $events _= [
                [ 'buffer' $buffer] ['onset' $onset] ['pan' mc2pan($mc, $nt * 0.5) ] [
                    'gain' [0 1 0] [1 0 xrand(-1/3, 1/3)] 
                ] 
            ] 
        ) 
    );
    $maxonset = maximum($onsets);
    for $e in $events do (
        $e.getkey('buffer').transcribe(
            @onset $maxonset - $e.getkey('onset') 
            @pan $e.getkey('pan') 
            @gain $e.getkey('gain') 
        ) 
    ) 
);
render(
    @play 1 @process dynamics(
        @knee 0.2
        @ratio 12
        @thresh -40
        @release 500
    ) normalize(-3) freeverb(
        @roomsize 0.75
        @wet [0 0.01 0] [1 0.0125 0.125] 
        @damp 0.5
        @width 0.5
    ) normalize(-3) 
);
ezexport($maxonset)