$wedgesort = (
    $llll -> (
        $size = length($llll);
        $llll = $llll.sort().slice(round($size / 2));
        $llll = trans($llll:2 [$llll::1.rev()]).flat();
        $llll
    ) 
);
$root = d2;
## create groups instead
$techniques = 'nonvib' :* 3 'ord' 'nonvib+mute' 'nonvib+piombo' 'pont' 'tasto' 'cresc' 'cresc-to-dim' 'ord-to-crushed' 'crushed-to-ord' 'trem' 'sfz' 'harm';
$names = 'violin' 'viola' 'cello' 'bass';
$rootpc = $root.mc2pc();
$chord = r2mc(1...32 @mc $root);
$pcs1 = r2pc(1 10/9 6/5 4/3 3/2 8/5 7/4, $rootpc);
$pcs2 = r2pc(1 9/8 5/4 7/5 3/2 5/3 15/8, $rootpc);
$chord1 = $wedgesort(
    thin(
        for $mc in $chord collect int(
            round($mc + pitchdiff($mc, $pcs1)) 
        ) 
    ) 
);
$chord2 = (for $mc in $chord1 collect $mc + pitchdiff($mc, $pcs2));
$t = 0;
$totaldur = 120000;
$climax = 0.618033;
$slope = 0.25;
$glissbpf = [0 0 0] [$climax 1 $slope] [1 1 0];
$velbpf = [0 0 0] [1 127 $slope];
$chordiszebpf = [0 1 0] [1 length($chord1) $slope];
$numtechniquesbpf = [0 1 0] [1 length($techniques) 0.75];
$chordpan = $wedgesort(
    arithmser(0, 1, null, length($chord1)) 
);
$fadeinbpf = [0 1000 0] [1 0 -0.5];
while $t < $totaldur do (
    $nt = $t / $totaldur;
    $gliss = samplebpf($glissbpf, $nt);
    $vel = samplebpf($velbpf, $nt);
    $fadein = samplebpf($fadeinbpf, $nt);
    $chordsize = int(
        round(samplebpf($chordiszebpf, $nt)) 
    );
    $numtechniques = max(
        1, int(samplebpf($numtechniquesbpf, $nt)) 
    );
    $chord = thin($chord1 * (1 - $gliss) + $chord2 * $gliss);
    $mindur = $totaldur;
    $mcs = $chord.left($chordsize);
    for $mc in $mcs, $pan in $chordpan.left($chordsize) do (
        $instruments = for $n in $names collect instrument($n, $techniques.left($numtechniques));
        $instrument = $instruments.pitchfilter($mc, 700).choose();
        $fn = $instrument.getkey('fn');
        $types = $instrument.getkey('types').choose();
        $b = $fn(
            @pitch $mc
            @duration null
            @velocity min(
                127, max(0, $vel + random(-15, 15) ) 
            ) 
            @type $types
        ).process(fade(@fadein $fadein, @fadeout 0));
        $mindur = min(
            $mindur, $b.analyze(effectiveduration(@thresholdratio 0.005)).getkey('effectiveduration') 
        );
        $b.transcribe(
            @onset $t @pan $pan
        ) 
    );
    $t += $mindur ||| 3000.print() 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.9
        @wet [0 0.001 0] [1 0.025 0.125] 
        @damp 1
        @width 1
        @tail 5000
    ) normalize(-3) 
);
export(
    './' + thispath().getkey('name') + '.wav' 
)