## $overlap = 4;
## $factor = 1.5;
## $incr = $split / $overlap;
## $segs = $b.splitbuf(@split $split @overlap $overlap * $factor);
## $t = 0;
## $var = max(0, $factor - 1) / 2;
## for $s in $segs do (
##     $s.process(window()).transcribe($t + xrand(-$var, $var) * $incr);
##     $t += $incr
## );
render(
    @play 1 @process freeverb(
        @roomsize 0.9
        @wet 0.2
        @damp 1
        @width 1
    ) 
);
export(
    './' + thispath(1).getkey('name') + '.wav' 
)