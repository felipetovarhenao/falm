$chord = r2mc(1/2 1...64, d3);
$pcs = r2pc(1 3/2, 2);
$chord = thin(
    for $mc in $chord collect int(
        round($mc + pitchdiff($mc, $pcs)) 
    ) 
);
$instrumentnames = 'violin' 'viola' 'cello' 'bass';
$techniques = 'nonvib' 'ord';
for $mc in $chord do (
    $instruments = for $n in $instrumentnames collect instrument($n, $techniques @join 0);
    $instruments = pitchfilter($instruments, $mc, 800);
    $instrument = choose($instruments);
    $fn = $instrument.getkey('fn');
    $type = $instrument.getkey('types').choose();
    $b = $fn(
        @pitch $mc
        @type $type
        @velocity 0
        @duration null
    ).analyze(effectiveduration(@thresholdratio 0.01));
    $b = $b.setkey('duration', $b.getkey('effectiveduration')).process(fade(0, 2000));
    $b.transcribe(@pan rand()) 
);
$b = render(@reset 1);
$split = 300;
$overlap = 4;
$factor = 2;
$incr = $split / $overlap;
$segs = $b.splitbuf(@split $split @overlap $overlap * $factor);
$t = 0;
for $s in $segs do (
    $s.process(window()).transcribe($t + rand(-0.125, 0.125) * $incr);
    $t += $incr
);
render(
    @play 1 @process freeverb(
        @roomsize 0.9
        @wet 0.2
        @damp 1
        @width 1
    ) 
);
export(
    './' + thispath(1).getkey('name') + '.wav' 
)