$metadata = read('./chordinterpolation.meta.txt');
$b = importaudio('./chordinterpolation.wav');
$b.transcribe();
$b = importaudio('./ending.wav');
$last = $metadata.getkey('events'):-1;
$onset = $last.getkey('onset');
$dur = $last.getkey('duration');
$b.transcribe($onset + $dur * 2);
$b = importaudio('./runs2.wav');
$b.transcribe(@gain 0.25);
render(
    @play 1 @process freeverb(
        @roomsize 0.95
        @wet 0.025
        @damp 1
        @width 1
    ) normalize(-3) 
);
export('./gloria.wav')