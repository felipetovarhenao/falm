setseed(9);
Swirl = (
    $onset = 0, $duration = 1000, $chord = null, $length = null, $velocity = 127, $slope = 0.125 -> (
        $t = 0;
        $velbpf = bpf($velocity);
        $maxnumnotes = round($duration / 90);
        $seqlength = $length ||| xrandom(2, 5);
        $numnotes = xrandom($maxnumnotes // 2, $maxnumnotes);
        $numreps = ceil($numnotes / $seqlength);
        $seq = randomseq(
            @llll $chord
            @length $seqlength
            @steps -2 -1 1 2
            @useseed 1
        );
        $seq = $seq :* $numreps;
        $seq = $seq.left($numnotes);
        $unit = $duration / $numnotes;
        $panoffset = xrand();
        $onsets = $onset + arithmser(0, 1, null, length($seq) + 1).scale(@outmax $duration @slope $slope);
        $durs = x2dx($onsets $duration);
        for $mc in $seq, $onset in $onsets, $dur in $durs do (
            $nt = $t / $duration;
            $vel = samplebpf($velbpf, $nt);
            $mindb = atodb(($vel / 127) ** 2);
            ezsol(
                @pitch $mc
                @names 'flute' 'sax' 'clar' 'acc' 
                @types 'ord' 'ord-high' 'ord-micro' 
                @velocity $vel
                @duration $dur + 50
                @useseed 1
            ).clipnorm(@minlevel $mindb).transcribe(
                @onset $onset
                @gain [0 1 0] [1 0 0.9] 
                @pan fold(mc2pan($mc, 0.2) + $panoffset) 
            );
            $t += $dur
        ) 
    ) 
);
$meta = read('../03_leadup/leadup.txt');
$meta2 = read('../01_foreground/foreground.txt');
$tempo = $meta2.'tempo';
$beatdur = 60000 / $tempo;
$bardur = $beatdur * 8;
$chord = $meta.'chord'.sort();
$totdur = $bardur * 3/8 * 3;
$velocity = [0 1 0] [1 127 0.35];
$numvoices = 2;
for $vel $id in (
    [revbpf($velocity)] 
    ## 
    [$velocity] 
) with @unwrap 1 do (
    for $i in 1...($numvoices * $id) do (
        ## --—
        Swirl(
            @chord $chord
            @duration $totdur
            @velocity $vel
            @length null
            @slope xrand(0.1, 0.25) * (if $id == 2 then -1 else 1) 
        ) 
    ) 
);
$ampenv = [0 0.5 0] [0.5 0.0125 -0.25] [1 0.5 0.5];
$bassmc = $chord:1;
cycle(
    @frequency $bassmc.mc2f() @duration $totdur
).transcribe(@gain $ampenv);
for $mc in ($bassmc $chord:2) - 1200, $start in 0 $totdur do (
    bass(
        @pitch $mc
        @duration null
        @type 'bartok' 
        @velocity 127
        @useseed 1
    ).process(normalize(-3)).transcribe(
        @onset $start @pan xrand() 
    ) 
);
$downbeatdur = 3000;
cycle(
    @frequency $chord:2.mc2f() / 2 @duration $downbeatdur
).transcribe(
    @onset $totdur @gain [0 1 0] [1 0 -0.5] 
);
$tail = 300;
render(
    @play 1 @process freeverb(
        @roomsize 0.98
        @wet [0 0.05 0] [$totdur / ($totdur + $downbeatdur) 0 -0.125] [1 0 0] 
        @damp 1
        @width 1
        @tail $tail
    ) fade(0, $tail) normalize(-3) 
);
ezexport($totdur)