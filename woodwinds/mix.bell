setseed(20);
$t = 0;
$meta = read('./main.txt');
$tempo = $meta.'tempo';
$totdur = $meta.'totdur';
$beatdur = 60000 / $tempo;
$bardur = $beatdur * 4;
$unit = $bardur * 1/16;
$split = read('./dance.txt');
$base = importaudio('./main.wav');
$base1 = $base.setkey('duration', $split);
$base2 = $base.setkey('offset', $split);
$base1.transcribe($t);
$t += $split;
$t += $unit * 9;
$tail = $base2.process(
    mix(importaudio('./dance.wav')) 
).setkey('duration', $totdur - $split);
$segs = $tail.splitbuf(@split $unit);
$numsegs = length($segs);
$slopebpf = [0 0.999 0] [1 -0.5 -0.1];
$maskbpf = [0 1 0] [1 0 0.8];
for $seg $segid in $segs do (
    $nt = ($segid - 1) / ($numsegs - 1);
    $mask = samplebpf($maskbpf, $nt);
    if $mask > xrand() then (
        $slope = samplebpf($slopebpf, $nt);
        $seg.clipnorm(@minlevel -10 @maxlevel -6).transcribe(
            @onset $t @gain [0 1 0] [1 0 $slope] 
        ) 
    );
    $t += $unit
);
render(
    @play 1 @process freeverb(
        @roomsize 0.9
        @wet [0 0 0] [1 0.0125 0.125] 
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport()