setseed(0);
$meta = read('./main.txt');
$root = f#3;
$peak = $meta.'peak';
$tempo = $meta.'tempo';
$beatdur = 60000 / $tempo;
$bardur = $beatdur * 4;
$markers = $meta.'markers';
$onsets = null;
$cycleonsets = null;
for $x in $markers do (
    $onset = $x.getkey('onset');
    $onsets _= $onset;
    if $x.getkey('index') == 1 then (
        $cycleonsets _= $onset;
        $x
    ) 
);
$peakmarkerid = nearest(
    @list $onsets
    @target $peak
    @mode 1
);
$peak = $onsets:$peakmarkerid;
$stop = 0;
$peakmarker = null;
$peakid = null;
for $i in -1 * (0...32) as $peakmarker == null || $stop == 0 do (
    $addr = ($peakmarkerid + $i);
    $marker = $markers:$addr;
    $index = $marker.getkey('index');
    if $index == 1 then (
        $peakmarker = $marker;
        $peakid = $addr
    ) else if $index == 4 then ($stop = 1) 
);
$peakmarkerid = $peakid;
$peak = $peakmarker.getkey('onset');
$markers = $markers.right($peakmarkerid - 1);
$velpattern = int(
    round(scale(3 2 3 4 0 8 1 2 9 1 10 2, 0, 10, 1, 127, -0.125)) 
);
$mcpattern = int(
    round(scale(8 7 8 9 6 1 5 6 2 6 0 10, 0, 10, 3600, 10800)) 
);
$count = 0;
$groups = (
    [
        ['names' family('strings') ] [
            'types' 'pizz' 'hit-on-body' 
        ] 
    ] [
        ['names' family('plucked')] [
            'types' 'pizz' 'ord' 'harm' 'perc' 'tap' 
        ] 
    ] [
        [
            'names' 'sax' 'flute' 'clar' 
        ] [
            'types' 'keys' 'pizz' 'exp-slap-pitch' 'slap-pitch' 'slap-unpitch' 
        ] 
    ] 
);
for $marker in $markers do (
    $vel = $velpattern:($count + 1);
    $mc = $mcpattern:($count + 1);
    $pcs = $marker.getkey('pcs');
    $onset = $marker.getkey('onset') - $peak;
    $mc = $mc.pcquant($pcs);
    $group = xchoose($groups);
    ezsol(
        @pitch $mc
        @names $group.getkey('names') 
        @duration $bardur * 1/16
        @types $group.getkey('types') 
        @velocity $vel
        @useseed 1
    ).clipnorm(@minlevel -8 @maxlevel -3).transcribe(
        @onset $onset
        @gain [0 1 0] [1 0 0.7] 
        @pan mc2pan($mc, 0.125) 
    );
    if $count == 10 then (
        $fq = $mc.mc2f();
        $gliss = $fq * xrand(-90, -10).c2r();
        cycle(
            @frequency [0 $fq 0] [1 $gliss -0.125] 
            @duration 500
            @phase rand() 
        ).transcribe(
            @onset $onset
            @gain [0 0.25 0] [1 0 -0.125] 
            @pan mc2pan($mc, 0.125) 
        ) 
    );
    $count = ($count + 1) % length($velpattern);
    null
);
$b = importaudio('./main.wav').setkey('offset', $peak);
render(
    @play 1 @process freeverb(
        @roomsize 0.9
        @wet 0.0125
        @damp 1
        @width 1
    ) normalize(-3) mix($b) normalize(-3) 
)