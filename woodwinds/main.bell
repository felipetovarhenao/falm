## -------------------------
## Global setup and variables
## -------------------------
setseed(390);
$tempo = 112;
$beatdur = 60000 / $tempo;
$bardur = $beatdur * 4;
$root = g3;
$pcroot = $root.mc2pc();
$t = 0;
$totdur = 100 * 1000;
$types = 'vib' 'ord' 'ord-micro' 'sfz' 'flz' 'ord+mute' 'air-and-ord' 'air-to-ord' 'ord-to-air' 'harm';
$ratios = 1 9/8 5/4 3/2 5/3 15/8;
$fullchord = r2mc(1...21, $root).pcquant(r2pc($ratios, $pcroot)).sort();
$units = rev(
    sort((1 1 1...12) / 16) 
);
## -------------------------
## BPFs
## -------------------------
$gapbpf = [0 1 0] [1 0 -0.35];
$chordsizebpf = [0 6 0] [1 length($fullchord) 0];
$maxunitsbpf = [0 4 0] [1 2 -0.125];
$numunitsbpf = [0 1 0] [1 length($units) 0.125];
## ----------------------
## Helpers
## ----------------------
$ampmod = (
    $c, $m -> (
        $m = $m.process(scaling(-1, 1, 0, 1) rampsmooth(16, 16));
        $c.process(multiply($m) normalize(-6)) 
    ) 
);
## ----------------------
## Function: TremChord
## ----------------------
TremChord = (
    $onset = 0, $duration = 1000, $chord = null, $types = 'ord' -^ $ampmod -> (
        $vel = xrand(50, 127);
        ## add oscillating cycles around chosen chord tones
        for $sign in -1 1 do (
            $mc = xchoose($chord);
            $env = [0 rand(0.05, 0.35) 0] [1 0 -0.25];
            if $sign == 1 then ($env = revbpf($env) );
            cycle(
                @frequency $mc.mc2f() * exp2(xrandom(0, 3) * $sign) 
                @duration $duration
                @phase xrand() 
            ).transcribe(
                @onset $onset
                @pan abs(mc2pan($mc, 0.25) - (0 1)) 
                @gain $env
            ) 
        );
        ## woodwind layer with modulation
        $dip = xrand(0.05, 2/3);
        for $mc in $chord do (
            $oct = xrandom(-6, -9) * xchoose(1 -1);
            $b = ezsol(
                @names family('woodwinds') 
                @pitch $mc
                @duration $duration + 50
                @types $types
                @velocity $vel
                @useseed 1
            );
            $mod = xchoose(rect saw cycle tri)(
                @frequency $mc.mc2f() * exp2($oct) * xchoose(-1 1) 
                @duration $duration
                @phase xrand() 
            );
            $b.$ampmod($mod).transcribe(
                @onset $onset
                @pan mc2pan($mc, 1/3) 
                @gain [0 1 0] [$dip xrand(0.1, 0.5) -0.25] [1 1 0.125] 
            ) 
        ) 
    ) 
);
## ----------------------
## Function: Gap
## ----------------------
PercGap = (
    $onset = 0, $duration = 1000, $chord = null -> (
        $mcs = randomseq(
            @llll $chord
            @length xrandom(4, 9) 
            @steps -2 -3 3
            @useseed 1
        );
        $mcs = sort(thin($mcs));
        if xrand() > 0.5 then ($mcs = $mcs.rev());
        $onsetvar = xrand().scale(@slope 0.25) * 90;
        for $mc in $mcs do (
            ezsol(
                @pitch $mc
                @names 'sax' 'flute' 'clar' family('strings') 'harp' 
                @types 'pizz' 'keys' 'slap-pitch' 'pizz-secco' 'exp-slap-pitch' 'harm-in-wood' 
                @velocity xrandom(60, 127) 
                @useseed 1
                @duration $duration * 2
            ).process(normalize(-5)).transcribe(
                @onset $onset
                @pan mc2pan($mc, 0.5) 
                @gain [0 1 0] [1 0 0.7] 
            );
            $onset += $onsetvar
        ) 
    ) 
);
## ----------------------
## Function: Arpeggi
## ----------------------
Arpeggi = (
    $onset = 0, $duration = 1000, $chord = null -^ $bardur -> (
        $unit = $bardur * xchoose(1/16 1/24 1/20);
        $chord = xscramble($chord).left(xrandom(3, 7));
        $chordsize = length($chord);
        $numnotes = max(1, $duration / $unit);
        $legato = $unit * 0.25;
        $panoffset = xrand(-1, 1);
        PianoRoll(
            @onset $onset
            @duration $duration
            @chord $chord
        );
        for $i in 1...$numnotes do (
            $mc = $chord:(
                (($i - 1) % $chordsize) + 1
            );
            ezsol(
                @pitch $mc
                @duration $unit + $legato
                @names 'clar' 
                @types 'ord' 'sfz' 'stacc' 'ten' 'ord-micro' 'dim' 'ord-high' 
                @velocity 127
                @useseed 1
            ).process(normalize(-7)).transcribe(
                @onset $onset
                @gain [0 1 0] [1 0 0.5] 
                @pan fold(mc2pan($mc, 0.125) + $panoffset) 
            );
            $onset += $unit
        ) 
    ) 
);
## ----------------------
## Function: Melody
## ----------------------
Melody = (
    $onset, $duration, $chord -> (
        $maxnotes = int(round($duration / 90));
        ## randomized arpeggiated sequence
        $chord = randomseq(
            @llll $chord
            @length xrandom(3, $maxnotes) 
            @steps -1 1 2
            @useseed 1
        );
        ## compute onset times and legato values
        $t = $onset;
        $legato = 50;
        $pairs = group($chord $chord:-1, 2, 1);
        $slope = xrand(1/10, 1/3) * xchoose(-1 1);
        $onsets = $onset + arithmser(0, 1, null, length($pairs) + 1).scale(0, 1, 0, $duration, @slope $slope);
        $incrs = x2dx($onsets);
        $onsets = $onsets.left(-1);
        ## iterate through note pairs
        for $mcs in $pairs, $t in $onsets, $incr in $incrs with @unwrap 1 do (
            $mc1 = $mcs:1;
            $mc2 = $mcs:2;
            $gliss = float(
                c2r(minabs($mc2 - $mc1, 350)) 
            );
            $res = [0 1 0] [1 1/$gliss xrand(0.65, 0.9)];
            ezsol(
                @pitch $mc1
                @duration $incr + $legato
                @types 'ord' 'vib' 'air-and-ord' 'ord-to-air' 'sfz' 
                @names 'sax' 'flute' 
                @velocity 90
                @useseed 1
            ).process(
                resample($res) fade(0, $legato) normalize(-7) 
            ).transcribe(
                @onset $t @pan mc2pan($mc1, 0.125) 
            ) 
        ) 
    ) 
);
## ----------------------
## Function: PianoRoll
## ----------------------
PianoRoll = (
    $onset = 0, $duration = 1000, $chord = null -> (
        $t = $onset;
        $vel = xrand(20, 100);
        $incr = xrand(50);
        for $mc in $chord do (
            pno(
                @pitch $mc + xrandom(-1, 2) * 1200
                @duration $duration * 1.5
                @velocity $vel
                @useseed 1
            ).transcribe(
                @onset $t
                @pan mc2pan($mc, 0.1) 
                @gain [0 1 0] [1 0 0.7] 
            );
            $t += $incr
        ) 
    ) 
);
## ----------------------
## GetHarmony
## ----------------------
GetHarmony = (
    -> (
        init $r = 1.;
        init $i = 1;
        init $steps = 5/3 4/5 10/9 2/3;
        init $harms = float(
            [1 5/4 3/2 5/3] [1 6/5 3/2 4/3] [1 5/4 3/2 10/9] [1 5/4 3/2 7/4] 
        );
        $id = ($i - 1) % length($steps) + 1;
        $step = $steps:$id;
        $harm = $harms:$id;
        $chord = $r * $harm;
        keep $r *= $step;
        keep $i += 1;
        $chord::1
    ) 
);
## ----------------------
## Main loop
## ----------------------
$objects = Arpeggi TremChord Melody;
$stweights = 1/3 0 2/3;
$weightsbpf = (
    [0 [$stweights] 0] 
    ## 
    [0.75 [0.2 0.8 0] 0.125] 
    ## 
    [1 [0 1 0] -0.125] 
);
$count = 0;
while $t < $totdur do (
    $nt = $t / $totdur;
    ## probabilistically choose between objects
    $weights = samplebpf($weightsbpf, $nt);
    $object = xchoose(
        @choices $objects @weights $weights
    );
    ## sample global breakpoint functions
    $gap = samplebpf($gapbpf, $nt);
    $numunits = samplebpf($numunitsbpf, $nt);
    $maxunits = samplebpf($maxunitsbpf, $nt).round().int();
    $chordsize = samplebpf($chordsizebpf, $nt).round().int();
    ## determine max event duration
    $subunits = right(left($units, $numunits), -$maxunits);
    $maxdur = $bardur * xchoose($subunits);
    $maxdur = max(50, min($maxdur, $totdur - $t));
    ## choose chord slice
    if $count % 6 == 0 then (
        $pcs = GetHarmony().r2pc() 
    );
    $count += 1;
    $chord = $fullchord.pcquant($pcs).left($chordsize);
    ## invoke chosen object (Melody or TremChord)
    $object(
        @onset $t
        @duration $maxdur
        @chord $chord
        @types $types
    );
    ## advance time and occasionally insert a gap
    $t += $maxdur;
    if xrand() < $gap then (
        $gapdur = $bardur * xchoose($units);
        PercGap(
            @onset $t
            @duration $gapdur
            @chord $chord
        );
        $t += $gapdur
    ) 
);
## ----------------------
## Rendering and export
## ----------------------
render(
    @play 1 @process normalize(-3) freeverb(
        @roomsize 0.85
        @wet 0.0125
        @damp 1
        @width 1
    ) 
);
ezexport()