setseed(21);
$root = b3;
$pcroot = $root.mc2pc();
$t = 0;
$totdur = 60 * 1000;
$bardur = 2200;
$i = 1;
$types = 'vib' 'ord' 'ord-micro' 'sfz' 'flz' 'ord+mute' 'air-and-ord' 'air-to-ord' 'ord-to-air' 'harm';
$ratios = 1 9/8 5/4 3/2 5/3 15/8;
$fullchord = r2mc(1...21, $root).pcquant(r2pc($ratios, $pcroot)).sort();
$units = rev(sort(1/16 1/8 3/16 1/4 5/16 3/8 1/2));
$gapbpf = [0 1 0] [1 0.1 -0.25];
$chordsizebpf = [0 1 0] [1 length($fullchord) 0];
$maxunitsbpf = [0 4 0] [1 1 -0.125];
$numunitsbpf = [0 1 0] [1 length($units) 0.125];
$ampmod = (
    $c, $m -> (
        $m = $m.process(scaling(-1, 1, 0, 1) rampsmooth(16, 16));
        $c.process(multiply($m) normalize(-6)) 
    ) 
);
TremChord = (
    $onset = 0, $duration = 1000, $chord = null, $types = 'ord' -^ $ampmod -> (
        $vel = xrand(50, 127);
        for $sign in -1 1 do (
            $mc = xchoose($chord);
            $env = [0 rand(0.05, 0.35) 0] [1 0 -0.25];
            if $sign == 1 then ($env = revbpf($env) );
            cycle(
                @frequency $mc.mc2f() * exp2(xrandom(0, 3) * $sign) 
                @duration $duration
                @phase xrand() 
            ).transcribe(
                @onset $onset
                @pan abs(mc2pan($mc, 0.25) - (0 1)) 
                @gain $env
            ) 
        );
        for $mc in $chord do (
            $oct = xrandom(-6, -9) * xchoose(1 -1);
            $b = ezsol(
                @names family('woodwinds') 
                @pitch $mc
                @duration $duration + 50
                @types $types
                @velocity $vel
                @useseed 1
            );
            $mod = xchoose(rect saw cycle tri)(
                @frequency $mc.mc2f() * exp2($oct) * xchoose(-1 1) 
                @duration $duration
                @phase xrand() 
            );
            $b.$ampmod($mod).transcribe(
                @onset $onset
                @pan mc2pan($mc, 1/3) 
                @gain [0 1 0] [0.5 xrand(0.1, 0.5) -0.25] [1 1 0.125] 
            ) 
        ) 
    ) 
);
Arpeggi = (
    $onset, $duration, $chord -> (
        $chord = $chord.mc2pc().thin().xscramble() * 100 + 7200;
        $numnotes= length($chord);
        $incr = $duration / $numnotes;
        $t = $onset;
        $legato = 50;
        for $mcs in group($chord $chord:-1, 2, 1) with @unwrap 1 do (
            $mc1 = $mcs:1;
            $mc2 = $mcs:2;
            $gliss = float(c2r($mc2 - $mc1));
            $res = [0 1 0] [1 1/$gliss xrand(0.65, 0.9)];
            ezsol(
                @pitch $mc1
                @duration $incr + $legato
                @types 'ord' 'vib' 'air-and-ord' 'ord-to-air' 'sfz' 
                @names 'sax' 'flute' 
                @velocity 90
                @useseed 1
            ).process(
                resample($res) fade(0, $legato) normalize(-3) 
            ).transcribe(
                @onset $t @pan mc2pan($mc1, 0.125) 
            );
            $t += $incr
        ) 
    ) 
);
while $t < $totdur do (
    $nt = $t / $totdur;
    $gap = samplebpf($gapbpf, $nt);
    $numunits = samplebpf($numunitsbpf, $nt);
    $maxunits = samplebpf($maxunitsbpf, $nt).round().int();
    $chordsize = samplebpf($chordsizebpf, $nt).round().int();
    $subunits = right(left($units, $numunits), -$maxunits);
    $maxdur = $bardur * xchoose($subunits);
    $maxdur = max(50, min($maxdur, $totdur - $t));
    $chord = $fullchord.left($chordsize);
    $i += 1;
    xchoose(Arpeggi TremChord)(
        @onset $t
        @duration $maxdur
        @chord $chord
        @types $types
    );
    $t += $maxdur;
    if xrand() < $gap then ($t += $bardur * xchoose($units)) 
);
render(
    @play 1 @process normalize(-9) freeverb(
        @roomsize 0.75
        @wet 0.01
        @damp 1
        @width 1
    ) 
);
ezexport()