setseed(10);
$t = 0;
$totdur = 30 * 1000;
$bardur = 2000;
$i = 1;
$fullchord = r2mc(1...21, c4).pcquant(r2pc(1 9/8 5/4 3/2 5/3)).sort();
$units = 3/16 1/8 3/8 1/4 3/4 1;
while $t < $totdur do (
    $nt = $t / $totdur;
    $chordsize = $nt.scale(0, 1, 1, length($fullchord), -0.125).round().int();
    $maxdur = $bardur * xchoose($units);
    $vel = xrand(50, 127);
    $chord = $fullchord.left($chordsize);
    $i += 1;
    cycle(
        @frequency xchoose($chord).mc2f() / 4
        @duration $maxdur
        @phase xrand() 
    ).transcribe(
        @onset $t
        @pan mc2pan($mc) 
        @gain [0 rand(0.1, 0.5) 0] [1 0 -0.25] 
    );
    for $mc in $chord do (
        $oct = xrandom(-6, -9) * xchoose(1 -1);
        $b = ezsol(
            @names family('woodwinds') 
            @pitch $mc
            @duration null
            @types 'vib' 'ord' 'ord-micro' 'sfz' 'flz' 
            @velocity $vel
            @useseed 1
        );
        $dur = min($maxdur, $b.getkey('duration')) + 100;
        $trem = xchoose(rect saw cycle tri)(
            @frequency $mc.mc2f() * exp2($oct) * xchoose(-1 1) 
            @duration $dur
            @phase xrand() 
        ).process(scaling(-1, 1, 0, 1) rampsmooth(64, 64));
        $b.process(multiply($trem) normalize(-6)).transcribe(
            @onset $t
            @pan mc2pan($mc, 1/3) 
            @gain [0 1 0] [0.5 xrand(0.1, 0.5) -0.25] [1 1 0.125] 
        ) 
    );
    $t += $maxdur;
    if xrand() > 0.9 then ($t += $bardur * xchoose($units)) 
);
render(
    @play 1 @process normalize(-9) freeverb(
        @roomsize 0.8
        @wet 0.0125
        @damp 1
        @width 1
    ) 
);
ezexport()