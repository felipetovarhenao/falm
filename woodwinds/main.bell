setseed(1);
$chord = r2mc(1 5/4 3/2 15/8 9/4 3/4 1/2 5/2, c4);
$t = 0;
$totdur = 30 * 1000;
$bardur = 2000;
while $t < $totdur do (
    $maxdur = $bardur * xchoose(1/16 1/8 3/8 1/4 3/4 1);
    $vel = xrand(127);
    for $mc in $chord do (
        $oct = xrandom(-6, -9) * xchoose(1 -1);
        $b = ezsol(
            @names family('woodwinds') 
            @pitch $mc
            @duration null
            @types 'vib' 'ord' 'ord-micro' 'sfz' 
            @velocity $vel
        );
        $dur = min($maxdur, $b.getkey('duration')) + 100;
        $trem = xchoose(rect saw cycle tri)(
            @frequency $mc.mc2f() * exp2($oct) * xchoose(-1 1) 
            @duration $dur
            @phase xrand() 
        ).process(scaling(-1, 1, 0, 1) rampsmooth(64, 64));
        $b.process(multiply($trem)).transcribe(
            @onset $t
            @pan mc2pan($mc) 
            @gain [0 1 0] [0.5 xrand(0.1, 0.5) -0.25] [1 1 0.125] 
        ) 
    );
    $t += $maxdur;
    if xrand() > 0.9 then ($t += $bardur * xchoose(1/4 3/16 1/8 5/16) ) 
);
render(
    @play 1 @process normalize(-9) freeverb(
        @roomsize 0.4
        @wet 0.0125
        @damp 1
        @width 1
    ) 
);
ezexport()