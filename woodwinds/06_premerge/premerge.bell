setseed(33);
$t = 0;
$meta = read('../01_foreground/foreground.txt');
$tempo = $meta.'tempo';
$totdur = $meta.'totdur';
$beatdur = 60000 / $tempo;
$bardur = $beatdur * 4;
$unit = $bardur * 1/16;
$split = read('../02_percussion/percussion.txt');
$base = importaudio('../01_foreground/foreground.wav');
$base1 = $base.setkey('duration', $split);
$base2 = $base.setkey('offset', $split);
$base1.process(normalize(-3)).transcribe($t);
$t += $split;
importaudio('../05_bridge/bridge.wav').transcribe($t);
$t += read('../05_bridge/bridge.txt');
$tail = $base2.process(
    mix(
        importaudio('../02_percussion/percussion.wav') @gains 1 0.5
    ) normalize(-3) 
).setkey('duration', $totdur - $split);
$segs = $tail.splitbuf(@split $unit);
$numsegs = length($segs);
$slopebpf = [0 0.999 0] [1 -0.5 -0.1];
$maskbpf = [0 1 0] [1 0.25 0.85];
$stutterbpf = [0 0 0] [1 1 0.4];
$maxnumcopies = 4;
$lastonset = 0;
$speedbpf = [0 1 0] [1 2 0.85];
$state = 0;
$gates = null;
$b = importaudio('../03_leadup/leadup.wav');
$leadupmeta = read('../03_leadup/leadup.txt');
$b.transcribe($leadupmeta.'onset');
for $seg $segid in $segs do (
    $nt = ($segid - 1) / ($numsegs - 1);
    $speed = samplebpf($speedbpf, $nt);
    $mask = samplebpf($maskbpf, $nt);
    if $mask > xrand() then (
        if $state == 1 then ($gates _= [$t $state] );
        $state = 0;
        $slope = samplebpf($slopebpf, $nt);
        $stutter = samplebpf($stutterbpf, $nt);
        $copyweights = (1 0 :* ($maxnumcopies - 1)) * (1 - $stutter) + $stutter * rev(
            exp2(
                (0...($maxnumcopies - 1)) 
            ) 
        );
        $copy = $seg.process(
            gain([0 1 0] [1 0 $slope]) 
        ).clipnorm(@minlevel -7 @maxlevel -3);
        $numcopies = xchoose(1...4 @weights $copyweights);
        $copydur = $copy.getkey('duration') / $numcopies;
        $shift = 0;
        $lastonset = $t;
        for $c in 1...$numcopies do (
            $copy.setkey('duration', $copydur).transcribe(@onset $t + $shift);
            $shift += $copydur
        ) 
    ) else (
        if $state == 0 then ($gates _= [$t $state]);
        $state = 1
    );
    $t += $unit * $speed
);
render(
    @play 1 @process normalize(-3) 
);
ezexport(['totdur' $lastonset] ['gates' $gates])