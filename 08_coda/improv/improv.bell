setseed(20);
$meta = read('../intro/intro.txt');
$totdur = $meta.'total_duration';
$globaldelay = $meta.'markers':3;
$totdur -= $globaldelay;
$mcroot = d2;
$pcroot = mc2pc($mcroot);
$basechord = r2mc(2...40, $mcroot);
$ratios = thin(sort(1 9/8 8/7 5/4 9/7 3/2 7/5 11/8 5/3 15/8));
$pcs = r2pc($ratios, $pcroot);
$t = 0;
$gapbpf = [0 3000 0] [1 250 -0.125];
$melspanbpf = [0 3500 0] [1 1500 -0.125];
$maxnotesbpf = [0 1 0] [1 25 0.05];
$melvelbpf = [0 0 0] [1 127 0.25];
$numvoicesbpf = [0 1 0] [1 4 2/3];
$gainbpf = [0 0.25 0] [1 1 0.125];
$filterbpf = [0 0.5 0] [1 1 0.125];
$types = thin(
    'ord' 'stacc' 'ten' 'stop' 'flz' 'bisb' 'dim' 'stop-to-open' 'open-to-stop' 'ord+mute' 'sfz' 'ord-high' 'ord-micro' 'ord-to-brassy' 'flz-stop' 'flz+mute' 'flz-to-ord' 
);
$numtypesbpf = [0 2 0] [1 length($types) 0.05];
$names = 'horn' 'sax' 'tromb' 'flute' 'clar';
$numnamesbpf = [0 1 0] [1 length($names) 1/2];
$maxsteps = 3;
$steps = 0...$maxsteps;
$stepsweights = (
    sgn(abs($steps)) * ($maxsteps - abs($steps)) + 1
);
while $t < $totdur do (
    $nt = $t / $totdur;
    $melspan = samplebpf($melspanbpf, $nt) * exp2(xrand(-0.125, 0.125));
    $gap = samplebpf($gapbpf, $nt) * exp2(xrand(-0.25, 0.25));
    $numvoices = round(samplebpf($numvoicesbpf, $nt));
    for $v in 1...$numvoices do (
        $voicedelay = if $v > 1 then xrand(-0.5, 0.5) * $melspan else 0;
        $maxnotes = samplebpf($maxnotesbpf, $nt);
        $maxnotes = max(
            1, int(
                round(min($maxnotes, $melspan / 90)) 
            ) 
        );
        $numnotes = xrandom(ceil($maxnotes / 5), $maxnotes);
        $slope = xrand(-1/2, 1/2);
        $durs = timeramp(
            @duration $melspan
            @length $numnotes
            @slope $slope
        );
        $stepsize = xchoose(@choices $steps @weights $stepsweights);
        $filter = int(
            round(samplebpf($filterbpf, $nt) * length($basechord)) 
        );
        $chord = left($basechord, $filter);
        $chord = pcquant(
            $chord, left(xscramble($pcs), xrandom(4, 6)) 
        );
        $mcs = randomseq(
            @llll $chord
            @length $numnotes
            @steps -$stepsize...$stepsize
            @useseed 1
        );
        $dyads = group($mcs $mcs:-1, 2, 1);
        $shift = 0;
        $pan = xrand() - 0.5;
        for $dyad in $dyads, $dur in $durs with @unwrap 1 do (
            $onset = $shift + $t + $voicedelay;
            if $onset < $totdur then (
                $nt = $onset / $totdur;
                $melvel = samplebpf($melvelbpf, $nt);
                $gain = samplebpf($gainbpf, $nt);
                $numtypes = int(
                    round(samplebpf($numtypesbpf, $nt)) 
                );
                $numnames = int(
                    round(samplebpf($numnamesbpf, $nt)) 
                );
                $mc1 = $dyad:1;
                $mc2 = $dyad:2;
                $gliss = [0 1 0] [
                    1 1/c2r(minabs($mc2 - $mc1, 400)) xrand(1/2, 0.95) 
                ];
                $durmul = integrate($gliss):(-1 2);
                $envslope = xrand(-1/2, 1/2);
                $minenvgain = xrand(0.01, 0.707);
                $env = xchoose(
                    ## ---
                    [[0 $minenvgain 0] [1 $gain $envslope]] 
                    ## ---
                    [[0 $gain 0] [1 $minenvgain $envslope]] 
                    ## ---
                    [hanning() * $gain] 
                )::1;
                $b = ezsol(
                    @pitch $mc1
                    @duration $dur / $durmul
                    @velocity min(
                        127, max(0, $melvel + xrandom(-7, 7)) 
                    ) 
                    @names flat(left($names, $numnames)) 
                    @types left($types, $numtypes) 
                    @useseed 1
                ).clipnorm(@minlevel -27 @maxlevel -15).process(
                    resample($gliss) multiply(xchoose(-1 1)) gain($env) dcfilter() 
                );
                $dur = $b.getkey('duration');
                $b.transcribe(
                    @onset $onset
                    ## ----
                    @pan fold(mc2pan($mc1, 0.125) + $pan) 
                ) 
            );
            $shift += $dur
        ) 
    );
    $t += $melspan + $gap
);
render(
    @play 1 @process freeverb(
        @roomsize 0.95
        @wet 0.025
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport(@data $globaldelay)