setseed(9);
$totdur = read('../intro/intro.txt');
## $totdur = 30000;
$mcroot = d2;
$pcroot = mc2pc($mcroot);
$ratios = 1 9/8 8/7 5/4 9/7 3/2 7/5 11/8 5/3 15/8;
$pcs = r2pc($ratios, $pcroot);
$basechord = r2mc(2...32, $mcroot);
$basechord = pcquant($basechord, $pcs);
$t = 15000;
$gapbpf = [0 4000 0] [1 1000 -0.125];
$melspanbpf = [0 4000 0] [1 1000 -0.125];
$maxnotesbpf = [0 1 0] [1 20 0];
$melvelbpf = [0 0 0] [1 127 0.125];
$numvoicesbpf = [0 1 0] [1 3 0.5];
$gainbpf = [0 0.707 0] [1 1 0.125];
$filterbpf = [0 0.707 0] [1 1 0.125];
$types = 'stacc' 'ord' 'stop' 'ord-to-brassy' 'ord+mute' 'ten' 'bisb' 'flz' 'dim' 'flz-stop' 'stop-to-open' 'open-to-stop' 'ord-high' 'ord-micro';
$numtypesbpf = [0 1 0] [1 length($types) -0.125];
while $t < $totdur do (
    $nt = $t / $totdur;
    $melspan = samplebpf($melspanbpf, $nt);
    $gap = samplebpf($gapbpf, $nt);
    $numvoices = round(samplebpf($numvoicesbpf, $nt));
    for $v in 1...$numvoices do (
        $voicedelay = if $v == 1 then xrand(-0.5, 0.5) * $gap else 0;
        $maxnotes = samplebpf($maxnotesbpf, $nt);
        $filter = int(
            round(samplebpf($filterbpf, $nt) * length($basechord)) 
        );
        $maxnotes = max(
            1, int(
                round(min($maxnotes, $melspan / 90)) 
            ) 
        );
        $numnotes = xrandom(ceil($maxnotes / 4), $maxnotes);
        $slope = xrand(-1/2, 1/2);
        $durs = timeramp(
            @duration $melspan
            @length $numnotes
            @slope $slope
        );
        $stepsize = xrandom(0, 3);
        $mcs = randomseq(
            @llll left($basechord, $filter) 
            @length $numnotes
            @steps -$stepsize...$stepsize
            @useseed 1
        );
        $dyads = group($mcs $mcs:-1, 2, 1);
        $shift = 0;
        $pan = xrand() - 0.5;
        $legato = xrand(40);
        for $dyad in $dyads, $dur in $durs with @unwrap 1 do (
            $onset = $shift + $t;
            if $onset < $totdur then (
                $nt = $onset / $totdur;
                $melvel = samplebpf($melvelbpf, $nt);
                $gain = samplebpf($gainbpf, $nt);
                $numtypes = int(
                    round(samplebpf($numtypesbpf, $nt)) 
                );
                $mc1 = $dyad:1;
                $mc2 = $dyad:2;
                $gliss = [0 1 0] [
                    1 1/c2r(minabs($mc2 - $mc1, 400)) xrand(1/2, 0.95) 
                ];
                $durmul = integrate($gliss):(-1 2);
                $envslope = xrand(-1/2, 1/2);
                $minenvgain = xrand(0, 1);
                $env = xchoose(
                    ## ---
                    [[0 $minenvgain 0] [1 $gain $envslope]] 
                    ## ---
                    [[0 $gain 0] [1 0 $envslope]] 
                    ## ---
                    [hanning()] 
                )::1;
                $b = ezsol(
                    @pitch $mc1
                    @duration ($dur + $legato) / $durmul
                    @velocity $melvel
                    @names 'horn' 'sax' 'tromb' 
                    @types left($types, $numtypes) 
                    @useseed 1
                ).process(resample($gliss));
                $b.transcribe(
                    @onset $t + $shift + $voicedelay
                    @pan fold(mc2pan($mc1, 0.125) + $pan) 
                    @gain $env
                ) 
            );
            $shift += $dur
        ) 
    );
    $t += $gap * exp2(xrand(-0.25, 0.25)) 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.95
        @wet 0.025
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport()