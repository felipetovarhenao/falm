setseed(2);
GetExtraTypes = (
    $name -> (
        $extras = null;
        if intersection(
            $name, 'violin' 'viola' 'harp' 
        ) != null then ($extras _= 'harm');
        if intersection(
            $name, 'violin' 'viola' 
        ) != null then ($extras _= 'trem');
        if intersection(
            $name, 'sax' 'oboe' 'bassoon' 
        ) != null then ($extras _= 'ord-micro' (if $name == 'sax' then 'ord-high'));
        if intersection($name, family('strings')) != null then (
            $extras _= 'nonvib' 'nonvib+mute' 'ord+mute' 'trem' 
        );
        $extras
    ) 
);
GetArpeggi = (
    $chord, $size = 7, $length = 5 -> (
        $chordlen = length($chord);
        init $names = 'guitar' 'harp' 'acc' (
            for $fam in 'strings' 'winds' collect family($fam) 
        );
        keep $names;
        init $instruments = for $name in $names collect instrument(
            @name $name
            @types 'ord' GetExtraTypes($name) 
            @join 0
        );
        keep $instruments;
        for $i in left(
            int(
                round(arithmser(0, $chordlen - $size, null, $length)) 
            ), -1
        ) collect (
            $mcs = $chord:[
                (0...($size - 1)) + $i
            ];
            $instrument = xchoose(
                pitchfilter(
                    @instruments $instruments
                    @pitch mean($mcs) 
                    @tolerance 50
                ) 
            );
            [['region' $mcs] ['instrument' $instrument]] 
        ) 
    ) 
);
$mcroot = d2;
$pcroot = mc2pc($mcroot);
$basechord = r2mc(3...64, $mcroot);
$ratios = thin(sort(1 9/8 8/7 5/4 9/7 3/2 7/5 11/8 5/3 15/8));
$pcs = r2pc($ratios, $pcroot);
$basechord = pcquant($basechord, $pcs);
$numvoices = 24;
$regionsize = 8;
$compression = 1/3;
$arpeggi = GetArpeggi(
    @chord $basechord
    @size $regionsize
    @length $numvoices
);
$globalduration = 120 * 1000;
$globalslope = 1/2;
for $arp in $arpeggi do (
    $stretchbpf = [0 1 0] [1 6 $globalslope];
    $velbpf = [0 1 0] [1 0 $globalslope];
    $sinethreshbpf = [0 1/3 0] [1 0 $globalslope];
    $totdur = $globalduration * exp2(xrand(-1/3, 0));
    $region = getkey($arp, 'region');
    $instrument = getkey($arp, 'instrument');
    $name = getkey($instrument, 'name');
    $type = getkey($instrument, 'types');
    $extend = xrandom(0, 1);
    $len = max(
        2, round(xrandom(2, 16) / exp2($extend)) 
    );
    $mcs = randomseq(
        @llll $region
        @length $len
        @useseed 1
        @steps (-1 1) (2 * xchoose(-1 1)) 
    );
    if $extend == 1 then (
        $mcsrev = rev($mcs);
        if xrand() > 0.5 then ($mcsrev = right($mcsrev, 1));
        if xrand() > 0.5 then ($mcsrev = left($mcsrev, -1));
        $mcs _= $mcsrev
    );
    $dynamics = scale(
        @x hanning(
            @length round(length($mcs) * xrand(1, 2)) 
        ) 
        @inmin 0
        @inmax 1
        @outmin xrand(0.01, 0.125) 
        @outmax 1
    );
    $t = 0;
    $unit = xrand(70, 140);
    $panbpf = [0 xrand() 0] [1 xrand() xrand(-0.25, -0.25)];
    while $t < $totdur do (
        $nt = $t / $totdur;
        $pan = samplebpf($panbpf, $nt);
        $sinethresh = samplebpf($sinethreshbpf, $nt);
        $stretch = samplebpf($stretchbpf, $nt);
        $notedur = $unit * $stretch;
        $vel = samplebpf($velbpf, $nt) * 127;
        $envslope = xrand(0.01, 0.5);
        $mingain = xrand(0.01, 0.707);
        $env = xchoose(
            [[0 $mingain 0] [1 1 $envslope]] [[0 1 0] [1 $mingain -$envslope]] [hanning()] [] 
        )::1;
        $mc = $mcs:1;
        $dyn = $dynamics:1;
        if xrand() < $sinethresh then (
            sinewave(
                @pitch $mc + xrandom(-1, 4) * 1200
                @duration $notedur * exp2(xrand(-1, 2)) 
                @velocity max(2, $vel) 
            ).transcribe(
                @onset $t
                @pan $pan
                @gain $dyn * xrand(0.05, 0.125) 
            ) 
        );
        $b = ezsol(
            @pitch $mc
            @duration $notedur + 33
            @velocity $vel + xrandom(-6, 6) 
            @names $name
            @useseed 1
            @types $type
        );
        $boost = gainboost(
            @buffer $b
            @slope $compression * -1
            @rms 1
        );
        $b = $b.process(gain($dyn * $boost)).analyze(envmaxtime());
        $b.transcribe(
            @onset $t - $b.getkey('envmaxtime') 
            @gain $env
            @pan $pan
        );
        $dynamics = rot($dynamics, 1);
        $mcs = rot($mcs, 1);
        $t += $notedur
    ) 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.96
        @wet 0.03
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport(
    @data ['total_duration' $globalduration] ['slope' $globalslope] ['numvoices' $numvoices] 
)