setseed(1);
$mcroot = d2;
$pcroot = mc2pc($mcroot);
$basechord = r2mc(1...48, $mcroot);
$ratios = thin(sort(1 9/8 8/7 5/4 9/7 3/2 7/5 11/8 5/3 15/8));
$pcs = r2pc($ratios, $pcroot);
$basechord = pcquant($basechord, $pcs);
$maxtotdur = 120 * 1000;
$numvoices = 24;
for $v in 1...$numvoices do (
    $totdur = $maxtotdur * exp2(xrand(-0.25, 0));
    $len = xrandom(2, 21);
    $arp = randomseq(
        @llll $basechord
        @length $len
        @steps xchoose(-1 1) * (-1 1 2) 
        @useseed 1
    );
    $prob = xrand();
    if $prob < 0.5 then ($arp = rev($arp));
    if $prob < 0.5 then (
        $arp _= rev(
            right(left($arp, -1), 1) 
        ) 
    );
    $t = 0;
    $fam = xchoose(
        @choices 'strings' 'woodwinds' 'brass' @weights 5 2 1
    );
    $dur = xrand(70, 130);
    $pan = xrand();
    $vels = hanning(@length $len) * 127;
    $gainpat = scale($vels, 0, 127, xrand(0.125, 0.707), 1);
    $type = xchoose('stacc' 'ord');
    $velbpf = [0 1 0] [1 0 0.33];
    $stretchbpf = [0 1 0] [1 4 0.33];
    while $t < $totdur do (
        $nt = $t / $totdur;
        $stretch = samplebpf($stretchbpf, $nt);
        $mc = $arp:1;
        $gain = $gainpat:1;
        $vel = ($vels:1) * samplebpf($velbpf, $nt);
        $gainpat = rot($gainpat, 1);
        $vels = rot($vels, 1);
        $arp = rot($arp, 1);
        $duration = $dur * $stretch;
        $panval = fold($pan + mc2pan($mc, 0.125));
        if xrand() > 0.8 then (
            sinewave(
                @pitch $mc + xrandom(0, 3) * 1200
                @duration $duration * exp2(xrandom(-0.5, 0.5)) 
                @velocity max(10, $vel) 
            ).transcribe(
                @onset $t
                @gain $gain * 0.25
                @pan $panval
            ) 
        );
        ezsol(
            @pitch $mc
            @names family($fam) 
            @types $type
            @velocity $vel
            @duration $duration
            @useseed 1
        ).transcribe(
            @onset $t
            @pan $panval
            @gain $gain * hanning() 
        );
        $t += $duration - 10
    );
    $t = 0;
    $mc = xchoose($basechord);
    $fam = 'strings' 'woodwinds' 'brass';
    $gainbpf = [0 1 0] [1 0.125 0.25];
    while $t < $totdur do (
        $nt = $t / $totdur;
        $gain = samplebpf($gainbpf, $nt);
        $b = ezsol(
            @pitch $mc
            @names family($fam) 
            @types 'ord' 'sfz' 'flz' 'ord-high' 'ord-micro' 
            @velocity 127 * samplebpf($velbpf, $nt) 
            @duration null
            @useseed 1
        ).clipnorm(@maxlevel -12);
        $b.transcribe(
            @onset $t
            @pan xrand() 
            @gain 1/3 * $gain
        );
        $t += max(0, $b.getkey('duration') - 500) 
    ) 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.96
        @wet 0.025
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport($totdur)