setseed(125);
$chord = thin(
    int(jispectrum(
        @harmonics 1...64
        @ratios 1 9/8 8/7 5/4 9/7 3/2 7/5 11/8 5/3 15/8
        @root d2 
    )) 
);
$t = 0;
$names = thin(
    family('plucked') family('strings') family('woodwinds') family('brass') 'acc' 
);
$types = 'ord' 'nonvib' 'nonvib+mute' 'harm' 'harm-in-wood' 'air' 'breath' 'air-and-ord' 'air-to-ord' 'ord-to-air' 'harm-trem' 'cresc-to-dim' 'bisb';
$N = 48;
$chordlen = length($chord);
$peak = 0.75;
$gapbpf = [0 3000 0] [1 $peak 0.125] [1 2000 0.125];
$jitterbpf = [0 500 0] [$peak 100 -0.125] [1 100 0];
$numnamesbpf = [0 2 0] [1 length($names) 0.125];
$numnotesbpf = [0 5 0] [1 $chordlen 0.25];
$lowpassbpf = [0 2/3. 0] [1 1 0];
$numtypesbpf = [0 2 0] [1 length($types) 0.125];
$velbpf = [0 0 0] [1 90 1/2];
$totalduration = 0;
$markers = $t;
$sections = 0...$N;
for $i in $sections do (
    $nt = $i / $N;
    $numnotes = samplebpf($numnotesbpf, $nt);
    $lowpass = int(
        round(samplebpf($lowpassbpf, $nt) * $chordlen) 
    );
    $gap = samplebpf($gapbpf, $nt);
    $jitter = samplebpf($jitterbpf, $nt);
    $numnames = round(samplebpf($numnamesbpf, $nt));
    $numtypes = round(samplebpf($numtypesbpf, $nt));
    $vel = samplebpf($velbpf, $nt).round();
    for $mc in left(
        xscramble(left($chord, $lowpass)), $numnotes
    ) do (
        $pan = mc2pan($mc);
        cycle(
            @frequency mc2f($mc) * exp2(xrandom(-1, 3)) 
            @duration xrand(100, 1000) 
            @phase xrand() 
        ).transcribe(
            @onset $t
            @pan $pan
            @gain [0 xrand(0.001, 0.025) 0] [1 0 -xrand(1/4, 3/4)] 
        );
        $b = ezsol(
            @pitch $mc
            @duration null
            @types left($types, $numtypes) 
            @names left($names, $numnames) 
            @velocity min(
                max(0, $vel - xrandom(-10, 10)), 127
            ) 
            @useseed 1
        ).analyze(effectiveduration(@thresholdratio 0.01)).detach();
        $boost = gainboost(
            @buffer $b
            @outmin dbtoa(-60) 
            @outmax dbtoa(-14) 
            @rms 1
        );
        $b.process(gain($boost)).transcribe(
            @onset $t
            @pan $pan
            @gain [0 1 0] [1 0 1/3] 
        );
        $totalduration = max($totalduration, $t + $b.getkey('effectiveduration'));
        $t += xrand($jitter) 
    );
    $t += $gap;
    $markers _= $t
);
render(
    @play 1 @process freeverb(
        @roomsize 0.97
        @wet [0 0.025 0] [1 0.1 0.25] 
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport(
    @data ['total_duration' $totalduration] ['markers' $markers] 
)