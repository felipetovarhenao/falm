dot = ($a, $b -> reduce($a * $b, #+));
matmul = (
    $a, $b -> (
        $b = $b.trans();
        for $x in $a with @unwrap 1 collect [
            for $y in $b with @unwrap 1 collect dot($x, $y) 
        ] 
    ) 
);
mat = (
    $dims = 2 2, $func = (-> rand(-1, 1)) -> (0 :* $dims).map(
        @depth -1 -1 @modfunction $func
    ) 
);
sigmoid = (
    $x -> 1 / (1 + exp(-$x)) 
);
dsigmoid = ($x -> $x * (1 - $x));
mlptrain = (
    $x, $y, $hidden = 2, $epochs = 1000, $lr = 0.1 -> (
        ## Initialize weights and biases
        $dims = group(
            length($x::1) $hidden length($y::1) @modulos 2 @overlap 1
        );
        $weights = null;
        $biases = null;
        for $dim in $dims with @unwrap 1 do (
            $weights _= [
                mat(rev($dim)) 
            ];
            $biases _= [mat($dim:2)] 
        );
        ## $weights = mat(length($x::1) $hidden length($y::1));
        ## $biases = for $i in 1...$layers.length() collect mat($layers:$i 1);
        ## for $epoch in 1...$epochs do (
        ##     ## Forward pass
        ##     $activations = $x;
        ##     $zs = null;
        ##     for $w $b in $weights $biases do (
        ##         $z = matmul($activations, $w) + $b;
        ##         $zs _= $z;
        ##         $activations = sigmoid($z)
        ##     );
        ##     ## Backward pass
        ##     $delta = ($activations - $y) * dsigmoid($zs:-1);
        ##     $grad_w = matmul($zs:-2.trans(), $delta);
        ##     $grad_b = $delta;
        ##     ## Update weights and biases
        ##     $weights:-1 -= $lr * $grad_w;
        ##     $biases:-1 -= $lr * $grad_b;
        ##     for $l in ($layers.length() - 2)...1 do (
        ##         $delta = matmul($delta, $weights:$l.trans()) * dsigmoid($zs:$l);
        ##         $grad_w = matmul(
        ##             $zs:($l - 1).trans(), $delta
        ##         );
        ##         $grad_b = $delta;
        ##         $weights:$l -= $lr * $grad_w;
        ##         $biases:$l -= $lr * $grad_b
        ##     )
        ## );
        ['w' $weights] ['b' $biases] 
    ) 
);
## XOR dataset
$x = (
    [0 0] [0 1] [1 0] [1 1] 
);
$y = (
    [0] [1] [1] [0] 
);
mlptrain($x, $y, 3 4).print()