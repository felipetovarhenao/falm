setseed(0);
$cells = [3/16 1/8 3/16] [3/16 5/16 1/8 1/8] [1/12 :* 4] [1/6 :* 2] [1/10 :* 5];
$bpm = 94;
$bardur = float(240000 / $bpm);
$ratios = 1 9/8 5/4 21/16 3/2 5/3 15/8;
$pcs = r2pc($ratios);
$mcs = r2mc(1...9, e2).pcquant($pcs);
$events = for $cell in xscramble($cells) with @unwrap 1 collect (
    $durs = xscramble($cell) * $bardur;
    $repeat = length(
        thin(den($cell)) 
    ) == 1;
    for $dur $i in $durs collect (
        if $i == 1 || $repeat == 0 then ($mc = xchoose($mcs));
        [
            ['duration' $dur] ['pitch' $mc] ['accent' $i == 1] 
        ] 
    ) 
);
write($events, './events.txt')