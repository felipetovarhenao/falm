setseed(50);
$totdur = 60000;
$t = 0;
$root = 4800;
$minvelbpf = [0 0 0] [1 90 0.33];
$gapbpf = [0 2500 0] [1 0 0.35];
$gapthreshbpf = [0 0.125 0] [1 0 0.25];
$spanbpf = [0 2000 0] [1 250 0.25];
$maxincrbpf = [0 250 0] [1 300 0.25];
$samplers = for $instrument in violin viola cello collect [$instrument 'pizz' 'pizz-secco'];
$samplers _= (
    ## 
    [
        harp 'harm' 'harm-in-wood' 'xylo' 'near-board' 'near-pegs' 
    ] 
    ## 
    [
        guitar 'harm' 'pizz' 
    ] 
);
$chordweightmixbpf = [0 0 0] [1 1 0.25];
$markers = null;
while $t < $totdur do (
    $nt = $t / $totdur;
    $minvel = samplebpf($minvelbpf, $nt);
    $span = samplebpf($spanbpf, $nt);
    $maxincr = samplebpf($maxincrbpf, $nt);
    $incrbpf = [0 xrand($maxincr) 0] [
        1 xrand($maxincr) xrand(1/3, 1/2) * xchoose(-1 1) 
    ];
    $vel = xrandom($minvel, 127);
    $chordweightmix = samplebpf($chordweightmixbpf, $nt);
    $weights = (1 1 1 1) * (1 - $chordweightmix) + $chordweightmix * (0 1 0 0);
    $chord = xchoose(
        ## 
        [1/2 1 18/7 20/9 3/2 24/7 56/15] 
        ## 
        [1/2 1 5/2 9/4 3/2 5 15/4] 
        ## 
        [1/2 1 11/9 16/7 3/2 20/7 15/4] 
        ## 
        [1/2 5/6 4/3 20/9 5/3 2 7/2] 
        ## 
        @weights $weights
    )::1;
    $offset = 0;
    $chordsize = length($chord);
    $numnotes = xrandom(4, $chordsize);
    $chord = r2mc($chord, $root).left($numnotes).sort();
    $chordsize = length($chord);
    for $mc $mci in $chord do (
        $prob = xrand();
        $arpt = ($mci - 1) / ($chordsize - 1);
        $incr = samplebpf($incrbpf, $arpt);
        $onset = $t + $offset;
        if $prob > $nt ** 0.5 then (
            $env = [0 1 0] [1 0 -xrand(2/3, 4/5)];
            $fq = $mc.mc2f() * exp2(xrandom(-2, 4));
            $gainmul = $mc.scale(2100, 10800, 1, 0.25, -0.25);
            $dur = xrand().scale(0, 1, 200, 2000, 1/2);
            $pan = xrand() xrand();
            $process = gain(($vel / 127) * 0.07 * $gainmul);
            $phase = xrand();
            if xrand() > 0.5 then (
                $process _= freqshift(
                    @shift xrand(0.5, 8) * xchoose(-1 1) 
                ) 
            );
            if xrand() > 0.9 then (
                $onset -= $dur;
                $env = revbpf($env) 
            );
            cycle(
                @frequency $fq
                @duration $dur
                @phase $phase
            ).process($process).transcribe(
                @onset $onset
                @gain $env
                @pan $pan
            ) 
        ) else (
            $sampweights = (2 2 1 1 3 4) * (1 - $nt) + $nt * (1 :* 6);
            $sampler = xchoose($samplers @weights $sampweights)::1;
            $instrument = $sampler:1;
            $type = xchoose($sampler.right(1));
            $b = $instrument(
                @pitch $mc
                @duration null
                @velocity $vel
                @type $type
            );
            $b.transcribe(
                @onset $onset @pan xrand() 
            ) 
        );
        $markers _= $onset;
        $offset += $incr
    );
    $t += $span;
    $gapthresh = samplebpf($gapthreshbpf, $nt);
    if xrand() < $gapthresh then (
        $gap = samplebpf($gapbpf, $nt);
        $t += $gap
    ) 
);
render(
    @play 1 @process normalize(-3) freeverb(
        @roomsize 0.707
        @wet [0 0.025 0] [1 0.0125 -0.125] 
        @damp 1
        @width 1
    ) 
);
ezexport($markers)