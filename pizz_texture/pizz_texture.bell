setseed(2);
$tot = 45000;
$N = round($tot / 800);
$toff = 0;
$root = 4800;
$minvelbpf = [0 0 0] [1 127 0.33];
for $t in arithmser(0, 1, null, $N).scale(0, 1, 0, $tot, -0.25) do (
    $nt = $t / $tot;
    $minvel = samplebpf($minvelbpf, $nt);
    $off = 0;
    $incr = xrand(190);
    $vel = xrandom($minvel, 127);
    $chord = xchoose(
        ## 
        [1/2 1 18/7 20/9 3/2 24/7 56/15] 
        ## 
        [1/2 1 5/2 9/4 3/2 5 15/4] 
    )::1;
    for $mc in r2mc($chord, $nt.scale(0, 1, $root, $root + 50)).left(xrandom(4, 9)).sort() do (
        $env = [0 1 0] [1 0 -xrand(1/2, 3/4)];
        if xrand() > $nt ** 0.5 then (
            cycle(
                @frequency $mc.mc2f() * exp2(xrandom(-2, 4)) 
                @duration xrand(1).scale(0, 1, 50, 900, 0.5) 
                @phase xrand() 
            ).process(
                gain(($vel / 127) * 0.125) 
            ).transcribe(
                @onset $t + $off
                @gain $env
                @pan xrand() 
            ) 
        ) else (
            $sampler = xchoose(viola violin cello bass guitar harp);
            $sampler(
                @pitch $mc
                @duration null
                @velocity $vel
                @type if $sampler.intersection(harp guitar) != null then 'harm' else 'pizz' 
            ).transcribe(
                @onset $t + $off + $toff
                @pan xrand() 
                @gain $env
            ) 
        );
        $off += $incr
        ## 
        null
    );
    if xrand() > 0.9 then ($toff += xrand(1000, 2500)) 
);
render(
    @play 1 @process normalize(-3) freeverb(
        @roomsize 0.707
        @wet 0.0125
        @damp 1
        @width 1
    ) 
)