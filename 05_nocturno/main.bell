$t = 0;
importaudio('./01_keyclicks/keyclicks.wav').transcribe($t);
$t += read('./01_keyclicks/keyclicks.txt');
importaudio('./04_rall/rall.wav').transcribe($t);
$t += read('./04_rall/rall.txt');
importaudio('./02_climax/climax.wav').setkey('offset', 2000).transcribe(
    @onset $t @gain [0 0.707 0] [1 0.125 -0.125] 
);
importaudio('./03_sparkles/sparkles.wav').transcribe($t);
$t += read('./03_sparkles/sparkles.txt');
importaudio('./05_granular/granular.wav').transcribe($t);
$t += read('./05_granular/granular.txt');
render(
    @play 1 @process normalize(-3) 
);
ezexport()