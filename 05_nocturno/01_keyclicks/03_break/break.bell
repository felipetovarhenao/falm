setseed(3);
$cadence = read('../../00_harmony/harmony.txt').'cadence';
$spectrum = getkey($cadence:1, 'mcs');
$t = 0;
$t += Tremolo(
    @onset $t
    @spectrum $spectrum
    @duration 8000
    @ctrl 0
);
$tail = 2000;
render(
    @play 1 @process normalize(0) freeverb(
        @roomsize 0.95
        @wet [0 0.015 0] [1 0.25 0.125] 
        @damp 1
        @width 1
        @tail $tail
    ) fade(
        @fadein 0
        @fadeout $tail
        @fadeoutcurve 0.8
        @fadeouttype 2
    ) normalize(-19) 
);
ezexport($t)