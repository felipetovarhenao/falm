Beats = (
    $onset = 0, $spectrum, $duration = 2000, $subdivs = 12 -> (
        for $dur in timeramp(
            @duration $duration
            @length $subdivs
            @slope xrand(-0.2, 0.2) 
        ) do (
            $spectrum = xscramble($spectrum).left(4);
            $pan = xrand() - 0.5;
            for $mc in $spectrum do (
                $b = ezsol(
                    @pitch $mc
                    @duration $duration
                    @velocity 0
                    @names family('brass') 'sax' 
                    @types 'slap-pitch' 'slap-unpitch' 'perc-emb' 'keys' 
                    @useseed 1
                ).process(gain(0.125));
                $b.transcribe(
                    @onset $onset
                    @gain [0 1 0] [0.1 xrand(0.1, 0.5) -0.125] [1 0 0.5] 
                    @pan fold($pan + mc2pan($mc, 0.25)) 
                ) 
            );
            $onset += $dur
        );
        $duration
    ) 
);
$mcs = r2mc(8...32, c1).pcquant(r2pc(1 9/8 5/4 3/2 5/3 15/8));
$t = 0;
for $i in 1...4 do ($t += Beats(
    @onset $t
    @spectrum $mcs
    @duration 2000
));
render(
    @play 1 @process normalize(-3) 
)