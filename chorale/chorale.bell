RandBpf = (
    -> (
        $x = 0;
        $env = while $x < 1 collect (
            $y = abs(xrand(0.33) - xchoose(0 1));
            $pt = [$x $y xrand(-0.25, 0.25)];
            $x += xrand(0.001, 0.25) ** 2;
            $pt
        );
        $env [1 0 0] 
    ) 
);
setseed(1);
$totdur = 120000;
$mcroot = fq2;
$pcroot = mc2pc($mcroot);
$mcs = r2mc(1...64, $mcroot).pcquant(r2pc(1 9/8 6/5 4/3 21/16 3/2 12/7 5/3 7/4, $pcroot));
$st = 0;
$ids = argsort(
    abs(mc2pc($mcs) - $pcroot) 
);
$stbpf = [0 0 0] [1 1 -0.33];
for $id $ii in $ids do (
    $iin = scale($ii, 1, length($ids) + 1, 0, 1);
    $st = samplebpf($stbpf, $iin) * $totdur;
    $t = $st;
    while $t < $totdur do (
        $b = ezsol(
            @pitch $mcs:$id
            @duration null
            @names xchoose(
                'acc' if $id == 1 then 'bass' 
            ) 
            @types 'back' 'reg' 'ord' 'stacc' 'dim' 'sfz' 'cresc' 'cresc-to-dim' 
            @velocity xrandom(127) 
            @useseed 1
        );
        if xrand() > 0.75 then (
            $skipsize = xchoose(1 2 @weights 8 1);
            $neighbor = xchoose(
                $mcs:[$id + (-1 1) * $skipsize] 
            );
            $rat = 1/c2r($neighbor - $mcs:$id);
            $gliss = [0 1 0] [xrand(0.05, 2/3.) $rat xrand(0.85, 0.99)] [1 $rat 0];
            $b = $b.process(resample($gliss)) 
        );
        if xrand() > 0.75 then ($b = $b.process(reverse()));
        $env = null;
        if xrand() > 0.75 then ($env = RandBpf());
        $b = $b.analyze(envmaxtime());
        $peak = $b.getkey('envmaxtime');
        $b.transcribe(
            @onset $t
            @pan abs(xrand() - (0 1)) 
            @gain $env
        );
        $t += $peak
    );
    $st += xrand($totdur / length($mcs)) 
);
render(
    @play 1 @process normalize(-3) freeverb(
        @roomsize 0.98
        @wet 0.0125
        @damp 1
        @width 1
    ) normalize(-3) 
);
ezexport()