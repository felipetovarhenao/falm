$prog = read('./progression.txt');
$t = 0;
for $chord in $prog with @unwrap 1 do (
    $pcs = r2pc($chord);
    $mcs = r2mc(1...32, c3).pcquant($pcs);
    for $mc in $mcs.xscramble().left(25) do (
        $b = ezsol(
            @pitch $mc
            @duration 1000
            @velocity xrand(127) 
            @names 'acc' 
            @types 'back' 'reg' 'ord' 'stacc' 'dim' 'sfz' 'cresc' 'cresc-to-dim' 
        );
        $b.transcribe(
            @onset $t
            @pan xrand() 
            @gain [0 1 0] [1 0 0.8] 
        );
        $t += xrand(100) 
    ) 
);
render(
    @play 1 @process freeverb(
        @roomsize 0.9
        @wet 0.0125
        @damp 1
        @width 1
    ) normalize(-3) 
)