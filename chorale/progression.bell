Nearest = (
    $list, $target -> (
        $mindiff = 1000000;
        $bestidx = -1;
        for $elem $idx in $list do (
            $diff = abs(
                pitchdiff(r2mc($elem), r2pc($target)) 
            );
            if $diff < $mindiff then (
                $bestidx = $idx;
                $mindiff = $diff
            ) 
        );
        $bestidx
    ) 
);
HarmonicInterpolation = (
    $chord1, $chord2 -> (
        $remove = diff($chord1, $chord2);
        $add = diff($chord2, $chord1);
        $tmp = $chord1;
        $steps = [sort($chord1)];
        for $target in $add do (
            $bestidx = Nearest(
                @list $tmp
                @target $target
                @mode 1
            );
            $bestmc = $tmp:$bestidx;
            if intersection($bestmc, $remove) != null then (
                $tmp = diff($tmp, $bestmc);
                $tmp = sort($tmp $target);
                $remove = diff($remove, $bestmc);
                $add = diff($add, $target);
                $steps _= [sort($tmp)] 
            ) 
        );
        $add = for $a in $add collect [$a 1];
        $remove = for $rem in $remove collect [$rem 0];
        for $change in $remove $add with @unwrap 1 do (
            $item = $change:1;
            $mode = $change:2;
            $tmp = if $mode == 0 then diff($tmp, $item) else $tmp $item;
            $steps _= [sort($tmp)] 
        );
        $steps
    ) 
);
setseed(0);
$chords = [1 5/4 3/2 5/3] [1 4/3 5/3 9/8] [3/2 9/8 15/8 21/16];
$chords = for $r in octreduce(dr2r(8/5 :* 4)) collect octreduce($r * $chords);
$steps = for $link in group($chords, 2, 1) with @unwrap 1 collect (HarmonicInterpolation($link::1, $link::2).left(-1));
$steps _= $chords:-1;
$steps = for $pair in group($steps $steps:-1, 2, 1) with @unwrap 1 collect (
    $changes = length(diff($pair::1, $pair::2)) > 0;
    if $changes == 1 then $pair:1
);
write($steps, './progression.txt')